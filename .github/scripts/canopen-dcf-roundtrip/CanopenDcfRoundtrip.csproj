<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reads DCF files with EdsDcfNet for .github/scripts/canopen_dcf_crosscheck.py; build with -p:EdsDcfNetDir=<clone>. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(EdsDcfNetDir)/src/EdsDcfNet/EdsDcfNet.csproj" />
  </ItemGroup>
</Project>
