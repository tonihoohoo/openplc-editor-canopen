Value value="2.1.4"/></c:parameter><c:parameter uniqueID="UID_100C" access="readWrite"><label lang="en">Guard time</label><description lang="en">Node guarding period. 0: node guarding off.</description><UINT/><c:defaultValue value="0"/><c:unit multiplier="1"><label lang="en">ms</label></c:unit></c:parameter><c:parameter uniqueID="UID_100D" access="readWrite"><label lang="en">Life time factor</label><description lang="en">Guard time x life time factor = node life time.</description><USINT/><c:defaultValue value="0"/></c:parameter><c:parameter uniqueID="UID_101000" access="const"><label lang="en">Highest sub-index supported</label><USINT/><c:defaultValue value="4"/></c:parameter><c:parameter uniqueID="UID_101001" access="readWrite"><label lang="en">Save all parameters</label><description lang="en">Write "save" (0x65766173) to store. Read: how the device stores.</description><c:dataTypeIDRef uniqueIDRef="DT_101001"/><c:defaultValue value="0x00000001"/></c:parameter><c:parameter uniqueID="UID_101002" access="readWrite"><label lang="en">Save communication parameters</label><description lang="en">Write "save" (0x65766173) to store. Read: how the device stores.</description><c:dataTypeIDRef uniqueIDRef="DT_101002"/><c:defaultValue value="0x00000001"/></c:parameter><c:parameter uniqueID="UID_101003" access="readWrite"><label lang="en">Save application parameters</label><description lang="en">Write "save" (0x65766173) to store. Read: how the device stores.</description><c:dataTypeIDRef uniqueIDRef="DT_101003"/><c:defaultValue value="0x00000001"/></c:parameter><c:parameter uniqueID="UID_101004" access="readWrite"><label lang="en">Save manufacturer-defined parameters</label><description lang="en">Write "save" (0x65766173) to store. Read: how the device stores.</description><c:dataTypeIDRef uniqueIDRef="DT_101004"/><c:defaultValue value="0x00000001"/></c:parameter><c:parameter uniqueID="UID_101100" access="const"><label lang="en">Highest sub-index supported</label><USINT/><c:defaultValue value="4"/></c:parameter><c:parameter uniqueID="UID_101101" access="readWrite"><label lang="en">Restore all default parameters</label><description lang="en">Write "load" (0x64616F6C) to restore; takes effect after reset.</description><c:dataTypeIDRef uniqueIDRef="DT_101101"/><c:defaultValue value="0x00000001"/></c:parameter><c:parameter uniqueID="UID_101102" access="readWrite"><label lang="en">Restore communication default parameters</label><description lang="en">Write "load" (0x64616F6C) to restore; takes effect after reset.</description><c:dataTypeIDRef uniqueIDRef="DT_101102"/><c:defaultValue value="0x00000001"/></c:parameter><c:parameter uniqueID="UID_101103" access="readWrite"><label lang="en">Restore application default parameters</label><description lang="en">Write "load" (0x64616F6C) to restore; takes effect after reset.</description><c:dataTypeIDRef uniqueIDRef="DT_101103"/><c:defaultValue value="0x00000001"/></c:parameter><c:parameter uniqueID="UID_101104" access="readWrite"><label lang="en">Restore manufacturer-defined default parameters</label><description lang="en">Write "load" (0x64616F6C) to restore; takes effect after reset.</description><c:dataTypeIDRef uniqueIDRef="DT_101104"/><c:defaultValue value="0x00000001"/></c:parameter><c:parameter uniqueID="UID_1012" access="readWrite"><label lang="en">COB-ID time stamp object</label><c:dataTypeIDRef uniqueIDRef="DT_1012"/><c:defaultValue value="0x00000100"/></c:parameter><c:parameter uniqueID="UID_1013" access="readWrite"><label lang="en">High resolution time stamp</label><description lang="en">Time stamp in microseconds.</description><UDINT/><c:defaultValue value="0"/><c:unit multiplier="0.001"><label lang="en">ms</label></c:unit></c:parameter><c:parameter uniqueID="UID_1014" access="readWrite"><label lang="en">COB-ID EMCY</label><description lang="en">CAN-ID of the emergency message. Bit 31 set: the device sends no EMCY.</description><c:dataTypeIDRef uniqueIDRef="DT_1014"/><c:defaultValue valu