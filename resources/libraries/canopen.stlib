            "name": "CONFIRM",
            "type": "BOOL"
          },
          {
            "name": "ERROR",
            "type": "USINT"
          },
          {
            "name": "ERRORTEXT",
            "type": "STRING"
          },
          {
            "name": "STATE",
            "type": "USINT"
          }
        ],
        "inouts": [],
        "implementation": "cpp",
        "sourceFile": "GET_STATE.cpp",
        "documentation": "Gives a node's NMT state as the master sees it, in the same call while ENABLE is TRUE: INIT, PRE_OPERATIONAL, STOPPED, OPERATIONAL, UNKNOWN or NOT_AVAIL (not answering). NETWORK counts from 1; DEVICE is the node ID or its name.\nExample: state(ENABLE := TRUE, DEVICE := IO_Module); IF state.STATE = STOPPED THEN ... END_IF;"
      },
