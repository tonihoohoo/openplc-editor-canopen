  "sources": [
    {
      "fileName": "types.st",
      "source": "(* Types and constants of the canopen function block library (CiA 405 names).\n\n   STruC++ does not carry the values of a library's enumerations into a program, so the CiA 405\n   enumerations are USINT types with one constant per value: a program writes\n   IF sdo.ERROR = CANOPEN_KERNEL_TIMEOUT THEN ... and NMT(STATE := START_REMOTE_NODE, ...). *)\nTYPE\n  CANOPEN_KERNEL_ERROR : USINT;\n  DEVICE_STATE : USINT;\n  TRANSITION_STATE : USINT;\n  CANOPEN_RUN_STATE : USINT;\n  CANOPEN_BUS_STATE : USINT;\n  EMCY_ERROR : STRUCT\n    ERRORCODE : WORD;\n    ERRORREGISTER : BYTE;\n    MANUFACTURERERROR : ARRAY[0..4] OF BYTE;\n  END_STRUCT;\nEND_TYPE\n\nVAR_GLOBAL CONSTANT\n  CANOPEN_KERNEL_NO_ERROR : USINT := 0;\n  CANOPEN_KERNEL_OTHER_ERROR : USINT := 1;\n  CANOPEN_KERNEL_TIMEOUT : USINT := 2;\n  CANOPEN_KERNEL_BUS_OFF : USINT := 3;\n  CANOPEN_KERNEL_ERROR_PASSIVE : USINT := 4;\n  CANOPEN_KERNEL_INTERNAL : USINT := 5;\n  CANOPEN_KERNEL_WRONG_PARAMETER : USINT := 6;\n  CANOPEN_KERNEL_NODE_ID_UNKNOWN : USINT := 7;\n  CANOPEN_KERNEL_NET_ID_UNKNOWN : USINT := 8;\n  CANOPEN_KERNEL_REQUEST_ERROR : USINT := 9;\n  CANOPEN_KERNEL_NO_DRIVER : USINT := 10;\n\n  INIT : USINT := 0;\n  RESET_COMM : USINT := 1;\n  RESET_APP : USINT := 2;\n  PRE_OPERATIONAL : USINT := 3;\n  STOPPED : USINT := 4;\n  OPERATIONAL : USINT := 5;\n  UNKNOWN : USINT := 6;\n  NOT_AVAIL : USINT := 7;\n\n  START_REMOTE_NODE : USINT := 0;\n  STOP_REMOTE_NODE : USINT := 1;\n  ENTER_PRE_OPERATIONAL : USINT := 2;\n  RESET_NODE : USINT := 3;\n  RESET_COMMUNICATION : USINT := 4;\n\n  RUN_NOT_FOUND : USINT := 0;\n  RUN_BOOTING : USINT := 1;\n  RUN_FAILED : USINT := 2;\n  RUN_WAITING_START : USINT := 3;\n  RUN_OPERATIONAL : USINT := 4;\n  RUN_MANUAL : USINT := 5;\n  RUN_LOST : USINT := 6;\n  RUN_HELD : USINT := 7;\n  RUN_DISABLED : USINT := 8;\n  RUN_STOPPED : USINT := 9;\n\n  BUS_ERROR_ACTIVE : USINT := 0;\n  BUS_ERROR_PASSIVE : USINT := 1;\n  BUS_OFF : USINT := 2;\n  BUS_UNKNOWN : USINT := 3;\nEND_VAR\n\nFUNCTION CANOPEN_DWORD_TO_REAL : REAL\n(* The REAL whose IEEE 754 bits are IN, every bit kept. Example:\n   speed := CANOPEN_DWORD_TO_REAL(read.DATA); *)\nVAR_INPUT\n  IN : DWORD;\nEND_VAR\n{external\n  uint32_t canopen_bits = IN;\n  float canopen_value;\n  __builtin_memcpy(&canopen_value, &canopen_bits, sizeof canopen_value);\n  CANOPEN_DWORD_TO_REAL_result = canopen_value;\n}\nEND_FUNCTION\n\nFUNCTION CANOPEN_REAL_TO_DWORD : DWORD\n(* The IEEE 754 bits of IN as a DWORD, every bit kept. Example:\n   write(DATA := CANOPEN_REAL_TO_DWORD(1.5), DATALENGTH := 4, ...); *)\nVAR_INPUT\n  IN : REAL;\nEND_VAR\n{external\n  float canopen_value = IN;\n  uint32_t canopen_bits;\n  __builtin_memcpy(&canopen_bits, &canopen_value, sizeof canopen_bits);\n  CANOPEN_REAL_TO_DWORD_result = canopen_bits;\n}\nEND_FUNCTION\n"
    },
    {
      "fileName": "SDO_READ4.cpp",
      "source": "(* Reads an object of 1 to 4 bytes from a node by SDO. A rising edge of ENABLE starts the read; BUSY is TRUE until it ends, then CONFIRM (DATA holds the value, little-endian and zero-filled, DATALENGTH the byte count) or ERROR with ERRORTEXT stays until ENABLE goes FALSE. NETWORK counts from 1; DEVICE is the node ID or its name; TIMEOUT T#0s uses the network SDO timeout.\nExample: read(ENABLE := start, DEVICE := IO_Module, INDEX := 16#1018, SUBINDEX := 1); IF read.CONFIRM THEN vendor := read.DATA; END_IF; *)\nFUNCTION_BLOCK SDO_READ4\nVAR_INPUT\n  NETWORK : USINT := 1;\n  ENABLE : BOOL;\n  DEVICE : USINT;\n  INDEX : WORD;\n  SUBINDEX : BYTE;\n  TIMEOUT : TIME;\nEND_VAR\nVAR_OUTPUT\n  CONFIRM : BOOL;\n  BUSY : BOOL;\n  ERROR : USINT;\n  ERRORINFO : UDINT;\n  ERRORTEXT : STRING;\n  DATA : DWORD;\n  DATALENGTH : USINT;\nEND_VAR\nVAR\n  cop_prev : BOOL;\n  cop_phase : USINT;\n  cop_handle : ULINT;\n  cop_net : USINT;\n  cop_node : USINT;\n  cop_index : WORD;\n  cop_sub : BYTE;\n  cop_timeout : UDINT;\nEND_VAR\n// SPDX-License-Identifier: Apache-2.0\n//\n// Shared code of the canopen function blocks. The generator copies it into every block's source,\n// because the editor grafts each library C++ block into one c_blocks_code.cpp and has no other\n// place for shared code; the include guard keeps one copy per program.\n//\n// The editor binds every pin and local of a block to a #define of its name, so nothing here uses\n// a pin or local name (those are upper case or start with cop_; this code is lower case), nor the\n// keyword that closes a variable section, and no system header is included after those defines:\n// dlopen, dlsym and dlclose are declared here as glibc declares them.\n//\n// Derived from canworks ec7fd59, library/src/common.inc (Apache-2.0), adapted to the plugin's\n// interface version 3 (core/src/drivers/plugins/native/canopen/plc_api.h in the runtime fork).\n#ifndef CANOPEN_FB_SHARED_INCLUDED\n#define CANOPEN_FB_SHARED_INCLUDED\n#if defined(__linux__)\nextern \"C\" void *dlopen(const char *file, int mode) noexcept(true);\nextern \"C\" void *dlsym(void *handle, const char *name) noexcept(true);\nextern \"C\" int dlclose(void *handle) noexcept(true);\n#else\n// A board's firmware: the slave module's table, when the project has a slave on the board.\nextern \"C\" const void *canopen_plc_api(uint32_t version) __attribute__((weak));\n#endif\n\nnamespace canopen_fb {\n\n// A copy of the plugin's C interface, version 3; keep in step with plc_api.h. Version 1 is asked\n// for, since a newer plugin answers it with its newest table; `size` tells which it is.\nconst uint32_t api_version = 1;\nconst uint32_t max_data = 256;\nenum {\n  e_no_error = 0, e_other_error = 1, e_timeout = 2, e_bus_off = 3, e_error_passive = 4,\n  e_internal = 5, e_wrong_parameter = 6, e_node_id_unknown = 7, e_net_id_unknown = 8,\n  e_request_error = 9, e_no_driver = 10\n};\nenum {\n  r_none = 0, r_booting = 1, r_full = 2, r_not_run = 3, r_restart = 4, r_link = 5,\n  r_too_large = 6, r_length = 7, r_command = 8, r_version = 9,\n  r_not_in_eds = 100,  // the blocks' own: DATALENGTH 0 for an object the EDS does not list\n  r_needs_v2 = 101,    // the blocks' own: the plugin's table lacks the functions the block needs\n  r_reset = 102,       // the blocks' own: a slave NMT block asked for a reset\n  r_own_code = 103,    // the blocks' own: an emergency code the slave sends itself\n  r_slots = 104,       // the blocks' own: all program emergency slots are taken\n  r_object = 105       // the blocks' own: the slave has no such object from the master\n};\nenum { k_read = 0, k_write = 1, k_nmt = 2 };\nstruct request {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint8_t command;\n  uint16_t index;\n  uint8_t subindex;\n  uint8_t reserved;\n  uint32_t timeout_ms;\n  uint32_t length;\n  const uint8_t *data;\n};\nstruct result {\n  uint8_t error;\n  uint8_t reason;\n  uint16_t reserved;\n  uint32_t abort_code;\n  uint32_t length;\n};\nstruct emcy {\n  uint8_t node;\n  uint8_t error_register;\n  uint16_t error_code;\n  uint8_t data[5];\n  uint8_t reserved[3];\n  uint32_t lost;\n};\nstruct api_v1 {\n  uint32_t size;\n  uint32_t version;\n  uint64_t (*start)(const request *req, result *res);\n  int (*poll)(uint64_t handle, result *res, uint8_t *data, uint32_t cap);\n  void (*cancel)(uint64_t handle);\n  int (*node_state)(uint8_t network, uint8_t node, uint8_t *state);\n  int (*kernel_state)(uint8_t network, uint8_t *state);\n  int (*local_node_id)(uint8_t network, uint8_t *node_id);\n  int (*emcy_cursor)(uint8_t network, uint64_t *cursor);\n  int (*emcy_next)(uint8_t network, uint8_t node, uint64_t *cursor, emcy *out);\n  uint32_t flags;  // present when size covers it\n};\n// flags: the plugin is never unmapped, so its table stays valid for the life of the process.\nconst uint32_t flag_permanent = 0x1;\n// node_info::flags\nconst uint8_t node_enabled = 0x01;\nconst uint8_t node_optional = 0x02;\nconst uint8_t node_program_start = 0x04;\nconst uint32_t status_text = 80;\nstruct node_info {\n  uint8_t run_state;\n  uint8_t flags;\n  uint8_t reserved[2];\n  char problem[status_text];\n};\nstruct network_info {\n  uint8_t mandatory_up;\n  uint8_t optional_up;\n  uint8_t configured;\n  uint8_t operational;\n  uint8_t waiting;\n  uint8_t disabled;\n  uint8_t faulty;\n  uint8_t nodes;\n};\nstruct api_v2 {\n  api_v1 v1;\n  int (*node_status)(uint8_t network, uint8_t node, node_info *out);\n  int (*network_status)(uint8_t network, network_info *out);\n  int (*node_enable)(uint8_t network, uint8_t node, uint8_t on);\n};\n// slave_info::flags\nconst uint8_t slave_on_bus = 0x01;\nconst uint8_t slave_master_watched = 0x02;\nconst uint8_t slave_master_seen = 0x04;\nconst uint32_t slave_emcy_slots = 31;\nstruct slave_info {\n  uint8_t state;\n  uint8_t node_id;\n  uint8_t flags;\n  uint8_t bus_state;\n  uint8_t error_register;\n  uint8_t emcy_active;\n  uint8_t reserved[2];\n};\nstruct api_v3 {\n  api_v2 v2;\n  int (*slave_status)(uint8_t slave, slave_info *out);\n  int (*slave_nmt)(uint8_t slave, uint8_t command);\n  int (*slave_nmt_done)(uint8_t slave, uint8_t command, uint8_t *done);\n  int (*slave_emcy_claim)(uint8_t slave, uint32_t *handle);\n  int (*slave_emcy)(uint8_t slave, uint32_t handle, uint8_t active, uint16_t code, uint32_t info);\n  int (*slave_written)(uint8_t slave, uint16_t index, uint8_t subindex, uint32_t *count);\n};\n// After a lookup that found no plugin, this many lookups are skipped before the next one.\nconst uint32_t miss_skip = 1024;\n\n// The loaded plugin's table, or null with `why` set (r_not_run or r_version). The runtime loads\n// the plugin again at each PLC start while this program stays loaded, so a table is kept only\n// when its flags say it stays valid; otherwise it is looked up on each call. While no plugin is\n// found, only one lookup in miss_skip runs; the others answer r_not_run at once.\ninline const api_v1 *lookup_api(uint8_t &why) {\n  const void *table = nullptr;\n  why = r_not_run;\n#if defined(__linux__)\n  void *lib = dlopen(\"libcanopen_plugin.so\", 0x2 | 0x4);  // RTLD_NOW | RTLD_NOLOAD\n  if (!lib) return nullptr;\n  typedef const void *(*entry_t)(uint32_t);\n  entry_t entry = reinterpret_cast<entry_t>(dlsym(lib, \"canopen_plc_api\"));\n  if (entry) {\n    table = entry(api_version);\n    if (!table) why = r_version;\n  }\n  dlclose(lib);\n#else\n  if (canopen_plc_api) {\n    table = canopen_plc_api(api_version);\n    if (!table) why = r_version;\n  }\n#endif\n  const api_v1 *t = static_cast<const api_v1 *>(table);\n  if (t && t->size < __builtin_offsetof(api_v1, flags)) {\n    why = r_version;\n    return nullptr;\n  }\n  return t;\n}\n\ninline bool api_is_permanent(const api_v1 *t) {\n  return t->size >= sizeof(api_v1) && (t->flags & flag_permanent) != 0;\n}\n\ninline const api_v1 *api(uint8_t &why) {\n  static const api_v1 *kept = nullptr;\n  static uint32_t skip = 0;\n  const api_v1 *t = __atomic_load_n(&kept, __ATOMIC_ACQUIRE);\n  if (t) {\n    why = r_not_run;\n    return t;\n  }\n  uint32_t left = __atomic_load_n(&skip, __ATOMIC_RELAXED);\n  if (left > 0) {\n    __atomic_store_n(&skip, left - 1, __ATOMIC_RELAXED);\n    why = r_not_run;\n    return nullptr;\n  }\n  t = lookup_api(why);\n  if (!t) {\n    if (why == r_not_run) __atomic_store_n(&skip, miss_skip, __ATOMIC_RELAXED);\n    return nullptr;\n  }\n  if (api_is_permanent(t)) __atomic_store_n(&kept, t, __ATOMIC_RELEASE);\n  return t;\n}\n\n// The table with the version 2 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v2 *api2(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 2 || t->size < sizeof(api_v2)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v2 *>(static_cast<const void *>(t));\n}\n\n// The table with the version 3 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v3 *api3(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 3 || t->size < sizeof(api_v3)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v3 *>(static_cast<const void *>(t));\n}\n\n// ---- Error text, written into a fixed buffer (no allocation, no libc). ----\nstruct text {\n  char buf[200];\n  unsigned len;\n};\ninline void clear(text &t) {\n  t.len = 0;\n  t.buf[0] = 0;\n}\ninline void put(text &t, const char *s) {\n  while (*s && t.len + 1 < sizeof t.buf) t.buf[t.len++] = *s++;\n  t.buf[t.len] = 0;\n}\ninline void put_dec(text &t, uint32_t v) {\n  char d[12];\n  int n = 0;\n  do {\n    d[n++] = static_cast<char>('0' + v % 10);\n    v /= 10;\n  } while (v && n < 12);\n  while (n > 0 && t.len + 1 < sizeof t.buf) t.buf[t.len++] = d[--n];\n  t.buf[t.len] = 0;\n}\ninline void put_hex(text &t, uint32_t v, int digits) {\n  put(t, \"16#\");\n  for (int i = digits - 1; i >= 0 && t.len + 1 < sizeof t.buf; --i)\n    t.buf[t.len++] = \"0123456789ABCDEF\"[(v >> (4 * i)) & 0xF];\n  t.buf[t.len] = 0;\n}\n\n// CiA 301 SDO abort codes.\ninline const char *abort_text(uint32_t code) {\n  switch (code) {\n    case 0x05030000u: return \"toggle bit not alternated\";\n    case 0x05040000u: return \"SDO protocol timed out\";\n    case 0x05040001u: return \"command specifier not valid or unknown\";\n    case 0x05040002u: return \"invalid block size\";\n    case 0x05040003u: return \"invalid sequence number\";\n    case 0x05040004u: return \"CRC error\";\n    case 0x05040005u: return \"out of memory\";\n    case 0x06010000u: return \"unsupported access to an object\";\n    case 0x06010001u: return \"attempt to read a write only object\";\n    case 0x06010002u: return \"attempt to write a read only object\";\n    case 0x06020000u: return \"object does not exist\";\n    case 0x06040041u: return \"object cannot be mapped to the PDO\";\n    case 0x06040042u: return \"the mapped objects would exceed the PDO length\";\n    case 0x06040043u: return \"general parameter incompatibility\";\n    case 0x06040047u: return \"general internal incompatibility in the device\";\n    case 0x06060000u: return \"access failed due to a hardware error\";\n    case 0x06070010u: return \"data type or length does not match\";\n    case 0x06070012u: return \"data type does not match, length too high\";\n    case 0x06070013u: return \"data type does not match, length too low\";\n    case 0x06090011u: return \"sub-index does not exist\";\n    case 0x06090030u: return \"invalid value for parameter\";\n    case 0x06090031u: return \"value of parameter written too high\";\n    case 0x06090032u: return \"value of parameter written too low\";\n    case 0x06090036u: return \"maximum value is less than minimum value\";\n    case 0x060A0023u: return \"resource not available: SDO connection\";\n    case 0x08000000u: return \"general error\";\n    case 0x08000020u: return \"data cannot be transferred or stored to the application\";\n    case 0x08000021u: return \"data cannot be transferred or stored because of local control\";\n    case 0x08000022u: return \"data cannot be transferred or stored in the present device state\";\n    case 0x08000023u: return \"no object dictionary is present\";\n    case 0x08000024u: return \"no data available\";\n    default: return \"unknown abort code\";\n  }\n}\n\n// What a request was about, for its error text.\nstruct what {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint16_t index;\n  uint8_t subindex;\n  uint32_t timeout_ms;\n  uint32_t capacity;  // bytes the block holds\n};\n\ninline what what_of(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex,\n                    uint32_t timeout_ms, uint32_t capacity) {\n  what w{};\n  w.network = network;\n  w.node = node;\n  w.index = index;\n  w.subindex = subindex;\n  w.timeout_ms = timeout_ms;\n  w.capacity = capacity;\n  return w;\n}\n\ninline void put_node(text &t, const what &w) {\n  if (w.node == 0) {\n    put(t, \"the nodes of network \");\n    put_dec(t, w.network);\n  } else {\n    put(t, \"node \");\n    put_dec(t, w.node);\n  }\n}\n\ninline void put_object(text &t, const what &w) {\n  put_hex(t, w.index, 4);\n  put(t, \" sub \");\n  put_dec(t, w.subindex);\n}\n\n// The error text of a failed request, and its ERRORINFO.\ninline uint32_t describe(text &t, const what &w, const result &r) {\n  clear(t);\n  switch (r.error) {\n    case e_other_error:\n      put_node(t, w);\n      put(t, \" aborted \");\n      put_object(t, w);\n      put(t, \": \");\n      put(t, abort_text(r.abort_code));\n      put(t, \" (\");\n      put_hex(t, r.abort_code, 8);\n      put(t, \")\");\n      return r.abort_code;\n    case e_timeout:\n      put_node(t, w);\n      put(t, \" did not answer\");\n      if (w.timeout_ms) {\n        put(t, \" within \");\n        put_dec(t, w.timeout_ms);\n        put(t, \" ms\");\n      }\n      return r.abort_code ? r.abort_code : 0x05040000u;\n    case e_bus_off:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, r.reason == r_link ? \" link is down\" : \" bus is off\");\n      return 0;\n    case e_error_passive:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" is error passive\");\n      return 0;\n    case e_wrong_parameter:\n      if (r.reason == r_too_large) {\n        put(t, \"object has \");\n        put_dec(t, r.length);\n        put(t, \" bytes, the block holds \");\n        put_dec(t, w.capacity);\n        return r.length;\n      }\n      if (r.reason == r_length) {\n        put(t, \"DATALENGTH \");\n        put_dec(t, r.length);\n        put(t, \" is not 1 to \");\n        put_dec(t, w.capacity);\n        return 0;\n      }\n      if (r.reason == r_not_in_eds) {\n        put_node(t, w);\n        put(t, \" has no object \");\n        put_object(t, w);\n        put(t, \" of 1 to 4 bytes in its EDS; set DATALENGTH\");\n        return 0;\n      }\n      if (r.reason == r_command) {\n        put(t, \"STATE \");\n        put_dec(t, r.length);\n        put(t, \" is not an NMT state change\");\n        return 0;\n      }\n      put(t, \"wrong parameter\");\n      return 0;\n    case e_node_id_unknown:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" has no node \");\n      put_dec(t, w.node);\n      return 0;\n    case e_net_id_unknown:\n      put(t, \"no CANopen network \");\n      put_dec(t, w.network);\n      return 0;\n    case e_request_error:\n      if (r.reason == r_booting) {\n        put_node(t, w);\n        put(t, \" is booting\");\n      } else if (r.reason == r_full) {\n        put(t, \"network \");\n        put_dec(t, w.network);\n        put(t, \" has 16 block requests waiting\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return 0;\n    case e_no_driver:\n      if (r.reason == r_restart)\n        put(t, \"request cancelled by the PLC stop\");\n      else if (r.reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else if (r.reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else\n        put(t, \"no CANopen network runs\");\n      return 0;\n    default:\n      put(t, \"internal error in the CANopen master\");\n      return 0;\n  }\n}\n\n// The error text of a slave block, for `slave` and the object (index, subindex) or ERRORCODE.\ninline void describe_slave(text &t, uint8_t slave, uint8_t error, uint8_t reason, uint16_t index,\n                           uint8_t subindex) {\n  clear(t);\n  switch (error) {\n    case e_no_error:\n      return;\n    case e_net_id_unknown:\n      put(t, \"no CANopen slave \");\n      put_dec(t, slave);\n      return;\n    case e_no_driver:\n      if (reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else if (reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else\n        put(t, \"no CANopen slave runs\");\n      return;\n    case e_wrong_parameter:\n      if (reason == r_reset) {\n        put(t, \"the program cannot reset the slave; STATE must be START_REMOTE_NODE, \");\n        put(t, \"STOP_REMOTE_NODE or ENTER_PRE_OPERATIONAL\");\n      } else if (reason == r_own_code) {\n        put(t, \"ERRORCODE \");\n        put_hex(t, index, 4);\n        put(t, \" is sent by the slave itself; use another code\");\n      } else if (reason == r_object) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" has no object \");\n        put_hex(t, index, 4);\n        put(t, \" sub \");\n        put_dec(t, subindex);\n        put(t, \" written by the master\");\n      } else {\n        put(t, \"wrong parameter\");\n      }\n      return;\n    case e_request_error:\n      if (reason == r_slots) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" already holds 31 program emergencies\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return;\n    default:\n      put(t, \"internal error in the CANopen slave\");\n      return;\n  }\n}\n\n// Shows a failed request on the block's ERROR, ERRORINFO and ERRORTEXT pins.\ntemplate <class error_pin, class info_pin, class text_pin>\ninline void show(error_pin &error, info_pin &info, text_pin &errortext, const what &w,\n                 const result &r) {\n  text t;\n  uint32_t i = describe(t, w, r);\n  error = r.error ? r.error : static_cast<uint8_t>(e_internal);\n  info = i;\n  errortext = t.buf;\n}\n\n// The size of an object of 1 to 4 bytes in the node's EDS, from the table the editor's build\n// generates (sorted network, node, index, sub-index, size); 0 when it is not listed.\ninline uint32_t eds_size(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex) {\n  const uint64_t key = (static_cast<uint64_t>(network) << 32) | (static_cast<uint64_t>(node) << 24) |\n                       (static_cast<uint64_t>(index) << 8) | subindex;\n  long lo = 0;\n  long hi = static_cast<long>(static_cast<uint32_t>(strucpp::CANOPEN_OBJECT_SIZE_COUNT)) - 1;\n  while (lo <= hi) {\n    long mid = (lo + hi) / 2;\n    uint64_t entry = static_cast<uint64_t>(strucpp::CANOPEN_OBJECT_SIZES[mid]);\n    uint64_t k = entry >> 8;\n    if (k == key) return static_cast<uint32_t>(entry & 0xFF);\n    if (k < key)\n      lo = mid + 1;\n    else\n      hi = mid - 1;\n  }\n  return 0;\n}\n\n// TIME (nanoseconds) to milliseconds; 0 or less: the network's SDO timeout.\ninline uint32_t timeout_ms(long long ns) {\n  if (ns <= 0) return 0;\n  long long ms = (ns + 999999) / 1000000;\n  return ms > 3600000 ? 3600000u : static_cast<uint32_t>(ms);\n}\n\n// One instance's handshake (CiA 405): the block keeps `prev`, `phase` and `handle` in its locals.\nenum { phase_idle = 0, phase_busy = 1, phase_ended = 2 };\nstruct step {\n  bool start;   // rising edge of ENABLE: clear the outputs and start a request\n  bool cancel;  // falling edge while busy: drop the request and clear the outputs\n  bool clear;   // the result was shown and ENABLE is FALSE: clear the outputs\n};\ninline step begin(bool enable, bool &prev, uint8_t &phase) {\n  step s{false, false, false};\n  bool rising = enable && !prev;\n  prev = enable;\n  if (!enable && phase == phase_busy) {\n    s.cancel = true;\n    phase = phase_idle;\n  } else if (!enable && phase == phase_ended) {\n    s.clear = true;\n    phase = phase_idle;\n  }\n  if (rising && phase != phase_busy) s.start = true;\n  return s;\n}\n\n// Starts `req`. Returns the handle, or 0 with `res` saying why it cannot run.\ninline uint64_t start(const request &req, result &res) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why;\n    return 0;\n  }\n  uint64_t handle = t->start(&req, &res);\n  if (!handle && res.error == e_no_error) res.error = e_internal;\n  return handle;\n}\n\n// 0 while the request runs; 1 done, 2 failed (`res` set).\ninline int poll(uint64_t handle, result &res, uint8_t *data, uint32_t cap) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why == r_version ? r_version : r_restart;\n    return 2;\n  }\n  return t->poll(handle, &res, data, cap);\n}\n\ninline void cancel(uint64_t handle) {\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (t) t->cancel(handle);\n}\n\ninline void put_le(uint8_t *out, uint32_t v, unsigned n) {\n  for (unsigned b = 0; b < n; ++b) out[b] = static_cast<uint8_t>(v >> (8 * b));\n}\n\ninline uint32_t get_le(const uint8_t *in, unsigned n) {\n  uint32_t v = 0;\n  for (unsigned b = 0; b < n && b < 4; ++b) v |= static_cast<uint32_t>(in[b]) << (8 * b);\n  return v;\n}\n\n// A failure before any request ran (bad input): `res` for describe().\ninline result fail(uint8_t error, uint8_t reason, uint32_t length) {\n  result r{};\n  r.error = error;\n  r.reason = reason;\n  r.length = length;\n  return r;\n}\n\n}  // namespace canopen_fb\n#endif\nvoid setup() {\n}\n\nvoid loop() {\n  bool l_prev = cop_prev;\n  uint8_t l_phase = cop_phase;\n  canopen_fb::step l_step = canopen_fb::begin(ENABLE, l_prev, l_phase);\n  cop_prev = l_prev;\n  cop_phase = l_phase;\n  if (l_step.cancel) canopen_fb::cancel(cop_handle);\n  if (l_step.cancel || l_step.clear || l_step.start) {\n    BUSY = false;\n    CONFIRM = false;\n    ERROR = 0;\n    ERRORINFO = 0;\n    ERRORTEXT = \"\";\n    cop_handle = 0;\n    DATA = 0;\n    DATALENGTH = 0;\n  }\n  if (l_step.start) {\n    canopen_fb::request l_req = {};\n    l_req.network = NETWORK;\n    l_req.node = DEVICE;\n    l_req.kind = canopen_fb::k_read;\n    l_req.index = INDEX;\n    l_req.subindex = SUBINDEX;\n    l_req.timeout_ms = canopen_fb::timeout_ms(TIMEOUT);\n    canopen_fb::result l_res = {};\n    canopen_fb::result l_bad = {};\n    uint8_t l_payload[canopen_fb::max_data];\n    (void)l_payload;\n    cop_net = l_req.network;\n    cop_node = l_req.node;\n    cop_index = l_req.index;\n    cop_sub = l_req.subindex;\n    cop_timeout = l_req.timeout_ms;\n    uint64_t l_handle = l_bad.error ? 0 : canopen_fb::start(l_req, l_res);\n    if (l_handle) {\n      cop_handle = l_handle;\n      BUSY = true;\n      cop_phase = canopen_fb::phase_busy;\n    } else {\n      cop_phase = canopen_fb::phase_ended;\n      canopen_fb::show(ERROR, ERRORINFO, ERRORTEXT, canopen_fb::what_of(cop_net, cop_node, cop_index, cop_sub,\n                       cop_timeout, 4), l_bad.error ? l_bad : l_res);\n    }\n  }\n  if (cop_phase == canopen_fb::phase_busy) {\n    canopen_fb::result l_res = {};\n    uint8_t l_buf[canopen_fb::max_data + 1];\n    int l_state = canopen_fb::poll(cop_handle, l_res, l_buf, canopen_fb::max_data);\n    if (l_state != 0) {\n      BUSY = false;\n      cop_handle = 0;\n      cop_phase = canopen_fb::phase_ended;\n      if (l_state == 1 && l_res.length > 4u) {\n        l_state = 2;\n        l_res = canopen_fb::fail(canopen_fb::e_wrong_parameter, canopen_fb::r_too_large, l_res.length);\n      }\n      if (l_state == 1) {\n        CONFIRM = true;\n        DATA = canopen_fb::get_le(l_buf, l_res.length);\n        DATALENGTH = static_cast<uint8_t>(l_res.length);\n      } else {\n        canopen_fb::show(ERROR, ERRORINFO, ERRORTEXT, canopen_fb::what_of(cop_net, cop_node, cop_index, cop_sub,\n                         cop_timeout, 4), l_res);\n      }\n    }\n  }\n}\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "SDO_WRITE4.cpp",
      "source": "(* Writes an object of 1 to 4 bytes of a node by SDO: the low DATALENGTH bytes of DATA, little-endian. DATALENGTH 0 takes the size from the node's EDS. A rising edge of ENABLE starts the write; then CONFIRM or ERROR with ERRORTEXT stays until ENABLE goes FALSE. NETWORK counts from 1; DEVICE is the node ID or its name; TIMEOUT T#0s uses the network SDO timeout.\nExample: write(ENABLE := set, DEVICE := IO_Module, INDEX := 16#1017, SUBINDEX := 0, DATA := 1000); *)\nFUNCTION_BLOCK SDO_WRITE4\nVAR_INPUT\n  NETWORK : USINT := 1;\n  ENABLE : BOOL;\n  DEVICE : USINT;\n  INDEX : WORD;\n  SUBINDEX : BYTE;\n  DATA : DWORD;\n  DATALENGTH : USINT;\n  TIMEOUT : TIME;\nEND_VAR\nVAR_OUTPUT\n  CONFIRM : BOOL;\n  BUSY : BOOL;\n  ERROR : USINT;\n  ERRORINFO : UDINT;\n  ERRORTEXT : STRING;\nEND_VAR\nVAR\n  cop_prev : BOOL;\n  cop_phase : USINT;\n  cop_handle : ULINT;\n  cop_net : USINT;\n  cop_node : USINT;\n  cop_index : WORD;\n  cop_sub : BYTE;\n  cop_timeout : UDINT;\nEND_VAR\n// SPDX-License-Identifier: Apache-2.0\n//\n// Shared code of the canopen function blocks. The generator copies it into every block's source,\n// because the editor grafts each library C++ block into one c_blocks_code.cpp and has no other\n// place for shared code; the include guard keeps one copy per program.\n//\n// The editor binds every pin and local of a block to a #define of its name, so nothing here uses\n// a pin or local name (those are upper case or start with cop_; this code is lower case), nor the\n// keyword that closes a variable section, and no system header is included after those defines:\n// dlopen, dlsym and dlclose are declared here as glibc declares them.\n//\n// Derived from canworks ec7fd59, library/src/common.inc (Apache-2.0), adapted to the plugin's\n// interface version 3 (core/src/drivers/plugins/native/canopen/plc_api.h in the runtime fork).\n#ifndef CANOPEN_FB_SHARED_INCLUDED\n#define CANOPEN_FB_SHARED_INCLUDED\n#if defined(__linux__)\nextern \"C\" void *dlopen(const char *file, int mode) noexcept(true);\nextern \"C\" void *dlsym(void *handle, const char *name) noexcept(true);\nextern \"C\" int dlclose(void *handle) noexcept(true);\n#else\n// A board's firmware: the slave module's table, when the project has a slave on the board.\nextern \"C\" const void *canopen_plc_api(uint32_t version) __attribute__((weak));\n#endif\n\nnamespace canopen_fb {\n\n// A copy of the plugin's C interface, version 3; keep in step with plc_api.h. Version 1 is asked\n// for, since a newer plugin answers it with its newest table; `size` tells which it is.\nconst uint32_t api_version = 1;\nconst uint32_t max_data = 256;\nenum {\n  e_no_error = 0, e_other_error = 1, e_timeout = 2, e_bus_off = 3, e_error_passive = 4,\n  e_internal = 5, e_wrong_parameter = 6, e_node_id_unknown = 7, e_net_id_unknown = 8,\n  e_request_error = 9, e_no_driver = 10\n};\nenum {\n  r_none = 0, r_booting = 1, r_full = 2, r_not_run = 3, r_restart = 4, r_link = 5,\n  r_too_large = 6, r_length = 7, r_command = 8, r_version = 9,\n  r_not_in_eds = 100,  // the blocks' own: DATALENGTH 0 for an object the EDS does not list\n  r_needs_v2 = 101,    // the blocks' own: the plugin's table lacks the functions the block needs\n  r_reset = 102,       // the blocks' own: a slave NMT block asked for a reset\n  r_own_code = 103,    // the blocks' own: an emergency code the slave sends itself\n  r_slots = 104,       // the blocks' own: all program emergency slots are taken\n  r_object = 105       // the blocks' own: the slave has no such object from the master\n};\nenum { k_read = 0, k_write = 1, k_nmt = 2 };\nstruct request {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint8_t command;\n  uint16_t index;\n  uint8_t subindex;\n  uint8_t reserved;\n  uint32_t timeout_ms;\n  uint32_t length;\n  const uint8_t *data;\n};\nstruct result {\n  uint8_t error;\n  uint8_t reason;\n  uint16_t reserved;\n  uint32_t abort_code;\n  uint32_t length;\n};\nstruct emcy {\n  uint8_t node;\n  uint8_t error_register;\n  uint16_t error_code;\n  uint8_t data[5];\n  uint8_t reserved[3];\n  uint32_t lost;\n};\nstruct api_v1 {\n  uint32_t size;\n  uint32_t version;\n  uint64_t (*start)(const request *req, result *res);\n  int (*poll)(uint64_t handle, result *res, uint8_t *data, uint32_t cap);\n  void (*cancel)(uint64_t handle);\n  int (*node_state)(uint8_t network, uint8_t node, uint8_t *state);\n  int (*kernel_state)(uint8_t network, uint8_t *state);\n  int (*local_node_id)(uint8_t network, uint8_t *node_id);\n  int (*emcy_cursor)(uint8_t network, uint64_t *cursor);\n  int (*emcy_next)(uint8_t network, uint8_t node, uint64_t *cursor, emcy *out);\n  uint32_t flags;  // present when size covers it\n};\n// flags: the plugin is never unmapped, so its table stays valid for the life of the process.\nconst uint32_t flag_permanent = 0x1;\n// node_info::flags\nconst uint8_t node_enabled = 0x01;\nconst uint8_t node_optional = 0x02;\nconst uint8_t node_program_start = 0x04;\nconst uint32_t status_text = 80;\nstruct node_info {\n  uint8_t run_state;\n  uint8_t flags;\n  uint8_t reserved[2];\n  char problem[status_text];\n};\nstruct network_info {\n  uint8_t mandatory_up;\n  uint8_t optional_up;\n  uint8_t configured;\n  uint8_t operational;\n  uint8_t waiting;\n  uint8_t disabled;\n  uint8_t faulty;\n  uint8_t nodes;\n};\nstruct api_v2 {\n  api_v1 v1;\n  int (*node_status)(uint8_t network, uint8_t node, node_info *out);\n  int (*network_status)(uint8_t network, network_info *out);\n  int (*node_enable)(uint8_t network, uint8_t node, uint8_t on);\n};\n// slave_info::flags\nconst uint8_t slave_on_bus = 0x01;\nconst uint8_t slave_master_watched = 0x02;\nconst uint8_t slave_master_seen = 0x04;\nconst uint32_t slave_emcy_slots = 31;\nstruct slave_info {\n  uint8_t state;\n  uint8_t node_id;\n  uint8_t flags;\n  uint8_t bus_state;\n  uint8_t error_register;\n  uint8_t emcy_active;\n  uint8_t reserved[2];\n};\nstruct api_v3 {\n  api_v2 v2;\n  int (*slave_status)(uint8_t slave, slave_info *out);\n  int (*slave_nmt)(uint8_t slave, uint8_t command);\n  int (*slave_nmt_done)(uint8_t slave, uint8_t command, uint8_t *done);\n  int (*slave_emcy_claim)(uint8_t slave, uint32_t *handle);\n  int (*slave_emcy)(uint8_t slave, uint32_t handle, uint8_t active, uint16_t code, uint32_t info);\n  int (*slave_written)(uint8_t slave, uint16_t index, uint8_t subindex, uint32_t *count);\n};\n// After a lookup that found no plugin, this many lookups are skipped before the next one.\nconst uint32_t miss_skip = 1024;\n\n// The loaded plugin's table, or null with `why` set (r_not_run or r_version). The runtime loads\n// the plugin again at each PLC start while this program stays loaded, so a table is kept only\n// when its flags say it stays valid; otherwise it is looked up on each call. While no plugin is\n// found, only one lookup in miss_skip runs; the others answer r_not_run at once.\ninline const api_v1 *lookup_api(uint8_t &why) {\n  const void *table = nullptr;\n  why = r_not_run;\n#if defined(__linux__)\n  void *lib = dlopen(\"libcanopen_plugin.so\", 0x2 | 0x4);  // RTLD_NOW | RTLD_NOLOAD\n  if (!lib) return nullptr;\n  typedef const void *(*entry_t)(uint32_t);\n  entry_t entry = reinterpret_cast<entry_t>(dlsym(lib, \"canopen_plc_api\"));\n  if (entry) {\n    table = entry(api_version);\n    if (!table) why = r_version;\n  }\n  dlclose(lib);\n#else\n  if (canopen_plc_api) {\n    table = canopen_plc_api(api_version);\n    if (!table) why = r_version;\n  }\n#endif\n  const api_v1 *t = static_cast<const api_v1 *>(table);\n  if (t && t->size < __builtin_offsetof(api_v1, flags)) {\n    why = r_version;\n    return nullptr;\n  }\n  return t;\n}\n\ninline bool api_is_permanent(const api_v1 *t) {\n  return t->size >= sizeof(api_v1) && (t->flags & flag_permanent) != 0;\n}\n\ninline const api_v1 *api(uint8_t &why) {\n  static const api_v1 *kept = nullptr;\n  static uint32_t skip = 0;\n  const api_v1 *t = __atomic_load_n(&kept, __ATOMIC_ACQUIRE);\n  if (t) {\n    why = r_not_run;\n    return t;\n  }\n  uint32_t left = __atomic_load_n(&skip, __ATOMIC_RELAXED);\n  if (left > 0) {\n    __atomic_store_n(&skip, left - 1, __ATOMIC_RELAXED);\n    why = r_not_run;\n    return nullptr;\n  }\n  t = lookup_api(why);\n  if (!t) {\n    if (why == r_not_run) __atomic_store_n(&skip, miss_skip, __ATOMIC_RELAXED);\n    return nullptr;\n  }\n  if (api_is_permanent(t)) __atomic_store_n(&kept, t, __ATOMIC_RELEASE);\n  return t;\n}\n\n// The table with the version 2 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v2 *api2(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 2 || t->size < sizeof(api_v2)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v2 *>(static_cast<const void *>(t));\n}\n\n// The table with the version 3 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v3 *api3(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 3 || t->size < sizeof(api_v3)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v3 *>(static_cast<const void *>(t));\n}\n\n// ---- Error text, written into a fixed buffer (no allocation, no libc). ----\nstruct text {\n  char buf[200];\n  unsigned len;\n};\ninline void clear(text &t) {\n  t.len = 0;\n  t.buf[0] = 0;\n}\ninline void put(text &t, const char *s) {\n  while (*s && t.len + 1 < sizeof t.buf) t.buf[t.len++] = *s++;\n  t.buf[t.len] = 0;\n}\ninline void put_dec(text &t, uint32_t v) {\n  char d[12];\n  int n = 0;\n  do {\n    d[n++] = static_cast<char>('0' + v % 10);\n    v /= 10;\n  } while (v && n < 12);\n  while (n > 0 && t.len + 1 < sizeof t.buf) t.buf[t.len++] = d[--n];\n  t.buf[t.len] = 0;\n}\ninline void put_hex(text &t, uint32_t v, int digits) {\n  put(t, \"16#\");\n  for (int i = digits - 1; i >= 0 && t.len + 1 < sizeof t.buf; --i)\n    t.buf[t.len++] = \"0123456789ABCDEF\"[(v >> (4 * i)) & 0xF];\n  t.buf[t.len] = 0;\n}\n\n// CiA 301 SDO abort codes.\ninline const char *abort_text(uint32_t code) {\n  switch (code) {\n    case 0x05030000u: return \"toggle bit not alternated\";\n    case 0x05040000u: return \"SDO protocol timed out\";\n    case 0x05040001u: return \"command specifier not valid or unknown\";\n    case 0x05040002u: return \"invalid block size\";\n    case 0x05040003u: return \"invalid sequence number\";\n    case 0x05040004u: return \"CRC error\";\n    case 0x05040005u: return \"out of memory\";\n    case 0x06010000u: return \"unsupported access to an object\";\n    case 0x06010001u: return \"attempt to read a write only object\";\n    case 0x06010002u: return \"attempt to write a read only object\";\n    case 0x06020000u: return \"object does not exist\";\n    case 0x06040041u: return \"object cannot be mapped to the PDO\";\n    case 0x06040042u: return \"the mapped objects would exceed the PDO length\";\n    case 0x06040043u: return \"general parameter incompatibility\";\n    case 0x06040047u: return \"general internal incompatibility in the device\";\n    case 0x06060000u: return \"access failed due to a hardware error\";\n    case 0x06070010u: return \"data type or length does not match\";\n    case 0x06070012u: return \"data type does not match, length too high\";\n    case 0x06070013u: return \"data type does not match, length too low\";\n    case 0x06090011u: return \"sub-index does not exist\";\n    case 0x06090030u: return \"invalid value for parameter\";\n    case 0x06090031u: return \"value of parameter written too high\";\n    case 0x06090032u: return \"value of parameter written too low\";\n    case 0x06090036u: return \"maximum value is less than minimum value\";\n    case 0x060A0023u: return \"resource not available: SDO connection\";\n    case 0x08000000u: return \"general error\";\n    case 0x08000020u: return \"data cannot be transferred or stored to the application\";\n    case 0x08000021u: return \"data cannot be transferred or stored because of local control\";\n    case 0x08000022u: return \"data cannot be transferred or stored in the present device state\";\n    case 0x08000023u: return \"no object dictionary is present\";\n    case 0x08000024u: return \"no data available\";\n    default: return \"unknown abort code\";\n  }\n}\n\n// What a request was about, for its error text.\nstruct what {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint16_t index;\n  uint8_t subindex;\n  uint32_t timeout_ms;\n  uint32_t capacity;  // bytes the block holds\n};\n\ninline what what_of(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex,\n                    uint32_t timeout_ms, uint32_t capacity) {\n  what w{};\n  w.network = network;\n  w.node = node;\n  w.index = index;\n  w.subindex = subindex;\n  w.timeout_ms = timeout_ms;\n  w.capacity = capacity;\n  return w;\n}\n\ninline void put_node(text &t, const what &w) {\n  if (w.node == 0) {\n    put(t, \"the nodes of network \");\n    put_dec(t, w.network);\n  } else {\n    put(t, \"node \");\n    put_dec(t, w.node);\n  }\n}\n\ninline void put_object(text &t, const what &w) {\n  put_hex(t, w.index, 4);\n  put(t, \" sub \");\n  put_dec(t, w.subindex);\n}\n\n// The error text of a failed request, and its ERRORINFO.\ninline uint32_t describe(text &t, const what &w, const result &r) {\n  clear(t);\n  switch (r.error) {\n    case e_other_error:\n      put_node(t, w);\n      put(t, \" aborted \");\n      put_object(t, w);\n      put(t, \": \");\n      put(t, abort_text(r.abort_code));\n      put(t, \" (\");\n      put_hex(t, r.abort_code, 8);\n      put(t, \")\");\n      return r.abort_code;\n    case e_timeout:\n      put_node(t, w);\n      put(t, \" did not answer\");\n      if (w.timeout_ms) {\n        put(t, \" within \");\n        put_dec(t, w.timeout_ms);\n        put(t, \" ms\");\n      }\n      return r.abort_code ? r.abort_code : 0x05040000u;\n    case e_bus_off:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, r.reason == r_link ? \" link is down\" : \" bus is off\");\n      return 0;\n    case e_error_passive:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" is error passive\");\n      return 0;\n    case e_wrong_parameter:\n      if (r.reason == r_too_large) {\n        put(t, \"object has \");\n        put_dec(t, r.length);\n        put(t, \" bytes, the block holds \");\n        put_dec(t, w.capacity);\n        return r.length;\n      }\n      if (r.reason == r_length) {\n        put(t, \"DATALENGTH \");\n        put_dec(t, r.length);\n        put(t, \" is not 1 to \");\n        put_dec(t, w.capacity);\n        return 0;\n      }\n      if (r.reason == r_not_in_eds) {\n        put_node(t, w);\n        put(t, \" has no object \");\n        put_object(t, w);\n        put(t, \" of 1 to 4 bytes in its EDS; set DATALENGTH\");\n        return 0;\n      }\n      if (r.reason == r_command) {\n        put(t, \"STATE \");\n        put_dec(t, r.length);\n        put(t, \" is not an NMT state change\");\n        return 0;\n      }\n      put(t, \"wrong parameter\");\n      return 0;\n    case e_node_id_unknown:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" has no node \");\n      put_dec(t, w.node);\n      return 0;\n    case e_net_id_unknown:\n      put(t, \"no CANopen network \");\n      put_dec(t, w.network);\n      return 0;\n    case e_request_error:\n      if (r.reason == r_booting) {\n        put_node(t, w);\n        put(t, \" is booting\");\n      } else if (r.reason == r_full) {\n        put(t, \"network \");\n        put_dec(t, w.network);\n        put(t, \" has 16 block requests waiting\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return 0;\n    case e_no_driver:\n      if (r.reason == r_restart)\n        put(t, \"request cancelled by the PLC stop\");\n      else if (r.reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else if (r.reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else\n        put(t, \"no CANopen network runs\");\n      return 0;\n    default:\n      put(t, \"internal error in the CANopen master\");\n      return 0;\n  }\n}\n\n// The error text of a slave block, for `slave` and the object (index, subindex) or ERRORCODE.\ninline void describe_slave(text &t, uint8_t slave, uint8_t error, uint8_t reason, uint16_t index,\n                           uint8_t subindex) {\n  clear(t);\n  switch (error) {\n    case e_no_error:\n      return;\n    case e_net_id_unknown:\n      put(t, \"no CANopen slave \");\n      put_dec(t, slave);\n      return;\n    case e_no_driver:\n      if (reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else if (reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else\n        put(t, \"no CANopen slave runs\");\n      return;\n    case e_wrong_parameter:\n      if (reason == r_reset) {\n        put(t, \"the program cannot reset the slave; STATE must be START_REMOTE_NODE, \");\n        put(t, \"STOP_REMOTE_NODE or ENTER_PRE_OPERATIONAL\");\n      } else if (reason == r_own_code) {\n        put(t, \"ERRORCODE \");\n        put_hex(t, index, 4);\n        put(t, \" is sent by the slave itself; use another code\");\n      } else if (reason == r_object) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" has no object \");\n        put_hex(t, index, 4);\n        put(t, \" sub \");\n        put_dec(t, subindex);\n        put(t, \" written by the master\");\n      } else {\n        put(t, \"wrong parameter\");\n      }\n      return;\n    case e_request_error:\n      if (reason == r_slots) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" already holds 31 program emergencies\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return;\n    default:\n      put(t, \"internal error in the CANopen slave\");\n      return;\n  }\n}\n\n// Shows a failed request on the block's ERROR, ERRORINFO and ERRORTEXT pins.\ntemplate <class error_pin, class info_pin, class text_pin>\ninline void show(error_pin &error, info_pin &info, text_pin &errortext, const what &w,\n                 const result &r) {\n  text t;\n  uint32_t i = describe(t, w, r);\n  error = r.error ? r.error : static_cast<uint8_t>(e_internal);\n  info = i;\n  errortext = t.buf;\n}\n\n// The size of an object of 1 to 4 bytes in the node's EDS, from the table the editor's build\n// generates (sorted network, node, index, sub-index, size); 0 when it is not listed.\ninline uint32_t eds_size(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex) {\n  const uint64_t key = (static_cast<uint64_t>(network) << 32) | (static_cast<uint64_t>(node) << 24) |\n                       (static_cast<uint64_t>(index) << 8) | subindex;\n  long lo = 0;\n  long hi = static_cast<long>(static_cast<uint32_t>(strucpp::CANOPEN_OBJECT_SIZE_COUNT)) - 1;\n  while (lo <= hi) {\n    long mid = (lo + hi) / 2;\n    uint64_t entry = static_cast<uint64_t>(strucpp::CANOPEN_OBJECT_SIZES[mid]);\n    uint64_t k = entry >> 8;\n    if (k == key) return static_cast<uint32_t>(entry & 0xFF);\n    if (k < key)\n      lo = mid + 1;\n    else\n      hi = mid - 1;\n  }\n  return 0;\n}\n\n// TIME (nanoseconds) to milliseconds; 0 or less: the network's SDO timeout.\ninline uint32_t timeout_ms(long long ns) {\n  if (ns <= 0) return 0;\n  long long ms = (ns + 999999) / 1000000;\n  return ms > 3600000 ? 3600000u : static_cast<uint32_t>(ms);\n}\n\n// One instance's handshake (CiA 405): the block keeps `prev`, `phase` and `handle` in its locals.\nenum { phase_idle = 0, phase_busy = 1, phase_ended = 2 };\nstruct step {\n  bool start;   // rising edge of ENABLE: clear the outputs and start a request\n  bool cancel;  // falling edge while busy: drop the request and clear the outputs\n  bool clear;   // the result was shown and ENABLE is FALSE: clear the outputs\n};\ninline step begin(bool enable, bool &prev, uint8_t &phase) {\n  step s{false, false, false};\n  bool rising = enable && !prev;\n  prev = enable;\n  if (!enable && phase == phase_busy) {\n    s.cancel = true;\n    phase = phase_idle;\n  } else if (!enable && phase == phase_ended) {\n    s.clear = true;\n    phase = phase_idle;\n  }\n  if (rising && phase != phase_busy) s.start = true;\n  return s;\n}\n\n// Starts `req`. Returns the handle, or 0 with `res` saying why it cannot run.\ninline uint64_t start(const request &req, result &res) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why;\n    return 0;\n  }\n  uint64_t handle = t->start(&req, &res);\n  if (!handle && res.error == e_no_error) res.error = e_internal;\n  return handle;\n}\n\n// 0 while the request runs; 1 done, 2 failed (`res` set).\ninline int poll(uint64_t handle, result &res, uint8_t *data, uint32_t cap) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why == r_version ? r_version : r_restart;\n    return 2;\n  }\n  return t->poll(handle, &res, data, cap);\n}\n\ninline void cancel(uint64_t handle) {\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (t) t->cancel(handle);\n}\n\ninline void put_le(uint8_t *out, uint32_t v, unsigned n) {\n  for (unsigned b = 0; b < n; ++b) out[b] = static_cast<uint8_t>(v >> (8 * b));\n}\n\ninline uint32_t get_le(const uint8_t *in, unsigned n) {\n  uint32_t v = 0;\n  for (unsigned b = 0; b < n && b < 4; ++b) v |= static_cast<uint32_t>(in[b]) << (8 * b);\n  return v;\n}\n\n// A failure before any request ran (bad input): `res` for describe().\ninline result fail(uint8_t error, uint8_t reason, uint32_t length) {\n  result r{};\n  r.error = error;\n  r.reason = reason;\n  r.length = length;\n  return r;\n}\n\n}  // namespace canopen_fb\n#endif\nvoid setup() {\n}\n\nvoid loop() {\n  bool l_prev = cop_prev;\n  uint8_t l_phase = cop_phase;\n  canopen_fb::step l_step = canopen_fb::begin(ENABLE, l_prev, l_phase);\n  cop_prev = l_prev;\n  cop_phase = l_phase;\n  if (l_step.cancel) canopen_fb::cancel(cop_handle);\n  if (l_step.cancel || l_step.clear || l_step.start) {\n    BUSY = false;\n    CONFIRM = false;\n    ERROR = 0;\n    ERRORINFO = 0;\n    ERRORTEXT = \"\";\n    cop_handle = 0;\n  }\n  if (l_step.start) {\n    canopen_fb::request l_req = {};\n    l_req.network = NETWORK;\n    l_req.node = DEVICE;\n    l_req.kind = canopen_fb::k_write;\n    l_req.index = INDEX;\n    l_req.subindex = SUBINDEX;\n    l_req.timeout_ms = canopen_fb::timeout_ms(TIMEOUT);\n    canopen_fb::result l_res = {};\n    canopen_fb::result l_bad = {};\n    uint8_t l_payload[canopen_fb::max_data];\n    (void)l_payload;\n    uint32_t l_length = DATALENGTH;\n    if (l_length == 0) {\n      l_length = canopen_fb::eds_size(NETWORK, DEVICE, INDEX, SUBINDEX);\n      if (l_length == 0) l_bad = canopen_fb::fail(canopen_fb::e_wrong_parameter, canopen_fb::r_not_in_eds, 0);\n    } else if (l_length > 4) {\n      l_bad = canopen_fb::fail(canopen_fb::e_wrong_parameter, canopen_fb::r_length, l_length);\n    }\n    canopen_fb::put_le(l_payload, DATA, 4);\n    l_req.data = l_payload;\n    l_req.length = l_length;\n    cop_net = l_req.network;\n    cop_node = l_req.node;\n    cop_index = l_req.index;\n    cop_sub = l_req.subindex;\n    cop_timeout = l_req.timeout_ms;\n    uint64_t l_handle = l_bad.error ? 0 : canopen_fb::start(l_req, l_res);\n    if (l_handle) {\n      cop_handle = l_handle;\n      BUSY = true;\n      cop_phase = canopen_fb::phase_busy;\n    } else {\n      cop_phase = canopen_fb::phase_ended;\n      canopen_fb::show(ERROR, ERRORINFO, ERRORTEXT, canopen_fb::what_of(cop_net, cop_node, cop_index, cop_sub,\n                       cop_timeout, 4), l_bad.error ? l_bad : l_res);\n    }\n  }\n  if (cop_phase == canopen_fb::phase_busy) {\n    canopen_fb::result l_res = {};\n    uint8_t l_buf[canopen_fb::max_data + 1];\n    int l_state = canopen_fb::poll(cop_handle, l_res, l_buf, canopen_fb::max_data);\n    if (l_state != 0) {\n      BUSY = false;\n      cop_handle = 0;\n      cop_phase = canopen_fb::phase_ended;\n      if (l_state == 1 && l_res.length > 4u) {\n        l_state = 2;\n        l_res = canopen_fb::fail(canopen_fb::e_wrong_parameter, canopen_fb::r_too_large, l_res.length);\n      }\n      if (l_state == 1) {\n        CONFIRM = true;\n      } else {\n        canopen_fb::show(ERROR, ERRORINFO, ERRORTEXT, canopen_fb::what_of(cop_net, cop_node, cop_index, cop_sub,\n                         cop_timeout, 4), l_res);\n      }\n    }\n  }\n}\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "SDO_READ_DATA.cpp",
      "source": "(* Reads an object of up to 256 bytes from a node by SDO into the byte array DATA; DATALENGTH gives the bytes received. Handshake as SDO_READ4. NETWORK counts from 1; DEVICE is the node ID or its name; TIMEOUT T#0s uses the network SDO timeout.\nExample: read(ENABLE := start, DEVICE := IO_Module, INDEX := 16#1008, SUBINDEX := 0, DATA := bytes); *)\nFUNCTION_BLOCK SDO_READ_DATA\nVAR_INPUT\n  NETWORK : USINT := 1;\n  ENABLE : BOOL;\n  DEVICE : USINT;\n  INDEX : WORD;\n  SUBINDEX : BYTE;\n  TIMEOUT : TIME;\nEND_VAR\nVAR_IN_OUT\n  DATA : ARRAY[0..255] OF BYTE;\nEND_VAR\nVAR_OUTPUT\n  CONFIRM : BOOL;\n  BUSY : BOOL;\n  ERROR : USINT;\n  ERRORINFO : UDINT;\n  ERRORTEXT : STRING;\n  DATALENGTH : UINT;\nEND_VAR\nVAR\n  cop_prev : BOOL;\n  cop_phase : USINT;\n  cop_handle : ULINT;\n  cop_net : USINT;\n  cop_node : USINT;\n  cop_index : WORD;\n  cop_sub : BYTE;\n  cop_timeout : UDINT;\nEND_VAR\n// SPDX-License-Identifier: Apache-2.0\n//\n// Shared code of the canopen function blocks. The generator copies it into every block's source,\n// because the editor grafts each library C++ block into one c_blocks_code.cpp and has no other\n// place for shared code; the include guard keeps one copy per program.\n//\n// The editor binds every pin and local of a block to a #define of its name, so nothing here uses\n// a pin or local name (those are upper case or start with cop_; this code is lower case), nor the\n// keyword that closes a variable section, and no system header is included after those defines:\n// dlopen, dlsym and dlclose are declared here as glibc declares them.\n//\n// Derived from canworks ec7fd59, library/src/common.inc (Apache-2.0), adapted to the plugin's\n// interface version 3 (core/src/drivers/plugins/native/canopen/plc_api.h in the runtime fork).\n#ifndef CANOPEN_FB_SHARED_INCLUDED\n#define CANOPEN_FB_SHARED_INCLUDED\n#if defined(__linux__)\nextern \"C\" void *dlopen(const char *file, int mode) noexcept(true);\nextern \"C\" void *dlsym(void *handle, const char *name) noexcept(true);\nextern \"C\" int dlclose(void *handle) noexcept(true);\n#else\n// A board's firmware: the slave module's table, when the project has a slave on the board.\nextern \"C\" const void *canopen_plc_api(uint32_t version) __attribute__((weak));\n#endif\n\nnamespace canopen_fb {\n\n// A copy of the plugin's C interface, version 3; keep in step with plc_api.h. Version 1 is asked\n// for, since a newer plugin answers it with its newest table; `size` tells which it is.\nconst uint32_t api_version = 1;\nconst uint32_t max_data = 256;\nenum {\n  e_no_error = 0, e_other_error = 1, e_timeout = 2, e_bus_off = 3, e_error_passive = 4,\n  e_internal = 5, e_wrong_parameter = 6, e_node_id_unknown = 7, e_net_id_unknown = 8,\n  e_request_error = 9, e_no_driver = 10\n};\nenum {\n  r_none = 0, r_booting = 1, r_full = 2, r_not_run = 3, r_restart = 4, r_link = 5,\n  r_too_large = 6, r_length = 7, r_command = 8, r_version = 9,\n  r_not_in_eds = 100,  // the blocks' own: DATALENGTH 0 for an object the EDS does not list\n  r_needs_v2 = 101,    // the blocks' own: the plugin's table lacks the functions the block needs\n  r_reset = 102,       // the blocks' own: a slave NMT block asked for a reset\n  r_own_code = 103,    // the blocks' own: an emergency code the slave sends itself\n  r_slots = 104,       // the blocks' own: all program emergency slots are taken\n  r_object = 105       // the blocks' own: the slave has no such object from the master\n};\nenum { k_read = 0, k_write = 1, k_nmt = 2 };\nstruct request {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint8_t command;\n  uint16_t index;\n  uint8_t subindex;\n  uint8_t reserved;\n  uint32_t timeout_ms;\n  uint32_t length;\n  const uint8_t *data;\n};\nstruct result {\n  uint8_t error;\n  uint8_t reason;\n  uint16_t reserved;\n  uint32_t abort_code;\n  uint32_t length;\n};\nstruct emcy {\n  uint8_t node;\n  uint8_t error_register;\n  uint16_t error_code;\n  uint8_t data[5];\n  uint8_t reserved[3];\n  uint32_t lost;\n};\nstruct api_v1 {\n  uint32_t size;\n  uint32_t version;\n  uint64_t (*start)(const request *req, result *res);\n  int (*poll)(uint64_t handle, result *res, uint8_t *data, uint32_t cap);\n  void (*cancel)(uint64_t handle);\n  int (*node_state)(uint8_t network, uint8_t node, uint8_t *state);\n  int (*kernel_state)(uint8_t network, uint8_t *state);\n  int (*local_node_id)(uint8_t network, uint8_t *node_id);\n  int (*emcy_cursor)(uint8_t network, uint64_t *cursor);\n  int (*emcy_next)(uint8_t network, uint8_t node, uint64_t *cursor, emcy *out);\n  uint32_t flags;  // present when size covers it\n};\n// flags: the plugin is never unmapped, so its table stays valid for the life of the process.\nconst uint32_t flag_permanent = 0x1;\n// node_info::flags\nconst uint8_t node_enabled = 0x01;\nconst uint8_t node_optional = 0x02;\nconst uint8_t node_program_start = 0x04;\nconst uint32_t status_text = 80;\nstruct node_info {\n  uint8_t run_state;\n  uint8_t flags;\n  uint8_t reserved[2];\n  char problem[status_text];\n};\nstruct network_info {\n  uint8_t mandatory_up;\n  uint8_t optional_up;\n  uint8_t configured;\n  uint8_t operational;\n  uint8_t waiting;\n  uint8_t disabled;\n  uint8_t faulty;\n  uint8_t nodes;\n};\nstruct api_v2 {\n  api_v1 v1;\n  int (*node_status)(uint8_t network, uint8_t node, node_info *out);\n  int (*network_status)(uint8_t network, network_info *out);\n  int (*node_enable)(uint8_t network, uint8_t node, uint8_t on);\n};\n// slave_info::flags\nconst uint8_t slave_on_bus = 0x01;\nconst uint8_t slave_master_watched = 0x02;\nconst uint8_t slave_master_seen = 0x04;\nconst uint32_t slave_emcy_slots = 31;\nstruct slave_info {\n  uint8_t state;\n  uint8_t node_id;\n  uint8_t flags;\n  uint8_t bus_state;\n  uint8_t error_register;\n  uint8_t emcy_active;\n  uint8_t reserved[2];\n};\nstruct api_v3 {\n  api_v2 v2;\n  int (*slave_status)(uint8_t slave, slave_info *out);\n  int (*slave_nmt)(uint8_t slave, uint8_t command);\n  int (*slave_nmt_done)(uint8_t slave, uint8_t command, uint8_t *done);\n  int (*slave_emcy_claim)(uint8_t slave, uint32_t *handle);\n  int (*slave_emcy)(uint8_t slave, uint32_t handle, uint8_t active, uint16_t code, uint32_t info);\n  int (*slave_written)(uint8_t slave, uint16_t index, uint8_t subindex, uint32_t *count);\n};\n// After a lookup that found no plugin, this many lookups are skipped before the next one.\nconst uint32_t miss_skip = 1024;\n\n// The loaded plugin's table, or null with `why` set (r_not_run or r_version). The runtime loads\n// the plugin again at each PLC start while this program stays loaded, so a table is kept only\n// when its flags say it stays valid; otherwise it is looked up on each call. While no plugin is\n// found, only one lookup in miss_skip runs; the others answer r_not_run at once.\ninline const api_v1 *lookup_api(uint8_t &why) {\n  const void *table = nullptr;\n  why = r_not_run;\n#if defined(__linux__)\n  void *lib = dlopen(\"libcanopen_plugin.so\", 0x2 | 0x4);  // RTLD_NOW | RTLD_NOLOAD\n  if (!lib) return nullptr;\n  typedef const void *(*entry_t)(uint32_t);\n  entry_t entry = reinterpret_cast<entry_t>(dlsym(lib, \"canopen_plc_api\"));\n  if (entry) {\n    table = entry(api_version);\n    if (!table) why = r_version;\n  }\n  dlclose(lib);\n#else\n  if (canopen_plc_api) {\n    table = canopen_plc_api(api_version);\n    if (!table) why = r_version;\n  }\n#endif\n  const api_v1 *t = static_cast<const api_v1 *>(table);\n  if (t && t->size < __builtin_offsetof(api_v1, flags)) {\n    why = r_version;\n    return nullptr;\n  }\n  return t;\n}\n\ninline bool api_is_permanent(const api_v1 *t) {\n  return t->size >= sizeof(api_v1) && (t->flags & flag_permanent) != 0;\n}\n\ninline const api_v1 *api(uint8_t &why) {\n  static const api_v1 *kept = nullptr;\n  static uint32_t skip = 0;\n  const api_v1 *t = __atomic_load_n(&kept, __ATOMIC_ACQUIRE);\n  if (t) {\n    why = r_not_run;\n    return t;\n  }\n  uint32_t left = __atomic_load_n(&skip, __ATOMIC_RELAXED);\n  if (left > 0) {\n    __atomic_store_n(&skip, left - 1, __ATOMIC_RELAXED);\n    why = r_not_run;\n    return nullptr;\n  }\n  t = lookup_api(why);\n  if (!t) {\n    if (why == r_not_run) __atomic_store_n(&skip, miss_skip, __ATOMIC_RELAXED);\n    return nullptr;\n  }\n  if (api_is_permanent(t)) __atomic_store_n(&kept, t, __ATOMIC_RELEASE);\n  return t;\n}\n\n// The table with the version 2 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v2 *api2(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 2 || t->size < sizeof(api_v2)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v2 *>(static_cast<const void *>(t));\n}\n\n// The table with the version 3 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v3 *api3(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 3 || t->size < sizeof(api_v3)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v3 *>(static_cast<const void *>(t));\n}\n\n// ---- Error text, written into a fixed buffer (no allocation, no libc). ----\nstruct text {\n  char buf[200];\n  unsigned len;\n};\ninline void clear(text &t) {\n  t.len = 0;\n  t.buf[0] = 0;\n}\ninline void put(text &t, const char *s) {\n  while (*s && t.len + 1 < sizeof t.buf) t.buf[t.len++] = *s++;\n  t.buf[t.len] = 0;\n}\ninline void put_dec(text &t, uint32_t v) {\n  char d[12];\n  int n = 0;\n  do {\n    d[n++] = static_cast<char>('0' + v % 10);\n    v /= 10;\n  } while (v && n < 12);\n  while (n > 0 && t.len + 1 < sizeof t.buf) t.buf[t.len++] = d[--n];\n  t.buf[t.len] = 0;\n}\ninline void put_hex(text &t, uint32_t v, int digits) {\n  put(t, \"16#\");\n  for (int i = digits - 1; i >= 0 && t.len + 1 < sizeof t.buf; --i)\n    t.buf[t.len++] = \"0123456789ABCDEF\"[(v >> (4 * i)) & 0xF];\n  t.buf[t.len] = 0;\n}\n\n// CiA 301 SDO abort codes.\ninline const char *abort_text(uint32_t code) {\n  switch (code) {\n    case 0x05030000u: return \"toggle bit not alternated\";\n    case 0x05040000u: return \"SDO protocol timed out\";\n    case 0x05040001u: return \"command specifier not valid or unknown\";\n    case 0x05040002u: return \"invalid block size\";\n    case 0x05040003u: return \"invalid sequence number\";\n    case 0x05040004u: return \"CRC error\";\n    case 0x05040005u: return \"out of memory\";\n    case 0x06010000u: return \"unsupported access to an object\";\n    case 0x06010001u: return \"attempt to read a write only object\";\n    case 0x06010002u: return \"attempt to write a read only object\";\n    case 0x06020000u: return \"object does not exist\";\n    case 0x06040041u: return \"object cannot be mapped to the PDO\";\n    case 0x06040042u: return \"the mapped objects would exceed the PDO length\";\n    case 0x06040043u: return \"general parameter incompatibility\";\n    case 0x06040047u: return \"general internal incompatibility in the device\";\n    case 0x06060000u: return \"access failed due to a hardware error\";\n    case 0x06070010u: return \"data type or length does not match\";\n    case 0x06070012u: return \"data type does not match, length too high\";\n    case 0x06070013u: return \"data type does not match, length too low\";\n    case 0x06090011u: return \"sub-index does not exist\";\n    case 0x06090030u: return \"invalid value for parameter\";\n    case 0x06090031u: return \"value of parameter written too high\";\n    case 0x06090032u: return \"value of parameter written too low\";\n    case 0x06090036u: return \"maximum value is less than minimum value\";\n    case 0x060A0023u: return \"resource not available: SDO connection\";\n    case 0x08000000u: return \"general error\";\n    case 0x08000020u: return \"data cannot be transferred or stored to the application\";\n    case 0x08000021u: return \"data cannot be transferred or stored because of local control\";\n    case 0x08000022u: return \"data cannot be transferred or stored in the present device state\";\n    case 0x08000023u: return \"no object dictionary is present\";\n    case 0x08000024u: return \"no data available\";\n    default: return \"unknown abort code\";\n  }\n}\n\n// What a request was about, for its error text.\nstruct what {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint16_t index;\n  uint8_t subindex;\n  uint32_t timeout_ms;\n  uint32_t capacity;  // bytes the block holds\n};\n\ninline what what_of(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex,\n                    uint32_t timeout_ms, uint32_t capacity) {\n  what w{};\n  w.network = network;\n  w.node = node;\n  w.index = index;\n  w.subindex = subindex;\n  w.timeout_ms = timeout_ms;\n  w.capacity = capacity;\n  return w;\n}\n\ninline void put_node(text &t, const what &w) {\n  if (w.node == 0) {\n    put(t, \"the nodes of network \");\n    put_dec(t, w.network);\n  } else {\n    put(t, \"node \");\n    put_dec(t, w.node);\n  }\n}\n\ninline void put_object(text &t, const what &w) {\n  put_hex(t, w.index, 4);\n  put(t, \" sub \");\n  put_dec(t, w.subindex);\n}\n\n// The error text of a failed request, and its ERRORINFO.\ninline uint32_t describe(text &t, const what &w, const result &r) {\n  clear(t);\n  switch (r.error) {\n    case e_other_error:\n      put_node(t, w);\n      put(t, \" aborted \");\n      put_object(t, w);\n      put(t, \": \");\n      put(t, abort_text(r.abort_code));\n      put(t, \" (\");\n      put_hex(t, r.abort_code, 8);\n      put(t, \")\");\n      return r.abort_code;\n    case e_timeout:\n      put_node(t, w);\n      put(t, \" did not answer\");\n      if (w.timeout_ms) {\n        put(t, \" within \");\n        put_dec(t, w.timeout_ms);\n        put(t, \" ms\");\n      }\n      return r.abort_code ? r.abort_code : 0x05040000u;\n    case e_bus_off:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, r.reason == r_link ? \" link is down\" : \" bus is off\");\n      return 0;\n    case e_error_passive:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" is error passive\");\n      return 0;\n    case e_wrong_parameter:\n      if (r.reason == r_too_large) {\n        put(t, \"object has \");\n        put_dec(t, r.length);\n        put(t, \" bytes, the block holds \");\n        put_dec(t, w.capacity);\n        return r.length;\n      }\n      if (r.reason == r_length) {\n        put(t, \"DATALENGTH \");\n        put_dec(t, r.length);\n        put(t, \" is not 1 to \");\n        put_dec(t, w.capacity);\n        return 0;\n      }\n      if (r.reason == r_not_in_eds) {\n        put_node(t, w);\n        put(t, \" has no object \");\n        put_object(t, w);\n        put(t, \" of 1 to 4 bytes in its EDS; set DATALENGTH\");\n        return 0;\n      }\n      if (r.reason == r_command) {\n        put(t, \"STATE \");\n        put_dec(t, r.length);\n        put(t, \" is not an NMT state change\");\n        return 0;\n      }\n      put(t, \"wrong parameter\");\n      return 0;\n    case e_node_id_unknown:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" has no node \");\n      put_dec(t, w.node);\n      return 0;\n    case e_net_id_unknown:\n      put(t, \"no CANopen network \");\n      put_dec(t, w.network);\n      return 0;\n    case e_request_error:\n      if (r.reason == r_booting) {\n        put_node(t, w);\n        put(t, \" is booting\");\n      } else if (r.reason == r_full) {\n        put(t, \"network \");\n        put_dec(t, w.network);\n        put(t, \" has 16 block requests waiting\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return 0;\n    case e_no_driver:\n      if (r.reason == r_restart)\n        put(t, \"request cancelled by the PLC stop\");\n      else if (r.reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else if (r.reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else\n        put(t, \"no CANopen network runs\");\n      return 0;\n    default:\n      put(t, \"internal error in the CANopen master\");\n      return 0;\n  }\n}\n\n// The error text of a slave block, for `slave` and the object (index, subindex) or ERRORCODE.\ninline void describe_slave(text &t, uint8_t slave, uint8_t error, uint8_t reason, uint16_t index,\n                           uint8_t subindex) {\n  clear(t);\n  switch (error) {\n    case e_no_error:\n      return;\n    case e_net_id_unknown:\n      put(t, \"no CANopen slave \");\n      put_dec(t, slave);\n      return;\n    case e_no_driver:\n      if (reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else if (reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else\n        put(t, \"no CANopen slave runs\");\n      return;\n    case e_wrong_parameter:\n      if (reason == r_reset) {\n        put(t, \"the program cannot reset the slave; STATE must be START_REMOTE_NODE, \");\n        put(t, \"STOP_REMOTE_NODE or ENTER_PRE_OPERATIONAL\");\n      } else if (reason == r_own_code) {\n        put(t, \"ERRORCODE \");\n        put_hex(t, index, 4);\n        put(t, \" is sent by the slave itself; use another code\");\n      } else if (reason == r_object) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" has no object \");\n        put_hex(t, index, 4);\n        put(t, \" sub \");\n        put_dec(t, subindex);\n        put(t, \" written by the master\");\n      } else {\n        put(t, \"wrong parameter\");\n      }\n      return;\n    case e_request_error:\n      if (reason == r_slots) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" already holds 31 program emergencies\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return;\n    default:\n      put(t, \"internal error in the CANopen slave\");\n      return;\n  }\n}\n\n// Shows a failed request on the block's ERROR, ERRORINFO and ERRORTEXT pins.\ntemplate <class error_pin, class info_pin, class text_pin>\ninline void show(error_pin &error, info_pin &info, text_pin &errortext, const what &w,\n                 const result &r) {\n  text t;\n  uint32_t i = describe(t, w, r);\n  error = r.error ? r.error : static_cast<uint8_t>(e_internal);\n  info = i;\n  errortext = t.buf;\n}\n\n// The size of an object of 1 to 4 bytes in the node's EDS, from the table the editor's build\n// generates (sorted network, node, index, sub-index, size); 0 when it is not listed.\ninline uint32_t eds_size(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex) {\n  const uint64_t key = (static_cast<uint64_t>(network) << 32) | (static_cast<uint64_t>(node) << 24) |\n                       (static_cast<uint64_t>(index) << 8) | subindex;\n  long lo = 0;\n  long hi = static_cast<long>(static_cast<uint32_t>(strucpp::CANOPEN_OBJECT_SIZE_COUNT)) - 1;\n  while (lo <= hi) {\n    long mid = (lo + hi) / 2;\n    uint64_t entry = static_cast<uint64_t>(strucpp::CANOPEN_OBJECT_SIZES[mid]);\n    uint64_t k = entry >> 8;\n    if (k == key) return static_cast<uint32_t>(entry & 0xFF);\n    if (k < key)\n      lo = mid + 1;\n    else\n      hi = mid - 1;\n  }\n  return 0;\n}\n\n// TIME (nanoseconds) to milliseconds; 0 or less: the network's SDO timeout.\ninline uint32_t timeout_ms(long long ns) {\n  if (ns <= 0) return 0;\n  long long ms = (ns + 999999) / 1000000;\n  return ms > 3600000 ? 3600000u : static_cast<uint32_t>(ms);\n}\n\n// One instance's handshake (CiA 405): the block keeps `prev`, `phase` and `handle` in its locals.\nenum { phase_idle = 0, phase_busy = 1, phase_ended = 2 };\nstruct step {\n  bool start;   // rising edge of ENABLE: clear the outputs and start a request\n  bool cancel;  // falling edge while busy: drop the request and clear the outputs\n  bool clear;   // the result was shown and ENABLE is FALSE: clear the outputs\n};\ninline step begin(bool enable, bool &prev, uint8_t &phase) {\n  step s{false, false, false};\n  bool rising = enable && !prev;\n  prev = enable;\n  if (!enable && phase == phase_busy) {\n    s.cancel = true;\n    phase = phase_idle;\n  } else if (!enable && phase == phase_ended) {\n    s.clear = true;\n    phase = phase_idle;\n  }\n  if (rising && phase != phase_busy) s.start = true;\n  return s;\n}\n\n// Starts `req`. Returns the handle, or 0 with `res` saying why it cannot run.\ninline uint64_t start(const request &req, result &res) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why;\n    return 0;\n  }\n  uint64_t handle = t->start(&req, &res);\n  if (!handle && res.error == e_no_error) res.error = e_internal;\n  return handle;\n}\n\n// 0 while the request runs; 1 done, 2 failed (`res` set).\ninline int poll(uint64_t handle, result &res, uint8_t *data, uint32_t cap) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why == r_version ? r_version : r_restart;\n    return 2;\n  }\n  return t->poll(handle, &res, data, cap);\n}\n\ninline void cancel(uint64_t handle) {\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (t) t->cancel(handle);\n}\n\ninline void put_le(uint8_t *out, uint32_t v, unsigned n) {\n  for (unsigned b = 0; b < n; ++b) out[b] = static_cast<uint8_t>(v >> (8 * b));\n}\n\ninline uint32_t get_le(const uint8_t *in, unsigned n) {\n  uint32_t v = 0;\n  for (unsigned b = 0; b < n && b < 4; ++b) v |= static_cast<uint32_t>(in[b]) << (8 * b);\n  return v;\n}\n\n// A failure before any request ran (bad input): `res` for describe().\ninline result fail(uint8_t error, uint8_t reason, uint32_t length) {\n  result r{};\n  r.error = error;\n  r.reason = reason;\n  r.length = length;\n  return r;\n}\n\n}  // namespace canopen_fb\n#endif\nvoid setup() {\n}\n\nvoid loop() {\n  bool l_prev = cop_prev;\n  uint8_t l_phase = cop_phase;\n  canopen_fb::step l_step = canopen_fb::begin(ENABLE, l_prev, l_phase);\n  cop_prev = l_prev;\n  cop_phase = l_phase;\n  if (l_step.cancel) canopen_fb::cancel(cop_handle);\n  if (l_step.cancel || l_step.clear || l_step.start) {\n    BUSY = false;\n    CONFIRM = false;\n    ERROR = 0;\n    ERRORINFO = 0;\n    ERRORTEXT = \"\";\n    cop_handle = 0;\n    DATALENGTH = 0;\n  }\n  if (l_step.start) {\n    canopen_fb::request l_req = {};\n    l_req.network = NETWORK;\n    l_req.node = DEVICE;\n    l_req.kind = canopen_fb::k_read;\n    l_req.index = INDEX;\n    l_req.subindex = SUBINDEX;\n    l_req.timeout_ms = canopen_fb::timeout_ms(TIMEOUT);\n    canopen_fb::result l_res = {};\n    canopen_fb::result l_bad = {};\n    uint8_t l_payload[canopen_fb::max_data];\n    (void)l_payload;\n    cop_net = l_req.network;\n    cop_node = l_req.node;\n    cop_index = l_req.index;\n    cop_sub = l_req.subindex;\n    cop_timeout = l_req.timeout_ms;\n    uint64_t l_handle = l_bad.error ? 0 : canopen_fb::start(l_req, l_res);\n    if (l_handle) {\n      cop_handle = l_handle;\n      BUSY = true;\n      cop_phase = canopen_fb::phase_busy;\n    } else {\n      cop_phase = canopen_fb::phase_ended;\n      canopen_fb::show(ERROR, ERRORINFO, ERRORTEXT, canopen_fb::what_of(cop_net, cop_node, cop_index, cop_sub,\n                       cop_timeout, 256), l_bad.error ? l_bad : l_res);\n    }\n  }\n  if (cop_phase == canopen_fb::phase_busy) {\n    canopen_fb::result l_res = {};\n    uint8_t l_buf[canopen_fb::max_data + 1];\n    int l_state = canopen_fb::poll(cop_handle, l_res, l_buf, canopen_fb::max_data);\n    if (l_state != 0) {\n      BUSY = false;\n      cop_handle = 0;\n      cop_phase = canopen_fb::phase_ended;\n      if (l_state == 1 && l_res.length > 256u) {\n        l_state = 2;\n        l_res = canopen_fb::fail(canopen_fb::e_wrong_parameter, canopen_fb::r_too_large, l_res.length);\n      }\n      if (l_state == 1) {\n        CONFIRM = true;\n        for (uint32_t l_i = 0; l_i < l_res.length; ++l_i) DATA[l_i] = l_buf[l_i];\n        DATALENGTH = static_cast<uint16_t>(l_res.length);\n      } else {\n        canopen_fb::show(ERROR, ERRORINFO, ERRORTEXT, canopen_fb::what_of(cop_net, cop_node, cop_index, cop_sub,\n                         cop_timeout, 256), l_res);\n      }\n    }\n  }\n}\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "SDO_WRITE_DATA.cpp",
      "source": "(* Writes the first DATALENGTH bytes (1 to 256) of the byte array DATA to an object of a node by SDO. Handshake as SDO_WRITE4. NETWORK counts from 1; DEVICE is the node ID or its name; TIMEOUT T#0s uses the network SDO timeout.\nExample: write(ENABLE := set, DEVICE := IO_Module, INDEX := 16#2000, SUBINDEX := 0, DATALENGTH := 6, DATA := bytes); *)\nFUNCTION_BLOCK SDO_WRITE_DATA\nVAR_INPUT\n  NETWORK : USINT := 1;\n  ENABLE : BOOL;\n  DEVICE : USINT;\n  INDEX : WORD;\n  SUBINDEX : BYTE;\n  DATALENGTH : UINT;\n  TIMEOUT : TIME;\nEND_VAR\nVAR_IN_OUT\n  DATA : ARRAY[0..255] OF BYTE;\nEND_VAR\nVAR_OUTPUT\n  CONFIRM : BOOL;\n  BUSY : BOOL;\n  ERROR : USINT;\n  ERRORINFO : UDINT;\n  ERRORTEXT : STRING;\nEND_VAR\nVAR\n  cop_prev : BOOL;\n  cop_phase : USINT;\n  cop_handle : ULINT;\n  cop_net : USINT;\n  cop_node : USINT;\n  cop_index : WORD;\n  cop_sub : BYTE;\n  cop_timeout : UDINT;\nEND_VAR\n// SPDX-License-Identifier: Apache-2.0\n//\n// Shared code of the canopen function blocks. The generator copies it into every block's source,\n// because the editor grafts each library C++ block into one c_blocks_code.cpp and has no other\n// place for shared code; the include guard keeps one copy per program.\n//\n// The editor binds every pin and local of a block to a #define of its name, so nothing here uses\n// a pin or local name (those are upper case or start with cop_; this code is lower case), nor the\n// keyword that closes a variable section, and no system header is included after those defines:\n// dlopen, dlsym and dlclose are declared here as glibc declares them.\n//\n// Derived from canworks ec7fd59, library/src/common.inc (Apache-2.0), adapted to the plugin's\n// interface version 3 (core/src/drivers/plugins/native/canopen/plc_api.h in the runtime fork).\n#ifndef CANOPEN_FB_SHARED_INCLUDED\n#define CANOPEN_FB_SHARED_INCLUDED\n#if defined(__linux__)\nextern \"C\" void *dlopen(const char *file, int mode) noexcept(true);\nextern \"C\" void *dlsym(void *handle, const char *name) noexcept(true);\nextern \"C\" int dlclose(void *handle) noexcept(true);\n#else\n// A board's firmware: the slave module's table, when the project has a slave on the board.\nextern \"C\" const void *canopen_plc_api(uint32_t version) __attribute__((weak));\n#endif\n\nnamespace canopen_fb {\n\n// A copy of the plugin's C interface, version 3; keep in step with plc_api.h. Version 1 is asked\n// for, since a newer plugin answers it with its newest table; `size` tells which it is.\nconst uint32_t api_version = 1;\nconst uint32_t max_data = 256;\nenum {\n  e_no_error = 0, e_other_error = 1, e_timeout = 2, e_bus_off = 3, e_error_passive = 4,\n  e_internal = 5, e_wrong_parameter = 6, e_node_id_unknown = 7, e_net_id_unknown = 8,\n  e_request_error = 9, e_no_driver = 10\n};\nenum {\n  r_none = 0, r_booting = 1, r_full = 2, r_not_run = 3, r_restart = 4, r_link = 5,\n  r_too_large = 6, r_length = 7, r_command = 8, r_version = 9,\n  r_not_in_eds = 100,  // the blocks' own: DATALENGTH 0 for an object the EDS does not list\n  r_needs_v2 = 101,    // the blocks' own: the plugin's table lacks the functions the block needs\n  r_reset = 102,       // the blocks' own: a slave NMT block asked for a reset\n  r_own_code = 103,    // the blocks' own: an emergency code the slave sends itself\n  r_slots = 104,       // the blocks' own: all program emergency slots are taken\n  r_object = 105       // the blocks' own: the slave has no such object from the master\n};\nenum { k_read = 0, k_write = 1, k_nmt = 2 };\nstruct request {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint8_t command;\n  uint16_t index;\n  uint8_t subindex;\n  uint8_t reserved;\n  uint32_t timeout_ms;\n  uint32_t length;\n  const uint8_t *data;\n};\nstruct result {\n  uint8_t error;\n  uint8_t reason;\n  uint16_t reserved;\n  uint32_t abort_code;\n  uint32_t length;\n};\nstruct emcy {\n  uint8_t node;\n  uint8_t error_register;\n  uint16_t error_code;\n  uint8_t data[5];\n  uint8_t reserved[3];\n  uint32_t lost;\n};\nstruct api_v1 {\n  uint32_t size;\n  uint32_t version;\n  uint64_t (*start)(const request *req, result *res);\n  int (*poll)(uint64_t handle, result *res, uint8_t *data, uint32_t cap);\n  void (*cancel)(uint64_t handle);\n  int (*node_state)(uint8_t network, uint8_t node, uint8_t *state);\n  int (*kernel_state)(uint8_t network, uint8_t *state);\n  int (*local_node_id)(uint8_t network, uint8_t *node_id);\n  int (*emcy_cursor)(uint8_t network, uint64_t *cursor);\n  int (*emcy_next)(uint8_t network, uint8_t node, uint64_t *cursor, emcy *out);\n  uint32_t flags;  // present when size covers it\n};\n// flags: the plugin is never unmapped, so its table stays valid for the life of the process.\nconst uint32_t flag_permanent = 0x1;\n// node_info::flags\nconst uint8_t node_enabled = 0x01;\nconst uint8_t node_optional = 0x02;\nconst uint8_t node_program_start = 0x04;\nconst uint32_t status_text = 80;\nstruct node_info {\n  uint8_t run_state;\n  uint8_t flags;\n  uint8_t reserved[2];\n  char problem[status_text];\n};\nstruct network_info {\n  uint8_t mandatory_up;\n  uint8_t optional_up;\n  uint8_t configured;\n  uint8_t operational;\n  uint8_t waiting;\n  uint8_t disabled;\n  uint8_t faulty;\n  uint8_t nodes;\n};\nstruct api_v2 {\n  api_v1 v1;\n  int (*node_status)(uint8_t network, uint8_t node, node_info *out);\n  int (*network_status)(uint8_t network, network_info *out);\n  int (*node_enable)(uint8_t network, uint8_t node, uint8_t on);\n};\n// slave_info::flags\nconst uint8_t slave_on_bus = 0x01;\nconst uint8_t slave_master_watched = 0x02;\nconst uint8_t slave_master_seen = 0x04;\nconst uint32_t slave_emcy_slots = 31;\nstruct slave_info {\n  uint8_t state;\n  uint8_t node_id;\n  uint8_t flags;\n  uint8_t bus_state;\n  uint8_t error_register;\n  uint8_t emcy_active;\n  uint8_t reserved[2];\n};\nstruct api_v3 {\n  api_v2 v2;\n  int (*slave_status)(uint8_t slave, slave_info *out);\n  int (*slave_nmt)(uint8_t slave, uint8_t command);\n  int (*slave_nmt_done)(uint8_t slave, uint8_t command, uint8_t *done);\n  int (*slave_emcy_claim)(uint8_t slave, uint32_t *handle);\n  int (*slave_emcy)(uint8_t slave, uint32_t handle, uint8_t active, uint16_t code, uint32_t info);\n  int (*slave_written)(uint8_t slave, uint16_t index, uint8_t subindex, uint32_t *count);\n};\n// After a lookup that found no plugin, this many lookups are skipped before the next one.\nconst uint32_t miss_skip = 1024;\n\n// The loaded plugin's table, or null with `why` set (r_not_run or r_version). The runtime loads\n// the plugin again at each PLC start while this program stays loaded, so a table is kept only\n// when its flags say it stays valid; otherwise it is looked up on each call. While no plugin is\n// found, only one lookup in miss_skip runs; the others answer r_not_run at once.\ninline const api_v1 *lookup_api(uint8_t &why) {\n  const void *table = nullptr;\n  why = r_not_run;\n#if defined(__linux__)\n  void *lib = dlopen(\"libcanopen_plugin.so\", 0x2 | 0x4);  // RTLD_NOW | RTLD_NOLOAD\n  if (!lib) return nullptr;\n  typedef const void *(*entry_t)(uint32_t);\n  entry_t entry = reinterpret_cast<entry_t>(dlsym(lib, \"canopen_plc_api\"));\n  if (entry) {\n    table = entry(api_version);\n    if (!table) why = r_version;\n  }\n  dlclose(lib);\n#else\n  if (canopen_plc_api) {\n    table = canopen_plc_api(api_version);\n    if (!table) why = r_version;\n  }\n#endif\n  const api_v1 *t = static_cast<const api_v1 *>(table);\n  if (t && t->size < __builtin_offsetof(api_v1, flags)) {\n    why = r_version;\n    return nullptr;\n  }\n  return t;\n}\n\ninline bool api_is_permanent(const api_v1 *t) {\n  return t->size >= sizeof(api_v1) && (t->flags & flag_permanent) != 0;\n}\n\ninline const api_v1 *api(uint8_t &why) {\n  static const api_v1 *kept = nullptr;\n  static uint32_t skip = 0;\n  const api_v1 *t = __atomic_load_n(&kept, __ATOMIC_ACQUIRE);\n  if (t) {\n    why = r_not_run;\n    return t;\n  }\n  uint32_t left = __atomic_load_n(&skip, __ATOMIC_RELAXED);\n  if (left > 0) {\n    __atomic_store_n(&skip, left - 1, __ATOMIC_RELAXED);\n    why = r_not_run;\n    return nullptr;\n  }\n  t = lookup_api(why);\n  if (!t) {\n    if (why == r_not_run) __atomic_store_n(&skip, miss_skip, __ATOMIC_RELAXED);\n    return nullptr;\n  }\n  if (api_is_permanent(t)) __atomic_store_n(&kept, t, __ATOMIC_RELEASE);\n  return t;\n}\n\n// The table with the version 2 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v2 *api2(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 2 || t->size < sizeof(api_v2)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v2 *>(static_cast<const void *>(t));\n}\n\n// The table with the version 3 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v3 *api3(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 3 || t->size < sizeof(api_v3)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v3 *>(static_cast<const void *>(t));\n}\n\n// ---- Error text, written into a fixed buffer (no allocation, no libc). ----\nstruct text {\n  char buf[200];\n  unsigned len;\n};\ninline void clear(text &t) {\n  t.len = 0;\n  t.buf[0] = 0;\n}\ninline void put(text &t, const char *s) {\n  while (*s && t.len + 1 < sizeof t.buf) t.buf[t.len++] = *s++;\n  t.buf[t.len] = 0;\n}\ninline void put_dec(text &t, uint32_t v) {\n  char d[12];\n  int n = 0;\n  do {\n    d[n++] = static_cast<char>('0' + v % 10);\n    v /= 10;\n  } while (v && n < 12);\n  while (n > 0 && t.len + 1 < sizeof t.buf) t.buf[t.len++] = d[--n];\n  t.buf[t.len] = 0;\n}\ninline void put_hex(text &t, uint32_t v, int digits) {\n  put(t, \"16#\");\n  for (int i = digits - 1; i >= 0 && t.len + 1 < sizeof t.buf; --i)\n    t.buf[t.len++] = \"0123456789ABCDEF\"[(v >> (4 * i)) & 0xF];\n  t.buf[t.len] = 0;\n}\n\n// CiA 301 SDO abort codes.\ninline const char *abort_text(uint32_t code) {\n  switch (code) {\n    case 0x05030000u: return \"toggle bit not alternated\";\n    case 0x05040000u: return \"SDO protocol timed out\";\n    case 0x05040001u: return \"command specifier not valid or unknown\";\n    case 0x05040002u: return \"invalid block size\";\n    case 0x05040003u: return \"invalid sequence number\";\n    case 0x05040004u: return \"CRC error\";\n    case 0x05040005u: return \"out of memory\";\n    case 0x06010000u: return \"unsupported access to an object\";\n    case 0x06010001u: return \"attempt to read a write only object\";\n    case 0x06010002u: return \"attempt to write a read only object\";\n    case 0x06020000u: return \"object does not exist\";\n    case 0x06040041u: return \"object cannot be mapped to the PDO\";\n    case 0x06040042u: return \"the mapped objects would exceed the PDO length\";\n    case 0x06040043u: return \"general parameter incompatibility\";\n    case 0x06040047u: return \"general internal incompatibility in the device\";\n    case 0x06060000u: return \"access failed due to a hardware error\";\n    case 0x06070010u: return \"data type or length does not match\";\n    case 0x06070012u: return \"data type does not match, length too high\";\n    case 0x06070013u: return \"data type does not match, length too low\";\n    case 0x06090011u: return \"sub-index does not exist\";\n    case 0x06090030u: return \"invalid value for parameter\";\n    case 0x06090031u: return \"value of parameter written too high\";\n    case 0x06090032u: return \"value of parameter written too low\";\n    case 0x06090036u: return \"maximum value is less than minimum value\";\n    case 0x060A0023u: return \"resource not available: SDO connection\";\n    case 0x08000000u: return \"general error\";\n    case 0x08000020u: return \"data cannot be transferred or stored to the application\";\n    case 0x08000021u: return \"data cannot be transferred or stored because of local control\";\n    case 0x08000022u: return \"data cannot be transferred or stored in the present device state\";\n    case 0x08000023u: return \"no object dictionary is present\";\n    case 0x08000024u: return \"no data available\";\n    default: return \"unknown abort code\";\n  }\n}\n\n// What a request was about, for its error text.\nstruct what {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint16_t index;\n  uint8_t subindex;\n  uint32_t timeout_ms;\n  uint32_t capacity;  // bytes the block holds\n};\n\ninline what what_of(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex,\n                    uint32_t timeout_ms, uint32_t capacity) {\n  what w{};\n  w.network = network;\n  w.node = node;\n  w.index = index;\n  w.subindex = subindex;\n  w.timeout_ms = timeout_ms;\n  w.capacity = capacity;\n  return w;\n}\n\ninline void put_node(text &t, const what &w) {\n  if (w.node == 0) {\n    put(t, \"the nodes of network \");\n    put_dec(t, w.network);\n  } else {\n    put(t, \"node \");\n    put_dec(t, w.node);\n  }\n}\n\ninline void put_object(text &t, const what &w) {\n  put_hex(t, w.index, 4);\n  put(t, \" sub \");\n  put_dec(t, w.subindex);\n}\n\n// The error text of a failed request, and its ERRORINFO.\ninline uint32_t describe(text &t, const what &w, const result &r) {\n  clear(t);\n  switch (r.error) {\n    case e_other_error:\n      put_node(t, w);\n      put(t, \" aborted \");\n      put_object(t, w);\n      put(t, \": \");\n      put(t, abort_text(r.abort_code));\n      put(t, \" (\");\n      put_hex(t, r.abort_code, 8);\n      put(t, \")\");\n      return r.abort_code;\n    case e_timeout:\n      put_node(t, w);\n      put(t, \" did not answer\");\n      if (w.timeout_ms) {\n        put(t, \" within \");\n        put_dec(t, w.timeout_ms);\n        put(t, \" ms\");\n      }\n      return r.abort_code ? r.abort_code : 0x05040000u;\n    case e_bus_off:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, r.reason == r_link ? \" link is down\" : \" bus is off\");\n      return 0;\n    case e_error_passive:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" is error passive\");\n      return 0;\n    case e_wrong_parameter:\n      if (r.reason == r_too_large) {\n        put(t, \"object has \");\n        put_dec(t, r.length);\n        put(t, \" bytes, the block holds \");\n        put_dec(t, w.capacity);\n        return r.length;\n      }\n      if (r.reason == r_length) {\n        put(t, \"DATALENGTH \");\n        put_dec(t, r.length);\n        put(t, \" is not 1 to \");\n        put_dec(t, w.capacity);\n        return 0;\n      }\n      if (r.reason == r_not_in_eds) {\n        put_node(t, w);\n        put(t, \" has no object \");\n        put_object(t, w);\n        put(t, \" of 1 to 4 bytes in its EDS; set DATALENGTH\");\n        return 0;\n      }\n      if (r.reason == r_command) {\n        put(t, \"STATE \");\n        put_dec(t, r.length);\n        put(t, \" is not an NMT state change\");\n        return 0;\n      }\n      put(t, \"wrong parameter\");\n      return 0;\n    case e_node_id_unknown:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" has no node \");\n      put_dec(t, w.node);\n      return 0;\n    case e_net_id_unknown:\n      put(t, \"no CANopen network \");\n      put_dec(t, w.network);\n      return 0;\n    case e_request_error:\n      if (r.reason == r_booting) {\n        put_node(t, w);\n        put(t, \" is booting\");\n      } else if (r.reason == r_full) {\n        put(t, \"network \");\n        put_dec(t, w.network);\n        put(t, \" has 16 block requests waiting\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return 0;\n    case e_no_driver:\n      if (r.reason == r_restart)\n        put(t, \"request cancelled by the PLC stop\");\n      else if (r.reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else if (r.reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else\n        put(t, \"no CANopen network runs\");\n      return 0;\n    default:\n      put(t, \"internal error in the CANopen master\");\n      return 0;\n  }\n}\n\n// The error text of a slave block, for `slave` and the object (index, subindex) or ERRORCODE.\ninline void describe_slave(text &t, uint8_t slave, uint8_t error, uint8_t reason, uint16_t index,\n                           uint8_t subindex) {\n  clear(t);\n  switch (error) {\n    case e_no_error:\n      return;\n    case e_net_id_unknown:\n      put(t, \"no CANopen slave \");\n      put_dec(t, slave);\n      return;\n    case e_no_driver:\n      if (reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else if (reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else\n        put(t, \"no CANopen slave runs\");\n      return;\n    case e_wrong_parameter:\n      if (reason == r_reset) {\n        put(t, \"the program cannot reset the slave; STATE must be START_REMOTE_NODE, \");\n        put(t, \"STOP_REMOTE_NODE or ENTER_PRE_OPERATIONAL\");\n      } else if (reason == r_own_code) {\n        put(t, \"ERRORCODE \");\n        put_hex(t, index, 4);\n        put(t, \" is sent by the slave itself; use another code\");\n      } else if (reason == r_object) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" has no object \");\n        put_hex(t, index, 4);\n        put(t, \" sub \");\n        put_dec(t, subindex);\n        put(t, \" written by the master\");\n      } else {\n        put(t, \"wrong parameter\");\n      }\n      return;\n    case e_request_error:\n      if (reason == r_slots) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" already holds 31 program emergencies\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return;\n    default:\n      put(t, \"internal error in the CANopen slave\");\n      return;\n  }\n}\n\n// Shows a failed request on the block's ERROR, ERRORINFO and ERRORTEXT pins.\ntemplate <class error_pin, class info_pin, class text_pin>\ninline void show(error_pin &error, info_pin &info, text_pin &errortext, const what &w,\n                 const result &r) {\n  text t;\n  uint32_t i = describe(t, w, r);\n  error = r.error ? r.error : static_cast<uint8_t>(e_internal);\n  info = i;\n  errortext = t.buf;\n}\n\n// The size of an object of 1 to 4 bytes in the node's EDS, from the table the editor's build\n// generates (sorted network, node, index, sub-index, size); 0 when it is not listed.\ninline uint32_t eds_size(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex) {\n  const uint64_t key = (static_cast<uint64_t>(network) << 32) | (static_cast<uint64_t>(node) << 24) |\n                       (static_cast<uint64_t>(index) << 8) | subindex;\n  long lo = 0;\n  long hi = static_cast<long>(static_cast<uint32_t>(strucpp::CANOPEN_OBJECT_SIZE_COUNT)) - 1;\n  while (lo <= hi) {\n    long mid = (lo + hi) / 2;\n    uint64_t entry = static_cast<uint64_t>(strucpp::CANOPEN_OBJECT_SIZES[mid]);\n    uint64_t k = entry >> 8;\n    if (k == key) return static_cast<uint32_t>(entry & 0xFF);\n    if (k < key)\n      lo = mid + 1;\n    else\n      hi = mid - 1;\n  }\n  return 0;\n}\n\n// TIME (nanoseconds) to milliseconds; 0 or less: the network's SDO timeout.\ninline uint32_t timeout_ms(long long ns) {\n  if (ns <= 0) return 0;\n  long long ms = (ns + 999999) / 1000000;\n  return ms > 3600000 ? 3600000u : static_cast<uint32_t>(ms);\n}\n\n// One instance's handshake (CiA 405): the block keeps `prev`, `phase` and `handle` in its locals.\nenum { phase_idle = 0, phase_busy = 1, phase_ended = 2 };\nstruct step {\n  bool start;   // rising edge of ENABLE: clear the outputs and start a request\n  bool cancel;  // falling edge while busy: drop the request and clear the outputs\n  bool clear;   // the result was shown and ENABLE is FALSE: clear the outputs\n};\ninline step begin(bool enable, bool &prev, uint8_t &phase) {\n  step s{false, false, false};\n  bool rising = enable && !prev;\n  prev = enable;\n  if (!enable && phase == phase_busy) {\n    s.cancel = true;\n    phase = phase_idle;\n  } else if (!enable && phase == phase_ended) {\n    s.clear = true;\n    phase = phase_idle;\n  }\n  if (rising && phase != phase_busy) s.start = true;\n  return s;\n}\n\n// Starts `req`. Returns the handle, or 0 with `res` saying why it cannot run.\ninline uint64_t start(const request &req, result &res) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why;\n    return 0;\n  }\n  uint64_t handle = t->start(&req, &res);\n  if (!handle && res.error == e_no_error) res.error = e_internal;\n  return handle;\n}\n\n// 0 while the request runs; 1 done, 2 failed (`res` set).\ninline int poll(uint64_t handle, result &res, uint8_t *data, uint32_t cap) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why == r_version ? r_version : r_restart;\n    return 2;\n  }\n  return t->poll(handle, &res, data, cap);\n}\n\ninline void cancel(uint64_t handle) {\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (t) t->cancel(handle);\n}\n\ninline void put_le(uint8_t *out, uint32_t v, unsigned n) {\n  for (unsigned b = 0; b < n; ++b) out[b] = static_cast<uint8_t>(v >> (8 * b));\n}\n\ninline uint32_t get_le(const uint8_t *in, unsigned n) {\n  uint32_t v = 0;\n  for (unsigned b = 0; b < n && b < 4; ++b) v |= static_cast<uint32_t>(in[b]) << (8 * b);\n  return v;\n}\n\n// A failure before any request ran (bad input): `res` for describe().\ninline result fail(uint8_t error, uint8_t reason, uint32_t length) {\n  result r{};\n  r.error = error;\n  r.reason = reason;\n  r.length = length;\n  return r;\n}\n\n}  // namespace canopen_fb\n#endif\nvoid setup() {\n}\n\nvoid loop() {\n  bool l_prev = cop_prev;\n  uint8_t l_phase = cop_phase;\n  canopen_fb::step l_step = canopen_fb::begin(ENABLE, l_prev, l_phase);\n  cop_prev = l_prev;\n  cop_phase = l_phase;\n  if (l_step.cancel) canopen_fb::cancel(cop_handle);\n  if (l_step.cancel || l_step.clear || l_step.start) {\n    BUSY = false;\n    CONFIRM = false;\n    ERROR = 0;\n    ERRORINFO = 0;\n    ERRORTEXT = \"\";\n    cop_handle = 0;\n  }\n  if (l_step.start) {\n    canopen_fb::request l_req = {};\n    l_req.network = NETWORK;\n    l_req.node = DEVICE;\n    l_req.kind = canopen_fb::k_write;\n    l_req.index = INDEX;\n    l_req.subindex = SUBINDEX;\n    l_req.timeout_ms = canopen_fb::timeout_ms(TIMEOUT);\n    canopen_fb::result l_res = {};\n    canopen_fb::result l_bad = {};\n    uint8_t l_payload[canopen_fb::max_data];\n    (void)l_payload;\n    uint32_t l_length = DATALENGTH;\n    if (l_length == 0 || l_length > canopen_fb::max_data) {\n      l_bad = canopen_fb::fail(canopen_fb::e_wrong_parameter, canopen_fb::r_length, l_length);\n      l_length = 0;\n    }\n    for (uint32_t l_i = 0; l_i < l_length; ++l_i) l_payload[l_i] = DATA[l_i];\n    l_req.data = l_payload;\n    l_req.length = l_length;\n    cop_net = l_req.network;\n    cop_node = l_req.node;\n    cop_index = l_req.index;\n    cop_sub = l_req.subindex;\n    cop_timeout = l_req.timeout_ms;\n    uint64_t l_handle = l_bad.error ? 0 : canopen_fb::start(l_req, l_res);\n    if (l_handle) {\n      cop_handle = l_handle;\n      BUSY = true;\n      cop_phase = canopen_fb::phase_busy;\n    } else {\n      cop_phase = canopen_fb::phase_ended;\n      canopen_fb::show(ERROR, ERRORINFO, ERRORTEXT, canopen_fb::what_of(cop_net, cop_node, cop_index, cop_sub,\n                       cop_timeout, 256), l_bad.error ? l_bad : l_res);\n    }\n  }\n  if (cop_phase == canopen_fb::phase_busy) {\n    canopen_fb::result l_res = {};\n    uint8_t l_buf[canopen_fb::max_data + 1];\n    int l_state = canopen_fb::poll(cop_handle, l_res, l_buf, canopen_fb::max_data);\n    if (l_state != 0) {\n      BUSY = false;\n      cop_handle = 0;\n      cop_phase = canopen_fb::phase_ended;\n      if (l_state == 1 && l_res.length > 256u) {\n        l_state = 2;\n        l_res = canopen_fb::fail(canopen_fb::e_wrong_parameter, canopen_fb::r_too_large, l_res.length);\n      }\n      if (l_state == 1) {\n        CONFIRM = true;\n      } else {\n        canopen_fb::show(ERROR, ERRORINFO, ERRORTEXT, canopen_fb::what_of(cop_net, cop_node, cop_index, cop_sub,\n                         cop_timeout, 256), l_res);\n      }\n    }\n  }\n}\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "SDO_READ_STRING.cpp",
      "source": "(* Reads a text object (VISIBLE_STRING) of up to 254 characters from a node by SDO into DATA. Handshake as SDO_READ4. NETWORK counts from 1; DEVICE is the node ID or its name; TIMEOUT T#0s uses the network SDO timeout.\nExample: read(ENABLE := start, DEVICE := IO_Module, INDEX := 16#1008, SUBINDEX := 0); IF read.CONFIRM THEN name := read.DATA; END_IF; *)\nFUNCTION_BLOCK SDO_READ_STRING\nVAR_INPUT\n  NETWORK : USINT := 1;\n  ENABLE : BOOL;\n  DEVICE : USINT;\n  INDEX : WORD;\n  SUBINDEX : BYTE;\n  TIMEOUT : TIME;\nEND_VAR\nVAR_OUTPUT\n  CONFIRM : BOOL;\n  BUSY : BOOL;\n  ERROR : USINT;\n  ERRORINFO : UDINT;\n  ERRORTEXT : STRING;\n  DATA : STRING;\nEND_VAR\nVAR\n  cop_prev : BOOL;\n  cop_phase : USINT;\n  cop_handle : ULINT;\n  cop_net : USINT;\n  cop_node : USINT;\n  cop_index : WORD;\n  cop_sub : BYTE;\n  cop_timeout : UDINT;\nEND_VAR\n// SPDX-License-Identifier: Apache-2.0\n//\n// Shared code of the canopen function blocks. The generator copies it into every block's source,\n// because the editor grafts each library C++ block into one c_blocks_code.cpp and has no other\n// place for shared code; the include guard keeps one copy per program.\n//\n// The editor binds every pin and local of a block to a #define of its name, so nothing here uses\n// a pin or local name (those are upper case or start with cop_; this code is lower case), nor the\n// keyword that closes a variable section, and no system header is included after those defines:\n// dlopen, dlsym and dlclose are declared here as glibc declares them.\n//\n// Derived from canworks ec7fd59, library/src/common.inc (Apache-2.0), adapted to the plugin's\n// interface version 3 (core/src/drivers/plugins/native/canopen/plc_api.h in the runtime fork).\n#ifndef CANOPEN_FB_SHARED_INCLUDED\n#define CANOPEN_FB_SHARED_INCLUDED\n#if defined(__linux__)\nextern \"C\" void *dlopen(const char *file, int mode) noexcept(true);\nextern \"C\" void *dlsym(void *handle, const char *name) noexcept(true);\nextern \"C\" int dlclose(void *handle) noexcept(true);\n#else\n// A board's firmware: the slave module's table, when the project has a slave on the board.\nextern \"C\" const void *canopen_plc_api(uint32_t version) __attribute__((weak));\n#endif\n\nnamespace canopen_fb {\n\n// A copy of the plugin's C interface, version 3; keep in step with plc_api.h. Version 1 is asked\n// for, since a newer plugin answers it with its newest table; `size` tells which it is.\nconst uint32_t api_version = 1;\nconst uint32_t max_data = 256;\nenum {\n  e_no_error = 0, e_other_error = 1, e_timeout = 2, e_bus_off = 3, e_error_passive = 4,\n  e_internal = 5, e_wrong_parameter = 6, e_node_id_unknown = 7, e_net_id_unknown = 8,\n  e_request_error = 9, e_no_driver = 10\n};\nenum {\n  r_none = 0, r_booting = 1, r_full = 2, r_not_run = 3, r_restart = 4, r_link = 5,\n  r_too_large = 6, r_length = 7, r_command = 8, r_version = 9,\n  r_not_in_eds = 100,  // the blocks' own: DATALENGTH 0 for an object the EDS does not list\n  r_needs_v2 = 101,    // the blocks' own: the plugin's table lacks the functions the block needs\n  r_reset = 102,       // the blocks' own: a slave NMT block asked for a reset\n  r_own_code = 103,    // the blocks' own: an emergency code the slave sends itself\n  r_slots = 104,       // the blocks' own: all program emergency slots are taken\n  r_object = 105       // the blocks' own: the slave has no such object from the master\n};\nenum { k_read = 0, k_write = 1, k_nmt = 2 };\nstruct request {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint8_t command;\n  uint16_t index;\n  uint8_t subindex;\n  uint8_t reserved;\n  uint32_t timeout_ms;\n  uint32_t length;\n  const uint8_t *data;\n};\nstruct result {\n  uint8_t error;\n  uint8_t reason;\n  uint16_t reserved;\n  uint32_t abort_code;\n  uint32_t length;\n};\nstruct emcy {\n  uint8_t node;\n  uint8_t error_register;\n  uint16_t error_code;\n  uint8_t data[5];\n  uint8_t reserved[3];\n  uint32_t lost;\n};\nstruct api_v1 {\n  uint32_t size;\n  uint32_t version;\n  uint64_t (*start)(const request *req, result *res);\n  int (*poll)(uint64_t handle, result *res, uint8_t *data, uint32_t cap);\n  void (*cancel)(uint64_t handle);\n  int (*node_state)(uint8_t network, uint8_t node, uint8_t *state);\n  int (*kernel_state)(uint8_t network, uint8_t *state);\n  int (*local_node_id)(uint8_t network, uint8_t *node_id);\n  int (*emcy_cursor)(uint8_t network, uint64_t *cursor);\n  int (*emcy_next)(uint8_t network, uint8_t node, uint64_t *cursor, emcy *out);\n  uint32_t flags;  // present when size covers it\n};\n// flags: the plugin is never unmapped, so its table stays valid for the life of the process.\nconst uint32_t flag_permanent = 0x1;\n// node_info::flags\nconst uint8_t node_enabled = 0x01;\nconst uint8_t node_optional = 0x02;\nconst uint8_t node_program_start = 0x04;\nconst uint32_t status_text = 80;\nstruct node_info {\n  uint8_t run_state;\n  uint8_t flags;\n  uint8_t reserved[2];\n  char problem[status_text];\n};\nstruct network_info {\n  uint8_t mandatory_up;\n  uint8_t optional_up;\n  uint8_t configured;\n  uint8_t operational;\n  uint8_t waiting;\n  uint8_t disabled;\n  uint8_t faulty;\n  uint8_t nodes;\n};\nstruct api_v2 {\n  api_v1 v1;\n  int (*node_status)(uint8_t network, uint8_t node, node_info *out);\n  int (*network_status)(uint8_t network, network_info *out);\n  int (*node_enable)(uint8_t network, uint8_t node, uint8_t on);\n};\n// slave_info::flags\nconst uint8_t slave_on_bus = 0x01;\nconst uint8_t slave_master_watched = 0x02;\nconst uint8_t slave_master_seen = 0x04;\nconst uint32_t slave_emcy_slots = 31;\nstruct slave_info {\n  uint8_t state;\n  uint8_t node_id;\n  uint8_t flags;\n  uint8_t bus_state;\n  uint8_t error_register;\n  uint8_t emcy_active;\n  uint8_t reserved[2];\n};\nstruct api_v3 {\n  api_v2 v2;\n  int (*slave_status)(uint8_t slave, slave_info *out);\n  int (*slave_nmt)(uint8_t slave, uint8_t command);\n  int (*slave_nmt_done)(uint8_t slave, uint8_t command, uint8_t *done);\n  int (*slave_emcy_claim)(uint8_t slave, uint32_t *handle);\n  int (*slave_emcy)(uint8_t slave, uint32_t handle, uint8_t active, uint16_t code, uint32_t info);\n  int (*slave_written)(uint8_t slave, uint16_t index, uint8_t subindex, uint32_t *count);\n};\n// After a lookup that found no plugin, this many lookups are skipped before the next one.\nconst uint32_t miss_skip = 1024;\n\n// The loaded plugin's table, or null with `why` set (r_not_run or r_version). The runtime loads\n// the plugin again at each PLC start while this program stays loaded, so a table is kept only\n// when its flags say it stays valid; otherwise it is looked up on each call. While no plugin is\n// found, only one lookup in miss_skip runs; the others answer r_not_run at once.\ninline const api_v1 *lookup_api(uint8_t &why) {\n  const void *table = nullptr;\n  why = r_not_run;\n#if defined(__linux__)\n  void *lib = dlopen(\"libcanopen_plugin.so\", 0x2 | 0x4);  // RTLD_NOW | RTLD_NOLOAD\n  if (!lib) return nullptr;\n  typedef const void *(*entry_t)(uint32_t);\n  entry_t entry = reinterpret_cast<entry_t>(dlsym(lib, \"canopen_plc_api\"));\n  if (entry) {\n    table = entry(api_version);\n    if (!table) why = r_version;\n  }\n  dlclose(lib);\n#else\n  if (canopen_plc_api) {\n    table = canopen_plc_api(api_version);\n    if (!table) why = r_version;\n  }\n#endif\n  const api_v1 *t = static_cast<const api_v1 *>(table);\n  if (t && t->size < __builtin_offsetof(api_v1, flags)) {\n    why = r_version;\n    return nullptr;\n  }\n  return t;\n}\n\ninline bool api_is_permanent(const api_v1 *t) {\n  return t->size >= sizeof(api_v1) && (t->flags & flag_permanent) != 0;\n}\n\ninline const api_v1 *api(uint8_t &why) {\n  static const api_v1 *kept = nullptr;\n  static uint32_t skip = 0;\n  const api_v1 *t = __atomic_load_n(&kept, __ATOMIC_ACQUIRE);\n  if (t) {\n    why = r_not_run;\n    return t;\n  }\n  uint32_t left = __atomic_load_n(&skip, __ATOMIC_RELAXED);\n  if (left > 0) {\n    __atomic_store_n(&skip, left - 1, __ATOMIC_RELAXED);\n    why = r_not_run;\n    return nullptr;\n  }\n  t = lookup_api(why);\n  if (!t) {\n    if (why == r_not_run) __atomic_store_n(&skip, miss_skip, __ATOMIC_RELAXED);\n    return nullptr;\n  }\n  if (api_is_permanent(t)) __atomic_store_n(&kept, t, __ATOMIC_RELEASE);\n  return t;\n}\n\n// The table with the version 2 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v2 *api2(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 2 || t->size < sizeof(api_v2)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v2 *>(static_cast<const void *>(t));\n}\n\n// The table with the version 3 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v3 *api3(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 3 || t->size < sizeof(api_v3)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v3 *>(static_cast<const void *>(t));\n}\n\n// ---- Error text, written into a fixed buffer (no allocation, no libc). ----\nstruct text {\n  char buf[200];\n  unsigned len;\n};\ninline void clear(text &t) {\n  t.len = 0;\n  t.buf[0] = 0;\n}\ninline void put(text &t, const char *s) {\n  while (*s && t.len + 1 < sizeof t.buf) t.buf[t.len++] = *s++;\n  t.buf[t.len] = 0;\n}\ninline void put_dec(text &t, uint32_t v) {\n  char d[12];\n  int n = 0;\n  do {\n    d[n++] = static_cast<char>('0' + v % 10);\n    v /= 10;\n  } while (v && n < 12);\n  while (n > 0 && t.len + 1 < sizeof t.buf) t.buf[t.len++] = d[--n];\n  t.buf[t.len] = 0;\n}\ninline void put_hex(text &t, uint32_t v, int digits) {\n  put(t, \"16#\");\n  for (int i = digits - 1; i >= 0 && t.len + 1 < sizeof t.buf; --i)\n    t.buf[t.len++] = \"0123456789ABCDEF\"[(v >> (4 * i)) & 0xF];\n  t.buf[t.len] = 0;\n}\n\n// CiA 301 SDO abort codes.\ninline const char *abort_text(uint32_t code) {\n  switch (code) {\n    case 0x05030000u: return \"toggle bit not alternated\";\n    case 0x05040000u: return \"SDO protocol timed out\";\n    case 0x05040001u: return \"command specifier not valid or unknown\";\n    case 0x05040002u: return \"invalid block size\";\n    case 0x05040003u: return \"invalid sequence number\";\n    case 0x05040004u: return \"CRC error\";\n    case 0x05040005u: return \"out of memory\";\n    case 0x06010000u: return \"unsupported access to an object\";\n    case 0x06010001u: return \"attempt to read a write only object\";\n    case 0x06010002u: return \"attempt to write a read only object\";\n    case 0x06020000u: return \"object does not exist\";\n    case 0x06040041u: return \"object cannot be mapped to the PDO\";\n    case 0x06040042u: return \"the mapped objects would exceed the PDO length\";\n    case 0x06040043u: return \"general parameter incompatibility\";\n    case 0x06040047u: return \"general internal incompatibility in the device\";\n    case 0x06060000u: return \"access failed due to a hardware error\";\n    case 0x06070010u: return \"data type or length does not match\";\n    case 0x06070012u: return \"data type does not match, length too high\";\n    case 0x06070013u: return \"data type does not match, length too low\";\n    case 0x06090011u: return \"sub-index does not exist\";\n    case 0x06090030u: return \"invalid value for parameter\";\n    case 0x06090031u: return \"value of parameter written too high\";\n    case 0x06090032u: return \"value of parameter written too low\";\n    case 0x06090036u: return \"maximum value is less than minimum value\";\n    case 0x060A0023u: return \"resource not available: SDO connection\";\n    case 0x08000000u: return \"general error\";\n    case 0x08000020u: return \"data cannot be transferred or stored to the application\";\n    case 0x08000021u: return \"data cannot be transferred or stored because of local control\";\n    case 0x08000022u: return \"data cannot be transferred or stored in the present device state\";\n    case 0x08000023u: return \"no object dictionary is present\";\n    case 0x08000024u: return \"no data available\";\n    default: return \"unknown abort code\";\n  }\n}\n\n// What a request was about, for its error text.\nstruct what {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint16_t index;\n  uint8_t subindex;\n  uint32_t timeout_ms;\n  uint32_t capacity;  // bytes the block holds\n};\n\ninline what what_of(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex,\n                    uint32_t timeout_ms, uint32_t capacity) {\n  what w{};\n  w.network = network;\n  w.node = node;\n  w.index = index;\n  w.subindex = subindex;\n  w.timeout_ms = timeout_ms;\n  w.capacity = capacity;\n  return w;\n}\n\ninline void put_node(text &t, const what &w) {\n  if (w.node == 0) {\n    put(t, \"the nodes of network \");\n    put_dec(t, w.network);\n  } else {\n    put(t, \"node \");\n    put_dec(t, w.node);\n  }\n}\n\ninline void put_object(text &t, const what &w) {\n  put_hex(t, w.index, 4);\n  put(t, \" sub \");\n  put_dec(t, w.subindex);\n}\n\n// The error text of a failed request, and its ERRORINFO.\ninline uint32_t describe(text &t, const what &w, const result &r) {\n  clear(t);\n  switch (r.error) {\n    case e_other_error:\n      put_node(t, w);\n      put(t, \" aborted \");\n      put_object(t, w);\n      put(t, \": \");\n      put(t, abort_text(r.abort_code));\n      put(t, \" (\");\n      put_hex(t, r.abort_code, 8);\n      put(t, \")\");\n      return r.abort_code;\n    case e_timeout:\n      put_node(t, w);\n      put(t, \" did not answer\");\n      if (w.timeout_ms) {\n        put(t, \" within \");\n        put_dec(t, w.timeout_ms);\n        put(t, \" ms\");\n      }\n      return r.abort_code ? r.abort_code : 0x05040000u;\n    case e_bus_off:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, r.reason == r_link ? \" link is down\" : \" bus is off\");\n      return 0;\n    case e_error_passive:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" is error passive\");\n      return 0;\n    case e_wrong_parameter:\n      if (r.reason == r_too_large) {\n        put(t, \"object has \");\n        put_dec(t, r.length);\n        put(t, \" bytes, the block holds \");\n        put_dec(t, w.capacity);\n        return r.length;\n      }\n      if (r.reason == r_length) {\n        put(t, \"DATALENGTH \");\n        put_dec(t, r.length);\n        put(t, \" is not 1 to \");\n        put_dec(t, w.capacity);\n        return 0;\n      }\n      if (r.reason == r_not_in_eds) {\n        put_node(t, w);\n        put(t, \" has no object \");\n        put_object(t, w);\n        put(t, \" of 1 to 4 bytes in its EDS; set DATALENGTH\");\n        return 0;\n      }\n      if (r.reason == r_command) {\n        put(t, \"STATE \");\n        put_dec(t, r.length);\n        put(t, \" is not an NMT state change\");\n        return 0;\n      }\n      put(t, \"wrong parameter\");\n      return 0;\n    case e_node_id_unknown:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" has no node \");\n      put_dec(t, w.node);\n      return 0;\n    case e_net_id_unknown:\n      put(t, \"no CANopen network \");\n      put_dec(t, w.network);\n      return 0;\n    case e_request_error:\n      if (r.reason == r_booting) {\n        put_node(t, w);\n        put(t, \" is booting\");\n      } else if (r.reason == r_full) {\n        put(t, \"network \");\n        put_dec(t, w.network);\n        put(t, \" has 16 block requests waiting\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return 0;\n    case e_no_driver:\n      if (r.reason == r_restart)\n        put(t, \"request cancelled by the PLC stop\");\n      else if (r.reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else if (r.reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else\n        put(t, \"no CANopen network runs\");\n      return 0;\n    default:\n      put(t, \"internal error in the CANopen master\");\n      return 0;\n  }\n}\n\n// The error text of a slave block, for `slave` and the object (index, subindex) or ERRORCODE.\ninline void describe_slave(text &t, uint8_t slave, uint8_t error, uint8_t reason, uint16_t index,\n                           uint8_t subindex) {\n  clear(t);\n  switch (error) {\n    case e_no_error:\n      return;\n    case e_net_id_unknown:\n      put(t, \"no CANopen slave \");\n      put_dec(t, slave);\n      return;\n    case e_no_driver:\n      if (reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else if (reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else\n        put(t, \"no CANopen slave runs\");\n      return;\n    case e_wrong_parameter:\n      if (reason == r_reset) {\n        put(t, \"the program cannot reset the slave; STATE must be START_REMOTE_NODE, \");\n        put(t, \"STOP_REMOTE_NODE or ENTER_PRE_OPERATIONAL\");\n      } else if (reason == r_own_code) {\n        put(t, \"ERRORCODE \");\n        put_hex(t, index, 4);\n        put(t, \" is sent by the slave itself; use another code\");\n      } else if (reason == r_object) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" has no object \");\n        put_hex(t, index, 4);\n        put(t, \" sub \");\n        put_dec(t, subindex);\n        put(t, \" written by the master\");\n      } else {\n        put(t, \"wrong parameter\");\n      }\n      return;\n    case e_request_error:\n      if (reason == r_slots) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" already holds 31 program emergencies\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return;\n    default:\n      put(t, \"internal error in the CANopen slave\");\n      return;\n  }\n}\n\n// Shows a failed request on the block's ERROR, ERRORINFO and ERRORTEXT pins.\ntemplate <class error_pin, class info_pin, class text_pin>\ninline void show(error_pin &error, info_pin &info, text_pin &errortext, const what &w,\n                 const result &r) {\n  text t;\n  uint32_t i = describe(t, w, r);\n  error = r.error ? r.error : static_cast<uint8_t>(e_internal);\n  info = i;\n  errortext = t.buf;\n}\n\n// The size of an object of 1 to 4 bytes in the node's EDS, from the table the editor's build\n// generates (sorted network, node, index, sub-index, size); 0 when it is not listed.\ninline uint32_t eds_size(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex) {\n  const uint64_t key = (static_cast<uint64_t>(network) << 32) | (static_cast<uint64_t>(node) << 24) |\n                       (static_cast<uint64_t>(index) << 8) | subindex;\n  long lo = 0;\n  long hi = static_cast<long>(static_cast<uint32_t>(strucpp::CANOPEN_OBJECT_SIZE_COUNT)) - 1;\n  while (lo <= hi) {\n    long mid = (lo + hi) / 2;\n    uint64_t entry = static_cast<uint64_t>(strucpp::CANOPEN_OBJECT_SIZES[mid]);\n    uint64_t k = entry >> 8;\n    if (k == key) return static_cast<uint32_t>(entry & 0xFF);\n    if (k < key)\n      lo = mid + 1;\n    else\n      hi = mid - 1;\n  }\n  return 0;\n}\n\n// TIME (nanoseconds) to milliseconds; 0 or less: the network's SDO timeout.\ninline uint32_t timeout_ms(long long ns) {\n  if (ns <= 0) return 0;\n  long long ms = (ns + 999999) / 1000000;\n  return ms > 3600000 ? 3600000u : static_cast<uint32_t>(ms);\n}\n\n// One instance's handshake (CiA 405): the block keeps `prev`, `phase` and `handle` in its locals.\nenum { phase_idle = 0, phase_busy = 1, phase_ended = 2 };\nstruct step {\n  bool start;   // rising edge of ENABLE: clear the outputs and start a request\n  bool cancel;  // falling edge while busy: drop the request and clear the outputs\n  bool clear;   // the result was shown and ENABLE is FALSE: clear the outputs\n};\ninline step begin(bool enable, bool &prev, uint8_t &phase) {\n  step s{false, false, false};\n  bool rising = enable && !prev;\n  prev = enable;\n  if (!enable && phase == phase_busy) {\n    s.cancel = true;\n    phase = phase_idle;\n  } else if (!enable && phase == phase_ended) {\n    s.clear = true;\n    phase = phase_idle;\n  }\n  if (rising && phase != phase_busy) s.start = true;\n  return s;\n}\n\n// Starts `req`. Returns the handle, or 0 with `res` saying why it cannot run.\ninline uint64_t start(const request &req, result &res) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why;\n    return 0;\n  }\n  uint64_t handle = t->start(&req, &res);\n  if (!handle && res.error == e_no_error) res.error = e_internal;\n  return handle;\n}\n\n// 0 while the request runs; 1 done, 2 failed (`res` set).\ninline int poll(uint64_t handle, result &res, uint8_t *data, uint32_t cap) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why == r_version ? r_version : r_restart;\n    return 2;\n  }\n  return t->poll(handle, &res, data, cap);\n}\n\ninline void cancel(uint64_t handle) {\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (t) t->cancel(handle);\n}\n\ninline void put_le(uint8_t *out, uint32_t v, unsigned n) {\n  for (unsigned b = 0; b < n; ++b) out[b] = static_cast<uint8_t>(v >> (8 * b));\n}\n\ninline uint32_t get_le(const uint8_t *in, unsigned n) {\n  uint32_t v = 0;\n  for (unsigned b = 0; b < n && b < 4; ++b) v |= static_cast<uint32_t>(in[b]) << (8 * b);\n  return v;\n}\n\n// A failure before any request ran (bad input): `res` for describe().\ninline result fail(uint8_t error, uint8_t reason, uint32_t length) {\n  result r{};\n  r.error = error;\n  r.reason = reason;\n  r.length = length;\n  return r;\n}\n\n}  // namespace canopen_fb\n#endif\nvoid setup() {\n}\n\nvoid loop() {\n  bool l_prev = cop_prev;\n  uint8_t l_phase = cop_phase;\n  canopen_fb::step l_step = canopen_fb::begin(ENABLE, l_prev, l_phase);\n  cop_prev = l_prev;\n  cop_phase = l_phase;\n  if (l_step.cancel) canopen_fb::cancel(cop_handle);\n  if (l_step.cancel || l_step.clear || l_step.start) {\n    BUSY = false;\n    CONFIRM = false;\n    ERROR = 0;\n    ERRORINFO = 0;\n    ERRORTEXT = \"\";\n    cop_handle = 0;\n    DATA = \"\";\n  }\n  if (l_step.start) {\n    canopen_fb::request l_req = {};\n    l_req.network = NETWORK;\n    l_req.node = DEVICE;\n    l_req.kind = canopen_fb::k_read;\n    l_req.index = INDEX;\n    l_req.subindex = SUBINDEX;\n    l_req.timeout_ms = canopen_fb::timeout_ms(TIMEOUT);\n    canopen_fb::result l_res = {};\n    canopen_fb::result l_bad = {};\n    uint8_t l_payload[canopen_fb::max_data];\n    (void)l_payload;\n    cop_net = l_req.network;\n    cop_node = l_req.node;\n    cop_index = l_req.index;\n    cop_sub = l_req.subindex;\n    cop_timeout = l_req.timeout_ms;\n    uint64_t l_handle = l_bad.error ? 0 : canopen_fb::start(l_req, l_res);\n    if (l_handle) {\n      cop_handle = l_handle;\n      BUSY = true;\n      cop_phase = canopen_fb::phase_busy;\n    } else {\n      cop_phase = canopen_fb::phase_ended;\n      canopen_fb::show(ERROR, ERRORINFO, ERRORTEXT, canopen_fb::what_of(cop_net, cop_node, cop_index, cop_sub,\n                       cop_timeout, 254), l_bad.error ? l_bad : l_res);\n    }\n  }\n  if (cop_phase == canopen_fb::phase_busy) {\n    canopen_fb::result l_res = {};\n    uint8_t l_buf[canopen_fb::max_data + 1];\n    int l_state = canopen_fb::poll(cop_handle, l_res, l_buf, canopen_fb::max_data);\n    if (l_state != 0) {\n      BUSY = false;\n      cop_handle = 0;\n      cop_phase = canopen_fb::phase_ended;\n      if (l_state == 1 && l_res.length > 254u) {\n        l_state = 2;\n        l_res = canopen_fb::fail(canopen_fb::e_wrong_parameter, canopen_fb::r_too_large, l_res.length);\n      }\n      if (l_state == 1) {\n        CONFIRM = true;\n        l_buf[l_res.length] = 0;\n        DATA = reinterpret_cast<const char *>(l_buf);\n      } else {\n        canopen_fb::show(ERROR, ERRORINFO, ERRORTEXT, canopen_fb::what_of(cop_net, cop_node, cop_index, cop_sub,\n                         cop_timeout, 254), l_res);\n      }\n    }\n  }\n}\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "SDO_WRITE_STRING.cpp",
      "source": "(* Writes the text DATA (1 to 254 characters) to a text object of a node by SDO. Handshake as SDO_WRITE4. NETWORK counts from 1; DEVICE is the node ID or its name; TIMEOUT T#0s uses the network SDO timeout.\nExample: write(ENABLE := set, DEVICE := IO_Module, INDEX := 16#2010, SUBINDEX := 0, DATA := 'line 1'); *)\nFUNCTION_BLOCK SDO_WRITE_STRING\nVAR_INPUT\n  NETWORK : USINT := 1;\n  ENABLE : BOOL;\n  DEVICE : USINT;\n  INDEX : WORD;\n  SUBINDEX : BYTE;\n  DATA : STRING;\n  TIMEOUT : TIME;\nEND_VAR\nVAR_OUTPUT\n  CONFIRM : BOOL;\n  BUSY : BOOL;\n  ERROR : USINT;\n  ERRORINFO : UDINT;\n  ERRORTEXT : STRING;\nEND_VAR\nVAR\n  cop_prev : BOOL;\n  cop_phase : USINT;\n  cop_handle : ULINT;\n  cop_net : USINT;\n  cop_node : USINT;\n  cop_index : WORD;\n  cop_sub : BYTE;\n  cop_timeout : UDINT;\nEND_VAR\n// SPDX-License-Identifier: Apache-2.0\n//\n// Shared code of the canopen function blocks. The generator copies it into every block's source,\n// because the editor grafts each library C++ block into one c_blocks_code.cpp and has no other\n// place for shared code; the include guard keeps one copy per program.\n//\n// The editor binds every pin and local of a block to a #define of its name, so nothing here uses\n// a pin or local name (those are upper case or start with cop_; this code is lower case), nor the\n// keyword that closes a variable section, and no system header is included after those defines:\n// dlopen, dlsym and dlclose are declared here as glibc declares them.\n//\n// Derived from canworks ec7fd59, library/src/common.inc (Apache-2.0), adapted to the plugin's\n// interface version 3 (core/src/drivers/plugins/native/canopen/plc_api.h in the runtime fork).\n#ifndef CANOPEN_FB_SHARED_INCLUDED\n#define CANOPEN_FB_SHARED_INCLUDED\n#if defined(__linux__)\nextern \"C\" void *dlopen(const char *file, int mode) noexcept(true);\nextern \"C\" void *dlsym(void *handle, const char *name) noexcept(true);\nextern \"C\" int dlclose(void *handle) noexcept(true);\n#else\n// A board's firmware: the slave module's table, when the project has a slave on the board.\nextern \"C\" const void *canopen_plc_api(uint32_t version) __attribute__((weak));\n#endif\n\nnamespace canopen_fb {\n\n// A copy of the plugin's C interface, version 3; keep in step with plc_api.h. Version 1 is asked\n// for, since a newer plugin answers it with its newest table; `size` tells which it is.\nconst uint32_t api_version = 1;\nconst uint32_t max_data = 256;\nenum {\n  e_no_error = 0, e_other_error = 1, e_timeout = 2, e_bus_off = 3, e_error_passive = 4,\n  e_internal = 5, e_wrong_parameter = 6, e_node_id_unknown = 7, e_net_id_unknown = 8,\n  e_request_error = 9, e_no_driver = 10\n};\nenum {\n  r_none = 0, r_booting = 1, r_full = 2, r_not_run = 3, r_restart = 4, r_link = 5,\n  r_too_large = 6, r_length = 7, r_command = 8, r_version = 9,\n  r_not_in_eds = 100,  // the blocks' own: DATALENGTH 0 for an object the EDS does not list\n  r_needs_v2 = 101,    // the blocks' own: the plugin's table lacks the functions the block needs\n  r_reset = 102,       // the blocks' own: a slave NMT block asked for a reset\n  r_own_code = 103,    // the blocks' own: an emergency code the slave sends itself\n  r_slots = 104,       // the blocks' own: all program emergency slots are taken\n  r_object = 105       // the blocks' own: the slave has no such object from the master\n};\nenum { k_read = 0, k_write = 1, k_nmt = 2 };\nstruct request {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint8_t command;\n  uint16_t index;\n  uint8_t subindex;\n  uint8_t reserved;\n  uint32_t timeout_ms;\n  uint32_t length;\n  const uint8_t *data;\n};\nstruct result {\n  uint8_t error;\n  uint8_t reason;\n  uint16_t reserved;\n  uint32_t abort_code;\n  uint32_t length;\n};\nstruct emcy {\n  uint8_t node;\n  uint8_t error_register;\n  uint16_t error_code;\n  uint8_t data[5];\n  uint8_t reserved[3];\n  uint32_t lost;\n};\nstruct api_v1 {\n  uint32_t size;\n  uint32_t version;\n  uint64_t (*start)(const request *req, result *res);\n  int (*poll)(uint64_t handle, result *res, uint8_t *data, uint32_t cap);\n  void (*cancel)(uint64_t handle);\n  int (*node_state)(uint8_t network, uint8_t node, uint8_t *state);\n  int (*kernel_state)(uint8_t network, uint8_t *state);\n  int (*local_node_id)(uint8_t network, uint8_t *node_id);\n  int (*emcy_cursor)(uint8_t network, uint64_t *cursor);\n  int (*emcy_next)(uint8_t network, uint8_t node, uint64_t *cursor, emcy *out);\n  uint32_t flags;  // present when size covers it\n};\n// flags: the plugin is never unmapped, so its table stays valid for the life of the process.\nconst uint32_t flag_permanent = 0x1;\n// node_info::flags\nconst uint8_t node_enabled = 0x01;\nconst uint8_t node_optional = 0x02;\nconst uint8_t node_program_start = 0x04;\nconst uint32_t status_text = 80;\nstruct node_info {\n  uint8_t run_state;\n  uint8_t flags;\n  uint8_t reserved[2];\n  char problem[status_text];\n};\nstruct network_info {\n  uint8_t mandatory_up;\n  uint8_t optional_up;\n  uint8_t configured;\n  uint8_t operational;\n  uint8_t waiting;\n  uint8_t disabled;\n  uint8_t faulty;\n  uint8_t nodes;\n};\nstruct api_v2 {\n  api_v1 v1;\n  int (*node_status)(uint8_t network, uint8_t node, node_info *out);\n  int (*network_status)(uint8_t network, network_info *out);\n  int (*node_enable)(uint8_t network, uint8_t node, uint8_t on);\n};\n// slave_info::flags\nconst uint8_t slave_on_bus = 0x01;\nconst uint8_t slave_master_watched = 0x02;\nconst uint8_t slave_master_seen = 0x04;\nconst uint32_t slave_emcy_slots = 31;\nstruct slave_info {\n  uint8_t state;\n  uint8_t node_id;\n  uint8_t flags;\n  uint8_t bus_state;\n  uint8_t error_register;\n  uint8_t emcy_active;\n  uint8_t reserved[2];\n};\nstruct api_v3 {\n  api_v2 v2;\n  int (*slave_status)(uint8_t slave, slave_info *out);\n  int (*slave_nmt)(uint8_t slave, uint8_t command);\n  int (*slave_nmt_done)(uint8_t slave, uint8_t command, uint8_t *done);\n  int (*slave_emcy_claim)(uint8_t slave, uint32_t *handle);\n  int (*slave_emcy)(uint8_t slave, uint32_t handle, uint8_t active, uint16_t code, uint32_t info);\n  int (*slave_written)(uint8_t slave, uint16_t index, uint8_t subindex, uint32_t *count);\n};\n// After a lookup that found no plugin, this many lookups are skipped before the next one.\nconst uint32_t miss_skip = 1024;\n\n// The loaded plugin's table, or null with `why` set (r_not_run or r_version). The runtime loads\n// the plugin again at each PLC start while this program stays loaded, so a table is kept only\n// when its flags say it stays valid; otherwise it is looked up on each call. While no plugin is\n// found, only one lookup in miss_skip runs; the others answer r_not_run at once.\ninline const api_v1 *lookup_api(uint8_t &why) {\n  const void *table = nullptr;\n  why = r_not_run;\n#if defined(__linux__)\n  void *lib = dlopen(\"libcanopen_plugin.so\", 0x2 | 0x4);  // RTLD_NOW | RTLD_NOLOAD\n  if (!lib) return nullptr;\n  typedef const void *(*entry_t)(uint32_t);\n  entry_t entry = reinterpret_cast<entry_t>(dlsym(lib, \"canopen_plc_api\"));\n  if (entry) {\n    table = entry(api_version);\n    if (!table) why = r_version;\n  }\n  dlclose(lib);\n#else\n  if (canopen_plc_api) {\n    table = canopen_plc_api(api_version);\n    if (!table) why = r_version;\n  }\n#endif\n  const api_v1 *t = static_cast<const api_v1 *>(table);\n  if (t && t->size < __builtin_offsetof(api_v1, flags)) {\n    why = r_version;\n    return nullptr;\n  }\n  return t;\n}\n\ninline bool api_is_permanent(const api_v1 *t) {\n  return t->size >= sizeof(api_v1) && (t->flags & flag_permanent) != 0;\n}\n\ninline const api_v1 *api(uint8_t &why) {\n  static const api_v1 *kept = nullptr;\n  static uint32_t skip = 0;\n  const api_v1 *t = __atomic_load_n(&kept, __ATOMIC_ACQUIRE);\n  if (t) {\n    why = r_not_run;\n    return t;\n  }\n  uint32_t left = __atomic_load_n(&skip, __ATOMIC_RELAXED);\n  if (left > 0) {\n    __atomic_store_n(&skip, left - 1, __ATOMIC_RELAXED);\n    why = r_not_run;\n    return nullptr;\n  }\n  t = lookup_api(why);\n  if (!t) {\n    if (why == r_not_run) __atomic_store_n(&skip, miss_skip, __ATOMIC_RELAXED);\n    return nullptr;\n  }\n  if (api_is_permanent(t)) __atomic_store_n(&kept, t, __ATOMIC_RELEASE);\n  return t;\n}\n\n// The table with the version 2 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v2 *api2(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 2 || t->size < sizeof(api_v2)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v2 *>(static_cast<const void *>(t));\n}\n\n// The table with the version 3 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v3 *api3(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 3 || t->size < sizeof(api_v3)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v3 *>(static_cast<const void *>(t));\n}\n\n// ---- Error text, written into a fixed buffer (no allocation, no libc). ----\nstruct text {\n  char buf[200];\n  unsigned len;\n};\ninline void clear(text &t) {\n  t.len = 0;\n  t.buf[0] = 0;\n}\ninline void put(text &t, const char *s) {\n  while (*s && t.len + 1 < sizeof t.buf) t.buf[t.len++] = *s++;\n  t.buf[t.len] = 0;\n}\ninline void put_dec(text &t, uint32_t v) {\n  char d[12];\n  int n = 0;\n  do {\n    d[n++] = static_cast<char>('0' + v % 10);\n    v /= 10;\n  } while (v && n < 12);\n  while (n > 0 && t.len + 1 < sizeof t.buf) t.buf[t.len++] = d[--n];\n  t.buf[t.len] = 0;\n}\ninline void put_hex(text &t, uint32_t v, int digits) {\n  put(t, \"16#\");\n  for (int i = digits - 1; i >= 0 && t.len + 1 < sizeof t.buf; --i)\n    t.buf[t.len++] = \"0123456789ABCDEF\"[(v >> (4 * i)) & 0xF];\n  t.buf[t.len] = 0;\n}\n\n// CiA 301 SDO abort codes.\ninline const char *abort_text(uint32_t code) {\n  switch (code) {\n    case 0x05030000u: return \"toggle bit not alternated\";\n    case 0x05040000u: return \"SDO protocol timed out\";\n    case 0x05040001u: return \"command specifier not valid or unknown\";\n    case 0x05040002u: return \"invalid block size\";\n    case 0x05040003u: return \"invalid sequence number\";\n    case 0x05040004u: return \"CRC error\";\n    case 0x05040005u: return \"out of memory\";\n    case 0x06010000u: return \"unsupported access to an object\";\n    case 0x06010001u: return \"attempt to read a write only object\";\n    case 0x06010002u: return \"attempt to write a read only object\";\n    case 0x06020000u: return \"object does not exist\";\n    case 0x06040041u: return \"object cannot be mapped to the PDO\";\n    case 0x06040042u: return \"the mapped objects would exceed the PDO length\";\n    case 0x06040043u: return \"general parameter incompatibility\";\n    case 0x06040047u: return \"general internal incompatibility in the device\";\n    case 0x06060000u: return \"access failed due to a hardware error\";\n    case 0x06070010u: return \"data type or length does not match\";\n    case 0x06070012u: return \"data type does not match, length too high\";\n    case 0x06070013u: return \"data type does not match, length too low\";\n    case 0x06090011u: return \"sub-index does not exist\";\n    case 0x06090030u: return \"invalid value for parameter\";\n    case 0x06090031u: return \"value of parameter written too high\";\n    case 0x06090032u: return \"value of parameter written too low\";\n    case 0x06090036u: return \"maximum value is less than minimum value\";\n    case 0x060A0023u: return \"resource not available: SDO connection\";\n    case 0x08000000u: return \"general error\";\n    case 0x08000020u: return \"data cannot be transferred or stored to the application\";\n    case 0x08000021u: return \"data cannot be transferred or stored because of local control\";\n    case 0x08000022u: return \"data cannot be transferred or stored in the present device state\";\n    case 0x08000023u: return \"no object dictionary is present\";\n    case 0x08000024u: return \"no data available\";\n    default: return \"unknown abort code\";\n  }\n}\n\n// What a request was about, for its error text.\nstruct what {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint16_t index;\n  uint8_t subindex;\n  uint32_t timeout_ms;\n  uint32_t capacity;  // bytes the block holds\n};\n\ninline what what_of(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex,\n                    uint32_t timeout_ms, uint32_t capacity) {\n  what w{};\n  w.network = network;\n  w.node = node;\n  w.index = index;\n  w.subindex = subindex;\n  w.timeout_ms = timeout_ms;\n  w.capacity = capacity;\n  return w;\n}\n\ninline void put_node(text &t, const what &w) {\n  if (w.node == 0) {\n    put(t, \"the nodes of network \");\n    put_dec(t, w.network);\n  } else {\n    put(t, \"node \");\n    put_dec(t, w.node);\n  }\n}\n\ninline void put_object(text &t, const what &w) {\n  put_hex(t, w.index, 4);\n  put(t, \" sub \");\n  put_dec(t, w.subindex);\n}\n\n// The error text of a failed request, and its ERRORINFO.\ninline uint32_t describe(text &t, const what &w, const result &r) {\n  clear(t);\n  switch (r.error) {\n    case e_other_error:\n      put_node(t, w);\n      put(t, \" aborted \");\n      put_object(t, w);\n      put(t, \": \");\n      put(t, abort_text(r.abort_code));\n      put(t, \" (\");\n      put_hex(t, r.abort_code, 8);\n      put(t, \")\");\n      return r.abort_code;\n    case e_timeout:\n      put_node(t, w);\n      put(t, \" did not answer\");\n      if (w.timeout_ms) {\n        put(t, \" within \");\n        put_dec(t, w.timeout_ms);\n        put(t, \" ms\");\n      }\n      return r.abort_code ? r.abort_code : 0x05040000u;\n    case e_bus_off:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, r.reason == r_link ? \" link is down\" : \" bus is off\");\n      return 0;\n    case e_error_passive:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" is error passive\");\n      return 0;\n    case e_wrong_parameter:\n      if (r.reason == r_too_large) {\n        put(t, \"object has \");\n        put_dec(t, r.length);\n        put(t, \" bytes, the block holds \");\n        put_dec(t, w.capacity);\n        return r.length;\n      }\n      if (r.reason == r_length) {\n        put(t, \"DATALENGTH \");\n        put_dec(t, r.length);\n        put(t, \" is not 1 to \");\n        put_dec(t, w.capacity);\n        return 0;\n      }\n      if (r.reason == r_not_in_eds) {\n        put_node(t, w);\n        put(t, \" has no object \");\n        put_object(t, w);\n        put(t, \" of 1 to 4 bytes in its EDS; set DATALENGTH\");\n        return 0;\n      }\n      if (r.reason == r_command) {\n        put(t, \"STATE \");\n        put_dec(t, r.length);\n        put(t, \" is not an NMT state change\");\n        return 0;\n      }\n      put(t, \"wrong parameter\");\n      return 0;\n    case e_node_id_unknown:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" has no node \");\n      put_dec(t, w.node);\n      return 0;\n    case e_net_id_unknown:\n      put(t, \"no CANopen network \");\n      put_dec(t, w.network);\n      return 0;\n    case e_request_error:\n      if (r.reason == r_booting) {\n        put_node(t, w);\n        put(t, \" is booting\");\n      } else if (r.reason == r_full) {\n        put(t, \"network \");\n        put_dec(t, w.network);\n        put(t, \" has 16 block requests waiting\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return 0;\n    case e_no_driver:\n      if (r.reason == r_restart)\n        put(t, \"request cancelled by the PLC stop\");\n      else if (r.reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else if (r.reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else\n        put(t, \"no CANopen network runs\");\n      return 0;\n    default:\n      put(t, \"internal error in the CANopen master\");\n      return 0;\n  }\n}\n\n// The error text of a slave block, for `slave` and the object (index, subindex) or ERRORCODE.\ninline void describe_slave(text &t, uint8_t slave, uint8_t error, uint8_t reason, uint16_t index,\n                           uint8_t subindex) {\n  clear(t);\n  switch (error) {\n    case e_no_error:\n      return;\n    case e_net_id_unknown:\n      put(t, \"no CANopen slave \");\n      put_dec(t, slave);\n      return;\n    case e_no_driver:\n      if (reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else if (reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else\n        put(t, \"no CANopen slave runs\");\n      return;\n    case e_wrong_parameter:\n      if (reason == r_reset) {\n        put(t, \"the program cannot reset the slave; STATE must be START_REMOTE_NODE, \");\n        put(t, \"STOP_REMOTE_NODE or ENTER_PRE_OPERATIONAL\");\n      } else if (reason == r_own_code) {\n        put(t, \"ERRORCODE \");\n        put_hex(t, index, 4);\n        put(t, \" is sent by the slave itself; use another code\");\n      } else if (reason == r_object) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" has no object \");\n        put_hex(t, index, 4);\n        put(t, \" sub \");\n        put_dec(t, subindex);\n        put(t, \" written by the master\");\n      } else {\n        put(t, \"wrong parameter\");\n      }\n      return;\n    case e_request_error:\n      if (reason == r_slots) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" already holds 31 program emergencies\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return;\n    default:\n      put(t, \"internal error in the CANopen slave\");\n      return;\n  }\n}\n\n// Shows a failed request on the block's ERROR, ERRORINFO and ERRORTEXT pins.\ntemplate <class error_pin, class info_pin, class text_pin>\ninline void show(error_pin &error, info_pin &info, text_pin &errortext, const what &w,\n                 const result &r) {\n  text t;\n  uint32_t i = describe(t, w, r);\n  error = r.error ? r.error : static_cast<uint8_t>(e_internal);\n  info = i;\n  errortext = t.buf;\n}\n\n// The size of an object of 1 to 4 bytes in the node's EDS, from the table the editor's build\n// generates (sorted network, node, index, sub-index, size); 0 when it is not listed.\ninline uint32_t eds_size(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex) {\n  const uint64_t key = (static_cast<uint64_t>(network) << 32) | (static_cast<uint64_t>(node) << 24) |\n                       (static_cast<uint64_t>(index) << 8) | subindex;\n  long lo = 0;\n  long hi = static_cast<long>(static_cast<uint32_t>(strucpp::CANOPEN_OBJECT_SIZE_COUNT)) - 1;\n  while (lo <= hi) {\n    long mid = (lo + hi) / 2;\n    uint64_t entry = static_cast<uint64_t>(strucpp::CANOPEN_OBJECT_SIZES[mid]);\n    uint64_t k = entry >> 8;\n    if (k == key) return static_cast<uint32_t>(entry & 0xFF);\n    if (k < key)\n      lo = mid + 1;\n    else\n      hi = mid - 1;\n  }\n  return 0;\n}\n\n// TIME (nanoseconds) to milliseconds; 0 or less: the network's SDO timeout.\ninline uint32_t timeout_ms(long long ns) {\n  if (ns <= 0) return 0;\n  long long ms = (ns + 999999) / 1000000;\n  return ms > 3600000 ? 3600000u : static_cast<uint32_t>(ms);\n}\n\n// One instance's handshake (CiA 405): the block keeps `prev`, `phase` and `handle` in its locals.\nenum { phase_idle = 0, phase_busy = 1, phase_ended = 2 };\nstruct step {\n  bool start;   // rising edge of ENABLE: clear the outputs and start a request\n  bool cancel;  // falling edge while busy: drop the request and clear the outputs\n  bool clear;   // the result was shown and ENABLE is FALSE: clear the outputs\n};\ninline step begin(bool enable, bool &prev, uint8_t &phase) {\n  step s{false, false, false};\n  bool rising = enable && !prev;\n  prev = enable;\n  if (!enable && phase == phase_busy) {\n    s.cancel = true;\n    phase = phase_idle;\n  } else if (!enable && phase == phase_ended) {\n    s.clear = true;\n    phase = phase_idle;\n  }\n  if (rising && phase != phase_busy) s.start = true;\n  return s;\n}\n\n// Starts `req`. Returns the handle, or 0 with `res` saying why it cannot run.\ninline uint64_t start(const request &req, result &res) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why;\n    return 0;\n  }\n  uint64_t handle = t->start(&req, &res);\n  if (!handle && res.error == e_no_error) res.error = e_internal;\n  return handle;\n}\n\n// 0 while the request runs; 1 done, 2 failed (`res` set).\ninline int poll(uint64_t handle, result &res, uint8_t *data, uint32_t cap) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why == r_version ? r_version : r_restart;\n    return 2;\n  }\n  return t->poll(handle, &res, data, cap);\n}\n\ninline void cancel(uint64_t handle) {\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (t) t->cancel(handle);\n}\n\ninline void put_le(uint8_t *out, uint32_t v, unsigned n) {\n  for (unsigned b = 0; b < n; ++b) out[b] = static_cast<uint8_t>(v >> (8 * b));\n}\n\ninline uint32_t get_le(const uint8_t *in, unsigned n) {\n  uint32_t v = 0;\n  for (unsigned b = 0; b < n && b < 4; ++b) v |= static_cast<uint32_t>(in[b]) << (8 * b);\n  return v;\n}\n\n// A failure before any request ran (bad input): `res` for describe().\ninline result fail(uint8_t error, uint8_t reason, uint32_t length) {\n  result r{};\n  r.error = error;\n  r.reason = reason;\n  r.length = length;\n  return r;\n}\n\n}  // namespace canopen_fb\n#endif\nvoid setup() {\n}\n\nvoid loop() {\n  bool l_prev = cop_prev;\n  uint8_t l_phase = cop_phase;\n  canopen_fb::step l_step = canopen_fb::begin(ENABLE, l_prev, l_phase);\n  cop_prev = l_prev;\n  cop_phase = l_phase;\n  if (l_step.cancel) canopen_fb::cancel(cop_handle);\n  if (l_step.cancel || l_step.clear || l_step.start) {\n    BUSY = false;\n    CONFIRM = false;\n    ERROR = 0;\n    ERRORINFO = 0;\n    ERRORTEXT = \"\";\n    cop_handle = 0;\n  }\n  if (l_step.start) {\n    canopen_fb::request l_req = {};\n    l_req.network = NETWORK;\n    l_req.node = DEVICE;\n    l_req.kind = canopen_fb::k_write;\n    l_req.index = INDEX;\n    l_req.subindex = SUBINDEX;\n    l_req.timeout_ms = canopen_fb::timeout_ms(TIMEOUT);\n    canopen_fb::result l_res = {};\n    canopen_fb::result l_bad = {};\n    uint8_t l_payload[canopen_fb::max_data];\n    (void)l_payload;\n    const char *l_text = DATA.c_str();\n    uint32_t l_length = 0;\n    while (l_text[l_length] && l_length < 254) {\n      l_payload[l_length] = static_cast<uint8_t>(l_text[l_length]);\n      ++l_length;\n    }\n    if (l_length == 0) l_bad = canopen_fb::fail(canopen_fb::e_wrong_parameter, canopen_fb::r_length, 0);\n    l_req.data = l_payload;\n    l_req.length = l_length;\n    cop_net = l_req.network;\n    cop_node = l_req.node;\n    cop_index = l_req.index;\n    cop_sub = l_req.subindex;\n    cop_timeout = l_req.timeout_ms;\n    uint64_t l_handle = l_bad.error ? 0 : canopen_fb::start(l_req, l_res);\n    if (l_handle) {\n      cop_handle = l_handle;\n      BUSY = true;\n      cop_phase = canopen_fb::phase_busy;\n    } else {\n      cop_phase = canopen_fb::phase_ended;\n      canopen_fb::show(ERROR, ERRORINFO, ERRORTEXT, canopen_fb::what_of(cop_net, cop_node, cop_index, cop_sub,\n                       cop_timeout, 254), l_bad.error ? l_bad : l_res);\n    }\n  }\n  if (cop_phase == canopen_fb::phase_busy) {\n    canopen_fb::result l_res = {};\n    uint8_t l_buf[canopen_fb::max_data + 1];\n    int l_state = canopen_fb::poll(cop_handle, l_res, l_buf, canopen_fb::max_data);\n    if (l_state != 0) {\n      BUSY = false;\n      cop_handle = 0;\n      cop_phase = canopen_fb::phase_ended;\n      if (l_state == 1 && l_res.length > 254u) {\n        l_state = 2;\n        l_res = canopen_fb::fail(canopen_fb::e_wrong_parameter, canopen_fb::r_too_large, l_res.length);\n      }\n      if (l_state == 1) {\n        CONFIRM = true;\n      } else {\n        canopen_fb::show(ERROR, ERRORINFO, ERRORTEXT, canopen_fb::what_of(cop_net, cop_node, cop_index, cop_sub,\n                         cop_timeout, 254), l_res);\n      }\n    }\n  }\n}\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "NMT.cpp",
      "source": "(* Sends an NMT command to a node, or with DEVICE 0 to every node of the network: STATE is START_REMOTE_NODE, STOP_REMOTE_NODE, ENTER_PRE_OPERATIONAL, RESET_NODE or RESET_COMMUNICATION. A node stopped or set pre-operational this way is not a node loss; a start returns it to operational. A rising edge of ENABLE sends it; CONFIRM once sent. TIMEOUT is not used (NMT has no answer).\nExample: nmt(ENABLE := restart, DEVICE := IO_Module, STATE := START_REMOTE_NODE); *)\nFUNCTION_BLOCK NMT\nVAR_INPUT\n  NETWORK : USINT := 1;\n  ENABLE : BOOL;\n  DEVICE : USINT;\n  STATE : USINT;\n  TIMEOUT : TIME;\nEND_VAR\nVAR_OUTPUT\n  CONFIRM : BOOL;\n  BUSY : BOOL;\n  ERROR : USINT;\n  ERRORINFO : UDINT;\n  ERRORTEXT : STRING;\nEND_VAR\nVAR\n  cop_prev : BOOL;\n  cop_phase : USINT;\n  cop_handle : ULINT;\n  cop_net : USINT;\n  cop_node : USINT;\n  cop_index : WORD;\n  cop_sub : BYTE;\n  cop_timeout : UDINT;\nEND_VAR\n// SPDX-License-Identifier: Apache-2.0\n//\n// Shared code of the canopen function blocks. The generator copies it into every block's source,\n// because the editor grafts each library C++ block into one c_blocks_code.cpp and has no other\n// place for shared code; the include guard keeps one copy per program.\n//\n// The editor binds every pin and local of a block to a #define of its name, so nothing here uses\n// a pin or local name (those are upper case or start with cop_; this code is lower case), nor the\n// keyword that closes a variable section, and no system header is included after those defines:\n// dlopen, dlsym and dlclose are declared here as glibc declares them.\n//\n// Derived from canworks ec7fd59, library/src/common.inc (Apache-2.0), adapted to the plugin's\n// interface version 3 (core/src/drivers/plugins/native/canopen/plc_api.h in the runtime fork).\n#ifndef CANOPEN_FB_SHARED_INCLUDED\n#define CANOPEN_FB_SHARED_INCLUDED\n#if defined(__linux__)\nextern \"C\" void *dlopen(const char *file, int mode) noexcept(true);\nextern \"C\" void *dlsym(void *handle, const char *name) noexcept(true);\nextern \"C\" int dlclose(void *handle) noexcept(true);\n#else\n// A board's firmware: the slave module's table, when the project has a slave on the board.\nextern \"C\" const void *canopen_plc_api(uint32_t version) __attribute__((weak));\n#endif\n\nnamespace canopen_fb {\n\n// A copy of the plugin's C interface, version 3; keep in step with plc_api.h. Version 1 is asked\n// for, since a newer plugin answers it with its newest table; `size` tells which it is.\nconst uint32_t api_version = 1;\nconst uint32_t max_data = 256;\nenum {\n  e_no_error = 0, e_other_error = 1, e_timeout = 2, e_bus_off = 3, e_error_passive = 4,\n  e_internal = 5, e_wrong_parameter = 6, e_node_id_unknown = 7, e_net_id_unknown = 8,\n  e_request_error = 9, e_no_driver = 10\n};\nenum {\n  r_none = 0, r_booting = 1, r_full = 2, r_not_run = 3, r_restart = 4, r_link = 5,\n  r_too_large = 6, r_length = 7, r_command = 8, r_version = 9,\n  r_not_in_eds = 100,  // the blocks' own: DATALENGTH 0 for an object the EDS does not list\n  r_needs_v2 = 101,    // the blocks' own: the plugin's table lacks the functions the block needs\n  r_reset = 102,       // the blocks' own: a slave NMT block asked for a reset\n  r_own_code = 103,    // the blocks' own: an emergency code the slave sends itself\n  r_slots = 104,       // the blocks' own: all program emergency slots are taken\n  r_object = 105       // the blocks' own: the slave has no such object from the master\n};\nenum { k_read = 0, k_write = 1, k_nmt = 2 };\nstruct request {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint8_t command;\n  uint16_t index;\n  uint8_t subindex;\n  uint8_t reserved;\n  uint32_t timeout_ms;\n  uint32_t length;\n  const uint8_t *data;\n};\nstruct result {\n  uint8_t error;\n  uint8_t reason;\n  uint16_t reserved;\n  uint32_t abort_code;\n  uint32_t length;\n};\nstruct emcy {\n  uint8_t node;\n  uint8_t error_register;\n  uint16_t error_code;\n  uint8_t data[5];\n  uint8_t reserved[3];\n  uint32_t lost;\n};\nstruct api_v1 {\n  uint32_t size;\n  uint32_t version;\n  uint64_t (*start)(const request *req, result *res);\n  int (*poll)(uint64_t handle, result *res, uint8_t *data, uint32_t cap);\n  void (*cancel)(uint64_t handle);\n  int (*node_state)(uint8_t network, uint8_t node, uint8_t *state);\n  int (*kernel_state)(uint8_t network, uint8_t *state);\n  int (*local_node_id)(uint8_t network, uint8_t *node_id);\n  int (*emcy_cursor)(uint8_t network, uint64_t *cursor);\n  int (*emcy_next)(uint8_t network, uint8_t node, uint64_t *cursor, emcy *out);\n  uint32_t flags;  // present when size covers it\n};\n// flags: the plugin is never unmapped, so its table stays valid for the life of the process.\nconst uint32_t flag_permanent = 0x1;\n// node_info::flags\nconst uint8_t node_enabled = 0x01;\nconst uint8_t node_optional = 0x02;\nconst uint8_t node_program_start = 0x04;\nconst uint32_t status_text = 80;\nstruct node_info {\n  uint8_t run_state;\n  uint8_t flags;\n  uint8_t reserved[2];\n  char problem[status_text];\n};\nstruct network_info {\n  uint8_t mandatory_up;\n  uint8_t optional_up;\n  uint8_t configured;\n  uint8_t operational;\n  uint8_t waiting;\n  uint8_t disabled;\n  uint8_t faulty;\n  uint8_t nodes;\n};\nstruct api_v2 {\n  api_v1 v1;\n  int (*node_status)(uint8_t network, uint8_t node, node_info *out);\n  int (*network_status)(uint8_t network, network_info *out);\n  int (*node_enable)(uint8_t network, uint8_t node, uint8_t on);\n};\n// slave_info::flags\nconst uint8_t slave_on_bus = 0x01;\nconst uint8_t slave_master_watched = 0x02;\nconst uint8_t slave_master_seen = 0x04;\nconst uint32_t slave_emcy_slots = 31;\nstruct slave_info {\n  uint8_t state;\n  uint8_t node_id;\n  uint8_t flags;\n  uint8_t bus_state;\n  uint8_t error_register;\n  uint8_t emcy_active;\n  uint8_t reserved[2];\n};\nstruct api_v3 {\n  api_v2 v2;\n  int (*slave_status)(uint8_t slave, slave_info *out);\n  int (*slave_nmt)(uint8_t slave, uint8_t command);\n  int (*slave_nmt_done)(uint8_t slave, uint8_t command, uint8_t *done);\n  int (*slave_emcy_claim)(uint8_t slave, uint32_t *handle);\n  int (*slave_emcy)(uint8_t slave, uint32_t handle, uint8_t active, uint16_t code, uint32_t info);\n  int (*slave_written)(uint8_t slave, uint16_t index, uint8_t subindex, uint32_t *count);\n};\n// After a lookup that found no plugin, this many lookups are skipped before the next one.\nconst uint32_t miss_skip = 1024;\n\n// The loaded plugin's table, or null with `why` set (r_not_run or r_version). The runtime loads\n// the plugin again at each PLC start while this program stays loaded, so a table is kept only\n// when its flags say it stays valid; otherwise it is looked up on each call. While no plugin is\n// found, only one lookup in miss_skip runs; the others answer r_not_run at once.\ninline const api_v1 *lookup_api(uint8_t &why) {\n  const void *table = nullptr;\n  why = r_not_run;\n#if defined(__linux__)\n  void *lib = dlopen(\"libcanopen_plugin.so\", 0x2 | 0x4);  // RTLD_NOW | RTLD_NOLOAD\n  if (!lib) return nullptr;\n  typedef const void *(*entry_t)(uint32_t);\n  entry_t entry = reinterpret_cast<entry_t>(dlsym(lib, \"canopen_plc_api\"));\n  if (entry) {\n    table = entry(api_version);\n    if (!table) why = r_version;\n  }\n  dlclose(lib);\n#else\n  if (canopen_plc_api) {\n    table = canopen_plc_api(api_version);\n    if (!table) why = r_version;\n  }\n#endif\n  const api_v1 *t = static_cast<const api_v1 *>(table);\n  if (t && t->size < __builtin_offsetof(api_v1, flags)) {\n    why = r_version;\n    return nullptr;\n  }\n  return t;\n}\n\ninline bool api_is_permanent(const api_v1 *t) {\n  return t->size >= sizeof(api_v1) && (t->flags & flag_permanent) != 0;\n}\n\ninline const api_v1 *api(uint8_t &why) {\n  static const api_v1 *kept = nullptr;\n  static uint32_t skip = 0;\n  const api_v1 *t = __atomic_load_n(&kept, __ATOMIC_ACQUIRE);\n  if (t) {\n    why = r_not_run;\n    return t;\n  }\n  uint32_t left = __atomic_load_n(&skip, __ATOMIC_RELAXED);\n  if (left > 0) {\n    __atomic_store_n(&skip, left - 1, __ATOMIC_RELAXED);\n    why = r_not_run;\n    return nullptr;\n  }\n  t = lookup_api(why);\n  if (!t) {\n    if (why == r_not_run) __atomic_store_n(&skip, miss_skip, __ATOMIC_RELAXED);\n    return nullptr;\n  }\n  if (api_is_permanent(t)) __atomic_store_n(&kept, t, __ATOMIC_RELEASE);\n  return t;\n}\n\n// The table with the version 2 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v2 *api2(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 2 || t->size < sizeof(api_v2)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v2 *>(static_cast<const void *>(t));\n}\n\n// The table with the version 3 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v3 *api3(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 3 || t->size < sizeof(api_v3)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v3 *>(static_cast<const void *>(t));\n}\n\n// ---- Error text, written into a fixed buffer (no allocation, no libc). ----\nstruct text {\n  char buf[200];\n  unsigned len;\n};\ninline void clear(text &t) {\n  t.len = 0;\n  t.buf[0] = 0;\n}\ninline void put(text &t, const char *s) {\n  while (*s && t.len + 1 < sizeof t.buf) t.buf[t.len++] = *s++;\n  t.buf[t.len] = 0;\n}\ninline void put_dec(text &t, uint32_t v) {\n  char d[12];\n  int n = 0;\n  do {\n    d[n++] = static_cast<char>('0' + v % 10);\n    v /= 10;\n  } while (v && n < 12);\n  while (n > 0 && t.len + 1 < sizeof t.buf) t.buf[t.len++] = d[--n];\n  t.buf[t.len] = 0;\n}\ninline void put_hex(text &t, uint32_t v, int digits) {\n  put(t, \"16#\");\n  for (int i = digits - 1; i >= 0 && t.len + 1 < sizeof t.buf; --i)\n    t.buf[t.len++] = \"0123456789ABCDEF\"[(v >> (4 * i)) & 0xF];\n  t.buf[t.len] = 0;\n}\n\n// CiA 301 SDO abort codes.\ninline const char *abort_text(uint32_t code) {\n  switch (code) {\n    case 0x05030000u: return \"toggle bit not alternated\";\n    case 0x05040000u: return \"SDO protocol timed out\";\n    case 0x05040001u: return \"command specifier not valid or unknown\";\n    case 0x05040002u: return \"invalid block size\";\n    case 0x05040003u: return \"invalid sequence number\";\n    case 0x05040004u: return \"CRC error\";\n    case 0x05040005u: return \"out of memory\";\n    case 0x06010000u: return \"unsupported access to an object\";\n    case 0x06010001u: return \"attempt to read a write only object\";\n    case 0x06010002u: return \"attempt to write a read only object\";\n    case 0x06020000u: return \"object does not exist\";\n    case 0x06040041u: return \"object cannot be mapped to the PDO\";\n    case 0x06040042u: return \"the mapped objects would exceed the PDO length\";\n    case 0x06040043u: return \"general parameter incompatibility\";\n    case 0x06040047u: return \"general internal incompatibility in the device\";\n    case 0x06060000u: return \"access failed due to a hardware error\";\n    case 0x06070010u: return \"data type or length does not match\";\n    case 0x06070012u: return \"data type does not match, length too high\";\n    case 0x06070013u: return \"data type does not match, length too low\";\n    case 0x06090011u: return \"sub-index does not exist\";\n    case 0x06090030u: return \"invalid value for parameter\";\n    case 0x06090031u: return \"value of parameter written too high\";\n    case 0x06090032u: return \"value of parameter written too low\";\n    case 0x06090036u: return \"maximum value is less than minimum value\";\n    case 0x060A0023u: return \"resource not available: SDO connection\";\n    case 0x08000000u: return \"general error\";\n    case 0x08000020u: return \"data cannot be transferred or stored to the application\";\n    case 0x08000021u: return \"data cannot be transferred or stored because of local control\";\n    case 0x08000022u: return \"data cannot be transferred or stored in the present device state\";\n    case 0x08000023u: return \"no object dictionary is present\";\n    case 0x08000024u: return \"no data available\";\n    default: return \"unknown abort code\";\n  }\n}\n\n// What a request was about, for its error text.\nstruct what {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint16_t index;\n  uint8_t subindex;\n  uint32_t timeout_ms;\n  uint32_t capacity;  // bytes the block holds\n};\n\ninline what what_of(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex,\n                    uint32_t timeout_ms, uint32_t capacity) {\n  what w{};\n  w.network = network;\n  w.node = node;\n  w.index = index;\n  w.subindex = subindex;\n  w.timeout_ms = timeout_ms;\n  w.capacity = capacity;\n  return w;\n}\n\ninline void put_node(text &t, const what &w) {\n  if (w.node == 0) {\n    put(t, \"the nodes of network \");\n    put_dec(t, w.network);\n  } else {\n    put(t, \"node \");\n    put_dec(t, w.node);\n  }\n}\n\ninline void put_object(text &t, const what &w) {\n  put_hex(t, w.index, 4);\n  put(t, \" sub \");\n  put_dec(t, w.subindex);\n}\n\n// The error text of a failed request, and its ERRORINFO.\ninline uint32_t describe(text &t, const what &w, const result &r) {\n  clear(t);\n  switch (r.error) {\n    case e_other_error:\n      put_node(t, w);\n      put(t, \" aborted \");\n      put_object(t, w);\n      put(t, \": \");\n      put(t, abort_text(r.abort_code));\n      put(t, \" (\");\n      put_hex(t, r.abort_code, 8);\n      put(t, \")\");\n      return r.abort_code;\n    case e_timeout:\n      put_node(t, w);\n      put(t, \" did not answer\");\n      if (w.timeout_ms) {\n        put(t, \" within \");\n        put_dec(t, w.timeout_ms);\n        put(t, \" ms\");\n      }\n      return r.abort_code ? r.abort_code : 0x05040000u;\n    case e_bus_off:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, r.reason == r_link ? \" link is down\" : \" bus is off\");\n      return 0;\n    case e_error_passive:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" is error passive\");\n      return 0;\n    case e_wrong_parameter:\n      if (r.reason == r_too_large) {\n        put(t, \"object has \");\n        put_dec(t, r.length);\n        put(t, \" bytes, the block holds \");\n        put_dec(t, w.capacity);\n        return r.length;\n      }\n      if (r.reason == r_length) {\n        put(t, \"DATALENGTH \");\n        put_dec(t, r.length);\n        put(t, \" is not 1 to \");\n        put_dec(t, w.capacity);\n        return 0;\n      }\n      if (r.reason == r_not_in_eds) {\n        put_node(t, w);\n        put(t, \" has no object \");\n        put_object(t, w);\n        put(t, \" of 1 to 4 bytes in its EDS; set DATALENGTH\");\n        return 0;\n      }\n      if (r.reason == r_command) {\n        put(t, \"STATE \");\n        put_dec(t, r.length);\n        put(t, \" is not an NMT state change\");\n        return 0;\n      }\n      put(t, \"wrong parameter\");\n      return 0;\n    case e_node_id_unknown:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" has no node \");\n      put_dec(t, w.node);\n      return 0;\n    case e_net_id_unknown:\n      put(t, \"no CANopen network \");\n      put_dec(t, w.network);\n      return 0;\n    case e_request_error:\n      if (r.reason == r_booting) {\n        put_node(t, w);\n        put(t, \" is booting\");\n      } else if (r.reason == r_full) {\n        put(t, \"network \");\n        put_dec(t, w.network);\n        put(t, \" has 16 block requests waiting\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return 0;\n    case e_no_driver:\n      if (r.reason == r_restart)\n        put(t, \"request cancelled by the PLC stop\");\n      else if (r.reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else if (r.reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else\n        put(t, \"no CANopen network runs\");\n      return 0;\n    default:\n      put(t, \"internal error in the CANopen master\");\n      return 0;\n  }\n}\n\n// The error text of a slave block, for `slave` and the object (index, subindex) or ERRORCODE.\ninline void describe_slave(text &t, uint8_t slave, uint8_t error, uint8_t reason, uint16_t index,\n                           uint8_t subindex) {\n  clear(t);\n  switch (error) {\n    case e_no_error:\n      return;\n    case e_net_id_unknown:\n      put(t, \"no CANopen slave \");\n      put_dec(t, slave);\n      return;\n    case e_no_driver:\n      if (reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else if (reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else\n        put(t, \"no CANopen slave runs\");\n      return;\n    case e_wrong_parameter:\n      if (reason == r_reset) {\n        put(t, \"the program cannot reset the slave; STATE must be START_REMOTE_NODE, \");\n        put(t, \"STOP_REMOTE_NODE or ENTER_PRE_OPERATIONAL\");\n      } else if (reason == r_own_code) {\n        put(t, \"ERRORCODE \");\n        put_hex(t, index, 4);\n        put(t, \" is sent by the slave itself; use another code\");\n      } else if (reason == r_object) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" has no object \");\n        put_hex(t, index, 4);\n        put(t, \" sub \");\n        put_dec(t, subindex);\n        put(t, \" written by the master\");\n      } else {\n        put(t, \"wrong parameter\");\n      }\n      return;\n    case e_request_error:\n      if (reason == r_slots) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" already holds 31 program emergencies\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return;\n    default:\n      put(t, \"internal error in the CANopen slave\");\n      return;\n  }\n}\n\n// Shows a failed request on the block's ERROR, ERRORINFO and ERRORTEXT pins.\ntemplate <class error_pin, class info_pin, class text_pin>\ninline void show(error_pin &error, info_pin &info, text_pin &errortext, const what &w,\n                 const result &r) {\n  text t;\n  uint32_t i = describe(t, w, r);\n  error = r.error ? r.error : static_cast<uint8_t>(e_internal);\n  info = i;\n  errortext = t.buf;\n}\n\n// The size of an object of 1 to 4 bytes in the node's EDS, from the table the editor's build\n// generates (sorted network, node, index, sub-index, size); 0 when it is not listed.\ninline uint32_t eds_size(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex) {\n  const uint64_t key = (static_cast<uint64_t>(network) << 32) | (static_cast<uint64_t>(node) << 24) |\n                       (static_cast<uint64_t>(index) << 8) | subindex;\n  long lo = 0;\n  long hi = static_cast<long>(static_cast<uint32_t>(strucpp::CANOPEN_OBJECT_SIZE_COUNT)) - 1;\n  while (lo <= hi) {\n    long mid = (lo + hi) / 2;\n    uint64_t entry = static_cast<uint64_t>(strucpp::CANOPEN_OBJECT_SIZES[mid]);\n    uint64_t k = entry >> 8;\n    if (k == key) return static_cast<uint32_t>(entry & 0xFF);\n    if (k < key)\n      lo = mid + 1;\n    else\n      hi = mid - 1;\n  }\n  return 0;\n}\n\n// TIME (nanoseconds) to milliseconds; 0 or less: the network's SDO timeout.\ninline uint32_t timeout_ms(long long ns) {\n  if (ns <= 0) return 0;\n  long long ms = (ns + 999999) / 1000000;\n  return ms > 3600000 ? 3600000u : static_cast<uint32_t>(ms);\n}\n\n// One instance's handshake (CiA 405): the block keeps `prev`, `phase` and `handle` in its locals.\nenum { phase_idle = 0, phase_busy = 1, phase_ended = 2 };\nstruct step {\n  bool start;   // rising edge of ENABLE: clear the outputs and start a request\n  bool cancel;  // falling edge while busy: drop the request and clear the outputs\n  bool clear;   // the result was shown and ENABLE is FALSE: clear the outputs\n};\ninline step begin(bool enable, bool &prev, uint8_t &phase) {\n  step s{false, false, false};\n  bool rising = enable && !prev;\n  prev = enable;\n  if (!enable && phase == phase_busy) {\n    s.cancel = true;\n    phase = phase_idle;\n  } else if (!enable && phase == phase_ended) {\n    s.clear = true;\n    phase = phase_idle;\n  }\n  if (rising && phase != phase_busy) s.start = true;\n  return s;\n}\n\n// Starts `req`. Returns the handle, or 0 with `res` saying why it cannot run.\ninline uint64_t start(const request &req, result &res) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why;\n    return 0;\n  }\n  uint64_t handle = t->start(&req, &res);\n  if (!handle && res.error == e_no_error) res.error = e_internal;\n  return handle;\n}\n\n// 0 while the request runs; 1 done, 2 failed (`res` set).\ninline int poll(uint64_t handle, result &res, uint8_t *data, uint32_t cap) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why == r_version ? r_version : r_restart;\n    return 2;\n  }\n  return t->poll(handle, &res, data, cap);\n}\n\ninline void cancel(uint64_t handle) {\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (t) t->cancel(handle);\n}\n\ninline void put_le(uint8_t *out, uint32_t v, unsigned n) {\n  for (unsigned b = 0; b < n; ++b) out[b] = static_cast<uint8_t>(v >> (8 * b));\n}\n\ninline uint32_t get_le(const uint8_t *in, unsigned n) {\n  uint32_t v = 0;\n  for (unsigned b = 0; b < n && b < 4; ++b) v |= static_cast<uint32_t>(in[b]) << (8 * b);\n  return v;\n}\n\n// A failure before any request ran (bad input): `res` for describe().\ninline result fail(uint8_t error, uint8_t reason, uint32_t length) {\n  result r{};\n  r.error = error;\n  r.reason = reason;\n  r.length = length;\n  return r;\n}\n\n}  // namespace canopen_fb\n#endif\nvoid setup() {\n}\n\nvoid loop() {\n  bool l_prev = cop_prev;\n  uint8_t l_phase = cop_phase;\n  canopen_fb::step l_step = canopen_fb::begin(ENABLE, l_prev, l_phase);\n  cop_prev = l_prev;\n  cop_phase = l_phase;\n  if (l_step.cancel) canopen_fb::cancel(cop_handle);\n  if (l_step.cancel || l_step.clear || l_step.start) {\n    BUSY = false;\n    CONFIRM = false;\n    ERROR = 0;\n    ERRORINFO = 0;\n    ERRORTEXT = \"\";\n    cop_handle = 0;\n  }\n  if (l_step.start) {\n    canopen_fb::request l_req = {};\n    l_req.network = NETWORK;\n    l_req.node = DEVICE;\n    l_req.kind = canopen_fb::k_nmt;\n    canopen_fb::result l_res = {};\n    canopen_fb::result l_bad = {};\n    uint8_t l_payload[canopen_fb::max_data];\n    (void)l_payload;\n    switch (static_cast<uint8_t>(STATE)) {\n      case 0: l_req.command = 1; break;\n      case 1: l_req.command = 2; break;\n      case 2: l_req.command = 0x80; break;\n      case 3: l_req.command = 0x81; break;\n      case 4: l_req.command = 0x82; break;\n      default: l_bad = canopen_fb::fail(canopen_fb::e_wrong_parameter, canopen_fb::r_command, STATE); break;\n    }\n    cop_net = l_req.network;\n    cop_node = l_req.node;\n    cop_index = l_req.index;\n    cop_sub = l_req.subindex;\n    cop_timeout = l_req.timeout_ms;\n    uint64_t l_handle = l_bad.error ? 0 : canopen_fb::start(l_req, l_res);\n    if (l_handle) {\n      cop_handle = l_handle;\n      BUSY = true;\n      cop_phase = canopen_fb::phase_busy;\n    } else {\n      cop_phase = canopen_fb::phase_ended;\n      canopen_fb::show(ERROR, ERRORINFO, ERRORTEXT, canopen_fb::what_of(cop_net, cop_node, cop_index, cop_sub,\n                       cop_timeout, 0), l_bad.error ? l_bad : l_res);\n    }\n  }\n  if (cop_phase == canopen_fb::phase_busy) {\n    canopen_fb::result l_res = {};\n    uint8_t l_buf[canopen_fb::max_data + 1];\n    int l_state = canopen_fb::poll(cop_handle, l_res, l_buf, canopen_fb::max_data);\n    if (l_state != 0) {\n      BUSY = false;\n      cop_handle = 0;\n      cop_phase = canopen_fb::phase_ended;\n      if (l_state == 1 && l_res.length > 0u) {\n        l_state = 2;\n        l_res = canopen_fb::fail(canopen_fb::e_wrong_parameter, canopen_fb::r_too_large, l_res.length);\n      }\n      if (l_state == 1) {\n        CONFIRM = true;\n      } else {\n        canopen_fb::show(ERROR, ERRORINFO, ERRORTEXT, canopen_fb::what_of(cop_net, cop_node, cop_index, cop_sub,\n                         cop_timeout, 0), l_res);\n      }\n    }\n  }\n}\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "GET_STATE.cpp",
      "source": "(* Gives a node's NMT state as the master sees it, in the same call while ENABLE is TRUE: INIT, PRE_OPERATIONAL, STOPPED, OPERATIONAL, UNKNOWN or NOT_AVAIL (not answering). NETWORK counts from 1; DEVICE is the node ID or its name.\nExample: state(ENABLE := TRUE, DEVICE := IO_Module); IF state.STATE = STOPPED THEN ... END_IF; *)\nFUNCTION_BLOCK GET_STATE\nVAR_INPUT\n  NETWORK : USINT := 1;\n  ENABLE : BOOL;\n  DEVICE : USINT;\nEND_VAR\nVAR_OUTPUT\n  CONFIRM : BOOL;\n  ERROR : USINT;\n  ERRORTEXT : STRING;\n  STATE : USINT;\nEND_VAR\nVAR\n  cop_last : USINT;\nEND_VAR\n// SPDX-License-Identifier: Apache-2.0\n//\n// Shared code of the canopen function blocks. The generator copies it into every block's source,\n// because the editor grafts each library C++ block into one c_blocks_code.cpp and has no other\n// place for shared code; the include guard keeps one copy per program.\n//\n// The editor binds every pin and local of a block to a #define of its name, so nothing here uses\n// a pin or local name (those are upper case or start with cop_; this code is lower case), nor the\n// keyword that closes a variable section, and no system header is included after those defines:\n// dlopen, dlsym and dlclose are declared here as glibc declares them.\n//\n// Derived from canworks ec7fd59, library/src/common.inc (Apache-2.0), adapted to the plugin's\n// interface version 3 (core/src/drivers/plugins/native/canopen/plc_api.h in the runtime fork).\n#ifndef CANOPEN_FB_SHARED_INCLUDED\n#define CANOPEN_FB_SHARED_INCLUDED\n#if defined(__linux__)\nextern \"C\" void *dlopen(const char *file, int mode) noexcept(true);\nextern \"C\" void *dlsym(void *handle, const char *name) noexcept(true);\nextern \"C\" int dlclose(void *handle) noexcept(true);\n#else\n// A board's firmware: the slave module's table, when the project has a slave on the board.\nextern \"C\" const void *canopen_plc_api(uint32_t version) __attribute__((weak));\n#endif\n\nnamespace canopen_fb {\n\n// A copy of the plugin's C interface, version 3; keep in step with plc_api.h. Version 1 is asked\n// for, since a newer plugin answers it with its newest table; `size` tells which it is.\nconst uint32_t api_version = 1;\nconst uint32_t max_data = 256;\nenum {\n  e_no_error = 0, e_other_error = 1, e_timeout = 2, e_bus_off = 3, e_error_passive = 4,\n  e_internal = 5, e_wrong_parameter = 6, e_node_id_unknown = 7, e_net_id_unknown = 8,\n  e_request_error = 9, e_no_driver = 10\n};\nenum {\n  r_none = 0, r_booting = 1, r_full = 2, r_not_run = 3, r_restart = 4, r_link = 5,\n  r_too_large = 6, r_length = 7, r_command = 8, r_version = 9,\n  r_not_in_eds = 100,  // the blocks' own: DATALENGTH 0 for an object the EDS does not list\n  r_needs_v2 = 101,    // the blocks' own: the plugin's table lacks the functions the block needs\n  r_reset = 102,       // the blocks' own: a slave NMT block asked for a reset\n  r_own_code = 103,    // the blocks' own: an emergency code the slave sends itself\n  r_slots = 104,       // the blocks' own: all program emergency slots are taken\n  r_object = 105       // the blocks' own: the slave has no such object from the master\n};\nenum { k_read = 0, k_write = 1, k_nmt = 2 };\nstruct request {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint8_t command;\n  uint16_t index;\n  uint8_t subindex;\n  uint8_t reserved;\n  uint32_t timeout_ms;\n  uint32_t length;\n  const uint8_t *data;\n};\nstruct result {\n  uint8_t error;\n  uint8_t reason;\n  uint16_t reserved;\n  uint32_t abort_code;\n  uint32_t length;\n};\nstruct emcy {\n  uint8_t node;\n  uint8_t error_register;\n  uint16_t error_code;\n  uint8_t data[5];\n  uint8_t reserved[3];\n  uint32_t lost;\n};\nstruct api_v1 {\n  uint32_t size;\n  uint32_t version;\n  uint64_t (*start)(const request *req, result *res);\n  int (*poll)(uint64_t handle, result *res, uint8_t *data, uint32_t cap);\n  void (*cancel)(uint64_t handle);\n  int (*node_state)(uint8_t network, uint8_t node, uint8_t *state);\n  int (*kernel_state)(uint8_t network, uint8_t *state);\n  int (*local_node_id)(uint8_t network, uint8_t *node_id);\n  int (*emcy_cursor)(uint8_t network, uint64_t *cursor);\n  int (*emcy_next)(uint8_t network, uint8_t node, uint64_t *cursor, emcy *out);\n  uint32_t flags;  // present when size covers it\n};\n// flags: the plugin is never unmapped, so its table stays valid for the life of the process.\nconst uint32_t flag_permanent = 0x1;\n// node_info::flags\nconst uint8_t node_enabled = 0x01;\nconst uint8_t node_optional = 0x02;\nconst uint8_t node_program_start = 0x04;\nconst uint32_t status_text = 80;\nstruct node_info {\n  uint8_t run_state;\n  uint8_t flags;\n  uint8_t reserved[2];\n  char problem[status_text];\n};\nstruct network_info {\n  uint8_t mandatory_up;\n  uint8_t optional_up;\n  uint8_t configured;\n  uint8_t operational;\n  uint8_t waiting;\n  uint8_t disabled;\n  uint8_t faulty;\n  uint8_t nodes;\n};\nstruct api_v2 {\n  api_v1 v1;\n  int (*node_status)(uint8_t network, uint8_t node, node_info *out);\n  int (*network_status)(uint8_t network, network_info *out);\n  int (*node_enable)(uint8_t network, uint8_t node, uint8_t on);\n};\n// slave_info::flags\nconst uint8_t slave_on_bus = 0x01;\nconst uint8_t slave_master_watched = 0x02;\nconst uint8_t slave_master_seen = 0x04;\nconst uint32_t slave_emcy_slots = 31;\nstruct slave_info {\n  uint8_t state;\n  uint8_t node_id;\n  uint8_t flags;\n  uint8_t bus_state;\n  uint8_t error_register;\n  uint8_t emcy_active;\n  uint8_t reserved[2];\n};\nstruct api_v3 {\n  api_v2 v2;\n  int (*slave_status)(uint8_t slave, slave_info *out);\n  int (*slave_nmt)(uint8_t slave, uint8_t command);\n  int (*slave_nmt_done)(uint8_t slave, uint8_t command, uint8_t *done);\n  int (*slave_emcy_claim)(uint8_t slave, uint32_t *handle);\n  int (*slave_emcy)(uint8_t slave, uint32_t handle, uint8_t active, uint16_t code, uint32_t info);\n  int (*slave_written)(uint8_t slave, uint16_t index, uint8_t subindex, uint32_t *count);\n};\n// After a lookup that found no plugin, this many lookups are skipped before the next one.\nconst uint32_t miss_skip = 1024;\n\n// The loaded plugin's table, or null with `why` set (r_not_run or r_version). The runtime loads\n// the plugin again at each PLC start while this program stays loaded, so a table is kept only\n// when its flags say it stays valid; otherwise it is looked up on each call. While no plugin is\n// found, only one lookup in miss_skip runs; the others answer r_not_run at once.\ninline const api_v1 *lookup_api(uint8_t &why) {\n  const void *table = nullptr;\n  why = r_not_run;\n#if defined(__linux__)\n  void *lib = dlopen(\"libcanopen_plugin.so\", 0x2 | 0x4);  // RTLD_NOW | RTLD_NOLOAD\n  if (!lib) return nullptr;\n  typedef const void *(*entry_t)(uint32_t);\n  entry_t entry = reinterpret_cast<entry_t>(dlsym(lib, \"canopen_plc_api\"));\n  if (entry) {\n    table = entry(api_version);\n    if (!table) why = r_version;\n  }\n  dlclose(lib);\n#else\n  if (canopen_plc_api) {\n    table = canopen_plc_api(api_version);\n    if (!table) why = r_version;\n  }\n#endif\n  const api_v1 *t = static_cast<const api_v1 *>(table);\n  if (t && t->size < __builtin_offsetof(api_v1, flags)) {\n    why = r_version;\n    return nullptr;\n  }\n  return t;\n}\n\ninline bool api_is_permanent(const api_v1 *t) {\n  return t->size >= sizeof(api_v1) && (t->flags & flag_permanent) != 0;\n}\n\ninline const api_v1 *api(uint8_t &why) {\n  static const api_v1 *kept = nullptr;\n  static uint32_t skip = 0;\n  const api_v1 *t = __atomic_load_n(&kept, __ATOMIC_ACQUIRE);\n  if (t) {\n    why = r_not_run;\n    return t;\n  }\n  uint32_t left = __atomic_load_n(&skip, __ATOMIC_RELAXED);\n  if (left > 0) {\n    __atomic_store_n(&skip, left - 1, __ATOMIC_RELAXED);\n    why = r_not_run;\n    return nullptr;\n  }\n  t = lookup_api(why);\n  if (!t) {\n    if (why == r_not_run) __atomic_store_n(&skip, miss_skip, __ATOMIC_RELAXED);\n    return nullptr;\n  }\n  if (api_is_permanent(t)) __atomic_store_n(&kept, t, __ATOMIC_RELEASE);\n  return t;\n}\n\n// The table with the version 2 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v2 *api2(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 2 || t->size < sizeof(api_v2)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v2 *>(static_cast<const void *>(t));\n}\n\n// The table with the version 3 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v3 *api3(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 3 || t->size < sizeof(api_v3)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v3 *>(static_cast<const void *>(t));\n}\n\n// ---- Error text, written into a fixed buffer (no allocation, no libc). ----\nstruct text {\n  char buf[200];\n  unsigned len;\n};\ninline void clear(text &t) {\n  t.len = 0;\n  t.buf[0] = 0;\n}\ninline void put(text &t, const char *s) {\n  while (*s && t.len + 1 < sizeof t.buf) t.buf[t.len++] = *s++;\n  t.buf[t.len] = 0;\n}\ninline void put_dec(text &t, uint32_t v) {\n  char d[12];\n  int n = 0;\n  do {\n    d[n++] = static_cast<char>('0' + v % 10);\n    v /= 10;\n  } while (v && n < 12);\n  while (n > 0 && t.len + 1 < sizeof t.buf) t.buf[t.len++] = d[--n];\n  t.buf[t.len] = 0;\n}\ninline void put_hex(text &t, uint32_t v, int digits) {\n  put(t, \"16#\");\n  for (int i = digits - 1; i >= 0 && t.len + 1 < sizeof t.buf; --i)\n    t.buf[t.len++] = \"0123456789ABCDEF\"[(v >> (4 * i)) & 0xF];\n  t.buf[t.len] = 0;\n}\n\n// CiA 301 SDO abort codes.\ninline const char *abort_text(uint32_t code) {\n  switch (code) {\n    case 0x05030000u: return \"toggle bit not alternated\";\n    case 0x05040000u: return \"SDO protocol timed out\";\n    case 0x05040001u: return \"command specifier not valid or unknown\";\n    case 0x05040002u: return \"invalid block size\";\n    case 0x05040003u: return \"invalid sequence number\";\n    case 0x05040004u: return \"CRC error\";\n    case 0x05040005u: return \"out of memory\";\n    case 0x06010000u: return \"unsupported access to an object\";\n    case 0x06010001u: return \"attempt to read a write only object\";\n    case 0x06010002u: return \"attempt to write a read only object\";\n    case 0x06020000u: return \"object does not exist\";\n    case 0x06040041u: return \"object cannot be mapped to the PDO\";\n    case 0x06040042u: return \"the mapped objects would exceed the PDO length\";\n    case 0x06040043u: return \"general parameter incompatibility\";\n    case 0x06040047u: return \"general internal incompatibility in the device\";\n    case 0x06060000u: return \"access failed due to a hardware error\";\n    case 0x06070010u: return \"data type or length does not match\";\n    case 0x06070012u: return \"data type does not match, length too high\";\n    case 0x06070013u: return \"data type does not match, length too low\";\n    case 0x06090011u: return \"sub-index does not exist\";\n    case 0x06090030u: return \"invalid value for parameter\";\n    case 0x06090031u: return \"value of parameter written too high\";\n    case 0x06090032u: return \"value of parameter written too low\";\n    case 0x06090036u: return \"maximum value is less than minimum value\";\n    case 0x060A0023u: return \"resource not available: SDO connection\";\n    case 0x08000000u: return \"general error\";\n    case 0x08000020u: return \"data cannot be transferred or stored to the application\";\n    case 0x08000021u: return \"data cannot be transferred or stored because of local control\";\n    case 0x08000022u: return \"data cannot be transferred or stored in the present device state\";\n    case 0x08000023u: return \"no object dictionary is present\";\n    case 0x08000024u: return \"no data available\";\n    default: return \"unknown abort code\";\n  }\n}\n\n// What a request was about, for its error text.\nstruct what {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint16_t index;\n  uint8_t subindex;\n  uint32_t timeout_ms;\n  uint32_t capacity;  // bytes the block holds\n};\n\ninline what what_of(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex,\n                    uint32_t timeout_ms, uint32_t capacity) {\n  what w{};\n  w.network = network;\n  w.node = node;\n  w.index = index;\n  w.subindex = subindex;\n  w.timeout_ms = timeout_ms;\n  w.capacity = capacity;\n  return w;\n}\n\ninline void put_node(text &t, const what &w) {\n  if (w.node == 0) {\n    put(t, \"the nodes of network \");\n    put_dec(t, w.network);\n  } else {\n    put(t, \"node \");\n    put_dec(t, w.node);\n  }\n}\n\ninline void put_object(text &t, const what &w) {\n  put_hex(t, w.index, 4);\n  put(t, \" sub \");\n  put_dec(t, w.subindex);\n}\n\n// The error text of a failed request, and its ERRORINFO.\ninline uint32_t describe(text &t, const what &w, const result &r) {\n  clear(t);\n  switch (r.error) {\n    case e_other_error:\n      put_node(t, w);\n      put(t, \" aborted \");\n      put_object(t, w);\n      put(t, \": \");\n      put(t, abort_text(r.abort_code));\n      put(t, \" (\");\n      put_hex(t, r.abort_code, 8);\n      put(t, \")\");\n      return r.abort_code;\n    case e_timeout:\n      put_node(t, w);\n      put(t, \" did not answer\");\n      if (w.timeout_ms) {\n        put(t, \" within \");\n        put_dec(t, w.timeout_ms);\n        put(t, \" ms\");\n      }\n      return r.abort_code ? r.abort_code : 0x05040000u;\n    case e_bus_off:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, r.reason == r_link ? \" link is down\" : \" bus is off\");\n      return 0;\n    case e_error_passive:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" is error passive\");\n      return 0;\n    case e_wrong_parameter:\n      if (r.reason == r_too_large) {\n        put(t, \"object has \");\n        put_dec(t, r.length);\n        put(t, \" bytes, the block holds \");\n        put_dec(t, w.capacity);\n        return r.length;\n      }\n      if (r.reason == r_length) {\n        put(t, \"DATALENGTH \");\n        put_dec(t, r.length);\n        put(t, \" is not 1 to \");\n        put_dec(t, w.capacity);\n        return 0;\n      }\n      if (r.reason == r_not_in_eds) {\n        put_node(t, w);\n        put(t, \" has no object \");\n        put_object(t, w);\n        put(t, \" of 1 to 4 bytes in its EDS; set DATALENGTH\");\n        return 0;\n      }\n      if (r.reason == r_command) {\n        put(t, \"STATE \");\n        put_dec(t, r.length);\n        put(t, \" is not an NMT state change\");\n        return 0;\n      }\n      put(t, \"wrong parameter\");\n      return 0;\n    case e_node_id_unknown:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" has no node \");\n      put_dec(t, w.node);\n      return 0;\n    case e_net_id_unknown:\n      put(t, \"no CANopen network \");\n      put_dec(t, w.network);\n      return 0;\n    case e_request_error:\n      if (r.reason == r_booting) {\n        put_node(t, w);\n        put(t, \" is booting\");\n      } else if (r.reason == r_full) {\n        put(t, \"network \");\n        put_dec(t, w.network);\n        put(t, \" has 16 block requests waiting\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return 0;\n    case e_no_driver:\n      if (r.reason == r_restart)\n        put(t, \"request cancelled by the PLC stop\");\n      else if (r.reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else if (r.reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else\n        put(t, \"no CANopen network runs\");\n      return 0;\n    default:\n      put(t, \"internal error in the CANopen master\");\n      return 0;\n  }\n}\n\n// The error text of a slave block, for `slave` and the object (index, subindex) or ERRORCODE.\ninline void describe_slave(text &t, uint8_t slave, uint8_t error, uint8_t reason, uint16_t index,\n                           uint8_t subindex) {\n  clear(t);\n  switch (error) {\n    case e_no_error:\n      return;\n    case e_net_id_unknown:\n      put(t, \"no CANopen slave \");\n      put_dec(t, slave);\n      return;\n    case e_no_driver:\n      if (reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else if (reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else\n        put(t, \"no CANopen slave runs\");\n      return;\n    case e_wrong_parameter:\n      if (reason == r_reset) {\n        put(t, \"the program cannot reset the slave; STATE must be START_REMOTE_NODE, \");\n        put(t, \"STOP_REMOTE_NODE or ENTER_PRE_OPERATIONAL\");\n      } else if (reason == r_own_code) {\n        put(t, \"ERRORCODE \");\n        put_hex(t, index, 4);\n        put(t, \" is sent by the slave itself; use another code\");\n      } else if (reason == r_object) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" has no object \");\n        put_hex(t, index, 4);\n        put(t, \" sub \");\n        put_dec(t, subindex);\n        put(t, \" written by the master\");\n      } else {\n        put(t, \"wrong parameter\");\n      }\n      return;\n    case e_request_error:\n      if (reason == r_slots) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" already holds 31 program emergencies\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return;\n    default:\n      put(t, \"internal error in the CANopen slave\");\n      return;\n  }\n}\n\n// Shows a failed request on the block's ERROR, ERRORINFO and ERRORTEXT pins.\ntemplate <class error_pin, class info_pin, class text_pin>\ninline void show(error_pin &error, info_pin &info, text_pin &errortext, const what &w,\n                 const result &r) {\n  text t;\n  uint32_t i = describe(t, w, r);\n  error = r.error ? r.error : static_cast<uint8_t>(e_internal);\n  info = i;\n  errortext = t.buf;\n}\n\n// The size of an object of 1 to 4 bytes in the node's EDS, from the table the editor's build\n// generates (sorted network, node, index, sub-index, size); 0 when it is not listed.\ninline uint32_t eds_size(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex) {\n  const uint64_t key = (static_cast<uint64_t>(network) << 32) | (static_cast<uint64_t>(node) << 24) |\n                       (static_cast<uint64_t>(index) << 8) | subindex;\n  long lo = 0;\n  long hi = static_cast<long>(static_cast<uint32_t>(strucpp::CANOPEN_OBJECT_SIZE_COUNT)) - 1;\n  while (lo <= hi) {\n    long mid = (lo + hi) / 2;\n    uint64_t entry = static_cast<uint64_t>(strucpp::CANOPEN_OBJECT_SIZES[mid]);\n    uint64_t k = entry >> 8;\n    if (k == key) return static_cast<uint32_t>(entry & 0xFF);\n    if (k < key)\n      lo = mid + 1;\n    else\n      hi = mid - 1;\n  }\n  return 0;\n}\n\n// TIME (nanoseconds) to milliseconds; 0 or less: the network's SDO timeout.\ninline uint32_t timeout_ms(long long ns) {\n  if (ns <= 0) return 0;\n  long long ms = (ns + 999999) / 1000000;\n  return ms > 3600000 ? 3600000u : static_cast<uint32_t>(ms);\n}\n\n// One instance's handshake (CiA 405): the block keeps `prev`, `phase` and `handle` in its locals.\nenum { phase_idle = 0, phase_busy = 1, phase_ended = 2 };\nstruct step {\n  bool start;   // rising edge of ENABLE: clear the outputs and start a request\n  bool cancel;  // falling edge while busy: drop the request and clear the outputs\n  bool clear;   // the result was shown and ENABLE is FALSE: clear the outputs\n};\ninline step begin(bool enable, bool &prev, uint8_t &phase) {\n  step s{false, false, false};\n  bool rising = enable && !prev;\n  prev = enable;\n  if (!enable && phase == phase_busy) {\n    s.cancel = true;\n    phase = phase_idle;\n  } else if (!enable && phase == phase_ended) {\n    s.clear = true;\n    phase = phase_idle;\n  }\n  if (rising && phase != phase_busy) s.start = true;\n  return s;\n}\n\n// Starts `req`. Returns the handle, or 0 with `res` saying why it cannot run.\ninline uint64_t start(const request &req, result &res) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why;\n    return 0;\n  }\n  uint64_t handle = t->start(&req, &res);\n  if (!handle && res.error == e_no_error) res.error = e_internal;\n  return handle;\n}\n\n// 0 while the request runs; 1 done, 2 failed (`res` set).\ninline int poll(uint64_t handle, result &res, uint8_t *data, uint32_t cap) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why == r_version ? r_version : r_restart;\n    return 2;\n  }\n  return t->poll(handle, &res, data, cap);\n}\n\ninline void cancel(uint64_t handle) {\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (t) t->cancel(handle);\n}\n\ninline void put_le(uint8_t *out, uint32_t v, unsigned n) {\n  for (unsigned b = 0; b < n; ++b) out[b] = static_cast<uint8_t>(v >> (8 * b));\n}\n\ninline uint32_t get_le(const uint8_t *in, unsigned n) {\n  uint32_t v = 0;\n  for (unsigned b = 0; b < n && b < 4; ++b) v |= static_cast<uint32_t>(in[b]) << (8 * b);\n  return v;\n}\n\n// A failure before any request ran (bad input): `res` for describe().\ninline result fail(uint8_t error, uint8_t reason, uint32_t length) {\n  result r{};\n  r.error = error;\n  r.reason = reason;\n  r.length = length;\n  return r;\n}\n\n}  // namespace canopen_fb\n#endif\nvoid setup() {\n}\n\nvoid loop() {\n  if (!ENABLE) {\n    CONFIRM = false;\n    ERROR = 0;\n    if (cop_last != 0) ERRORTEXT = \"\";\n    cop_last = 0;\n    return;\n  }\n  uint8_t l_why = 0;\n  const canopen_fb::api_v1 *l_api = canopen_fb::api(l_why);\n  int l_error = canopen_fb::e_no_driver;\n  uint8_t l_node = 0;\n  if (l_api) {\n    uint8_t l_state = 0;\n    l_node = DEVICE;\n    l_error = l_api->node_state(NETWORK, l_node, &l_state);\n    if (l_error == canopen_fb::e_no_error) STATE = l_state;\n  }\n  CONFIRM = l_error == canopen_fb::e_no_error;\n  ERROR = static_cast<uint8_t>(l_error);\n  if (l_error != cop_last) {\n    canopen_fb::result l_res = canopen_fb::fail(static_cast<uint8_t>(l_error), l_api ? 0 : l_why, 0);\n    canopen_fb::text l_text;\n    canopen_fb::clear(l_text);\n    if (l_error != canopen_fb::e_no_error)\n      canopen_fb::describe(l_text, canopen_fb::what_of(NETWORK, l_node, 0, 0, 0, 0), l_res);\n    ERRORTEXT = l_text.buf;\n    cop_last = static_cast<uint8_t>(l_error);\n  }\n}\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "GET_LOCAL_NODE_ID.cpp",
      "source": "(* Gives the master's own node ID on the network, in the same call while ENABLE is TRUE. NETWORK counts from 1.\nExample: local(ENABLE := TRUE); id := local.NODEID; *)\nFUNCTION_BLOCK GET_LOCAL_NODE_ID\nVAR_INPUT\n  NETWORK : USINT := 1;\n  ENABLE : BOOL;\nEND_VAR\nVAR_OUTPUT\n  CONFIRM : BOOL;\n  ERROR : USINT;\n  ERRORTEXT : STRING;\n  NODEID : USINT;\nEND_VAR\nVAR\n  cop_last : USINT;\nEND_VAR\n// SPDX-License-Identifier: Apache-2.0\n//\n// Shared code of the canopen function blocks. The generator copies it into every block's source,\n// because the editor grafts each library C++ block into one c_blocks_code.cpp and has no other\n// place for shared code; the include guard keeps one copy per program.\n//\n// The editor binds every pin and local of a block to a #define of its name, so nothing here uses\n// a pin or local name (those are upper case or start with cop_; this code is lower case), nor the\n// keyword that closes a variable section, and no system header is included after those defines:\n// dlopen, dlsym and dlclose are declared here as glibc declares them.\n//\n// Derived from canworks ec7fd59, library/src/common.inc (Apache-2.0), adapted to the plugin's\n// interface version 3 (core/src/drivers/plugins/native/canopen/plc_api.h in the runtime fork).\n#ifndef CANOPEN_FB_SHARED_INCLUDED\n#define CANOPEN_FB_SHARED_INCLUDED\n#if defined(__linux__)\nextern \"C\" void *dlopen(const char *file, int mode) noexcept(true);\nextern \"C\" void *dlsym(void *handle, const char *name) noexcept(true);\nextern \"C\" int dlclose(void *handle) noexcept(true);\n#else\n// A board's firmware: the slave module's table, when the project has a slave on the board.\nextern \"C\" const void *canopen_plc_api(uint32_t version) __attribute__((weak));\n#endif\n\nnamespace canopen_fb {\n\n// A copy of the plugin's C interface, version 3; keep in step with plc_api.h. Version 1 is asked\n// for, since a newer plugin answers it with its newest table; `size` tells which it is.\nconst uint32_t api_version = 1;\nconst uint32_t max_data = 256;\nenum {\n  e_no_error = 0, e_other_error = 1, e_timeout = 2, e_bus_off = 3, e_error_passive = 4,\n  e_internal = 5, e_wrong_parameter = 6, e_node_id_unknown = 7, e_net_id_unknown = 8,\n  e_request_error = 9, e_no_driver = 10\n};\nenum {\n  r_none = 0, r_booting = 1, r_full = 2, r_not_run = 3, r_restart = 4, r_link = 5,\n  r_too_large = 6, r_length = 7, r_command = 8, r_version = 9,\n  r_not_in_eds = 100,  // the blocks' own: DATALENGTH 0 for an object the EDS does not list\n  r_needs_v2 = 101,    // the blocks' own: the plugin's table lacks the functions the block needs\n  r_reset = 102,       // the blocks' own: a slave NMT block asked for a reset\n  r_own_code = 103,    // the blocks' own: an emergency code the slave sends itself\n  r_slots = 104,       // the blocks' own: all program emergency slots are taken\n  r_object = 105       // the blocks' own: the slave has no such object from the master\n};\nenum { k_read = 0, k_write = 1, k_nmt = 2 };\nstruct request {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint8_t command;\n  uint16_t index;\n  uint8_t subindex;\n  uint8_t reserved;\n  uint32_t timeout_ms;\n  uint32_t length;\n  const uint8_t *data;\n};\nstruct result {\n  uint8_t error;\n  uint8_t reason;\n  uint16_t reserved;\n  uint32_t abort_code;\n  uint32_t length;\n};\nstruct emcy {\n  uint8_t node;\n  uint8_t error_register;\n  uint16_t error_code;\n  uint8_t data[5];\n  uint8_t reserved[3];\n  uint32_t lost;\n};\nstruct api_v1 {\n  uint32_t size;\n  uint32_t version;\n  uint64_t (*start)(const request *req, result *res);\n  int (*poll)(uint64_t handle, result *res, uint8_t *data, uint32_t cap);\n  void (*cancel)(uint64_t handle);\n  int (*node_state)(uint8_t network, uint8_t node, uint8_t *state);\n  int (*kernel_state)(uint8_t network, uint8_t *state);\n  int (*local_node_id)(uint8_t network, uint8_t *node_id);\n  int (*emcy_cursor)(uint8_t network, uint64_t *cursor);\n  int (*emcy_next)(uint8_t network, uint8_t node, uint64_t *cursor, emcy *out);\n  uint32_t flags;  // present when size covers it\n};\n// flags: the plugin is never unmapped, so its table stays valid for the life of the process.\nconst uint32_t flag_permanent = 0x1;\n// node_info::flags\nconst uint8_t node_enabled = 0x01;\nconst uint8_t node_optional = 0x02;\nconst uint8_t node_program_start = 0x04;\nconst uint32_t status_text = 80;\nstruct node_info {\n  uint8_t run_state;\n  uint8_t flags;\n  uint8_t reserved[2];\n  char problem[status_text];\n};\nstruct network_info {\n  uint8_t mandatory_up;\n  uint8_t optional_up;\n  uint8_t configured;\n  uint8_t operational;\n  uint8_t waiting;\n  uint8_t disabled;\n  uint8_t faulty;\n  uint8_t nodes;\n};\nstruct api_v2 {\n  api_v1 v1;\n  int (*node_status)(uint8_t network, uint8_t node, node_info *out);\n  int (*network_status)(uint8_t network, network_info *out);\n  int (*node_enable)(uint8_t network, uint8_t node, uint8_t on);\n};\n// slave_info::flags\nconst uint8_t slave_on_bus = 0x01;\nconst uint8_t slave_master_watched = 0x02;\nconst uint8_t slave_master_seen = 0x04;\nconst uint32_t slave_emcy_slots = 31;\nstruct slave_info {\n  uint8_t state;\n  uint8_t node_id;\n  uint8_t flags;\n  uint8_t bus_state;\n  uint8_t error_register;\n  uint8_t emcy_active;\n  uint8_t reserved[2];\n};\nstruct api_v3 {\n  api_v2 v2;\n  int (*slave_status)(uint8_t slave, slave_info *out);\n  int (*slave_nmt)(uint8_t slave, uint8_t command);\n  int (*slave_nmt_done)(uint8_t slave, uint8_t command, uint8_t *done);\n  int (*slave_emcy_claim)(uint8_t slave, uint32_t *handle);\n  int (*slave_emcy)(uint8_t slave, uint32_t handle, uint8_t active, uint16_t code, uint32_t info);\n  int (*slave_written)(uint8_t slave, uint16_t index, uint8_t subindex, uint32_t *count);\n};\n// After a lookup that found no plugin, this many lookups are skipped before the next one.\nconst uint32_t miss_skip = 1024;\n\n// The loaded plugin's table, or null with `why` set (r_not_run or r_version). The runtime loads\n// the plugin again at each PLC start while this program stays loaded, so a table is kept only\n// when its flags say it stays valid; otherwise it is looked up on each call. While no plugin is\n// found, only one lookup in miss_skip runs; the others answer r_not_run at once.\ninline const api_v1 *lookup_api(uint8_t &why) {\n  const void *table = nullptr;\n  why = r_not_run;\n#if defined(__linux__)\n  void *lib = dlopen(\"libcanopen_plugin.so\", 0x2 | 0x4);  // RTLD_NOW | RTLD_NOLOAD\n  if (!lib) return nullptr;\n  typedef const void *(*entry_t)(uint32_t);\n  entry_t entry = reinterpret_cast<entry_t>(dlsym(lib, \"canopen_plc_api\"));\n  if (entry) {\n    table = entry(api_version);\n    if (!table) why = r_version;\n  }\n  dlclose(lib);\n#else\n  if (canopen_plc_api) {\n    table = canopen_plc_api(api_version);\n    if (!table) why = r_version;\n  }\n#endif\n  const api_v1 *t = static_cast<const api_v1 *>(table);\n  if (t && t->size < __builtin_offsetof(api_v1, flags)) {\n    why = r_version;\n    return nullptr;\n  }\n  return t;\n}\n\ninline bool api_is_permanent(const api_v1 *t) {\n  return t->size >= sizeof(api_v1) && (t->flags & flag_permanent) != 0;\n}\n\ninline const api_v1 *api(uint8_t &why) {\n  static const api_v1 *kept = nullptr;\n  static uint32_t skip = 0;\n  const api_v1 *t = __atomic_load_n(&kept, __ATOMIC_ACQUIRE);\n  if (t) {\n    why = r_not_run;\n    return t;\n  }\n  uint32_t left = __atomic_load_n(&skip, __ATOMIC_RELAXED);\n  if (left > 0) {\n    __atomic_store_n(&skip, left - 1, __ATOMIC_RELAXED);\n    why = r_not_run;\n    return nullptr;\n  }\n  t = lookup_api(why);\n  if (!t) {\n    if (why == r_not_run) __atomic_store_n(&skip, miss_skip, __ATOMIC_RELAXED);\n    return nullptr;\n  }\n  if (api_is_permanent(t)) __atomic_store_n(&kept, t, __ATOMIC_RELEASE);\n  return t;\n}\n\n// The table with the version 2 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v2 *api2(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 2 || t->size < sizeof(api_v2)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v2 *>(static_cast<const void *>(t));\n}\n\n// The table with the version 3 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v3 *api3(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 3 || t->size < sizeof(api_v3)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v3 *>(static_cast<const void *>(t));\n}\n\n// ---- Error text, written into a fixed buffer (no allocation, no libc). ----\nstruct text {\n  char buf[200];\n  unsigned len;\n};\ninline void clear(text &t) {\n  t.len = 0;\n  t.buf[0] = 0;\n}\ninline void put(text &t, const char *s) {\n  while (*s && t.len + 1 < sizeof t.buf) t.buf[t.len++] = *s++;\n  t.buf[t.len] = 0;\n}\ninline void put_dec(text &t, uint32_t v) {\n  char d[12];\n  int n = 0;\n  do {\n    d[n++] = static_cast<char>('0' + v % 10);\n    v /= 10;\n  } while (v && n < 12);\n  while (n > 0 && t.len + 1 < sizeof t.buf) t.buf[t.len++] = d[--n];\n  t.buf[t.len] = 0;\n}\ninline void put_hex(text &t, uint32_t v, int digits) {\n  put(t, \"16#\");\n  for (int i = digits - 1; i >= 0 && t.len + 1 < sizeof t.buf; --i)\n    t.buf[t.len++] = \"0123456789ABCDEF\"[(v >> (4 * i)) & 0xF];\n  t.buf[t.len] = 0;\n}\n\n// CiA 301 SDO abort codes.\ninline const char *abort_text(uint32_t code) {\n  switch (code) {\n    case 0x05030000u: return \"toggle bit not alternated\";\n    case 0x05040000u: return \"SDO protocol timed out\";\n    case 0x05040001u: return \"command specifier not valid or unknown\";\n    case 0x05040002u: return \"invalid block size\";\n    case 0x05040003u: return \"invalid sequence number\";\n    case 0x05040004u: return \"CRC error\";\n    case 0x05040005u: return \"out of memory\";\n    case 0x06010000u: return \"unsupported access to an object\";\n    case 0x06010001u: return \"attempt to read a write only object\";\n    case 0x06010002u: return \"attempt to write a read only object\";\n    case 0x06020000u: return \"object does not exist\";\n    case 0x06040041u: return \"object cannot be mapped to the PDO\";\n    case 0x06040042u: return \"the mapped objects would exceed the PDO length\";\n    case 0x06040043u: return \"general parameter incompatibility\";\n    case 0x06040047u: return \"general internal incompatibility in the device\";\n    case 0x06060000u: return \"access failed due to a hardware error\";\n    case 0x06070010u: return \"data type or length does not match\";\n    case 0x06070012u: return \"data type does not match, length too high\";\n    case 0x06070013u: return \"data type does not match, length too low\";\n    case 0x06090011u: return \"sub-index does not exist\";\n    case 0x06090030u: return \"invalid value for parameter\";\n    case 0x06090031u: return \"value of parameter written too high\";\n    case 0x06090032u: return \"value of parameter written too low\";\n    case 0x06090036u: return \"maximum value is less than minimum value\";\n    case 0x060A0023u: return \"resource not available: SDO connection\";\n    case 0x08000000u: return \"general error\";\n    case 0x08000020u: return \"data cannot be transferred or stored to the application\";\n    case 0x08000021u: return \"data cannot be transferred or stored because of local control\";\n    case 0x08000022u: return \"data cannot be transferred or stored in the present device state\";\n    case 0x08000023u: return \"no object dictionary is present\";\n    case 0x08000024u: return \"no data available\";\n    default: return \"unknown abort code\";\n  }\n}\n\n// What a request was about, for its error text.\nstruct what {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint16_t index;\n  uint8_t subindex;\n  uint32_t timeout_ms;\n  uint32_t capacity;  // bytes the block holds\n};\n\ninline what what_of(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex,\n                    uint32_t timeout_ms, uint32_t capacity) {\n  what w{};\n  w.network = network;\n  w.node = node;\n  w.index = index;\n  w.subindex = subindex;\n  w.timeout_ms = timeout_ms;\n  w.capacity = capacity;\n  return w;\n}\n\ninline void put_node(text &t, const what &w) {\n  if (w.node == 0) {\n    put(t, \"the nodes of network \");\n    put_dec(t, w.network);\n  } else {\n    put(t, \"node \");\n    put_dec(t, w.node);\n  }\n}\n\ninline void put_object(text &t, const what &w) {\n  put_hex(t, w.index, 4);\n  put(t, \" sub \");\n  put_dec(t, w.subindex);\n}\n\n// The error text of a failed request, and its ERRORINFO.\ninline uint32_t describe(text &t, const what &w, const result &r) {\n  clear(t);\n  switch (r.error) {\n    case e_other_error:\n      put_node(t, w);\n      put(t, \" aborted \");\n      put_object(t, w);\n      put(t, \": \");\n      put(t, abort_text(r.abort_code));\n      put(t, \" (\");\n      put_hex(t, r.abort_code, 8);\n      put(t, \")\");\n      return r.abort_code;\n    case e_timeout:\n      put_node(t, w);\n      put(t, \" did not answer\");\n      if (w.timeout_ms) {\n        put(t, \" within \");\n        put_dec(t, w.timeout_ms);\n        put(t, \" ms\");\n      }\n      return r.abort_code ? r.abort_code : 0x05040000u;\n    case e_bus_off:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, r.reason == r_link ? \" link is down\" : \" bus is off\");\n      return 0;\n    case e_error_passive:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" is error passive\");\n      return 0;\n    case e_wrong_parameter:\n      if (r.reason == r_too_large) {\n        put(t, \"object has \");\n        put_dec(t, r.length);\n        put(t, \" bytes, the block holds \");\n        put_dec(t, w.capacity);\n        return r.length;\n      }\n      if (r.reason == r_length) {\n        put(t, \"DATALENGTH \");\n        put_dec(t, r.length);\n        put(t, \" is not 1 to \");\n        put_dec(t, w.capacity);\n        return 0;\n      }\n      if (r.reason == r_not_in_eds) {\n        put_node(t, w);\n        put(t, \" has no object \");\n        put_object(t, w);\n        put(t, \" of 1 to 4 bytes in its EDS; set DATALENGTH\");\n        return 0;\n      }\n      if (r.reason == r_command) {\n        put(t, \"STATE \");\n        put_dec(t, r.length);\n        put(t, \" is not an NMT state change\");\n        return 0;\n      }\n      put(t, \"wrong parameter\");\n      return 0;\n    case e_node_id_unknown:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" has no node \");\n      put_dec(t, w.node);\n      return 0;\n    case e_net_id_unknown:\n      put(t, \"no CANopen network \");\n      put_dec(t, w.network);\n      return 0;\n    case e_request_error:\n      if (r.reason == r_booting) {\n        put_node(t, w);\n        put(t, \" is booting\");\n      } else if (r.reason == r_full) {\n        put(t, \"network \");\n        put_dec(t, w.network);\n        put(t, \" has 16 block requests waiting\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return 0;\n    case e_no_driver:\n      if (r.reason == r_restart)\n        put(t, \"request cancelled by the PLC stop\");\n      else if (r.reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else if (r.reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else\n        put(t, \"no CANopen network runs\");\n      return 0;\n    default:\n      put(t, \"internal error in the CANopen master\");\n      return 0;\n  }\n}\n\n// The error text of a slave block, for `slave` and the object (index, subindex) or ERRORCODE.\ninline void describe_slave(text &t, uint8_t slave, uint8_t error, uint8_t reason, uint16_t index,\n                           uint8_t subindex) {\n  clear(t);\n  switch (error) {\n    case e_no_error:\n      return;\n    case e_net_id_unknown:\n      put(t, \"no CANopen slave \");\n      put_dec(t, slave);\n      return;\n    case e_no_driver:\n      if (reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else if (reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else\n        put(t, \"no CANopen slave runs\");\n      return;\n    case e_wrong_parameter:\n      if (reason == r_reset) {\n        put(t, \"the program cannot reset the slave; STATE must be START_REMOTE_NODE, \");\n        put(t, \"STOP_REMOTE_NODE or ENTER_PRE_OPERATIONAL\");\n      } else if (reason == r_own_code) {\n        put(t, \"ERRORCODE \");\n        put_hex(t, index, 4);\n        put(t, \" is sent by the slave itself; use another code\");\n      } else if (reason == r_object) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" has no object \");\n        put_hex(t, index, 4);\n        put(t, \" sub \");\n        put_dec(t, subindex);\n        put(t, \" written by the master\");\n      } else {\n        put(t, \"wrong parameter\");\n      }\n      return;\n    case e_request_error:\n      if (reason == r_slots) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" already holds 31 program emergencies\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return;\n    default:\n      put(t, \"internal error in the CANopen slave\");\n      return;\n  }\n}\n\n// Shows a failed request on the block's ERROR, ERRORINFO and ERRORTEXT pins.\ntemplate <class error_pin, class info_pin, class text_pin>\ninline void show(error_pin &error, info_pin &info, text_pin &errortext, const what &w,\n                 const result &r) {\n  text t;\n  uint32_t i = describe(t, w, r);\n  error = r.error ? r.error : static_cast<uint8_t>(e_internal);\n  info = i;\n  errortext = t.buf;\n}\n\n// The size of an object of 1 to 4 bytes in the node's EDS, from the table the editor's build\n// generates (sorted network, node, index, sub-index, size); 0 when it is not listed.\ninline uint32_t eds_size(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex) {\n  const uint64_t key = (static_cast<uint64_t>(network) << 32) | (static_cast<uint64_t>(node) << 24) |\n                       (static_cast<uint64_t>(index) << 8) | subindex;\n  long lo = 0;\n  long hi = static_cast<long>(static_cast<uint32_t>(strucpp::CANOPEN_OBJECT_SIZE_COUNT)) - 1;\n  while (lo <= hi) {\n    long mid = (lo + hi) / 2;\n    uint64_t entry = static_cast<uint64_t>(strucpp::CANOPEN_OBJECT_SIZES[mid]);\n    uint64_t k = entry >> 8;\n    if (k == key) return static_cast<uint32_t>(entry & 0xFF);\n    if (k < key)\n      lo = mid + 1;\n    else\n      hi = mid - 1;\n  }\n  return 0;\n}\n\n// TIME (nanoseconds) to milliseconds; 0 or less: the network's SDO timeout.\ninline uint32_t timeout_ms(long long ns) {\n  if (ns <= 0) return 0;\n  long long ms = (ns + 999999) / 1000000;\n  return ms > 3600000 ? 3600000u : static_cast<uint32_t>(ms);\n}\n\n// One instance's handshake (CiA 405): the block keeps `prev`, `phase` and `handle` in its locals.\nenum { phase_idle = 0, phase_busy = 1, phase_ended = 2 };\nstruct step {\n  bool start;   // rising edge of ENABLE: clear the outputs and start a request\n  bool cancel;  // falling edge while busy: drop the request and clear the outputs\n  bool clear;   // the result was shown and ENABLE is FALSE: clear the outputs\n};\ninline step begin(bool enable, bool &prev, uint8_t &phase) {\n  step s{false, false, false};\n  bool rising = enable && !prev;\n  prev = enable;\n  if (!enable && phase == phase_busy) {\n    s.cancel = true;\n    phase = phase_idle;\n  } else if (!enable && phase == phase_ended) {\n    s.clear = true;\n    phase = phase_idle;\n  }\n  if (rising && phase != phase_busy) s.start = true;\n  return s;\n}\n\n// Starts `req`. Returns the handle, or 0 with `res` saying why it cannot run.\ninline uint64_t start(const request &req, result &res) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why;\n    return 0;\n  }\n  uint64_t handle = t->start(&req, &res);\n  if (!handle && res.error == e_no_error) res.error = e_internal;\n  return handle;\n}\n\n// 0 while the request runs; 1 done, 2 failed (`res` set).\ninline int poll(uint64_t handle, result &res, uint8_t *data, uint32_t cap) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why == r_version ? r_version : r_restart;\n    return 2;\n  }\n  return t->poll(handle, &res, data, cap);\n}\n\ninline void cancel(uint64_t handle) {\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (t) t->cancel(handle);\n}\n\ninline void put_le(uint8_t *out, uint32_t v, unsigned n) {\n  for (unsigned b = 0; b < n; ++b) out[b] = static_cast<uint8_t>(v >> (8 * b));\n}\n\ninline uint32_t get_le(const uint8_t *in, unsigned n) {\n  uint32_t v = 0;\n  for (unsigned b = 0; b < n && b < 4; ++b) v |= static_cast<uint32_t>(in[b]) << (8 * b);\n  return v;\n}\n\n// A failure before any request ran (bad input): `res` for describe().\ninline result fail(uint8_t error, uint8_t reason, uint32_t length) {\n  result r{};\n  r.error = error;\n  r.reason = reason;\n  r.length = length;\n  return r;\n}\n\n}  // namespace canopen_fb\n#endif\nvoid setup() {\n}\n\nvoid loop() {\n  if (!ENABLE) {\n    CONFIRM = false;\n    ERROR = 0;\n    if (cop_last != 0) ERRORTEXT = \"\";\n    cop_last = 0;\n    return;\n  }\n  uint8_t l_why = 0;\n  const canopen_fb::api_v1 *l_api = canopen_fb::api(l_why);\n  int l_error = canopen_fb::e_no_driver;\n  uint8_t l_node = 0;\n  if (l_api) {\n    uint8_t l_id = 0;\n    l_error = l_api->local_node_id(NETWORK, &l_id);\n    if (l_error == canopen_fb::e_no_error) NODEID = l_id;\n  }\n  CONFIRM = l_error == canopen_fb::e_no_error;\n  ERROR = static_cast<uint8_t>(l_error);\n  if (l_error != cop_last) {\n    canopen_fb::result l_res = canopen_fb::fail(static_cast<uint8_t>(l_error), l_api ? 0 : l_why, 0);\n    canopen_fb::text l_text;\n    canopen_fb::clear(l_text);\n    if (l_error != canopen_fb::e_no_error)\n      canopen_fb::describe(l_text, canopen_fb::what_of(NETWORK, l_node, 0, 0, 0, 0), l_res);\n    ERRORTEXT = l_text.buf;\n    cop_last = static_cast<uint8_t>(l_error);\n  }\n}\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "GET_CANOPEN_KERNEL_STATE.cpp",
      "source": "(* Gives the network's bus state, in the same call while ENABLE is TRUE: CANOPEN_KERNEL_NO_ERROR, CANOPEN_KERNEL_ERROR_PASSIVE, CANOPEN_KERNEL_BUS_OFF or CANOPEN_KERNEL_NO_DRIVER (link down or missing). NETWORK counts from 1.\nExample: kernel(ENABLE := TRUE); bus_ok := kernel.STATE = CANOPEN_KERNEL_NO_ERROR; *)\nFUNCTION_BLOCK GET_CANOPEN_KERNEL_STATE\nVAR_INPUT\n  NETWORK : USINT := 1;\n  ENABLE : BOOL;\nEND_VAR\nVAR_OUTPUT\n  CONFIRM : BOOL;\n  ERROR : USINT;\n  ERRORTEXT : STRING;\n  STATE : USINT;\nEND_VAR\nVAR\n  cop_last : USINT;\nEND_VAR\n// SPDX-License-Identifier: Apache-2.0\n//\n// Shared code of the canopen function blocks. The generator copies it into every block's source,\n// because the editor grafts each library C++ block into one c_blocks_code.cpp and has no other\n// place for shared code; the include guard keeps one copy per program.\n//\n// The editor binds every pin and local of a block to a #define of its name, so nothing here uses\n// a pin or local name (those are upper case or start with cop_; this code is lower case), nor the\n// keyword that closes a variable section, and no system header is included after those defines:\n// dlopen, dlsym and dlclose are declared here as glibc declares them.\n//\n// Derived from canworks ec7fd59, library/src/common.inc (Apache-2.0), adapted to the plugin's\n// interface version 3 (core/src/drivers/plugins/native/canopen/plc_api.h in the runtime fork).\n#ifndef CANOPEN_FB_SHARED_INCLUDED\n#define CANOPEN_FB_SHARED_INCLUDED\n#if defined(__linux__)\nextern \"C\" void *dlopen(const char *file, int mode) noexcept(true);\nextern \"C\" void *dlsym(void *handle, const char *name) noexcept(true);\nextern \"C\" int dlclose(void *handle) noexcept(true);\n#else\n// A board's firmware: the slave module's table, when the project has a slave on the board.\nextern \"C\" const void *canopen_plc_api(uint32_t version) __attribute__((weak));\n#endif\n\nnamespace canopen_fb {\n\n// A copy of the plugin's C interface, version 3; keep in step with plc_api.h. Version 1 is asked\n// for, since a newer plugin answers it with its newest table; `size` tells which it is.\nconst uint32_t api_version = 1;\nconst uint32_t max_data = 256;\nenum {\n  e_no_error = 0, e_other_error = 1, e_timeout = 2, e_bus_off = 3, e_error_passive = 4,\n  e_internal = 5, e_wrong_parameter = 6, e_node_id_unknown = 7, e_net_id_unknown = 8,\n  e_request_error = 9, e_no_driver = 10\n};\nenum {\n  r_none = 0, r_booting = 1, r_full = 2, r_not_run = 3, r_restart = 4, r_link = 5,\n  r_too_large = 6, r_length = 7, r_command = 8, r_version = 9,\n  r_not_in_eds = 100,  // the blocks' own: DATALENGTH 0 for an object the EDS does not list\n  r_needs_v2 = 101,    // the blocks' own: the plugin's table lacks the functions the block needs\n  r_reset = 102,       // the blocks' own: a slave NMT block asked for a reset\n  r_own_code = 103,    // the blocks' own: an emergency code the slave sends itself\n  r_slots = 104,       // the blocks' own: all program emergency slots are taken\n  r_object = 105       // the blocks' own: the slave has no such object from the master\n};\nenum { k_read = 0, k_write = 1, k_nmt = 2 };\nstruct request {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint8_t command;\n  uint16_t index;\n  uint8_t subindex;\n  uint8_t reserved;\n  uint32_t timeout_ms;\n  uint32_t length;\n  const uint8_t *data;\n};\nstruct result {\n  uint8_t error;\n  uint8_t reason;\n  uint16_t reserved;\n  uint32_t abort_code;\n  uint32_t length;\n};\nstruct emcy {\n  uint8_t node;\n  uint8_t error_register;\n  uint16_t error_code;\n  uint8_t data[5];\n  uint8_t reserved[3];\n  uint32_t lost;\n};\nstruct api_v1 {\n  uint32_t size;\n  uint32_t version;\n  uint64_t (*start)(const request *req, result *res);\n  int (*poll)(uint64_t handle, result *res, uint8_t *data, uint32_t cap);\n  void (*cancel)(uint64_t handle);\n  int (*node_state)(uint8_t network, uint8_t node, uint8_t *state);\n  int (*kernel_state)(uint8_t network, uint8_t *state);\n  int (*local_node_id)(uint8_t network, uint8_t *node_id);\n  int (*emcy_cursor)(uint8_t network, uint64_t *cursor);\n  int (*emcy_next)(uint8_t network, uint8_t node, uint64_t *cursor, emcy *out);\n  uint32_t flags;  // present when size covers it\n};\n// flags: the plugin is never unmapped, so its table stays valid for the life of the process.\nconst uint32_t flag_permanent = 0x1;\n// node_info::flags\nconst uint8_t node_enabled = 0x01;\nconst uint8_t node_optional = 0x02;\nconst uint8_t node_program_start = 0x04;\nconst uint32_t status_text = 80;\nstruct node_info {\n  uint8_t run_state;\n  uint8_t flags;\n  uint8_t reserved[2];\n  char problem[status_text];\n};\nstruct network_info {\n  uint8_t mandatory_up;\n  uint8_t optional_up;\n  uint8_t configured;\n  uint8_t operational;\n  uint8_t waiting;\n  uint8_t disabled;\n  uint8_t faulty;\n  uint8_t nodes;\n};\nstruct api_v2 {\n  api_v1 v1;\n  int (*node_status)(uint8_t network, uint8_t node, node_info *out);\n  int (*network_status)(uint8_t network, network_info *out);\n  int (*node_enable)(uint8_t network, uint8_t node, uint8_t on);\n};\n// slave_info::flags\nconst uint8_t slave_on_bus = 0x01;\nconst uint8_t slave_master_watched = 0x02;\nconst uint8_t slave_master_seen = 0x04;\nconst uint32_t slave_emcy_slots = 31;\nstruct slave_info {\n  uint8_t state;\n  uint8_t node_id;\n  uint8_t flags;\n  uint8_t bus_state;\n  uint8_t error_register;\n  uint8_t emcy_active;\n  uint8_t reserved[2];\n};\nstruct api_v3 {\n  api_v2 v2;\n  int (*slave_status)(uint8_t slave, slave_info *out);\n  int (*slave_nmt)(uint8_t slave, uint8_t command);\n  int (*slave_nmt_done)(uint8_t slave, uint8_t command, uint8_t *done);\n  int (*slave_emcy_claim)(uint8_t slave, uint32_t *handle);\n  int (*slave_emcy)(uint8_t slave, uint32_t handle, uint8_t active, uint16_t code, uint32_t info);\n  int (*slave_written)(uint8_t slave, uint16_t index, uint8_t subindex, uint32_t *count);\n};\n// After a lookup that found no plugin, this many lookups are skipped before the next one.\nconst uint32_t miss_skip = 1024;\n\n// The loaded plugin's table, or null with `why` set (r_not_run or r_version). The runtime loads\n// the plugin again at each PLC start while this program stays loaded, so a table is kept only\n// when its flags say it stays valid; otherwise it is looked up on each call. While no plugin is\n// found, only one lookup in miss_skip runs; the others answer r_not_run at once.\ninline const api_v1 *lookup_api(uint8_t &why) {\n  const void *table = nullptr;\n  why = r_not_run;\n#if defined(__linux__)\n  void *lib = dlopen(\"libcanopen_plugin.so\", 0x2 | 0x4);  // RTLD_NOW | RTLD_NOLOAD\n  if (!lib) return nullptr;\n  typedef const void *(*entry_t)(uint32_t);\n  entry_t entry = reinterpret_cast<entry_t>(dlsym(lib, \"canopen_plc_api\"));\n  if (entry) {\n    table = entry(api_version);\n    if (!table) why = r_version;\n  }\n  dlclose(lib);\n#else\n  if (canopen_plc_api) {\n    table = canopen_plc_api(api_version);\n    if (!table) why = r_version;\n  }\n#endif\n  const api_v1 *t = static_cast<const api_v1 *>(table);\n  if (t && t->size < __builtin_offsetof(api_v1, flags)) {\n    why = r_version;\n    return nullptr;\n  }\n  return t;\n}\n\ninline bool api_is_permanent(const api_v1 *t) {\n  return t->size >= sizeof(api_v1) && (t->flags & flag_permanent) != 0;\n}\n\ninline const api_v1 *api(uint8_t &why) {\n  static const api_v1 *kept = nullptr;\n  static uint32_t skip = 0;\n  const api_v1 *t = __atomic_load_n(&kept, __ATOMIC_ACQUIRE);\n  if (t) {\n    why = r_not_run;\n    return t;\n  }\n  uint32_t left = __atomic_load_n(&skip, __ATOMIC_RELAXED);\n  if (left > 0) {\n    __atomic_store_n(&skip, left - 1, __ATOMIC_RELAXED);\n    why = r_not_run;\n    return nullptr;\n  }\n  t = lookup_api(why);\n  if (!t) {\n    if (why == r_not_run) __atomic_store_n(&skip, miss_skip, __ATOMIC_RELAXED);\n    return nullptr;\n  }\n  if (api_is_permanent(t)) __atomic_store_n(&kept, t, __ATOMIC_RELEASE);\n  return t;\n}\n\n// The table with the version 2 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v2 *api2(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 2 || t->size < sizeof(api_v2)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v2 *>(static_cast<const void *>(t));\n}\n\n// The table with the version 3 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v3 *api3(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 3 || t->size < sizeof(api_v3)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v3 *>(static_cast<const void *>(t));\n}\n\n// ---- Error text, written into a fixed buffer (no allocation, no libc). ----\nstruct text {\n  char buf[200];\n  unsigned len;\n};\ninline void clear(text &t) {\n  t.len = 0;\n  t.buf[0] = 0;\n}\ninline void put(text &t, const char *s) {\n  while (*s && t.len + 1 < sizeof t.buf) t.buf[t.len++] = *s++;\n  t.buf[t.len] = 0;\n}\ninline void put_dec(text &t, uint32_t v) {\n  char d[12];\n  int n = 0;\n  do {\n    d[n++] = static_cast<char>('0' + v % 10);\n    v /= 10;\n  } while (v && n < 12);\n  while (n > 0 && t.len + 1 < sizeof t.buf) t.buf[t.len++] = d[--n];\n  t.buf[t.len] = 0;\n}\ninline void put_hex(text &t, uint32_t v, int digits) {\n  put(t, \"16#\");\n  for (int i = digits - 1; i >= 0 && t.len + 1 < sizeof t.buf; --i)\n    t.buf[t.len++] = \"0123456789ABCDEF\"[(v >> (4 * i)) & 0xF];\n  t.buf[t.len] = 0;\n}\n\n// CiA 301 SDO abort codes.\ninline const char *abort_text(uint32_t code) {\n  switch (code) {\n    case 0x05030000u: return \"toggle bit not alternated\";\n    case 0x05040000u: return \"SDO protocol timed out\";\n    case 0x05040001u: return \"command specifier not valid or unknown\";\n    case 0x05040002u: return \"invalid block size\";\n    case 0x05040003u: return \"invalid sequence number\";\n    case 0x05040004u: return \"CRC error\";\n    case 0x05040005u: return \"out of memory\";\n    case 0x06010000u: return \"unsupported access to an object\";\n    case 0x06010001u: return \"attempt to read a write only object\";\n    case 0x06010002u: return \"attempt to write a read only object\";\n    case 0x06020000u: return \"object does not exist\";\n    case 0x06040041u: return \"object cannot be mapped to the PDO\";\n    case 0x06040042u: return \"the mapped objects would exceed the PDO length\";\n    case 0x06040043u: return \"general parameter incompatibility\";\n    case 0x06040047u: return \"general internal incompatibility in the device\";\n    case 0x06060000u: return \"access failed due to a hardware error\";\n    case 0x06070010u: return \"data type or length does not match\";\n    case 0x06070012u: return \"data type does not match, length too high\";\n    case 0x06070013u: return \"data type does not match, length too low\";\n    case 0x06090011u: return \"sub-index does not exist\";\n    case 0x06090030u: return \"invalid value for parameter\";\n    case 0x06090031u: return \"value of parameter written too high\";\n    case 0x06090032u: return \"value of parameter written too low\";\n    case 0x06090036u: return \"maximum value is less than minimum value\";\n    case 0x060A0023u: return \"resource not available: SDO connection\";\n    case 0x08000000u: return \"general error\";\n    case 0x08000020u: return \"data cannot be transferred or stored to the application\";\n    case 0x08000021u: return \"data cannot be transferred or stored because of local control\";\n    case 0x08000022u: return \"data cannot be transferred or stored in the present device state\";\n    case 0x08000023u: return \"no object dictionary is present\";\n    case 0x08000024u: return \"no data available\";\n    default: return \"unknown abort code\";\n  }\n}\n\n// What a request was about, for its error text.\nstruct what {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint16_t index;\n  uint8_t subindex;\n  uint32_t timeout_ms;\n  uint32_t capacity;  // bytes the block holds\n};\n\ninline what what_of(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex,\n                    uint32_t timeout_ms, uint32_t capacity) {\n  what w{};\n  w.network = network;\n  w.node = node;\n  w.index = index;\n  w.subindex = subindex;\n  w.timeout_ms = timeout_ms;\n  w.capacity = capacity;\n  return w;\n}\n\ninline void put_node(text &t, const what &w) {\n  if (w.node == 0) {\n    put(t, \"the nodes of network \");\n    put_dec(t, w.network);\n  } else {\n    put(t, \"node \");\n    put_dec(t, w.node);\n  }\n}\n\ninline void put_object(text &t, const what &w) {\n  put_hex(t, w.index, 4);\n  put(t, \" sub \");\n  put_dec(t, w.subindex);\n}\n\n// The error text of a failed request, and its ERRORINFO.\ninline uint32_t describe(text &t, const what &w, const result &r) {\n  clear(t);\n  switch (r.error) {\n    case e_other_error:\n      put_node(t, w);\n      put(t, \" aborted \");\n      put_object(t, w);\n      put(t, \": \");\n      put(t, abort_text(r.abort_code));\n      put(t, \" (\");\n      put_hex(t, r.abort_code, 8);\n      put(t, \")\");\n      return r.abort_code;\n    case e_timeout:\n      put_node(t, w);\n      put(t, \" did not answer\");\n      if (w.timeout_ms) {\n        put(t, \" within \");\n        put_dec(t, w.timeout_ms);\n        put(t, \" ms\");\n      }\n      return r.abort_code ? r.abort_code : 0x05040000u;\n    case e_bus_off:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, r.reason == r_link ? \" link is down\" : \" bus is off\");\n      return 0;\n    case e_error_passive:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" is error passive\");\n      return 0;\n    case e_wrong_parameter:\n      if (r.reason == r_too_large) {\n        put(t, \"object has \");\n        put_dec(t, r.length);\n        put(t, \" bytes, the block holds \");\n        put_dec(t, w.capacity);\n        return r.length;\n      }\n      if (r.reason == r_length) {\n        put(t, \"DATALENGTH \");\n        put_dec(t, r.length);\n        put(t, \" is not 1 to \");\n        put_dec(t, w.capacity);\n        return 0;\n      }\n      if (r.reason == r_not_in_eds) {\n        put_node(t, w);\n        put(t, \" has no object \");\n        put_object(t, w);\n        put(t, \" of 1 to 4 bytes in its EDS; set DATALENGTH\");\n        return 0;\n      }\n      if (r.reason == r_command) {\n        put(t, \"STATE \");\n        put_dec(t, r.length);\n        put(t, \" is not an NMT state change\");\n        return 0;\n      }\n      put(t, \"wrong parameter\");\n      return 0;\n    case e_node_id_unknown:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" has no node \");\n      put_dec(t, w.node);\n      return 0;\n    case e_net_id_unknown:\n      put(t, \"no CANopen network \");\n      put_dec(t, w.network);\n      return 0;\n    case e_request_error:\n      if (r.reason == r_booting) {\n        put_node(t, w);\n        put(t, \" is booting\");\n      } else if (r.reason == r_full) {\n        put(t, \"network \");\n        put_dec(t, w.network);\n        put(t, \" has 16 block requests waiting\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return 0;\n    case e_no_driver:\n      if (r.reason == r_restart)\n        put(t, \"request cancelled by the PLC stop\");\n      else if (r.reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else if (r.reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else\n        put(t, \"no CANopen network runs\");\n      return 0;\n    default:\n      put(t, \"internal error in the CANopen master\");\n      return 0;\n  }\n}\n\n// The error text of a slave block, for `slave` and the object (index, subindex) or ERRORCODE.\ninline void describe_slave(text &t, uint8_t slave, uint8_t error, uint8_t reason, uint16_t index,\n                           uint8_t subindex) {\n  clear(t);\n  switch (error) {\n    case e_no_error:\n      return;\n    case e_net_id_unknown:\n      put(t, \"no CANopen slave \");\n      put_dec(t, slave);\n      return;\n    case e_no_driver:\n      if (reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else if (reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else\n        put(t, \"no CANopen slave runs\");\n      return;\n    case e_wrong_parameter:\n      if (reason == r_reset) {\n        put(t, \"the program cannot reset the slave; STATE must be START_REMOTE_NODE, \");\n        put(t, \"STOP_REMOTE_NODE or ENTER_PRE_OPERATIONAL\");\n      } else if (reason == r_own_code) {\n        put(t, \"ERRORCODE \");\n        put_hex(t, index, 4);\n        put(t, \" is sent by the slave itself; use another code\");\n      } else if (reason == r_object) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" has no object \");\n        put_hex(t, index, 4);\n        put(t, \" sub \");\n        put_dec(t, subindex);\n        put(t, \" written by the master\");\n      } else {\n        put(t, \"wrong parameter\");\n      }\n      return;\n    case e_request_error:\n      if (reason == r_slots) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" already holds 31 program emergencies\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return;\n    default:\n      put(t, \"internal error in the CANopen slave\");\n      return;\n  }\n}\n\n// Shows a failed request on the block's ERROR, ERRORINFO and ERRORTEXT pins.\ntemplate <class error_pin, class info_pin, class text_pin>\ninline void show(error_pin &error, info_pin &info, text_pin &errortext, const what &w,\n                 const result &r) {\n  text t;\n  uint32_t i = describe(t, w, r);\n  error = r.error ? r.error : static_cast<uint8_t>(e_internal);\n  info = i;\n  errortext = t.buf;\n}\n\n// The size of an object of 1 to 4 bytes in the node's EDS, from the table the editor's build\n// generates (sorted network, node, index, sub-index, size); 0 when it is not listed.\ninline uint32_t eds_size(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex) {\n  const uint64_t key = (static_cast<uint64_t>(network) << 32) | (static_cast<uint64_t>(node) << 24) |\n                       (static_cast<uint64_t>(index) << 8) | subindex;\n  long lo = 0;\n  long hi = static_cast<long>(static_cast<uint32_t>(strucpp::CANOPEN_OBJECT_SIZE_COUNT)) - 1;\n  while (lo <= hi) {\n    long mid = (lo + hi) / 2;\n    uint64_t entry = static_cast<uint64_t>(strucpp::CANOPEN_OBJECT_SIZES[mid]);\n    uint64_t k = entry >> 8;\n    if (k == key) return static_cast<uint32_t>(entry & 0xFF);\n    if (k < key)\n      lo = mid + 1;\n    else\n      hi = mid - 1;\n  }\n  return 0;\n}\n\n// TIME (nanoseconds) to milliseconds; 0 or less: the network's SDO timeout.\ninline uint32_t timeout_ms(long long ns) {\n  if (ns <= 0) return 0;\n  long long ms = (ns + 999999) / 1000000;\n  return ms > 3600000 ? 3600000u : static_cast<uint32_t>(ms);\n}\n\n// One instance's handshake (CiA 405): the block keeps `prev`, `phase` and `handle` in its locals.\nenum { phase_idle = 0, phase_busy = 1, phase_ended = 2 };\nstruct step {\n  bool start;   // rising edge of ENABLE: clear the outputs and start a request\n  bool cancel;  // falling edge while busy: drop the request and clear the outputs\n  bool clear;   // the result was shown and ENABLE is FALSE: clear the outputs\n};\ninline step begin(bool enable, bool &prev, uint8_t &phase) {\n  step s{false, false, false};\n  bool rising = enable && !prev;\n  prev = enable;\n  if (!enable && phase == phase_busy) {\n    s.cancel = true;\n    phase = phase_idle;\n  } else if (!enable && phase == phase_ended) {\n    s.clear = true;\n    phase = phase_idle;\n  }\n  if (rising && phase != phase_busy) s.start = true;\n  return s;\n}\n\n// Starts `req`. Returns the handle, or 0 with `res` saying why it cannot run.\ninline uint64_t start(const request &req, result &res) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why;\n    return 0;\n  }\n  uint64_t handle = t->start(&req, &res);\n  if (!handle && res.error == e_no_error) res.error = e_internal;\n  return handle;\n}\n\n// 0 while the request runs; 1 done, 2 failed (`res` set).\ninline int poll(uint64_t handle, result &res, uint8_t *data, uint32_t cap) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why == r_version ? r_version : r_restart;\n    return 2;\n  }\n  return t->poll(handle, &res, data, cap);\n}\n\ninline void cancel(uint64_t handle) {\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (t) t->cancel(handle);\n}\n\ninline void put_le(uint8_t *out, uint32_t v, unsigned n) {\n  for (unsigned b = 0; b < n; ++b) out[b] = static_cast<uint8_t>(v >> (8 * b));\n}\n\ninline uint32_t get_le(const uint8_t *in, unsigned n) {\n  uint32_t v = 0;\n  for (unsigned b = 0; b < n && b < 4; ++b) v |= static_cast<uint32_t>(in[b]) << (8 * b);\n  return v;\n}\n\n// A failure before any request ran (bad input): `res` for describe().\ninline result fail(uint8_t error, uint8_t reason, uint32_t length) {\n  result r{};\n  r.error = error;\n  r.reason = reason;\n  r.length = length;\n  return r;\n}\n\n}  // namespace canopen_fb\n#endif\nvoid setup() {\n}\n\nvoid loop() {\n  if (!ENABLE) {\n    CONFIRM = false;\n    ERROR = 0;\n    if (cop_last != 0) ERRORTEXT = \"\";\n    cop_last = 0;\n    return;\n  }\n  uint8_t l_why = 0;\n  const canopen_fb::api_v1 *l_api = canopen_fb::api(l_why);\n  int l_error = canopen_fb::e_no_driver;\n  uint8_t l_node = 0;\n  if (l_api) {\n    uint8_t l_state = 0;\n    l_error = l_api->kernel_state(NETWORK, &l_state);\n    if (l_error == canopen_fb::e_no_error) STATE = l_state;\n  }\n  CONFIRM = l_error == canopen_fb::e_no_error;\n  ERROR = static_cast<uint8_t>(l_error);\n  if (l_error != cop_last) {\n    canopen_fb::result l_res = canopen_fb::fail(static_cast<uint8_t>(l_error), l_api ? 0 : l_why, 0);\n    canopen_fb::text l_text;\n    canopen_fb::clear(l_text);\n    if (l_error != canopen_fb::e_no_error)\n      canopen_fb::describe(l_text, canopen_fb::what_of(NETWORK, l_node, 0, 0, 0, 0), l_res);\n    ERRORTEXT = l_text.buf;\n    cop_last = static_cast<uint8_t>(l_error);\n  }\n}\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "RECV_EMCY.cpp",
      "source": "(* Returns the network's emergency messages one per call while ENABLE is TRUE, oldest first: CONFIRM is TRUE in a call that returns one, with the sender in DEVICE and the message in EMCY. Messages from before the instance's first call are skipped; each instance has its own position. NETWORK counts from 1.\nExample: emcy(ENABLE := TRUE); IF emcy.CONFIRM THEN last_code := emcy.EMCY.ERRORCODE; END_IF; *)\nFUNCTION_BLOCK RECV_EMCY\nVAR_INPUT\n  NETWORK : USINT := 1;\n  ENABLE : BOOL;\nEND_VAR\nVAR_OUTPUT\n  CONFIRM : BOOL;\n  ERROR : USINT;\n  ERRORTEXT : STRING;\n  DEVICE : USINT;\n  EMCY : EMCY_ERROR;\nEND_VAR\nVAR\n  cop_started : BOOL;\n  cop_cursor : ULINT;\n  cop_net : USINT;\n  cop_last : USINT;\nEND_VAR\n// SPDX-License-Identifier: Apache-2.0\n//\n// Shared code of the canopen function blocks. The generator copies it into every block's source,\n// because the editor grafts each library C++ block into one c_blocks_code.cpp and has no other\n// place for shared code; the include guard keeps one copy per program.\n//\n// The editor binds every pin and local of a block to a #define of its name, so nothing here uses\n// a pin or local name (those are upper case or start with cop_; this code is lower case), nor the\n// keyword that closes a variable section, and no system header is included after those defines:\n// dlopen, dlsym and dlclose are declared here as glibc declares them.\n//\n// Derived from canworks ec7fd59, library/src/common.inc (Apache-2.0), adapted to the plugin's\n// interface version 3 (core/src/drivers/plugins/native/canopen/plc_api.h in the runtime fork).\n#ifndef CANOPEN_FB_SHARED_INCLUDED\n#define CANOPEN_FB_SHARED_INCLUDED\n#if defined(__linux__)\nextern \"C\" void *dlopen(const char *file, int mode) noexcept(true);\nextern \"C\" void *dlsym(void *handle, const char *name) noexcept(true);\nextern \"C\" int dlclose(void *handle) noexcept(true);\n#else\n// A board's firmware: the slave module's table, when the project has a slave on the board.\nextern \"C\" const void *canopen_plc_api(uint32_t version) __attribute__((weak));\n#endif\n\nnamespace canopen_fb {\n\n// A copy of the plugin's C interface, version 3; keep in step with plc_api.h. Version 1 is asked\n// for, since a newer plugin answers it with its newest table; `size` tells which it is.\nconst uint32_t api_version = 1;\nconst uint32_t max_data = 256;\nenum {\n  e_no_error = 0, e_other_error = 1, e_timeout = 2, e_bus_off = 3, e_error_passive = 4,\n  e_internal = 5, e_wrong_parameter = 6, e_node_id_unknown = 7, e_net_id_unknown = 8,\n  e_request_error = 9, e_no_driver = 10\n};\nenum {\n  r_none = 0, r_booting = 1, r_full = 2, r_not_run = 3, r_restart = 4, r_link = 5,\n  r_too_large = 6, r_length = 7, r_command = 8, r_version = 9,\n  r_not_in_eds = 100,  // the blocks' own: DATALENGTH 0 for an object the EDS does not list\n  r_needs_v2 = 101,    // the blocks' own: the plugin's table lacks the functions the block needs\n  r_reset = 102,       // the blocks' own: a slave NMT block asked for a reset\n  r_own_code = 103,    // the blocks' own: an emergency code the slave sends itself\n  r_slots = 104,       // the blocks' own: all program emergency slots are taken\n  r_object = 105       // the blocks' own: the slave has no such object from the master\n};\nenum { k_read = 0, k_write = 1, k_nmt = 2 };\nstruct request {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint8_t command;\n  uint16_t index;\n  uint8_t subindex;\n  uint8_t reserved;\n  uint32_t timeout_ms;\n  uint32_t length;\n  const uint8_t *data;\n};\nstruct result {\n  uint8_t error;\n  uint8_t reason;\n  uint16_t reserved;\n  uint32_t abort_code;\n  uint32_t length;\n};\nstruct emcy {\n  uint8_t node;\n  uint8_t error_register;\n  uint16_t error_code;\n  uint8_t data[5];\n  uint8_t reserved[3];\n  uint32_t lost;\n};\nstruct api_v1 {\n  uint32_t size;\n  uint32_t version;\n  uint64_t (*start)(const request *req, result *res);\n  int (*poll)(uint64_t handle, result *res, uint8_t *data, uint32_t cap);\n  void (*cancel)(uint64_t handle);\n  int (*node_state)(uint8_t network, uint8_t node, uint8_t *state);\n  int (*kernel_state)(uint8_t network, uint8_t *state);\n  int (*local_node_id)(uint8_t network, uint8_t *node_id);\n  int (*emcy_cursor)(uint8_t network, uint64_t *cursor);\n  int (*emcy_next)(uint8_t network, uint8_t node, uint64_t *cursor, emcy *out);\n  uint32_t flags;  // present when size covers it\n};\n// flags: the plugin is never unmapped, so its table stays valid for the life of the process.\nconst uint32_t flag_permanent = 0x1;\n// node_info::flags\nconst uint8_t node_enabled = 0x01;\nconst uint8_t node_optional = 0x02;\nconst uint8_t node_program_start = 0x04;\nconst uint32_t status_text = 80;\nstruct node_info {\n  uint8_t run_state;\n  uint8_t flags;\n  uint8_t reserved[2];\n  char problem[status_text];\n};\nstruct network_info {\n  uint8_t mandatory_up;\n  uint8_t optional_up;\n  uint8_t configured;\n  uint8_t operational;\n  uint8_t waiting;\n  uint8_t disabled;\n  uint8_t faulty;\n  uint8_t nodes;\n};\nstruct api_v2 {\n  api_v1 v1;\n  int (*node_status)(uint8_t network, uint8_t node, node_info *out);\n  int (*network_status)(uint8_t network, network_info *out);\n  int (*node_enable)(uint8_t network, uint8_t node, uint8_t on);\n};\n// slave_info::flags\nconst uint8_t slave_on_bus = 0x01;\nconst uint8_t slave_master_watched = 0x02;\nconst uint8_t slave_master_seen = 0x04;\nconst uint32_t slave_emcy_slots = 31;\nstruct slave_info {\n  uint8_t state;\n  uint8_t node_id;\n  uint8_t flags;\n  uint8_t bus_state;\n  uint8_t error_register;\n  uint8_t emcy_active;\n  uint8_t reserved[2];\n};\nstruct api_v3 {\n  api_v2 v2;\n  int (*slave_status)(uint8_t slave, slave_info *out);\n  int (*slave_nmt)(uint8_t slave, uint8_t command);\n  int (*slave_nmt_done)(uint8_t slave, uint8_t command, uint8_t *done);\n  int (*slave_emcy_claim)(uint8_t slave, uint32_t *handle);\n  int (*slave_emcy)(uint8_t slave, uint32_t handle, uint8_t active, uint16_t code, uint32_t info);\n  int (*slave_written)(uint8_t slave, uint16_t index, uint8_t subindex, uint32_t *count);\n};\n// After a lookup that found no plugin, this many lookups are skipped before the next one.\nconst uint32_t miss_skip = 1024;\n\n// The loaded plugin's table, or null with `why` set (r_not_run or r_version). The runtime loads\n// the plugin again at each PLC start while this program stays loaded, so a table is kept only\n// when its flags say it stays valid; otherwise it is looked up on each call. While no plugin is\n// found, only one lookup in miss_skip runs; the others answer r_not_run at once.\ninline const api_v1 *lookup_api(uint8_t &why) {\n  const void *table = nullptr;\n  why = r_not_run;\n#if defined(__linux__)\n  void *lib = dlopen(\"libcanopen_plugin.so\", 0x2 | 0x4);  // RTLD_NOW | RTLD_NOLOAD\n  if (!lib) return nullptr;\n  typedef const void *(*entry_t)(uint32_t);\n  entry_t entry = reinterpret_cast<entry_t>(dlsym(lib, \"canopen_plc_api\"));\n  if (entry) {\n    table = entry(api_version);\n    if (!table) why = r_version;\n  }\n  dlclose(lib);\n#else\n  if (canopen_plc_api) {\n    table = canopen_plc_api(api_version);\n    if (!table) why = r_version;\n  }\n#endif\n  const api_v1 *t = static_cast<const api_v1 *>(table);\n  if (t && t->size < __builtin_offsetof(api_v1, flags)) {\n    why = r_version;\n    return nullptr;\n  }\n  return t;\n}\n\ninline bool api_is_permanent(const api_v1 *t) {\n  return t->size >= sizeof(api_v1) && (t->flags & flag_permanent) != 0;\n}\n\ninline const api_v1 *api(uint8_t &why) {\n  static const api_v1 *kept = nullptr;\n  static uint32_t skip = 0;\n  const api_v1 *t = __atomic_load_n(&kept, __ATOMIC_ACQUIRE);\n  if (t) {\n    why = r_not_run;\n    return t;\n  }\n  uint32_t left = __atomic_load_n(&skip, __ATOMIC_RELAXED);\n  if (left > 0) {\n    __atomic_store_n(&skip, left - 1, __ATOMIC_RELAXED);\n    why = r_not_run;\n    return nullptr;\n  }\n  t = lookup_api(why);\n  if (!t) {\n    if (why == r_not_run) __atomic_store_n(&skip, miss_skip, __ATOMIC_RELAXED);\n    return nullptr;\n  }\n  if (api_is_permanent(t)) __atomic_store_n(&kept, t, __ATOMIC_RELEASE);\n  return t;\n}\n\n// The table with the version 2 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v2 *api2(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 2 || t->size < sizeof(api_v2)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v2 *>(static_cast<const void *>(t));\n}\n\n// The table with the version 3 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v3 *api3(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 3 || t->size < sizeof(api_v3)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v3 *>(static_cast<const void *>(t));\n}\n\n// ---- Error text, written into a fixed buffer (no allocation, no libc). ----\nstruct text {\n  char buf[200];\n  unsigned len;\n};\ninline void clear(text &t) {\n  t.len = 0;\n  t.buf[0] = 0;\n}\ninline void put(text &t, const char *s) {\n  while (*s && t.len + 1 < sizeof t.buf) t.buf[t.len++] = *s++;\n  t.buf[t.len] = 0;\n}\ninline void put_dec(text &t, uint32_t v) {\n  char d[12];\n  int n = 0;\n  do {\n    d[n++] = static_cast<char>('0' + v % 10);\n    v /= 10;\n  } while (v && n < 12);\n  while (n > 0 && t.len + 1 < sizeof t.buf) t.buf[t.len++] = d[--n];\n  t.buf[t.len] = 0;\n}\ninline void put_hex(text &t, uint32_t v, int digits) {\n  put(t, \"16#\");\n  for (int i = digits - 1; i >= 0 && t.len + 1 < sizeof t.buf; --i)\n    t.buf[t.len++] = \"0123456789ABCDEF\"[(v >> (4 * i)) & 0xF];\n  t.buf[t.len] = 0;\n}\n\n// CiA 301 SDO abort codes.\ninline const char *abort_text(uint32_t code) {\n  switch (code) {\n    case 0x05030000u: return \"toggle bit not alternated\";\n    case 0x05040000u: return \"SDO protocol timed out\";\n    case 0x05040001u: return \"command specifier not valid or unknown\";\n    case 0x05040002u: return \"invalid block size\";\n    case 0x05040003u: return \"invalid sequence number\";\n    case 0x05040004u: return \"CRC error\";\n    case 0x05040005u: return \"out of memory\";\n    case 0x06010000u: return \"unsupported access to an object\";\n    case 0x06010001u: return \"attempt to read a write only object\";\n    case 0x06010002u: return \"attempt to write a read only object\";\n    case 0x06020000u: return \"object does not exist\";\n    case 0x06040041u: return \"object cannot be mapped to the PDO\";\n    case 0x06040042u: return \"the mapped objects would exceed the PDO length\";\n    case 0x06040043u: return \"general parameter incompatibility\";\n    case 0x06040047u: return \"general internal incompatibility in the device\";\n    case 0x06060000u: return \"access failed due to a hardware error\";\n    case 0x06070010u: return \"data type or length does not match\";\n    case 0x06070012u: return \"data type does not match, length too high\";\n    case 0x06070013u: return \"data type does not match, length too low\";\n    case 0x06090011u: return \"sub-index does not exist\";\n    case 0x06090030u: return \"invalid value for parameter\";\n    case 0x06090031u: return \"value of parameter written too high\";\n    case 0x06090032u: return \"value of parameter written too low\";\n    case 0x06090036u: return \"maximum value is less than minimum value\";\n    case 0x060A0023u: return \"resource not available: SDO connection\";\n    case 0x08000000u: return \"general error\";\n    case 0x08000020u: return \"data cannot be transferred or stored to the application\";\n    case 0x08000021u: return \"data cannot be transferred or stored because of local control\";\n    case 0x08000022u: return \"data cannot be transferred or stored in the present device state\";\n    case 0x08000023u: return \"no object dictionary is present\";\n    case 0x08000024u: return \"no data available\";\n    default: return \"unknown abort code\";\n  }\n}\n\n// What a request was about, for its error text.\nstruct what {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint16_t index;\n  uint8_t subindex;\n  uint32_t timeout_ms;\n  uint32_t capacity;  // bytes the block holds\n};\n\ninline what what_of(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex,\n                    uint32_t timeout_ms, uint32_t capacity) {\n  what w{};\n  w.network = network;\n  w.node = node;\n  w.index = index;\n  w.subindex = subindex;\n  w.timeout_ms = timeout_ms;\n  w.capacity = capacity;\n  return w;\n}\n\ninline void put_node(text &t, const what &w) {\n  if (w.node == 0) {\n    put(t, \"the nodes of network \");\n    put_dec(t, w.network);\n  } else {\n    put(t, \"node \");\n    put_dec(t, w.node);\n  }\n}\n\ninline void put_object(text &t, const what &w) {\n  put_hex(t, w.index, 4);\n  put(t, \" sub \");\n  put_dec(t, w.subindex);\n}\n\n// The error text of a failed request, and its ERRORINFO.\ninline uint32_t describe(text &t, const what &w, const result &r) {\n  clear(t);\n  switch (r.error) {\n    case e_other_error:\n      put_node(t, w);\n      put(t, \" aborted \");\n      put_object(t, w);\n      put(t, \": \");\n      put(t, abort_text(r.abort_code));\n      put(t, \" (\");\n      put_hex(t, r.abort_code, 8);\n      put(t, \")\");\n      return r.abort_code;\n    case e_timeout:\n      put_node(t, w);\n      put(t, \" did not answer\");\n      if (w.timeout_ms) {\n        put(t, \" within \");\n        put_dec(t, w.timeout_ms);\n        put(t, \" ms\");\n      }\n      return r.abort_code ? r.abort_code : 0x05040000u;\n    case e_bus_off:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, r.reason == r_link ? \" link is down\" : \" bus is off\");\n      return 0;\n    case e_error_passive:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" is error passive\");\n      return 0;\n    case e_wrong_parameter:\n      if (r.reason == r_too_large) {\n        put(t, \"object has \");\n        put_dec(t, r.length);\n        put(t, \" bytes, the block holds \");\n        put_dec(t, w.capacity);\n        return r.length;\n      }\n      if (r.reason == r_length) {\n        put(t, \"DATALENGTH \");\n        put_dec(t, r.length);\n        put(t, \" is not 1 to \");\n        put_dec(t, w.capacity);\n        return 0;\n      }\n      if (r.reason == r_not_in_eds) {\n        put_node(t, w);\n        put(t, \" has no object \");\n        put_object(t, w);\n        put(t, \" of 1 to 4 bytes in its EDS; set DATALENGTH\");\n        return 0;\n      }\n      if (r.reason == r_command) {\n        put(t, \"STATE \");\n        put_dec(t, r.length);\n        put(t, \" is not an NMT state change\");\n        return 0;\n      }\n      put(t, \"wrong parameter\");\n      return 0;\n    case e_node_id_unknown:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" has no node \");\n      put_dec(t, w.node);\n      return 0;\n    case e_net_id_unknown:\n      put(t, \"no CANopen network \");\n      put_dec(t, w.network);\n      return 0;\n    case e_request_error:\n      if (r.reason == r_booting) {\n        put_node(t, w);\n        put(t, \" is booting\");\n      } else if (r.reason == r_full) {\n        put(t, \"network \");\n        put_dec(t, w.network);\n        put(t, \" has 16 block requests waiting\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return 0;\n    case e_no_driver:\n      if (r.reason == r_restart)\n        put(t, \"request cancelled by the PLC stop\");\n      else if (r.reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else if (r.reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else\n        put(t, \"no CANopen network runs\");\n      return 0;\n    default:\n      put(t, \"internal error in the CANopen master\");\n      return 0;\n  }\n}\n\n// The error text of a slave block, for `slave` and the object (index, subindex) or ERRORCODE.\ninline void describe_slave(text &t, uint8_t slave, uint8_t error, uint8_t reason, uint16_t index,\n                           uint8_t subindex) {\n  clear(t);\n  switch (error) {\n    case e_no_error:\n      return;\n    case e_net_id_unknown:\n      put(t, \"no CANopen slave \");\n      put_dec(t, slave);\n      return;\n    case e_no_driver:\n      if (reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else if (reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else\n        put(t, \"no CANopen slave runs\");\n      return;\n    case e_wrong_parameter:\n      if (reason == r_reset) {\n        put(t, \"the program cannot reset the slave; STATE must be START_REMOTE_NODE, \");\n        put(t, \"STOP_REMOTE_NODE or ENTER_PRE_OPERATIONAL\");\n      } else if (reason == r_own_code) {\n        put(t, \"ERRORCODE \");\n        put_hex(t, index, 4);\n        put(t, \" is sent by the slave itself; use another code\");\n      } else if (reason == r_object) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" has no object \");\n        put_hex(t, index, 4);\n        put(t, \" sub \");\n        put_dec(t, subindex);\n        put(t, \" written by the master\");\n      } else {\n        put(t, \"wrong parameter\");\n      }\n      return;\n    case e_request_error:\n      if (reason == r_slots) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" already holds 31 program emergencies\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return;\n    default:\n      put(t, \"internal error in the CANopen slave\");\n      return;\n  }\n}\n\n// Shows a failed request on the block's ERROR, ERRORINFO and ERRORTEXT pins.\ntemplate <class error_pin, class info_pin, class text_pin>\ninline void show(error_pin &error, info_pin &info, text_pin &errortext, const what &w,\n                 const result &r) {\n  text t;\n  uint32_t i = describe(t, w, r);\n  error = r.error ? r.error : static_cast<uint8_t>(e_internal);\n  info = i;\n  errortext = t.buf;\n}\n\n// The size of an object of 1 to 4 bytes in the node's EDS, from the table the editor's build\n// generates (sorted network, node, index, sub-index, size); 0 when it is not listed.\ninline uint32_t eds_size(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex) {\n  const uint64_t key = (static_cast<uint64_t>(network) << 32) | (static_cast<uint64_t>(node) << 24) |\n                       (static_cast<uint64_t>(index) << 8) | subindex;\n  long lo = 0;\n  long hi = static_cast<long>(static_cast<uint32_t>(strucpp::CANOPEN_OBJECT_SIZE_COUNT)) - 1;\n  while (lo <= hi) {\n    long mid = (lo + hi) / 2;\n    uint64_t entry = static_cast<uint64_t>(strucpp::CANOPEN_OBJECT_SIZES[mid]);\n    uint64_t k = entry >> 8;\n    if (k == key) return static_cast<uint32_t>(entry & 0xFF);\n    if (k < key)\n      lo = mid + 1;\n    else\n      hi = mid - 1;\n  }\n  return 0;\n}\n\n// TIME (nanoseconds) to milliseconds; 0 or less: the network's SDO timeout.\ninline uint32_t timeout_ms(long long ns) {\n  if (ns <= 0) return 0;\n  long long ms = (ns + 999999) / 1000000;\n  return ms > 3600000 ? 3600000u : static_cast<uint32_t>(ms);\n}\n\n// One instance's handshake (CiA 405): the block keeps `prev`, `phase` and `handle` in its locals.\nenum { phase_idle = 0, phase_busy = 1, phase_ended = 2 };\nstruct step {\n  bool start;   // rising edge of ENABLE: clear the outputs and start a request\n  bool cancel;  // falling edge while busy: drop the request and clear the outputs\n  bool clear;   // the result was shown and ENABLE is FALSE: clear the outputs\n};\ninline step begin(bool enable, bool &prev, uint8_t &phase) {\n  step s{false, false, false};\n  bool rising = enable && !prev;\n  prev = enable;\n  if (!enable && phase == phase_busy) {\n    s.cancel = true;\n    phase = phase_idle;\n  } else if (!enable && phase == phase_ended) {\n    s.clear = true;\n    phase = phase_idle;\n  }\n  if (rising && phase != phase_busy) s.start = true;\n  return s;\n}\n\n// Starts `req`. Returns the handle, or 0 with `res` saying why it cannot run.\ninline uint64_t start(const request &req, result &res) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why;\n    return 0;\n  }\n  uint64_t handle = t->start(&req, &res);\n  if (!handle && res.error == e_no_error) res.error = e_internal;\n  return handle;\n}\n\n// 0 while the request runs; 1 done, 2 failed (`res` set).\ninline int poll(uint64_t handle, result &res, uint8_t *data, uint32_t cap) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why == r_version ? r_version : r_restart;\n    return 2;\n  }\n  return t->poll(handle, &res, data, cap);\n}\n\ninline void cancel(uint64_t handle) {\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (t) t->cancel(handle);\n}\n\ninline void put_le(uint8_t *out, uint32_t v, unsigned n) {\n  for (unsigned b = 0; b < n; ++b) out[b] = static_cast<uint8_t>(v >> (8 * b));\n}\n\ninline uint32_t get_le(const uint8_t *in, unsigned n) {\n  uint32_t v = 0;\n  for (unsigned b = 0; b < n && b < 4; ++b) v |= static_cast<uint32_t>(in[b]) << (8 * b);\n  return v;\n}\n\n// A failure before any request ran (bad input): `res` for describe().\ninline result fail(uint8_t error, uint8_t reason, uint32_t length) {\n  result r{};\n  r.error = error;\n  r.reason = reason;\n  r.length = length;\n  return r;\n}\n\n}  // namespace canopen_fb\n#endif\nvoid setup() {\n}\n\nvoid loop() {\n  CONFIRM = false;\n  if (!ENABLE) {\n    ERROR = 0;\n    if (cop_last != 0) ERRORTEXT = \"\";\n    cop_last = 0;\n    return;\n  }\n  uint8_t l_why = 0;\n  const canopen_fb::api_v1 *l_api = canopen_fb::api(l_why);\n  int l_error = canopen_fb::e_no_driver;\n  uint8_t l_net = NETWORK;\n  uint8_t l_node = 0;\n  bool l_lost = false;\n  uint32_t l_lost_count = 0;\n  if (l_api) {\n    uint64_t l_cursor = cop_cursor;\n    l_error = canopen_fb::e_no_error;\n    if (!cop_started || cop_net != l_net) {\n      l_error = l_api->emcy_cursor(l_net, &l_cursor);\n      if (l_error == canopen_fb::e_no_error) {\n        cop_started = true;\n        cop_net = l_net;\n      }\n    }\n    if (l_error == canopen_fb::e_no_error) {\n      canopen_fb::emcy l_msg = {};\n      int l_got = l_api->emcy_next(l_net, l_node, &l_cursor, &l_msg);\n      if (l_got < 0) {\n        l_error = -l_got;\n      } else if (l_got == 1) {\n        CONFIRM = true;\n        DEVICE = l_msg.node;\n        EMCY.ERRORCODE = l_msg.error_code;\n        EMCY.ERRORREGISTER = l_msg.error_register;\n        for (int l_i = 0; l_i < 5; ++l_i) EMCY.MANUFACTURERERROR[l_i] = l_msg.data[l_i];\n        if (l_msg.lost) {\n          l_lost = true;\n          l_lost_count = l_msg.lost;\n        }\n      }\n      cop_cursor = l_cursor;\n    }\n  }\n  ERROR = static_cast<uint8_t>(l_error);\n  if (l_lost) {\n    canopen_fb::text l_text;\n    canopen_fb::clear(l_text);\n    canopen_fb::put_dec(l_text, l_lost_count);\n    canopen_fb::put(l_text, \" emergency messages were lost before this one\");\n    ERRORTEXT = l_text.buf;\n    cop_last = 0xFF;\n  } else if (l_error != cop_last && (l_error != canopen_fb::e_no_error || cop_last != 0xFF)) {\n    canopen_fb::result l_res = canopen_fb::fail(static_cast<uint8_t>(l_error), l_api ? 0 : l_why, 0);\n    canopen_fb::text l_text;\n    canopen_fb::clear(l_text);\n    if (l_error != canopen_fb::e_no_error)\n      canopen_fb::describe(l_text, canopen_fb::what_of(l_net, l_node, 0, 0, 0, 0), l_res);\n    ERRORTEXT = l_text.buf;\n    cop_last = static_cast<uint8_t>(l_error);\n  }\n}\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "RECV_EMCY_DEV.cpp",
      "source": "(* Returns one node's emergency messages one per call while ENABLE is TRUE, oldest first: CONFIRM is TRUE in a call that returns one, with the message in EMCY. Messages from before the instance's first call are skipped; each instance has its own position. NETWORK counts from 1; DEVICE is the node ID or its name.\nExample: emcy(ENABLE := TRUE, DEVICE := IO_Module); IF emcy.CONFIRM AND emcy.EMCY.ERRORCODE <> 0 THEN alarm := TRUE; END_IF; *)\nFUNCTION_BLOCK RECV_EMCY_DEV\nVAR_INPUT\n  NETWORK : USINT := 1;\n  ENABLE : BOOL;\n  DEVICE : USINT;\nEND_VAR\nVAR_OUTPUT\n  CONFIRM : BOOL;\n  ERROR : USINT;\n  ERRORTEXT : STRING;\n  EMCY : EMCY_ERROR;\nEND_VAR\nVAR\n  cop_started : BOOL;\n  cop_cursor : ULINT;\n  cop_net : USINT;\n  cop_last : USINT;\nEND_VAR\n// SPDX-License-Identifier: Apache-2.0\n//\n// Shared code of the canopen function blocks. The generator copies it into every block's source,\n// because the editor grafts each library C++ block into one c_blocks_code.cpp and has no other\n// place for shared code; the include guard keeps one copy per program.\n//\n// The editor binds every pin and local of a block to a #define of its name, so nothing here uses\n// a pin or local name (those are upper case or start with cop_; this code is lower case), nor the\n// keyword that closes a variable section, and no system header is included after those defines:\n// dlopen, dlsym and dlclose are declared here as glibc declares them.\n//\n// Derived from canworks ec7fd59, library/src/common.inc (Apache-2.0), adapted to the plugin's\n// interface version 3 (core/src/drivers/plugins/native/canopen/plc_api.h in the runtime fork).\n#ifndef CANOPEN_FB_SHARED_INCLUDED\n#define CANOPEN_FB_SHARED_INCLUDED\n#if defined(__linux__)\nextern \"C\" void *dlopen(const char *file, int mode) noexcept(true);\nextern \"C\" void *dlsym(void *handle, const char *name) noexcept(true);\nextern \"C\" int dlclose(void *handle) noexcept(true);\n#else\n// A board's firmware: the slave module's table, when the project has a slave on the board.\nextern \"C\" const void *canopen_plc_api(uint32_t version) __attribute__((weak));\n#endif\n\nnamespace canopen_fb {\n\n// A copy of the plugin's C interface, version 3; keep in step with plc_api.h. Version 1 is asked\n// for, since a newer plugin answers it with its newest table; `size` tells which it is.\nconst uint32_t api_version = 1;\nconst uint32_t max_data = 256;\nenum {\n  e_no_error = 0, e_other_error = 1, e_timeout = 2, e_bus_off = 3, e_error_passive = 4,\n  e_internal = 5, e_wrong_parameter = 6, e_node_id_unknown = 7, e_net_id_unknown = 8,\n  e_request_error = 9, e_no_driver = 10\n};\nenum {\n  r_none = 0, r_booting = 1, r_full = 2, r_not_run = 3, r_restart = 4, r_link = 5,\n  r_too_large = 6, r_length = 7, r_command = 8, r_version = 9,\n  r_not_in_eds = 100,  // the blocks' own: DATALENGTH 0 for an object the EDS does not list\n  r_needs_v2 = 101,    // the blocks' own: the plugin's table lacks the functions the block needs\n  r_reset = 102,       // the blocks' own: a slave NMT block asked for a reset\n  r_own_code = 103,    // the blocks' own: an emergency code the slave sends itself\n  r_slots = 104,       // the blocks' own: all program emergency slots are taken\n  r_object = 105       // the blocks' own: the slave has no such object from the master\n};\nenum { k_read = 0, k_write = 1, k_nmt = 2 };\nstruct request {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint8_t command;\n  uint16_t index;\n  uint8_t subindex;\n  uint8_t reserved;\n  uint32_t timeout_ms;\n  uint32_t length;\n  const uint8_t *data;\n};\nstruct result {\n  uint8_t error;\n  uint8_t reason;\n  uint16_t reserved;\n  uint32_t abort_code;\n  uint32_t length;\n};\nstruct emcy {\n  uint8_t node;\n  uint8_t error_register;\n  uint16_t error_code;\n  uint8_t data[5];\n  uint8_t reserved[3];\n  uint32_t lost;\n};\nstruct api_v1 {\n  uint32_t size;\n  uint32_t version;\n  uint64_t (*start)(const request *req, result *res);\n  int (*poll)(uint64_t handle, result *res, uint8_t *data, uint32_t cap);\n  void (*cancel)(uint64_t handle);\n  int (*node_state)(uint8_t network, uint8_t node, uint8_t *state);\n  int (*kernel_state)(uint8_t network, uint8_t *state);\n  int (*local_node_id)(uint8_t network, uint8_t *node_id);\n  int (*emcy_cursor)(uint8_t network, uint64_t *cursor);\n  int (*emcy_next)(uint8_t network, uint8_t node, uint64_t *cursor, emcy *out);\n  uint32_t flags;  // present when size covers it\n};\n// flags: the plugin is never unmapped, so its table stays valid for the life of the process.\nconst uint32_t flag_permanent = 0x1;\n// node_info::flags\nconst uint8_t node_enabled = 0x01;\nconst uint8_t node_optional = 0x02;\nconst uint8_t node_program_start = 0x04;\nconst uint32_t status_text = 80;\nstruct node_info {\n  uint8_t run_state;\n  uint8_t flags;\n  uint8_t reserved[2];\n  char problem[status_text];\n};\nstruct network_info {\n  uint8_t mandatory_up;\n  uint8_t optional_up;\n  uint8_t configured;\n  uint8_t operational;\n  uint8_t waiting;\n  uint8_t disabled;\n  uint8_t faulty;\n  uint8_t nodes;\n};\nstruct api_v2 {\n  api_v1 v1;\n  int (*node_status)(uint8_t network, uint8_t node, node_info *out);\n  int (*network_status)(uint8_t network, network_info *out);\n  int (*node_enable)(uint8_t network, uint8_t node, uint8_t on);\n};\n// slave_info::flags\nconst uint8_t slave_on_bus = 0x01;\nconst uint8_t slave_master_watched = 0x02;\nconst uint8_t slave_master_seen = 0x04;\nconst uint32_t slave_emcy_slots = 31;\nstruct slave_info {\n  uint8_t state;\n  uint8_t node_id;\n  uint8_t flags;\n  uint8_t bus_state;\n  uint8_t error_register;\n  uint8_t emcy_active;\n  uint8_t reserved[2];\n};\nstruct api_v3 {\n  api_v2 v2;\n  int (*slave_status)(uint8_t slave, slave_info *out);\n  int (*slave_nmt)(uint8_t slave, uint8_t command);\n  int (*slave_nmt_done)(uint8_t slave, uint8_t command, uint8_t *done);\n  int (*slave_emcy_claim)(uint8_t slave, uint32_t *handle);\n  int (*slave_emcy)(uint8_t slave, uint32_t handle, uint8_t active, uint16_t code, uint32_t info);\n  int (*slave_written)(uint8_t slave, uint16_t index, uint8_t subindex, uint32_t *count);\n};\n// After a lookup that found no plugin, this many lookups are skipped before the next one.\nconst uint32_t miss_skip = 1024;\n\n// The loaded plugin's table, or null with `why` set (r_not_run or r_version). The runtime loads\n// the plugin again at each PLC start while this program stays loaded, so a table is kept only\n// when its flags say it stays valid; otherwise it is looked up on each call. While no plugin is\n// found, only one lookup in miss_skip runs; the others answer r_not_run at once.\ninline const api_v1 *lookup_api(uint8_t &why) {\n  const void *table = nullptr;\n  why = r_not_run;\n#if defined(__linux__)\n  void *lib = dlopen(\"libcanopen_plugin.so\", 0x2 | 0x4);  // RTLD_NOW | RTLD_NOLOAD\n  if (!lib) return nullptr;\n  typedef const void *(*entry_t)(uint32_t);\n  entry_t entry = reinterpret_cast<entry_t>(dlsym(lib, \"canopen_plc_api\"));\n  if (entry) {\n    table = entry(api_version);\n    if (!table) why = r_version;\n  }\n  dlclose(lib);\n#else\n  if (canopen_plc_api) {\n    table = canopen_plc_api(api_version);\n    if (!table) why = r_version;\n  }\n#endif\n  const api_v1 *t = static_cast<const api_v1 *>(table);\n  if (t && t->size < __builtin_offsetof(api_v1, flags)) {\n    why = r_version;\n    return nullptr;\n  }\n  return t;\n}\n\ninline bool api_is_permanent(const api_v1 *t) {\n  return t->size >= sizeof(api_v1) && (t->flags & flag_permanent) != 0;\n}\n\ninline const api_v1 *api(uint8_t &why) {\n  static const api_v1 *kept = nullptr;\n  static uint32_t skip = 0;\n  const api_v1 *t = __atomic_load_n(&kept, __ATOMIC_ACQUIRE);\n  if (t) {\n    why = r_not_run;\n    return t;\n  }\n  uint32_t left = __atomic_load_n(&skip, __ATOMIC_RELAXED);\n  if (left > 0) {\n    __atomic_store_n(&skip, left - 1, __ATOMIC_RELAXED);\n    why = r_not_run;\n    return nullptr;\n  }\n  t = lookup_api(why);\n  if (!t) {\n    if (why == r_not_run) __atomic_store_n(&skip, miss_skip, __ATOMIC_RELAXED);\n    return nullptr;\n  }\n  if (api_is_permanent(t)) __atomic_store_n(&kept, t, __ATOMIC_RELEASE);\n  return t;\n}\n\n// The table with the version 2 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v2 *api2(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 2 || t->size < sizeof(api_v2)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v2 *>(static_cast<const void *>(t));\n}\n\n// The table with the version 3 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v3 *api3(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 3 || t->size < sizeof(api_v3)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v3 *>(static_cast<const void *>(t));\n}\n\n// ---- Error text, written into a fixed buffer (no allocation, no libc). ----\nstruct text {\n  char buf[200];\n  unsigned len;\n};\ninline void clear(text &t) {\n  t.len = 0;\n  t.buf[0] = 0;\n}\ninline void put(text &t, const char *s) {\n  while (*s && t.len + 1 < sizeof t.buf) t.buf[t.len++] = *s++;\n  t.buf[t.len] = 0;\n}\ninline void put_dec(text &t, uint32_t v) {\n  char d[12];\n  int n = 0;\n  do {\n    d[n++] = static_cast<char>('0' + v % 10);\n    v /= 10;\n  } while (v && n < 12);\n  while (n > 0 && t.len + 1 < sizeof t.buf) t.buf[t.len++] = d[--n];\n  t.buf[t.len] = 0;\n}\ninline void put_hex(text &t, uint32_t v, int digits) {\n  put(t, \"16#\");\n  for (int i = digits - 1; i >= 0 && t.len + 1 < sizeof t.buf; --i)\n    t.buf[t.len++] = \"0123456789ABCDEF\"[(v >> (4 * i)) & 0xF];\n  t.buf[t.len] = 0;\n}\n\n// CiA 301 SDO abort codes.\ninline const char *abort_text(uint32_t code) {\n  switch (code) {\n    case 0x05030000u: return \"toggle bit not alternated\";\n    case 0x05040000u: return \"SDO protocol timed out\";\n    case 0x05040001u: return \"command specifier not valid or unknown\";\n    case 0x05040002u: return \"invalid block size\";\n    case 0x05040003u: return \"invalid sequence number\";\n    case 0x05040004u: return \"CRC error\";\n    case 0x05040005u: return \"out of memory\";\n    case 0x06010000u: return \"unsupported access to an object\";\n    case 0x06010001u: return \"attempt to read a write only object\";\n    case 0x06010002u: return \"attempt to write a read only object\";\n    case 0x06020000u: return \"object does not exist\";\n    case 0x06040041u: return \"object cannot be mapped to the PDO\";\n    case 0x06040042u: return \"the mapped objects would exceed the PDO length\";\n    case 0x06040043u: return \"general parameter incompatibility\";\n    case 0x06040047u: return \"general internal incompatibility in the device\";\n    case 0x06060000u: return \"access failed due to a hardware error\";\n    case 0x06070010u: return \"data type or length does not match\";\n    case 0x06070012u: return \"data type does not match, length too high\";\n    case 0x06070013u: return \"data type does not match, length too low\";\n    case 0x06090011u: return \"sub-index does not exist\";\n    case 0x06090030u: return \"invalid value for parameter\";\n    case 0x06090031u: return \"value of parameter written too high\";\n    case 0x06090032u: return \"value of parameter written too low\";\n    case 0x06090036u: return \"maximum value is less than minimum value\";\n    case 0x060A0023u: return \"resource not available: SDO connection\";\n    case 0x08000000u: return \"general error\";\n    case 0x08000020u: return \"data cannot be transferred or stored to the application\";\n    case 0x08000021u: return \"data cannot be transferred or stored because of local control\";\n    case 0x08000022u: return \"data cannot be transferred or stored in the present device state\";\n    case 0x08000023u: return \"no object dictionary is present\";\n    case 0x08000024u: return \"no data available\";\n    default: return \"unknown abort code\";\n  }\n}\n\n// What a request was about, for its error text.\nstruct what {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint16_t index;\n  uint8_t subindex;\n  uint32_t timeout_ms;\n  uint32_t capacity;  // bytes the block holds\n};\n\ninline what what_of(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex,\n                    uint32_t timeout_ms, uint32_t capacity) {\n  what w{};\n  w.network = network;\n  w.node = node;\n  w.index = index;\n  w.subindex = subindex;\n  w.timeout_ms = timeout_ms;\n  w.capacity = capacity;\n  return w;\n}\n\ninline void put_node(text &t, const what &w) {\n  if (w.node == 0) {\n    put(t, \"the nodes of network \");\n    put_dec(t, w.network);\n  } else {\n    put(t, \"node \");\n    put_dec(t, w.node);\n  }\n}\n\ninline void put_object(text &t, const what &w) {\n  put_hex(t, w.index, 4);\n  put(t, \" sub \");\n  put_dec(t, w.subindex);\n}\n\n// The error text of a failed request, and its ERRORINFO.\ninline uint32_t describe(text &t, const what &w, const result &r) {\n  clear(t);\n  switch (r.error) {\n    case e_other_error:\n      put_node(t, w);\n      put(t, \" aborted \");\n      put_object(t, w);\n      put(t, \": \");\n      put(t, abort_text(r.abort_code));\n      put(t, \" (\");\n      put_hex(t, r.abort_code, 8);\n      put(t, \")\");\n      return r.abort_code;\n    case e_timeout:\n      put_node(t, w);\n      put(t, \" did not answer\");\n      if (w.timeout_ms) {\n        put(t, \" within \");\n        put_dec(t, w.timeout_ms);\n        put(t, \" ms\");\n      }\n      return r.abort_code ? r.abort_code : 0x05040000u;\n    case e_bus_off:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, r.reason == r_link ? \" link is down\" : \" bus is off\");\n      return 0;\n    case e_error_passive:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" is error passive\");\n      return 0;\n    case e_wrong_parameter:\n      if (r.reason == r_too_large) {\n        put(t, \"object has \");\n        put_dec(t, r.length);\n        put(t, \" bytes, the block holds \");\n        put_dec(t, w.capacity);\n        return r.length;\n      }\n      if (r.reason == r_length) {\n        put(t, \"DATALENGTH \");\n        put_dec(t, r.length);\n        put(t, \" is not 1 to \");\n        put_dec(t, w.capacity);\n        return 0;\n      }\n      if (r.reason == r_not_in_eds) {\n        put_node(t, w);\n        put(t, \" has no object \");\n        put_object(t, w);\n        put(t, \" of 1 to 4 bytes in its EDS; set DATALENGTH\");\n        return 0;\n      }\n      if (r.reason == r_command) {\n        put(t, \"STATE \");\n        put_dec(t, r.length);\n        put(t, \" is not an NMT state change\");\n        return 0;\n      }\n      put(t, \"wrong parameter\");\n      return 0;\n    case e_node_id_unknown:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" has no node \");\n      put_dec(t, w.node);\n      return 0;\n    case e_net_id_unknown:\n      put(t, \"no CANopen network \");\n      put_dec(t, w.network);\n      return 0;\n    case e_request_error:\n      if (r.reason == r_booting) {\n        put_node(t, w);\n        put(t, \" is booting\");\n      } else if (r.reason == r_full) {\n        put(t, \"network \");\n        put_dec(t, w.network);\n        put(t, \" has 16 block requests waiting\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return 0;\n    case e_no_driver:\n      if (r.reason == r_restart)\n        put(t, \"request cancelled by the PLC stop\");\n      else if (r.reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else if (r.reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else\n        put(t, \"no CANopen network runs\");\n      return 0;\n    default:\n      put(t, \"internal error in the CANopen master\");\n      return 0;\n  }\n}\n\n// The error text of a slave block, for `slave` and the object (index, subindex) or ERRORCODE.\ninline void describe_slave(text &t, uint8_t slave, uint8_t error, uint8_t reason, uint16_t index,\n                           uint8_t subindex) {\n  clear(t);\n  switch (error) {\n    case e_no_error:\n      return;\n    case e_net_id_unknown:\n      put(t, \"no CANopen slave \");\n      put_dec(t, slave);\n      return;\n    case e_no_driver:\n      if (reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else if (reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else\n        put(t, \"no CANopen slave runs\");\n      return;\n    case e_wrong_parameter:\n      if (reason == r_reset) {\n        put(t, \"the program cannot reset the slave; STATE must be START_REMOTE_NODE, \");\n        put(t, \"STOP_REMOTE_NODE or ENTER_PRE_OPERATIONAL\");\n      } else if (reason == r_own_code) {\n        put(t, \"ERRORCODE \");\n        put_hex(t, index, 4);\n        put(t, \" is sent by the slave itself; use another code\");\n      } else if (reason == r_object) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" has no object \");\n        put_hex(t, index, 4);\n        put(t, \" sub \");\n        put_dec(t, subindex);\n        put(t, \" written by the master\");\n      } else {\n        put(t, \"wrong parameter\");\n      }\n      return;\n    case e_request_error:\n      if (reason == r_slots) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" already holds 31 program emergencies\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return;\n    default:\n      put(t, \"internal error in the CANopen slave\");\n      return;\n  }\n}\n\n// Shows a failed request on the block's ERROR, ERRORINFO and ERRORTEXT pins.\ntemplate <class error_pin, class info_pin, class text_pin>\ninline void show(error_pin &error, info_pin &info, text_pin &errortext, const what &w,\n                 const result &r) {\n  text t;\n  uint32_t i = describe(t, w, r);\n  error = r.error ? r.error : static_cast<uint8_t>(e_internal);\n  info = i;\n  errortext = t.buf;\n}\n\n// The size of an object of 1 to 4 bytes in the node's EDS, from the table the editor's build\n// generates (sorted network, node, index, sub-index, size); 0 when it is not listed.\ninline uint32_t eds_size(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex) {\n  const uint64_t key = (static_cast<uint64_t>(network) << 32) | (static_cast<uint64_t>(node) << 24) |\n                       (static_cast<uint64_t>(index) << 8) | subindex;\n  long lo = 0;\n  long hi = static_cast<long>(static_cast<uint32_t>(strucpp::CANOPEN_OBJECT_SIZE_COUNT)) - 1;\n  while (lo <= hi) {\n    long mid = (lo + hi) / 2;\n    uint64_t entry = static_cast<uint64_t>(strucpp::CANOPEN_OBJECT_SIZES[mid]);\n    uint64_t k = entry >> 8;\n    if (k == key) return static_cast<uint32_t>(entry & 0xFF);\n    if (k < key)\n      lo = mid + 1;\n    else\n      hi = mid - 1;\n  }\n  return 0;\n}\n\n// TIME (nanoseconds) to milliseconds; 0 or less: the network's SDO timeout.\ninline uint32_t timeout_ms(long long ns) {\n  if (ns <= 0) return 0;\n  long long ms = (ns + 999999) / 1000000;\n  return ms > 3600000 ? 3600000u : static_cast<uint32_t>(ms);\n}\n\n// One instance's handshake (CiA 405): the block keeps `prev`, `phase` and `handle` in its locals.\nenum { phase_idle = 0, phase_busy = 1, phase_ended = 2 };\nstruct step {\n  bool start;   // rising edge of ENABLE: clear the outputs and start a request\n  bool cancel;  // falling edge while busy: drop the request and clear the outputs\n  bool clear;   // the result was shown and ENABLE is FALSE: clear the outputs\n};\ninline step begin(bool enable, bool &prev, uint8_t &phase) {\n  step s{false, false, false};\n  bool rising = enable && !prev;\n  prev = enable;\n  if (!enable && phase == phase_busy) {\n    s.cancel = true;\n    phase = phase_idle;\n  } else if (!enable && phase == phase_ended) {\n    s.clear = true;\n    phase = phase_idle;\n  }\n  if (rising && phase != phase_busy) s.start = true;\n  return s;\n}\n\n// Starts `req`. Returns the handle, or 0 with `res` saying why it cannot run.\ninline uint64_t start(const request &req, result &res) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why;\n    return 0;\n  }\n  uint64_t handle = t->start(&req, &res);\n  if (!handle && res.error == e_no_error) res.error = e_internal;\n  return handle;\n}\n\n// 0 while the request runs; 1 done, 2 failed (`res` set).\ninline int poll(uint64_t handle, result &res, uint8_t *data, uint32_t cap) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why == r_version ? r_version : r_restart;\n    return 2;\n  }\n  return t->poll(handle, &res, data, cap);\n}\n\ninline void cancel(uint64_t handle) {\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (t) t->cancel(handle);\n}\n\ninline void put_le(uint8_t *out, uint32_t v, unsigned n) {\n  for (unsigned b = 0; b < n; ++b) out[b] = static_cast<uint8_t>(v >> (8 * b));\n}\n\ninline uint32_t get_le(const uint8_t *in, unsigned n) {\n  uint32_t v = 0;\n  for (unsigned b = 0; b < n && b < 4; ++b) v |= static_cast<uint32_t>(in[b]) << (8 * b);\n  return v;\n}\n\n// A failure before any request ran (bad input): `res` for describe().\ninline result fail(uint8_t error, uint8_t reason, uint32_t length) {\n  result r{};\n  r.error = error;\n  r.reason = reason;\n  r.length = length;\n  return r;\n}\n\n}  // namespace canopen_fb\n#endif\nvoid setup() {\n}\n\nvoid loop() {\n  CONFIRM = false;\n  if (!ENABLE) {\n    ERROR = 0;\n    if (cop_last != 0) ERRORTEXT = \"\";\n    cop_last = 0;\n    return;\n  }\n  uint8_t l_why = 0;\n  const canopen_fb::api_v1 *l_api = canopen_fb::api(l_why);\n  int l_error = canopen_fb::e_no_driver;\n  uint8_t l_net = NETWORK;\n  uint8_t l_node = DEVICE;\n  bool l_lost = false;\n  uint32_t l_lost_count = 0;\n  if (l_api) {\n    uint64_t l_cursor = cop_cursor;\n    l_error = canopen_fb::e_no_error;\n    if (!cop_started || cop_net != l_net) {\n      l_error = l_api->emcy_cursor(l_net, &l_cursor);\n      if (l_error == canopen_fb::e_no_error) {\n        cop_started = true;\n        cop_net = l_net;\n      }\n    }\n    if (l_error == canopen_fb::e_no_error) {\n      canopen_fb::emcy l_msg = {};\n      int l_got = l_api->emcy_next(l_net, l_node, &l_cursor, &l_msg);\n      if (l_got < 0) {\n        l_error = -l_got;\n      } else if (l_got == 1) {\n        CONFIRM = true;\n        EMCY.ERRORCODE = l_msg.error_code;\n        EMCY.ERRORREGISTER = l_msg.error_register;\n        for (int l_i = 0; l_i < 5; ++l_i) EMCY.MANUFACTURERERROR[l_i] = l_msg.data[l_i];\n        if (l_msg.lost) {\n          l_lost = true;\n          l_lost_count = l_msg.lost;\n        }\n      }\n      cop_cursor = l_cursor;\n    }\n  }\n  ERROR = static_cast<uint8_t>(l_error);\n  if (l_lost) {\n    canopen_fb::text l_text;\n    canopen_fb::clear(l_text);\n    canopen_fb::put_dec(l_text, l_lost_count);\n    canopen_fb::put(l_text, \" emergency messages were lost before this one\");\n    ERRORTEXT = l_text.buf;\n    cop_last = 0xFF;\n  } else if (l_error != cop_last && (l_error != canopen_fb::e_no_error || cop_last != 0xFF)) {\n    canopen_fb::result l_res = canopen_fb::fail(static_cast<uint8_t>(l_error), l_api ? 0 : l_why, 0);\n    canopen_fb::text l_text;\n    canopen_fb::clear(l_text);\n    if (l_error != canopen_fb::e_no_error)\n      canopen_fb::describe(l_text, canopen_fb::what_of(l_net, l_node, 0, 0, 0, 0), l_res);\n    ERRORTEXT = l_text.buf;\n    cop_last = static_cast<uint8_t>(l_error);\n  }\n}\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "CANOPEN_NODE_ENABLE.cpp",
      "source": "(* Turns a node on or off while the PLC runs: while ENABLE is TRUE the node is on when ACTIVE is TRUE and off when it is FALSE. Each change of ACTIVE sends one request; BUSY until the master has applied it, then CONFIRM. A node that is off is not booted, supervised or warned about and gets no PDOs; turning off a running node sends it NMT stop and handles its inputs as on a loss. The choice lasts until the PLC stops; at the next start the node's \"On at PLC start\" setting applies again. NETWORK counts from 1; DEVICE is the node ID or its name.\nExample: gripper(ENABLE := TRUE, DEVICE := Gripper, ACTIVE := has_gripper); *)\nFUNCTION_BLOCK CANOPEN_NODE_ENABLE\nVAR_INPUT\n  NETWORK : USINT := 1;\n  ENABLE : BOOL;\n  DEVICE : USINT;\n  ACTIVE : BOOL;\nEND_VAR\nVAR_OUTPUT\n  CONFIRM : BOOL;\n  BUSY : BOOL;\n  ERROR : USINT;\n  ERRORTEXT : STRING;\nEND_VAR\nVAR\n  cop_last : USINT;\n  cop_sent : BOOL;\n  cop_want : BOOL;\n  cop_net : USINT;\n  cop_node : USINT;\nEND_VAR\n// SPDX-License-Identifier: Apache-2.0\n//\n// Shared code of the canopen function blocks. The generator copies it into every block's source,\n// because the editor grafts each library C++ block into one c_blocks_code.cpp and has no other\n// place for shared code; the include guard keeps one copy per program.\n//\n// The editor binds every pin and local of a block to a #define of its name, so nothing here uses\n// a pin or local name (those are upper case or start with cop_; this code is lower case), nor the\n// keyword that closes a variable section, and no system header is included after those defines:\n// dlopen, dlsym and dlclose are declared here as glibc declares them.\n//\n// Derived from canworks ec7fd59, library/src/common.inc (Apache-2.0), adapted to the plugin's\n// interface version 3 (core/src/drivers/plugins/native/canopen/plc_api.h in the runtime fork).\n#ifndef CANOPEN_FB_SHARED_INCLUDED\n#define CANOPEN_FB_SHARED_INCLUDED\n#if defined(__linux__)\nextern \"C\" void *dlopen(const char *file, int mode) noexcept(true);\nextern \"C\" void *dlsym(void *handle, const char *name) noexcept(true);\nextern \"C\" int dlclose(void *handle) noexcept(true);\n#else\n// A board's firmware: the slave module's table, when the project has a slave on the board.\nextern \"C\" const void *canopen_plc_api(uint32_t version) __attribute__((weak));\n#endif\n\nnamespace canopen_fb {\n\n// A copy of the plugin's C interface, version 3; keep in step with plc_api.h. Version 1 is asked\n// for, since a newer plugin answers it with its newest table; `size` tells which it is.\nconst uint32_t api_version = 1;\nconst uint32_t max_data = 256;\nenum {\n  e_no_error = 0, e_other_error = 1, e_timeout = 2, e_bus_off = 3, e_error_passive = 4,\n  e_internal = 5, e_wrong_parameter = 6, e_node_id_unknown = 7, e_net_id_unknown = 8,\n  e_request_error = 9, e_no_driver = 10\n};\nenum {\n  r_none = 0, r_booting = 1, r_full = 2, r_not_run = 3, r_restart = 4, r_link = 5,\n  r_too_large = 6, r_length = 7, r_command = 8, r_version = 9,\n  r_not_in_eds = 100,  // the blocks' own: DATALENGTH 0 for an object the EDS does not list\n  r_needs_v2 = 101,    // the blocks' own: the plugin's table lacks the functions the block needs\n  r_reset = 102,       // the blocks' own: a slave NMT block asked for a reset\n  r_own_code = 103,    // the blocks' own: an emergency code the slave sends itself\n  r_slots = 104,       // the blocks' own: all program emergency slots are taken\n  r_object = 105       // the blocks' own: the slave has no such object from the master\n};\nenum { k_read = 0, k_write = 1, k_nmt = 2 };\nstruct request {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint8_t command;\n  uint16_t index;\n  uint8_t subindex;\n  uint8_t reserved;\n  uint32_t timeout_ms;\n  uint32_t length;\n  const uint8_t *data;\n};\nstruct result {\n  uint8_t error;\n  uint8_t reason;\n  uint16_t reserved;\n  uint32_t abort_code;\n  uint32_t length;\n};\nstruct emcy {\n  uint8_t node;\n  uint8_t error_register;\n  uint16_t error_code;\n  uint8_t data[5];\n  uint8_t reserved[3];\n  uint32_t lost;\n};\nstruct api_v1 {\n  uint32_t size;\n  uint32_t version;\n  uint64_t (*start)(const request *req, result *res);\n  int (*poll)(uint64_t handle, result *res, uint8_t *data, uint32_t cap);\n  void (*cancel)(uint64_t handle);\n  int (*node_state)(uint8_t network, uint8_t node, uint8_t *state);\n  int (*kernel_state)(uint8_t network, uint8_t *state);\n  int (*local_node_id)(uint8_t network, uint8_t *node_id);\n  int (*emcy_cursor)(uint8_t network, uint64_t *cursor);\n  int (*emcy_next)(uint8_t network, uint8_t node, uint64_t *cursor, emcy *out);\n  uint32_t flags;  // present when size covers it\n};\n// flags: the plugin is never unmapped, so its table stays valid for the life of the process.\nconst uint32_t flag_permanent = 0x1;\n// node_info::flags\nconst uint8_t node_enabled = 0x01;\nconst uint8_t node_optional = 0x02;\nconst uint8_t node_program_start = 0x04;\nconst uint32_t status_text = 80;\nstruct node_info {\n  uint8_t run_state;\n  uint8_t flags;\n  uint8_t reserved[2];\n  char problem[status_text];\n};\nstruct network_info {\n  uint8_t mandatory_up;\n  uint8_t optional_up;\n  uint8_t configured;\n  uint8_t operational;\n  uint8_t waiting;\n  uint8_t disabled;\n  uint8_t faulty;\n  uint8_t nodes;\n};\nstruct api_v2 {\n  api_v1 v1;\n  int (*node_status)(uint8_t network, uint8_t node, node_info *out);\n  int (*network_status)(uint8_t network, network_info *out);\n  int (*node_enable)(uint8_t network, uint8_t node, uint8_t on);\n};\n// slave_info::flags\nconst uint8_t slave_on_bus = 0x01;\nconst uint8_t slave_master_watched = 0x02;\nconst uint8_t slave_master_seen = 0x04;\nconst uint32_t slave_emcy_slots = 31;\nstruct slave_info {\n  uint8_t state;\n  uint8_t node_id;\n  uint8_t flags;\n  uint8_t bus_state;\n  uint8_t error_register;\n  uint8_t emcy_active;\n  uint8_t reserved[2];\n};\nstruct api_v3 {\n  api_v2 v2;\n  int (*slave_status)(uint8_t slave, slave_info *out);\n  int (*slave_nmt)(uint8_t slave, uint8_t command);\n  int (*slave_nmt_done)(uint8_t slave, uint8_t command, uint8_t *done);\n  int (*slave_emcy_claim)(uint8_t slave, uint32_t *handle);\n  int (*slave_emcy)(uint8_t slave, uint32_t handle, uint8_t active, uint16_t code, uint32_t info);\n  int (*slave_written)(uint8_t slave, uint16_t index, uint8_t subindex, uint32_t *count);\n};\n// After a lookup that found no plugin, this many lookups are skipped before the next one.\nconst uint32_t miss_skip = 1024;\n\n// The loaded plugin's table, or null with `why` set (r_not_run or r_version). The runtime loads\n// the plugin again at each PLC start while this program stays loaded, so a table is kept only\n// when its flags say it stays valid; otherwise it is looked up on each call. While no plugin is\n// found, only one lookup in miss_skip runs; the others answer r_not_run at once.\ninline const api_v1 *lookup_api(uint8_t &why) {\n  const void *table = nullptr;\n  why = r_not_run;\n#if defined(__linux__)\n  void *lib = dlopen(\"libcanopen_plugin.so\", 0x2 | 0x4);  // RTLD_NOW | RTLD_NOLOAD\n  if (!lib) return nullptr;\n  typedef const void *(*entry_t)(uint32_t);\n  entry_t entry = reinterpret_cast<entry_t>(dlsym(lib, \"canopen_plc_api\"));\n  if (entry) {\n    table = entry(api_version);\n    if (!table) why = r_version;\n  }\n  dlclose(lib);\n#else\n  if (canopen_plc_api) {\n    table = canopen_plc_api(api_version);\n    if (!table) why = r_version;\n  }\n#endif\n  const api_v1 *t = static_cast<const api_v1 *>(table);\n  if (t && t->size < __builtin_offsetof(api_v1, flags)) {\n    why = r_version;\n    return nullptr;\n  }\n  return t;\n}\n\ninline bool api_is_permanent(const api_v1 *t) {\n  return t->size >= sizeof(api_v1) && (t->flags & flag_permanent) != 0;\n}\n\ninline const api_v1 *api(uint8_t &why) {\n  static const api_v1 *kept = nullptr;\n  static uint32_t skip = 0;\n  const api_v1 *t = __atomic_load_n(&kept, __ATOMIC_ACQUIRE);\n  if (t) {\n    why = r_not_run;\n    return t;\n  }\n  uint32_t left = __atomic_load_n(&skip, __ATOMIC_RELAXED);\n  if (left > 0) {\n    __atomic_store_n(&skip, left - 1, __ATOMIC_RELAXED);\n    why = r_not_run;\n    return nullptr;\n  }\n  t = lookup_api(why);\n  if (!t) {\n    if (why == r_not_run) __atomic_store_n(&skip, miss_skip, __ATOMIC_RELAXED);\n    return nullptr;\n  }\n  if (api_is_permanent(t)) __atomic_store_n(&kept, t, __ATOMIC_RELEASE);\n  return t;\n}\n\n// The table with the version 2 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v2 *api2(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 2 || t->size < sizeof(api_v2)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v2 *>(static_cast<const void *>(t));\n}\n\n// The table with the version 3 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v3 *api3(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 3 || t->size < sizeof(api_v3)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v3 *>(static_cast<const void *>(t));\n}\n\n// ---- Error text, written into a fixed buffer (no allocation, no libc). ----\nstruct text {\n  char buf[200];\n  unsigned len;\n};\ninline void clear(text &t) {\n  t.len = 0;\n  t.buf[0] = 0;\n}\ninline void put(text &t, const char *s) {\n  while (*s && t.len + 1 < sizeof t.buf) t.buf[t.len++] = *s++;\n  t.buf[t.len] = 0;\n}\ninline void put_dec(text &t, uint32_t v) {\n  char d[12];\n  int n = 0;\n  do {\n    d[n++] = static_cast<char>('0' + v % 10);\n    v /= 10;\n  } while (v && n < 12);\n  while (n > 0 && t.len + 1 < sizeof t.buf) t.buf[t.len++] = d[--n];\n  t.buf[t.len] = 0;\n}\ninline void put_hex(text &t, uint32_t v, int digits) {\n  put(t, \"16#\");\n  for (int i = digits - 1; i >= 0 && t.len + 1 < sizeof t.buf; --i)\n    t.buf[t.len++] = \"0123456789ABCDEF\"[(v >> (4 * i)) & 0xF];\n  t.buf[t.len] = 0;\n}\n\n// CiA 301 SDO abort codes.\ninline const char *abort_text(uint32_t code) {\n  switch (code) {\n    case 0x05030000u: return \"toggle bit not alternated\";\n    case 0x05040000u: return \"SDO protocol timed out\";\n    case 0x05040001u: return \"command specifier not valid or unknown\";\n    case 0x05040002u: return \"invalid block size\";\n    case 0x05040003u: return \"invalid sequence number\";\n    case 0x05040004u: return \"CRC error\";\n    case 0x05040005u: return \"out of memory\";\n    case 0x06010000u: return \"unsupported access to an object\";\n    case 0x06010001u: return \"attempt to read a write only object\";\n    case 0x06010002u: return \"attempt to write a read only object\";\n    case 0x06020000u: return \"object does not exist\";\n    case 0x06040041u: return \"object cannot be mapped to the PDO\";\n    case 0x06040042u: return \"the mapped objects would exceed the PDO length\";\n    case 0x06040043u: return \"general parameter incompatibility\";\n    case 0x06040047u: return \"general internal incompatibility in the device\";\n    case 0x06060000u: return \"access failed due to a hardware error\";\n    case 0x06070010u: return \"data type or length does not match\";\n    case 0x06070012u: return \"data type does not match, length too high\";\n    case 0x06070013u: return \"data type does not match, length too low\";\n    case 0x06090011u: return \"sub-index does not exist\";\n    case 0x06090030u: return \"invalid value for parameter\";\n    case 0x06090031u: return \"value of parameter written too high\";\n    case 0x06090032u: return \"value of parameter written too low\";\n    case 0x06090036u: return \"maximum value is less than minimum value\";\n    case 0x060A0023u: return \"resource not available: SDO connection\";\n    case 0x08000000u: return \"general error\";\n    case 0x08000020u: return \"data cannot be transferred or stored to the application\";\n    case 0x08000021u: return \"data cannot be transferred or stored because of local control\";\n    case 0x08000022u: return \"data cannot be transferred or stored in the present device state\";\n    case 0x08000023u: return \"no object dictionary is present\";\n    case 0x08000024u: return \"no data available\";\n    default: return \"unknown abort code\";\n  }\n}\n\n// What a request was about, for its error text.\nstruct what {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint16_t index;\n  uint8_t subindex;\n  uint32_t timeout_ms;\n  uint32_t capacity;  // bytes the block holds\n};\n\ninline what what_of(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex,\n                    uint32_t timeout_ms, uint32_t capacity) {\n  what w{};\n  w.network = network;\n  w.node = node;\n  w.index = index;\n  w.subindex = subindex;\n  w.timeout_ms = timeout_ms;\n  w.capacity = capacity;\n  return w;\n}\n\ninline void put_node(text &t, const what &w) {\n  if (w.node == 0) {\n    put(t, \"the nodes of network \");\n    put_dec(t, w.network);\n  } else {\n    put(t, \"node \");\n    put_dec(t, w.node);\n  }\n}\n\ninline void put_object(text &t, const what &w) {\n  put_hex(t, w.index, 4);\n  put(t, \" sub \");\n  put_dec(t, w.subindex);\n}\n\n// The error text of a failed request, and its ERRORINFO.\ninline uint32_t describe(text &t, const what &w, const result &r) {\n  clear(t);\n  switch (r.error) {\n    case e_other_error:\n      put_node(t, w);\n      put(t, \" aborted \");\n      put_object(t, w);\n      put(t, \": \");\n      put(t, abort_text(r.abort_code));\n      put(t, \" (\");\n      put_hex(t, r.abort_code, 8);\n      put(t, \")\");\n      return r.abort_code;\n    case e_timeout:\n      put_node(t, w);\n      put(t, \" did not answer\");\n      if (w.timeout_ms) {\n        put(t, \" within \");\n        put_dec(t, w.timeout_ms);\n        put(t, \" ms\");\n      }\n      return r.abort_code ? r.abort_code : 0x05040000u;\n    case e_bus_off:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, r.reason == r_link ? \" link is down\" : \" bus is off\");\n      return 0;\n    case e_error_passive:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" is error passive\");\n      return 0;\n    case e_wrong_parameter:\n      if (r.reason == r_too_large) {\n        put(t, \"object has \");\n        put_dec(t, r.length);\n        put(t, \" bytes, the block holds \");\n        put_dec(t, w.capacity);\n        return r.length;\n      }\n      if (r.reason == r_length) {\n        put(t, \"DATALENGTH \");\n        put_dec(t, r.length);\n        put(t, \" is not 1 to \");\n        put_dec(t, w.capacity);\n        return 0;\n      }\n      if (r.reason == r_not_in_eds) {\n        put_node(t, w);\n        put(t, \" has no object \");\n        put_object(t, w);\n        put(t, \" of 1 to 4 bytes in its EDS; set DATALENGTH\");\n        return 0;\n      }\n      if (r.reason == r_command) {\n        put(t, \"STATE \");\n        put_dec(t, r.length);\n        put(t, \" is not an NMT state change\");\n        return 0;\n      }\n      put(t, \"wrong parameter\");\n      return 0;\n    case e_node_id_unknown:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" has no node \");\n      put_dec(t, w.node);\n      return 0;\n    case e_net_id_unknown:\n      put(t, \"no CANopen network \");\n      put_dec(t, w.network);\n      return 0;\n    case e_request_error:\n      if (r.reason == r_booting) {\n        put_node(t, w);\n        put(t, \" is booting\");\n      } else if (r.reason == r_full) {\n        put(t, \"network \");\n        put_dec(t, w.network);\n        put(t, \" has 16 block requests waiting\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return 0;\n    case e_no_driver:\n      if (r.reason == r_restart)\n        put(t, \"request cancelled by the PLC stop\");\n      else if (r.reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else if (r.reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else\n        put(t, \"no CANopen network runs\");\n      return 0;\n    default:\n      put(t, \"internal error in the CANopen master\");\n      return 0;\n  }\n}\n\n// The error text of a slave block, for `slave` and the object (index, subindex) or ERRORCODE.\ninline void describe_slave(text &t, uint8_t slave, uint8_t error, uint8_t reason, uint16_t index,\n                           uint8_t subindex) {\n  clear(t);\n  switch (error) {\n    case e_no_error:\n      return;\n    case e_net_id_unknown:\n      put(t, \"no CANopen slave \");\n      put_dec(t, slave);\n      return;\n    case e_no_driver:\n      if (reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else if (reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else\n        put(t, \"no CANopen slave runs\");\n      return;\n    case e_wrong_parameter:\n      if (reason == r_reset) {\n        put(t, \"the program cannot reset the slave; STATE must be START_REMOTE_NODE, \");\n        put(t, \"STOP_REMOTE_NODE or ENTER_PRE_OPERATIONAL\");\n      } else if (reason == r_own_code) {\n        put(t, \"ERRORCODE \");\n        put_hex(t, index, 4);\n        put(t, \" is sent by the slave itself; use another code\");\n      } else if (reason == r_object) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" has no object \");\n        put_hex(t, index, 4);\n        put(t, \" sub \");\n        put_dec(t, subindex);\n        put(t, \" written by the master\");\n      } else {\n        put(t, \"wrong parameter\");\n      }\n      return;\n    case e_request_error:\n      if (reason == r_slots) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" already holds 31 program emergencies\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return;\n    default:\n      put(t, \"internal error in the CANopen slave\");\n      return;\n  }\n}\n\n// Shows a failed request on the block's ERROR, ERRORINFO and ERRORTEXT pins.\ntemplate <class error_pin, class info_pin, class text_pin>\ninline void show(error_pin &error, info_pin &info, text_pin &errortext, const what &w,\n                 const result &r) {\n  text t;\n  uint32_t i = describe(t, w, r);\n  error = r.error ? r.error : static_cast<uint8_t>(e_internal);\n  info = i;\n  errortext = t.buf;\n}\n\n// The size of an object of 1 to 4 bytes in the node's EDS, from the table the editor's build\n// generates (sorted network, node, index, sub-index, size); 0 when it is not listed.\ninline uint32_t eds_size(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex) {\n  const uint64_t key = (static_cast<uint64_t>(network) << 32) | (static_cast<uint64_t>(node) << 24) |\n                       (static_cast<uint64_t>(index) << 8) | subindex;\n  long lo = 0;\n  long hi = static_cast<long>(static_cast<uint32_t>(strucpp::CANOPEN_OBJECT_SIZE_COUNT)) - 1;\n  while (lo <= hi) {\n    long mid = (lo + hi) / 2;\n    uint64_t entry = static_cast<uint64_t>(strucpp::CANOPEN_OBJECT_SIZES[mid]);\n    uint64_t k = entry >> 8;\n    if (k == key) return static_cast<uint32_t>(entry & 0xFF);\n    if (k < key)\n      lo = mid + 1;\n    else\n      hi = mid - 1;\n  }\n  return 0;\n}\n\n// TIME (nanoseconds) to milliseconds; 0 or less: the network's SDO timeout.\ninline uint32_t timeout_ms(long long ns) {\n  if (ns <= 0) return 0;\n  long long ms = (ns + 999999) / 1000000;\n  return ms > 3600000 ? 3600000u : static_cast<uint32_t>(ms);\n}\n\n// One instance's handshake (CiA 405): the block keeps `prev`, `phase` and `handle` in its locals.\nenum { phase_idle = 0, phase_busy = 1, phase_ended = 2 };\nstruct step {\n  bool start;   // rising edge of ENABLE: clear the outputs and start a request\n  bool cancel;  // falling edge while busy: drop the request and clear the outputs\n  bool clear;   // the result was shown and ENABLE is FALSE: clear the outputs\n};\ninline step begin(bool enable, bool &prev, uint8_t &phase) {\n  step s{false, false, false};\n  bool rising = enable && !prev;\n  prev = enable;\n  if (!enable && phase == phase_busy) {\n    s.cancel = true;\n    phase = phase_idle;\n  } else if (!enable && phase == phase_ended) {\n    s.clear = true;\n    phase = phase_idle;\n  }\n  if (rising && phase != phase_busy) s.start = true;\n  return s;\n}\n\n// Starts `req`. Returns the handle, or 0 with `res` saying why it cannot run.\ninline uint64_t start(const request &req, result &res) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why;\n    return 0;\n  }\n  uint64_t handle = t->start(&req, &res);\n  if (!handle && res.error == e_no_error) res.error = e_internal;\n  return handle;\n}\n\n// 0 while the request runs; 1 done, 2 failed (`res` set).\ninline int poll(uint64_t handle, result &res, uint8_t *data, uint32_t cap) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why == r_version ? r_version : r_restart;\n    return 2;\n  }\n  return t->poll(handle, &res, data, cap);\n}\n\ninline void cancel(uint64_t handle) {\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (t) t->cancel(handle);\n}\n\ninline void put_le(uint8_t *out, uint32_t v, unsigned n) {\n  for (unsigned b = 0; b < n; ++b) out[b] = static_cast<uint8_t>(v >> (8 * b));\n}\n\ninline uint32_t get_le(const uint8_t *in, unsigned n) {\n  uint32_t v = 0;\n  for (unsigned b = 0; b < n && b < 4; ++b) v |= static_cast<uint32_t>(in[b]) << (8 * b);\n  return v;\n}\n\n// A failure before any request ran (bad input): `res` for describe().\ninline result fail(uint8_t error, uint8_t reason, uint32_t length) {\n  result r{};\n  r.error = error;\n  r.reason = reason;\n  r.length = length;\n  return r;\n}\n\n}  // namespace canopen_fb\n#endif\nvoid setup() {\n}\n\nvoid loop() {\n  if (!ENABLE) {\n    CONFIRM = false;\n    BUSY = false;\n    ERROR = 0;\n    if (cop_last != 0) ERRORTEXT = \"\";\n    cop_last = 0;\n    cop_sent = false;\n    return;\n  }\n  uint8_t l_why = 0;\n  const canopen_fb::api_v2 *l_api = canopen_fb::api2(l_why);\n  int l_error = canopen_fb::e_no_driver;\n  uint8_t l_node = DEVICE;\n  bool l_want = ACTIVE;\n  bool l_done = false;\n  if (l_api) {\n    l_error = canopen_fb::e_no_error;\n    // A level: each change of ACTIVE (or of the node) sends one request.\n    if (!cop_sent || cop_want != l_want || cop_net != NETWORK || cop_node != l_node) {\n      l_error = l_api->node_enable(NETWORK, l_node, l_want ? 1 : 0);\n      if (l_error == canopen_fb::e_no_error) {\n        cop_sent = true;\n        cop_want = l_want;\n        cop_net = NETWORK;\n        cop_node = l_node;\n      }\n    }\n    if (l_error == canopen_fb::e_no_error) {\n      canopen_fb::node_info l_status;\n      l_error = l_api->node_status(NETWORK, l_node, &l_status);\n      if (l_error == canopen_fb::e_no_error)\n        l_done = ((l_status.flags & canopen_fb::node_enabled) != 0) == l_want;\n    }\n  }\n  bool l_ok = l_error == canopen_fb::e_no_error;\n  CONFIRM = l_ok && l_done;\n  BUSY = l_ok && !l_done;\n  ERROR = static_cast<uint8_t>(l_error);\n  if (l_error != cop_last) {\n    canopen_fb::result l_res = canopen_fb::fail(static_cast<uint8_t>(l_error), l_api ? 0 : l_why, 0);\n    canopen_fb::text l_text;\n    canopen_fb::clear(l_text);\n    if (l_error != canopen_fb::e_no_error)\n      canopen_fb::describe(l_text, canopen_fb::what_of(NETWORK, l_node, 0, 0, 0, 0), l_res);\n    ERRORTEXT = l_text.buf;\n    cop_last = static_cast<uint8_t>(l_error);\n  }\n}\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "CANOPEN_NODE_STATUS.cpp",
      "source": "(* Gives how the master runs a node, in the same call while ENABLE is TRUE: RUNSTATE is RUN_NOT_FOUND, RUN_BOOTING, RUN_FAILED, RUN_WAITING_START, RUN_OPERATIONAL, RUN_MANUAL, RUN_LOST, RUN_HELD, RUN_DISABLED or RUN_STOPPED; ENABLED, OPTIONAL and PROGRAMSTART give its settings as they are now. While the node is failed, lost or held, ERRORTEXT says why. NETWORK counts from 1; DEVICE is the node ID or its name.\nExample: status(ENABLE := TRUE, DEVICE := IO_Module); IF status.RUNSTATE = RUN_WAITING_START THEN ... END_IF; *)\nFUNCTION_BLOCK CANOPEN_NODE_STATUS\nVAR_INPUT\n  NETWORK : USINT := 1;\n  ENABLE : BOOL;\n  DEVICE : USINT;\nEND_VAR\nVAR_OUTPUT\n  CONFIRM : BOOL;\n  ERROR : USINT;\n  ERRORTEXT : STRING;\n  RUNSTATE : USINT;\n  ENABLED : BOOL;\n  OPTIONAL : BOOL;\n  PROGRAMSTART : BOOL;\nEND_VAR\nVAR\n  cop_last : USINT;\nEND_VAR\n// SPDX-License-Identifier: Apache-2.0\n//\n// Shared code of the canopen function blocks. The generator copies it into every block's source,\n// because the editor grafts each library C++ block into one c_blocks_code.cpp and has no other\n// place for shared code; the include guard keeps one copy per program.\n//\n// The editor binds every pin and local of a block to a #define of its name, so nothing here uses\n// a pin or local name (those are upper case or start with cop_; this code is lower case), nor the\n// keyword that closes a variable section, and no system header is included after those defines:\n// dlopen, dlsym and dlclose are declared here as glibc declares them.\n//\n// Derived from canworks ec7fd59, library/src/common.inc (Apache-2.0), adapted to the plugin's\n// interface version 3 (core/src/drivers/plugins/native/canopen/plc_api.h in the runtime fork).\n#ifndef CANOPEN_FB_SHARED_INCLUDED\n#define CANOPEN_FB_SHARED_INCLUDED\n#if defined(__linux__)\nextern \"C\" void *dlopen(const char *file, int mode) noexcept(true);\nextern \"C\" void *dlsym(void *handle, const char *name) noexcept(true);\nextern \"C\" int dlclose(void *handle) noexcept(true);\n#else\n// A board's firmware: the slave module's table, when the project has a slave on the board.\nextern \"C\" const void *canopen_plc_api(uint32_t version) __attribute__((weak));\n#endif\n\nnamespace canopen_fb {\n\n// A copy of the plugin's C interface, version 3; keep in step with plc_api.h. Version 1 is asked\n// for, since a newer plugin answers it with its newest table; `size` tells which it is.\nconst uint32_t api_version = 1;\nconst uint32_t max_data = 256;\nenum {\n  e_no_error = 0, e_other_error = 1, e_timeout = 2, e_bus_off = 3, e_error_passive = 4,\n  e_internal = 5, e_wrong_parameter = 6, e_node_id_unknown = 7, e_net_id_unknown = 8,\n  e_request_error = 9, e_no_driver = 10\n};\nenum {\n  r_none = 0, r_booting = 1, r_full = 2, r_not_run = 3, r_restart = 4, r_link = 5,\n  r_too_large = 6, r_length = 7, r_command = 8, r_version = 9,\n  r_not_in_eds = 100,  // the blocks' own: DATALENGTH 0 for an object the EDS does not list\n  r_needs_v2 = 101,    // the blocks' own: the plugin's table lacks the functions the block needs\n  r_reset = 102,       // the blocks' own: a slave NMT block asked for a reset\n  r_own_code = 103,    // the blocks' own: an emergency code the slave sends itself\n  r_slots = 104,       // the blocks' own: all program emergency slots are taken\n  r_object = 105       // the blocks' own: the slave has no such object from the master\n};\nenum { k_read = 0, k_write = 1, k_nmt = 2 };\nstruct request {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint8_t command;\n  uint16_t index;\n  uint8_t subindex;\n  uint8_t reserved;\n  uint32_t timeout_ms;\n  uint32_t length;\n  const uint8_t *data;\n};\nstruct result {\n  uint8_t error;\n  uint8_t reason;\n  uint16_t reserved;\n  uint32_t abort_code;\n  uint32_t length;\n};\nstruct emcy {\n  uint8_t node;\n  uint8_t error_register;\n  uint16_t error_code;\n  uint8_t data[5];\n  uint8_t reserved[3];\n  uint32_t lost;\n};\nstruct api_v1 {\n  uint32_t size;\n  uint32_t version;\n  uint64_t (*start)(const request *req, result *res);\n  int (*poll)(uint64_t handle, result *res, uint8_t *data, uint32_t cap);\n  void (*cancel)(uint64_t handle);\n  int (*node_state)(uint8_t network, uint8_t node, uint8_t *state);\n  int (*kernel_state)(uint8_t network, uint8_t *state);\n  int (*local_node_id)(uint8_t network, uint8_t *node_id);\n  int (*emcy_cursor)(uint8_t network, uint64_t *cursor);\n  int (*emcy_next)(uint8_t network, uint8_t node, uint64_t *cursor, emcy *out);\n  uint32_t flags;  // present when size covers it\n};\n// flags: the plugin is never unmapped, so its table stays valid for the life of the process.\nconst uint32_t flag_permanent = 0x1;\n// node_info::flags\nconst uint8_t node_enabled = 0x01;\nconst uint8_t node_optional = 0x02;\nconst uint8_t node_program_start = 0x04;\nconst uint32_t status_text = 80;\nstruct node_info {\n  uint8_t run_state;\n  uint8_t flags;\n  uint8_t reserved[2];\n  char problem[status_text];\n};\nstruct network_info {\n  uint8_t mandatory_up;\n  uint8_t optional_up;\n  uint8_t configured;\n  uint8_t operational;\n  uint8_t waiting;\n  uint8_t disabled;\n  uint8_t faulty;\n  uint8_t nodes;\n};\nstruct api_v2 {\n  api_v1 v1;\n  int (*node_status)(uint8_t network, uint8_t node, node_info *out);\n  int (*network_status)(uint8_t network, network_info *out);\n  int (*node_enable)(uint8_t network, uint8_t node, uint8_t on);\n};\n// slave_info::flags\nconst uint8_t slave_on_bus = 0x01;\nconst uint8_t slave_master_watched = 0x02;\nconst uint8_t slave_master_seen = 0x04;\nconst uint32_t slave_emcy_slots = 31;\nstruct slave_info {\n  uint8_t state;\n  uint8_t node_id;\n  uint8_t flags;\n  uint8_t bus_state;\n  uint8_t error_register;\n  uint8_t emcy_active;\n  uint8_t reserved[2];\n};\nstruct api_v3 {\n  api_v2 v2;\n  int (*slave_status)(uint8_t slave, slave_info *out);\n  int (*slave_nmt)(uint8_t slave, uint8_t command);\n  int (*slave_nmt_done)(uint8_t slave, uint8_t command, uint8_t *done);\n  int (*slave_emcy_claim)(uint8_t slave, uint32_t *handle);\n  int (*slave_emcy)(uint8_t slave, uint32_t handle, uint8_t active, uint16_t code, uint32_t info);\n  int (*slave_written)(uint8_t slave, uint16_t index, uint8_t subindex, uint32_t *count);\n};\n// After a lookup that found no plugin, this many lookups are skipped before the next one.\nconst uint32_t miss_skip = 1024;\n\n// The loaded plugin's table, or null with `why` set (r_not_run or r_version). The runtime loads\n// the plugin again at each PLC start while this program stays loaded, so a table is kept only\n// when its flags say it stays valid; otherwise it is looked up on each call. While no plugin is\n// found, only one lookup in miss_skip runs; the others answer r_not_run at once.\ninline const api_v1 *lookup_api(uint8_t &why) {\n  const void *table = nullptr;\n  why = r_not_run;\n#if defined(__linux__)\n  void *lib = dlopen(\"libcanopen_plugin.so\", 0x2 | 0x4);  // RTLD_NOW | RTLD_NOLOAD\n  if (!lib) return nullptr;\n  typedef const void *(*entry_t)(uint32_t);\n  entry_t entry = reinterpret_cast<entry_t>(dlsym(lib, \"canopen_plc_api\"));\n  if (entry) {\n    table = entry(api_version);\n    if (!table) why = r_version;\n  }\n  dlclose(lib);\n#else\n  if (canopen_plc_api) {\n    table = canopen_plc_api(api_version);\n    if (!table) why = r_version;\n  }\n#endif\n  const api_v1 *t = static_cast<const api_v1 *>(table);\n  if (t && t->size < __builtin_offsetof(api_v1, flags)) {\n    why = r_version;\n    return nullptr;\n  }\n  return t;\n}\n\ninline bool api_is_permanent(const api_v1 *t) {\n  return t->size >= sizeof(api_v1) && (t->flags & flag_permanent) != 0;\n}\n\ninline const api_v1 *api(uint8_t &why) {\n  static const api_v1 *kept = nullptr;\n  static uint32_t skip = 0;\n  const api_v1 *t = __atomic_load_n(&kept, __ATOMIC_ACQUIRE);\n  if (t) {\n    why = r_not_run;\n    return t;\n  }\n  uint32_t left = __atomic_load_n(&skip, __ATOMIC_RELAXED);\n  if (left > 0) {\n    __atomic_store_n(&skip, left - 1, __ATOMIC_RELAXED);\n    why = r_not_run;\n    return nullptr;\n  }\n  t = lookup_api(why);\n  if (!t) {\n    if (why == r_not_run) __atomic_store_n(&skip, miss_skip, __ATOMIC_RELAXED);\n    return nullptr;\n  }\n  if (api_is_permanent(t)) __atomic_store_n(&kept, t, __ATOMIC_RELEASE);\n  return t;\n}\n\n// The table with the version 2 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v2 *api2(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 2 || t->size < sizeof(api_v2)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v2 *>(static_cast<const void *>(t));\n}\n\n// The table with the version 3 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v3 *api3(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 3 || t->size < sizeof(api_v3)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v3 *>(static_cast<const void *>(t));\n}\n\n// ---- Error text, written into a fixed buffer (no allocation, no libc). ----\nstruct text {\n  char buf[200];\n  unsigned len;\n};\ninline void clear(text &t) {\n  t.len = 0;\n  t.buf[0] = 0;\n}\ninline void put(text &t, const char *s) {\n  while (*s && t.len + 1 < sizeof t.buf) t.buf[t.len++] = *s++;\n  t.buf[t.len] = 0;\n}\ninline void put_dec(text &t, uint32_t v) {\n  char d[12];\n  int n = 0;\n  do {\n    d[n++] = static_cast<char>('0' + v % 10);\n    v /= 10;\n  } while (v && n < 12);\n  while (n > 0 && t.len + 1 < sizeof t.buf) t.buf[t.len++] = d[--n];\n  t.buf[t.len] = 0;\n}\ninline void put_hex(text &t, uint32_t v, int digits) {\n  put(t, \"16#\");\n  for (int i = digits - 1; i >= 0 && t.len + 1 < sizeof t.buf; --i)\n    t.buf[t.len++] = \"0123456789ABCDEF\"[(v >> (4 * i)) & 0xF];\n  t.buf[t.len] = 0;\n}\n\n// CiA 301 SDO abort codes.\ninline const char *abort_text(uint32_t code) {\n  switch (code) {\n    case 0x05030000u: return \"toggle bit not alternated\";\n    case 0x05040000u: return \"SDO protocol timed out\";\n    case 0x05040001u: return \"command specifier not valid or unknown\";\n    case 0x05040002u: return \"invalid block size\";\n    case 0x05040003u: return \"invalid sequence number\";\n    case 0x05040004u: return \"CRC error\";\n    case 0x05040005u: return \"out of memory\";\n    case 0x06010000u: return \"unsupported access to an object\";\n    case 0x06010001u: return \"attempt to read a write only object\";\n    case 0x06010002u: return \"attempt to write a read only object\";\n    case 0x06020000u: return \"object does not exist\";\n    case 0x06040041u: return \"object cannot be mapped to the PDO\";\n    case 0x06040042u: return \"the mapped objects would exceed the PDO length\";\n    case 0x06040043u: return \"general parameter incompatibility\";\n    case 0x06040047u: return \"general internal incompatibility in the device\";\n    case 0x06060000u: return \"access failed due to a hardware error\";\n    case 0x06070010u: return \"data type or length does not match\";\n    case 0x06070012u: return \"data type does not match, length too high\";\n    case 0x06070013u: return \"data type does not match, length too low\";\n    case 0x06090011u: return \"sub-index does not exist\";\n    case 0x06090030u: return \"invalid value for parameter\";\n    case 0x06090031u: return \"value of parameter written too high\";\n    case 0x06090032u: return \"value of parameter written too low\";\n    case 0x06090036u: return \"maximum value is less than minimum value\";\n    case 0x060A0023u: return \"resource not available: SDO connection\";\n    case 0x08000000u: return \"general error\";\n    case 0x08000020u: return \"data cannot be transferred or stored to the application\";\n    case 0x08000021u: return \"data cannot be transferred or stored because of local control\";\n    case 0x08000022u: return \"data cannot be transferred or stored in the present device state\";\n    case 0x08000023u: return \"no object dictionary is present\";\n    case 0x08000024u: return \"no data available\";\n    default: return \"unknown abort code\";\n  }\n}\n\n// What a request was about, for its error text.\nstruct what {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint16_t index;\n  uint8_t subindex;\n  uint32_t timeout_ms;\n  uint32_t capacity;  // bytes the block holds\n};\n\ninline what what_of(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex,\n                    uint32_t timeout_ms, uint32_t capacity) {\n  what w{};\n  w.network = network;\n  w.node = node;\n  w.index = index;\n  w.subindex = subindex;\n  w.timeout_ms = timeout_ms;\n  w.capacity = capacity;\n  return w;\n}\n\ninline void put_node(text &t, const what &w) {\n  if (w.node == 0) {\n    put(t, \"the nodes of network \");\n    put_dec(t, w.network);\n  } else {\n    put(t, \"node \");\n    put_dec(t, w.node);\n  }\n}\n\ninline void put_object(text &t, const what &w) {\n  put_hex(t, w.index, 4);\n  put(t, \" sub \");\n  put_dec(t, w.subindex);\n}\n\n// The error text of a failed request, and its ERRORINFO.\ninline uint32_t describe(text &t, const what &w, const result &r) {\n  clear(t);\n  switch (r.error) {\n    case e_other_error:\n      put_node(t, w);\n      put(t, \" aborted \");\n      put_object(t, w);\n      put(t, \": \");\n      put(t, abort_text(r.abort_code));\n      put(t, \" (\");\n      put_hex(t, r.abort_code, 8);\n      put(t, \")\");\n      return r.abort_code;\n    case e_timeout:\n      put_node(t, w);\n      put(t, \" did not answer\");\n      if (w.timeout_ms) {\n        put(t, \" within \");\n        put_dec(t, w.timeout_ms);\n        put(t, \" ms\");\n      }\n      return r.abort_code ? r.abort_code : 0x05040000u;\n    case e_bus_off:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, r.reason == r_link ? \" link is down\" : \" bus is off\");\n      return 0;\n    case e_error_passive:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" is error passive\");\n      return 0;\n    case e_wrong_parameter:\n      if (r.reason == r_too_large) {\n        put(t, \"object has \");\n        put_dec(t, r.length);\n        put(t, \" bytes, the block holds \");\n        put_dec(t, w.capacity);\n        return r.length;\n      }\n      if (r.reason == r_length) {\n        put(t, \"DATALENGTH \");\n        put_dec(t, r.length);\n        put(t, \" is not 1 to \");\n        put_dec(t, w.capacity);\n        return 0;\n      }\n      if (r.reason == r_not_in_eds) {\n        put_node(t, w);\n        put(t, \" has no object \");\n        put_object(t, w);\n        put(t, \" of 1 to 4 bytes in its EDS; set DATALENGTH\");\n        return 0;\n      }\n      if (r.reason == r_command) {\n        put(t, \"STATE \");\n        put_dec(t, r.length);\n        put(t, \" is not an NMT state change\");\n        return 0;\n      }\n      put(t, \"wrong parameter\");\n      return 0;\n    case e_node_id_unknown:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" has no node \");\n      put_dec(t, w.node);\n      return 0;\n    case e_net_id_unknown:\n      put(t, \"no CANopen network \");\n      put_dec(t, w.network);\n      return 0;\n    case e_request_error:\n      if (r.reason == r_booting) {\n        put_node(t, w);\n        put(t, \" is booting\");\n      } else if (r.reason == r_full) {\n        put(t, \"network \");\n        put_dec(t, w.network);\n        put(t, \" has 16 block requests waiting\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return 0;\n    case e_no_driver:\n      if (r.reason == r_restart)\n        put(t, \"request cancelled by the PLC stop\");\n      else if (r.reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else if (r.reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else\n        put(t, \"no CANopen network runs\");\n      return 0;\n    default:\n      put(t, \"internal error in the CANopen master\");\n      return 0;\n  }\n}\n\n// The error text of a slave block, for `slave` and the object (index, subindex) or ERRORCODE.\ninline void describe_slave(text &t, uint8_t slave, uint8_t error, uint8_t reason, uint16_t index,\n                           uint8_t subindex) {\n  clear(t);\n  switch (error) {\n    case e_no_error:\n      return;\n    case e_net_id_unknown:\n      put(t, \"no CANopen slave \");\n      put_dec(t, slave);\n      return;\n    case e_no_driver:\n      if (reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else if (reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else\n        put(t, \"no CANopen slave runs\");\n      return;\n    case e_wrong_parameter:\n      if (reason == r_reset) {\n        put(t, \"the program cannot reset the slave; STATE must be START_REMOTE_NODE, \");\n        put(t, \"STOP_REMOTE_NODE or ENTER_PRE_OPERATIONAL\");\n      } else if (reason == r_own_code) {\n        put(t, \"ERRORCODE \");\n        put_hex(t, index, 4);\n        put(t, \" is sent by the slave itself; use another code\");\n      } else if (reason == r_object) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" has no object \");\n        put_hex(t, index, 4);\n        put(t, \" sub \");\n        put_dec(t, subindex);\n        put(t, \" written by the master\");\n      } else {\n        put(t, \"wrong parameter\");\n      }\n      return;\n    case e_request_error:\n      if (reason == r_slots) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" already holds 31 program emergencies\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return;\n    default:\n      put(t, \"internal error in the CANopen slave\");\n      return;\n  }\n}\n\n// Shows a failed request on the block's ERROR, ERRORINFO and ERRORTEXT pins.\ntemplate <class error_pin, class info_pin, class text_pin>\ninline void show(error_pin &error, info_pin &info, text_pin &errortext, const what &w,\n                 const result &r) {\n  text t;\n  uint32_t i = describe(t, w, r);\n  error = r.error ? r.error : static_cast<uint8_t>(e_internal);\n  info = i;\n  errortext = t.buf;\n}\n\n// The size of an object of 1 to 4 bytes in the node's EDS, from the table the editor's build\n// generates (sorted network, node, index, sub-index, size); 0 when it is not listed.\ninline uint32_t eds_size(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex) {\n  const uint64_t key = (static_cast<uint64_t>(network) << 32) | (static_cast<uint64_t>(node) << 24) |\n                       (static_cast<uint64_t>(index) << 8) | subindex;\n  long lo = 0;\n  long hi = static_cast<long>(static_cast<uint32_t>(strucpp::CANOPEN_OBJECT_SIZE_COUNT)) - 1;\n  while (lo <= hi) {\n    long mid = (lo + hi) / 2;\n    uint64_t entry = static_cast<uint64_t>(strucpp::CANOPEN_OBJECT_SIZES[mid]);\n    uint64_t k = entry >> 8;\n    if (k == key) return static_cast<uint32_t>(entry & 0xFF);\n    if (k < key)\n      lo = mid + 1;\n    else\n      hi = mid - 1;\n  }\n  return 0;\n}\n\n// TIME (nanoseconds) to milliseconds; 0 or less: the network's SDO timeout.\ninline uint32_t timeout_ms(long long ns) {\n  if (ns <= 0) return 0;\n  long long ms = (ns + 999999) / 1000000;\n  return ms > 3600000 ? 3600000u : static_cast<uint32_t>(ms);\n}\n\n// One instance's handshake (CiA 405): the block keeps `prev`, `phase` and `handle` in its locals.\nenum { phase_idle = 0, phase_busy = 1, phase_ended = 2 };\nstruct step {\n  bool start;   // rising edge of ENABLE: clear the outputs and start a request\n  bool cancel;  // falling edge while busy: drop the request and clear the outputs\n  bool clear;   // the result was shown and ENABLE is FALSE: clear the outputs\n};\ninline step begin(bool enable, bool &prev, uint8_t &phase) {\n  step s{false, false, false};\n  bool rising = enable && !prev;\n  prev = enable;\n  if (!enable && phase == phase_busy) {\n    s.cancel = true;\n    phase = phase_idle;\n  } else if (!enable && phase == phase_ended) {\n    s.clear = true;\n    phase = phase_idle;\n  }\n  if (rising && phase != phase_busy) s.start = true;\n  return s;\n}\n\n// Starts `req`. Returns the handle, or 0 with `res` saying why it cannot run.\ninline uint64_t start(const request &req, result &res) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why;\n    return 0;\n  }\n  uint64_t handle = t->start(&req, &res);\n  if (!handle && res.error == e_no_error) res.error = e_internal;\n  return handle;\n}\n\n// 0 while the request runs; 1 done, 2 failed (`res` set).\ninline int poll(uint64_t handle, result &res, uint8_t *data, uint32_t cap) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why == r_version ? r_version : r_restart;\n    return 2;\n  }\n  return t->poll(handle, &res, data, cap);\n}\n\ninline void cancel(uint64_t handle) {\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (t) t->cancel(handle);\n}\n\ninline void put_le(uint8_t *out, uint32_t v, unsigned n) {\n  for (unsigned b = 0; b < n; ++b) out[b] = static_cast<uint8_t>(v >> (8 * b));\n}\n\ninline uint32_t get_le(const uint8_t *in, unsigned n) {\n  uint32_t v = 0;\n  for (unsigned b = 0; b < n && b < 4; ++b) v |= static_cast<uint32_t>(in[b]) << (8 * b);\n  return v;\n}\n\n// A failure before any request ran (bad input): `res` for describe().\ninline result fail(uint8_t error, uint8_t reason, uint32_t length) {\n  result r{};\n  r.error = error;\n  r.reason = reason;\n  r.length = length;\n  return r;\n}\n\n}  // namespace canopen_fb\n#endif\nvoid setup() {\n}\n\nvoid loop() {\n  if (!ENABLE) {\n    CONFIRM = false;\n    ERROR = 0;\n    ERRORTEXT = \"\";\n    cop_last = 0;\n    return;\n  }\n  uint8_t l_why = 0;\n  const canopen_fb::api_v2 *l_api = canopen_fb::api2(l_why);\n  int l_error = canopen_fb::e_no_driver;\n  uint8_t l_node = 0;\n  if (l_api) {\n    canopen_fb::node_info l_status;\n    l_node = DEVICE;\n    l_error = l_api->node_status(NETWORK, l_node, &l_status);\n    if (l_error == canopen_fb::e_no_error) {\n      RUNSTATE = l_status.run_state;\n      ENABLED = (l_status.flags & canopen_fb::node_enabled) != 0;\n      OPTIONAL = (l_status.flags & canopen_fb::node_optional) != 0;\n      PROGRAMSTART = (l_status.flags & canopen_fb::node_program_start) != 0;\n      l_status.problem[canopen_fb::status_text - 1] = 0;\n      ERRORTEXT = l_status.problem;\n    }\n  }\n  CONFIRM = l_error == canopen_fb::e_no_error;\n  ERROR = static_cast<uint8_t>(l_error);\n  if (l_error != cop_last) {\n    canopen_fb::result l_res = canopen_fb::fail(static_cast<uint8_t>(l_error), l_api ? 0 : l_why, 0);\n    canopen_fb::text l_text;\n    canopen_fb::clear(l_text);\n    if (l_error != canopen_fb::e_no_error)\n      canopen_fb::describe(l_text, canopen_fb::what_of(NETWORK, l_node, 0, 0, 0, 0), l_res);\n    if (l_error != canopen_fb::e_no_error) ERRORTEXT = l_text.buf;\n    cop_last = static_cast<uint8_t>(l_error);\n  }\n}\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "CANOPEN_NETWORK_STATE.cpp",
      "source": "(* Gives the state of a whole network, in the same call while ENABLE is TRUE: MANDATORY_UP when every mandatory node that is on is operational or waits for the program's start, OPTIONAL_UP the same for the optional nodes, and the number of nodes CONFIGURED (operational, waiting or set by hand), OPERATIONAL, WAITING for the program's start, DISABLED (off) and FAULTY (failed, lost, held, or mandatory and not answering). Nodes that are off count in neither flag. NETWORK counts from 1.\nExample: net(ENABLE := TRUE); IF net.MANDATORY_UP THEN start(ENABLE := TRUE, DEVICE := IO_Module, STATE := START_REMOTE_NODE); END_IF; *)\nFUNCTION_BLOCK CANOPEN_NETWORK_STATE\nVAR_INPUT\n  NETWORK : USINT := 1;\n  ENABLE : BOOL;\nEND_VAR\nVAR_OUTPUT\n  CONFIRM : BOOL;\n  ERROR : USINT;\n  ERRORTEXT : STRING;\n  MANDATORY_UP : BOOL;\n  OPTIONAL_UP : BOOL;\n  CONFIGURED : USINT;\n  OPERATIONAL : USINT;\n  WAITING : USINT;\n  DISABLED : USINT;\n  FAULTY : USINT;\nEND_VAR\nVAR\n  cop_last : USINT;\nEND_VAR\n// SPDX-License-Identifier: Apache-2.0\n//\n// Shared code of the canopen function blocks. The generator copies it into every block's source,\n// because the editor grafts each library C++ block into one c_blocks_code.cpp and has no other\n// place for shared code; the include guard keeps one copy per program.\n//\n// The editor binds every pin and local of a block to a #define of its name, so nothing here uses\n// a pin or local name (those are upper case or start with cop_; this code is lower case), nor the\n// keyword that closes a variable section, and no system header is included after those defines:\n// dlopen, dlsym and dlclose are declared here as glibc declares them.\n//\n// Derived from canworks ec7fd59, library/src/common.inc (Apache-2.0), adapted to the plugin's\n// interface version 3 (core/src/drivers/plugins/native/canopen/plc_api.h in the runtime fork).\n#ifndef CANOPEN_FB_SHARED_INCLUDED\n#define CANOPEN_FB_SHARED_INCLUDED\n#if defined(__linux__)\nextern \"C\" void *dlopen(const char *file, int mode) noexcept(true);\nextern \"C\" void *dlsym(void *handle, const char *name) noexcept(true);\nextern \"C\" int dlclose(void *handle) noexcept(true);\n#else\n// A board's firmware: the slave module's table, when the project has a slave on the board.\nextern \"C\" const void *canopen_plc_api(uint32_t version) __attribute__((weak));\n#endif\n\nnamespace canopen_fb {\n\n// A copy of the plugin's C interface, version 3; keep in step with plc_api.h. Version 1 is asked\n// for, since a newer plugin answers it with its newest table; `size` tells which it is.\nconst uint32_t api_version = 1;\nconst uint32_t max_data = 256;\nenum {\n  e_no_error = 0, e_other_error = 1, e_timeout = 2, e_bus_off = 3, e_error_passive = 4,\n  e_internal = 5, e_wrong_parameter = 6, e_node_id_unknown = 7, e_net_id_unknown = 8,\n  e_request_error = 9, e_no_driver = 10\n};\nenum {\n  r_none = 0, r_booting = 1, r_full = 2, r_not_run = 3, r_restart = 4, r_link = 5,\n  r_too_large = 6, r_length = 7, r_command = 8, r_version = 9,\n  r_not_in_eds = 100,  // the blocks' own: DATALENGTH 0 for an object the EDS does not list\n  r_needs_v2 = 101,    // the blocks' own: the plugin's table lacks the functions the block needs\n  r_reset = 102,       // the blocks' own: a slave NMT block asked for a reset\n  r_own_code = 103,    // the blocks' own: an emergency code the slave sends itself\n  r_slots = 104,       // the blocks' own: all program emergency slots are taken\n  r_object = 105       // the blocks' own: the slave has no such object from the master\n};\nenum { k_read = 0, k_write = 1, k_nmt = 2 };\nstruct request {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint8_t command;\n  uint16_t index;\n  uint8_t subindex;\n  uint8_t reserved;\n  uint32_t timeout_ms;\n  uint32_t length;\n  const uint8_t *data;\n};\nstruct result {\n  uint8_t error;\n  uint8_t reason;\n  uint16_t reserved;\n  uint32_t abort_code;\n  uint32_t length;\n};\nstruct emcy {\n  uint8_t node;\n  uint8_t error_register;\n  uint16_t error_code;\n  uint8_t data[5];\n  uint8_t reserved[3];\n  uint32_t lost;\n};\nstruct api_v1 {\n  uint32_t size;\n  uint32_t version;\n  uint64_t (*start)(const request *req, result *res);\n  int (*poll)(uint64_t handle, result *res, uint8_t *data, uint32_t cap);\n  void (*cancel)(uint64_t handle);\n  int (*node_state)(uint8_t network, uint8_t node, uint8_t *state);\n  int (*kernel_state)(uint8_t network, uint8_t *state);\n  int (*local_node_id)(uint8_t network, uint8_t *node_id);\n  int (*emcy_cursor)(uint8_t network, uint64_t *cursor);\n  int (*emcy_next)(uint8_t network, uint8_t node, uint64_t *cursor, emcy *out);\n  uint32_t flags;  // present when size covers it\n};\n// flags: the plugin is never unmapped, so its table stays valid for the life of the process.\nconst uint32_t flag_permanent = 0x1;\n// node_info::flags\nconst uint8_t node_enabled = 0x01;\nconst uint8_t node_optional = 0x02;\nconst uint8_t node_program_start = 0x04;\nconst uint32_t status_text = 80;\nstruct node_info {\n  uint8_t run_state;\n  uint8_t flags;\n  uint8_t reserved[2];\n  char problem[status_text];\n};\nstruct network_info {\n  uint8_t mandatory_up;\n  uint8_t optional_up;\n  uint8_t configured;\n  uint8_t operational;\n  uint8_t waiting;\n  uint8_t disabled;\n  uint8_t faulty;\n  uint8_t nodes;\n};\nstruct api_v2 {\n  api_v1 v1;\n  int (*node_status)(uint8_t network, uint8_t node, node_info *out);\n  int (*network_status)(uint8_t network, network_info *out);\n  int (*node_enable)(uint8_t network, uint8_t node, uint8_t on);\n};\n// slave_info::flags\nconst uint8_t slave_on_bus = 0x01;\nconst uint8_t slave_master_watched = 0x02;\nconst uint8_t slave_master_seen = 0x04;\nconst uint32_t slave_emcy_slots = 31;\nstruct slave_info {\n  uint8_t state;\n  uint8_t node_id;\n  uint8_t flags;\n  uint8_t bus_state;\n  uint8_t error_register;\n  uint8_t emcy_active;\n  uint8_t reserved[2];\n};\nstruct api_v3 {\n  api_v2 v2;\n  int (*slave_status)(uint8_t slave, slave_info *out);\n  int (*slave_nmt)(uint8_t slave, uint8_t command);\n  int (*slave_nmt_done)(uint8_t slave, uint8_t command, uint8_t *done);\n  int (*slave_emcy_claim)(uint8_t slave, uint32_t *handle);\n  int (*slave_emcy)(uint8_t slave, uint32_t handle, uint8_t active, uint16_t code, uint32_t info);\n  int (*slave_written)(uint8_t slave, uint16_t index, uint8_t subindex, uint32_t *count);\n};\n// After a lookup that found no plugin, this many lookups are skipped before the next one.\nconst uint32_t miss_skip = 1024;\n\n// The loaded plugin's table, or null with `why` set (r_not_run or r_version). The runtime loads\n// the plugin again at each PLC start while this program stays loaded, so a table is kept only\n// when its flags say it stays valid; otherwise it is looked up on each call. While no plugin is\n// found, only one lookup in miss_skip runs; the others answer r_not_run at once.\ninline const api_v1 *lookup_api(uint8_t &why) {\n  const void *table = nullptr;\n  why = r_not_run;\n#if defined(__linux__)\n  void *lib = dlopen(\"libcanopen_plugin.so\", 0x2 | 0x4);  // RTLD_NOW | RTLD_NOLOAD\n  if (!lib) return nullptr;\n  typedef const void *(*entry_t)(uint32_t);\n  entry_t entry = reinterpret_cast<entry_t>(dlsym(lib, \"canopen_plc_api\"));\n  if (entry) {\n    table = entry(api_version);\n    if (!table) why = r_version;\n  }\n  dlclose(lib);\n#else\n  if (canopen_plc_api) {\n    table = canopen_plc_api(api_version);\n    if (!table) why = r_version;\n  }\n#endif\n  const api_v1 *t = static_cast<const api_v1 *>(table);\n  if (t && t->size < __builtin_offsetof(api_v1, flags)) {\n    why = r_version;\n    return nullptr;\n  }\n  return t;\n}\n\ninline bool api_is_permanent(const api_v1 *t) {\n  return t->size >= sizeof(api_v1) && (t->flags & flag_permanent) != 0;\n}\n\ninline const api_v1 *api(uint8_t &why) {\n  static const api_v1 *kept = nullptr;\n  static uint32_t skip = 0;\n  const api_v1 *t = __atomic_load_n(&kept, __ATOMIC_ACQUIRE);\n  if (t) {\n    why = r_not_run;\n    return t;\n  }\n  uint32_t left = __atomic_load_n(&skip, __ATOMIC_RELAXED);\n  if (left > 0) {\n    __atomic_store_n(&skip, left - 1, __ATOMIC_RELAXED);\n    why = r_not_run;\n    return nullptr;\n  }\n  t = lookup_api(why);\n  if (!t) {\n    if (why == r_not_run) __atomic_store_n(&skip, miss_skip, __ATOMIC_RELAXED);\n    return nullptr;\n  }\n  if (api_is_permanent(t)) __atomic_store_n(&kept, t, __ATOMIC_RELEASE);\n  return t;\n}\n\n// The table with the version 2 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v2 *api2(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 2 || t->size < sizeof(api_v2)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v2 *>(static_cast<const void *>(t));\n}\n\n// The table with the version 3 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v3 *api3(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 3 || t->size < sizeof(api_v3)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v3 *>(static_cast<const void *>(t));\n}\n\n// ---- Error text, written into a fixed buffer (no allocation, no libc). ----\nstruct text {\n  char buf[200];\n  unsigned len;\n};\ninline void clear(text &t) {\n  t.len = 0;\n  t.buf[0] = 0;\n}\ninline void put(text &t, const char *s) {\n  while (*s && t.len + 1 < sizeof t.buf) t.buf[t.len++] = *s++;\n  t.buf[t.len] = 0;\n}\ninline void put_dec(text &t, uint32_t v) {\n  char d[12];\n  int n = 0;\n  do {\n    d[n++] = static_cast<char>('0' + v % 10);\n    v /= 10;\n  } while (v && n < 12);\n  while (n > 0 && t.len + 1 < sizeof t.buf) t.buf[t.len++] = d[--n];\n  t.buf[t.len] = 0;\n}\ninline void put_hex(text &t, uint32_t v, int digits) {\n  put(t, \"16#\");\n  for (int i = digits - 1; i >= 0 && t.len + 1 < sizeof t.buf; --i)\n    t.buf[t.len++] = \"0123456789ABCDEF\"[(v >> (4 * i)) & 0xF];\n  t.buf[t.len] = 0;\n}\n\n// CiA 301 SDO abort codes.\ninline const char *abort_text(uint32_t code) {\n  switch (code) {\n    case 0x05030000u: return \"toggle bit not alternated\";\n    case 0x05040000u: return \"SDO protocol timed out\";\n    case 0x05040001u: return \"command specifier not valid or unknown\";\n    case 0x05040002u: return \"invalid block size\";\n    case 0x05040003u: return \"invalid sequence number\";\n    case 0x05040004u: return \"CRC error\";\n    case 0x05040005u: return \"out of memory\";\n    case 0x06010000u: return \"unsupported access to an object\";\n    case 0x06010001u: return \"attempt to read a write only object\";\n    case 0x06010002u: return \"attempt to write a read only object\";\n    case 0x06020000u: return \"object does not exist\";\n    case 0x06040041u: return \"object cannot be mapped to the PDO\";\n    case 0x06040042u: return \"the mapped objects would exceed the PDO length\";\n    case 0x06040043u: return \"general parameter incompatibility\";\n    case 0x06040047u: return \"general internal incompatibility in the device\";\n    case 0x06060000u: return \"access failed due to a hardware error\";\n    case 0x06070010u: return \"data type or length does not match\";\n    case 0x06070012u: return \"data type does not match, length too high\";\n    case 0x06070013u: return \"data type does not match, length too low\";\n    case 0x06090011u: return \"sub-index does not exist\";\n    case 0x06090030u: return \"invalid value for parameter\";\n    case 0x06090031u: return \"value of parameter written too high\";\n    case 0x06090032u: return \"value of parameter written too low\";\n    case 0x06090036u: return \"maximum value is less than minimum value\";\n    case 0x060A0023u: return \"resource not available: SDO connection\";\n    case 0x08000000u: return \"general error\";\n    case 0x08000020u: return \"data cannot be transferred or stored to the application\";\n    case 0x08000021u: return \"data cannot be transferred or stored because of local control\";\n    case 0x08000022u: return \"data cannot be transferred or stored in the present device state\";\n    case 0x08000023u: return \"no object dictionary is present\";\n    case 0x08000024u: return \"no data available\";\n    default: return \"unknown abort code\";\n  }\n}\n\n// What a request was about, for its error text.\nstruct what {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint16_t index;\n  uint8_t subindex;\n  uint32_t timeout_ms;\n  uint32_t capacity;  // bytes the block holds\n};\n\ninline what what_of(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex,\n                    uint32_t timeout_ms, uint32_t capacity) {\n  what w{};\n  w.network = network;\n  w.node = node;\n  w.index = index;\n  w.subindex = subindex;\n  w.timeout_ms = timeout_ms;\n  w.capacity = capacity;\n  return w;\n}\n\ninline void put_node(text &t, const what &w) {\n  if (w.node == 0) {\n    put(t, \"the nodes of network \");\n    put_dec(t, w.network);\n  } else {\n    put(t, \"node \");\n    put_dec(t, w.node);\n  }\n}\n\ninline void put_object(text &t, const what &w) {\n  put_hex(t, w.index, 4);\n  put(t, \" sub \");\n  put_dec(t, w.subindex);\n}\n\n// The error text of a failed request, and its ERRORINFO.\ninline uint32_t describe(text &t, const what &w, const result &r) {\n  clear(t);\n  switch (r.error) {\n    case e_other_error:\n      put_node(t, w);\n      put(t, \" aborted \");\n      put_object(t, w);\n      put(t, \": \");\n      put(t, abort_text(r.abort_code));\n      put(t, \" (\");\n      put_hex(t, r.abort_code, 8);\n      put(t, \")\");\n      return r.abort_code;\n    case e_timeout:\n      put_node(t, w);\n      put(t, \" did not answer\");\n      if (w.timeout_ms) {\n        put(t, \" within \");\n        put_dec(t, w.timeout_ms);\n        put(t, \" ms\");\n      }\n      return r.abort_code ? r.abort_code : 0x05040000u;\n    case e_bus_off:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, r.reason == r_link ? \" link is down\" : \" bus is off\");\n      return 0;\n    case e_error_passive:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" is error passive\");\n      return 0;\n    case e_wrong_parameter:\n      if (r.reason == r_too_large) {\n        put(t, \"object has \");\n        put_dec(t, r.length);\n        put(t, \" bytes, the block holds \");\n        put_dec(t, w.capacity);\n        return r.length;\n      }\n      if (r.reason == r_length) {\n        put(t, \"DATALENGTH \");\n        put_dec(t, r.length);\n        put(t, \" is not 1 to \");\n        put_dec(t, w.capacity);\n        return 0;\n      }\n      if (r.reason == r_not_in_eds) {\n        put_node(t, w);\n        put(t, \" has no object \");\n        put_object(t, w);\n        put(t, \" of 1 to 4 bytes in its EDS; set DATALENGTH\");\n        return 0;\n      }\n      if (r.reason == r_command) {\n        put(t, \"STATE \");\n        put_dec(t, r.length);\n        put(t, \" is not an NMT state change\");\n        return 0;\n      }\n      put(t, \"wrong parameter\");\n      return 0;\n    case e_node_id_unknown:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" has no node \");\n      put_dec(t, w.node);\n      return 0;\n    case e_net_id_unknown:\n      put(t, \"no CANopen network \");\n      put_dec(t, w.network);\n      return 0;\n    case e_request_error:\n      if (r.reason == r_booting) {\n        put_node(t, w);\n        put(t, \" is booting\");\n      } else if (r.reason == r_full) {\n        put(t, \"network \");\n        put_dec(t, w.network);\n        put(t, \" has 16 block requests waiting\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return 0;\n    case e_no_driver:\n      if (r.reason == r_restart)\n        put(t, \"request cancelled by the PLC stop\");\n      else if (r.reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else if (r.reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else\n        put(t, \"no CANopen network runs\");\n      return 0;\n    default:\n      put(t, \"internal error in the CANopen master\");\n      return 0;\n  }\n}\n\n// The error text of a slave block, for `slave` and the object (index, subindex) or ERRORCODE.\ninline void describe_slave(text &t, uint8_t slave, uint8_t error, uint8_t reason, uint16_t index,\n                           uint8_t subindex) {\n  clear(t);\n  switch (error) {\n    case e_no_error:\n      return;\n    case e_net_id_unknown:\n      put(t, \"no CANopen slave \");\n      put_dec(t, slave);\n      return;\n    case e_no_driver:\n      if (reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else if (reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else\n        put(t, \"no CANopen slave runs\");\n      return;\n    case e_wrong_parameter:\n      if (reason == r_reset) {\n        put(t, \"the program cannot reset the slave; STATE must be START_REMOTE_NODE, \");\n        put(t, \"STOP_REMOTE_NODE or ENTER_PRE_OPERATIONAL\");\n      } else if (reason == r_own_code) {\n        put(t, \"ERRORCODE \");\n        put_hex(t, index, 4);\n        put(t, \" is sent by the slave itself; use another code\");\n      } else if (reason == r_object) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" has no object \");\n        put_hex(t, index, 4);\n        put(t, \" sub \");\n        put_dec(t, subindex);\n        put(t, \" written by the master\");\n      } else {\n        put(t, \"wrong parameter\");\n      }\n      return;\n    case e_request_error:\n      if (reason == r_slots) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" already holds 31 program emergencies\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return;\n    default:\n      put(t, \"internal error in the CANopen slave\");\n      return;\n  }\n}\n\n// Shows a failed request on the block's ERROR, ERRORINFO and ERRORTEXT pins.\ntemplate <class error_pin, class info_pin, class text_pin>\ninline void show(error_pin &error, info_pin &info, text_pin &errortext, const what &w,\n                 const result &r) {\n  text t;\n  uint32_t i = describe(t, w, r);\n  error = r.error ? r.error : static_cast<uint8_t>(e_internal);\n  info = i;\n  errortext = t.buf;\n}\n\n// The size of an object of 1 to 4 bytes in the node's EDS, from the table the editor's build\n// generates (sorted network, node, index, sub-index, size); 0 when it is not listed.\ninline uint32_t eds_size(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex) {\n  const uint64_t key = (static_cast<uint64_t>(network) << 32) | (static_cast<uint64_t>(node) << 24) |\n                       (static_cast<uint64_t>(index) << 8) | subindex;\n  long lo = 0;\n  long hi = static_cast<long>(static_cast<uint32_t>(strucpp::CANOPEN_OBJECT_SIZE_COUNT)) - 1;\n  while (lo <= hi) {\n    long mid = (lo + hi) / 2;\n    uint64_t entry = static_cast<uint64_t>(strucpp::CANOPEN_OBJECT_SIZES[mid]);\n    uint64_t k = entry >> 8;\n    if (k == key) return static_cast<uint32_t>(entry & 0xFF);\n    if (k < key)\n      lo = mid + 1;\n    else\n      hi = mid - 1;\n  }\n  return 0;\n}\n\n// TIME (nanoseconds) to milliseconds; 0 or less: the network's SDO timeout.\ninline uint32_t timeout_ms(long long ns) {\n  if (ns <= 0) return 0;\n  long long ms = (ns + 999999) / 1000000;\n  return ms > 3600000 ? 3600000u : static_cast<uint32_t>(ms);\n}\n\n// One instance's handshake (CiA 405): the block keeps `prev`, `phase` and `handle` in its locals.\nenum { phase_idle = 0, phase_busy = 1, phase_ended = 2 };\nstruct step {\n  bool start;   // rising edge of ENABLE: clear the outputs and start a request\n  bool cancel;  // falling edge while busy: drop the request and clear the outputs\n  bool clear;   // the result was shown and ENABLE is FALSE: clear the outputs\n};\ninline step begin(bool enable, bool &prev, uint8_t &phase) {\n  step s{false, false, false};\n  bool rising = enable && !prev;\n  prev = enable;\n  if (!enable && phase == phase_busy) {\n    s.cancel = true;\n    phase = phase_idle;\n  } else if (!enable && phase == phase_ended) {\n    s.clear = true;\n    phase = phase_idle;\n  }\n  if (rising && phase != phase_busy) s.start = true;\n  return s;\n}\n\n// Starts `req`. Returns the handle, or 0 with `res` saying why it cannot run.\ninline uint64_t start(const request &req, result &res) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why;\n    return 0;\n  }\n  uint64_t handle = t->start(&req, &res);\n  if (!handle && res.error == e_no_error) res.error = e_internal;\n  return handle;\n}\n\n// 0 while the request runs; 1 done, 2 failed (`res` set).\ninline int poll(uint64_t handle, result &res, uint8_t *data, uint32_t cap) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why == r_version ? r_version : r_restart;\n    return 2;\n  }\n  return t->poll(handle, &res, data, cap);\n}\n\ninline void cancel(uint64_t handle) {\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (t) t->cancel(handle);\n}\n\ninline void put_le(uint8_t *out, uint32_t v, unsigned n) {\n  for (unsigned b = 0; b < n; ++b) out[b] = static_cast<uint8_t>(v >> (8 * b));\n}\n\ninline uint32_t get_le(const uint8_t *in, unsigned n) {\n  uint32_t v = 0;\n  for (unsigned b = 0; b < n && b < 4; ++b) v |= static_cast<uint32_t>(in[b]) << (8 * b);\n  return v;\n}\n\n// A failure before any request ran (bad input): `res` for describe().\ninline result fail(uint8_t error, uint8_t reason, uint32_t length) {\n  result r{};\n  r.error = error;\n  r.reason = reason;\n  r.length = length;\n  return r;\n}\n\n}  // namespace canopen_fb\n#endif\nvoid setup() {\n}\n\nvoid loop() {\n  if (!ENABLE) {\n    CONFIRM = false;\n    ERROR = 0;\n    if (cop_last != 0) ERRORTEXT = \"\";\n    cop_last = 0;\n    return;\n  }\n  uint8_t l_why = 0;\n  const canopen_fb::api_v2 *l_api = canopen_fb::api2(l_why);\n  int l_error = canopen_fb::e_no_driver;\n  uint8_t l_node = 0;\n  if (l_api) {\n    canopen_fb::network_info l_net;\n    l_error = l_api->network_status(NETWORK, &l_net);\n    if (l_error == canopen_fb::e_no_error) {\n      MANDATORY_UP = l_net.mandatory_up != 0;\n      OPTIONAL_UP = l_net.optional_up != 0;\n      CONFIGURED = l_net.configured;\n      OPERATIONAL = l_net.operational;\n      WAITING = l_net.waiting;\n      DISABLED = l_net.disabled;\n      FAULTY = l_net.faulty;\n    }\n  }\n  CONFIRM = l_error == canopen_fb::e_no_error;\n  ERROR = static_cast<uint8_t>(l_error);\n  if (l_error != cop_last) {\n    canopen_fb::result l_res = canopen_fb::fail(static_cast<uint8_t>(l_error), l_api ? 0 : l_why, 0);\n    canopen_fb::text l_text;\n    canopen_fb::clear(l_text);\n    if (l_error != canopen_fb::e_no_error)\n      canopen_fb::describe(l_text, canopen_fb::what_of(NETWORK, l_node, 0, 0, 0, 0), l_res);\n    ERRORTEXT = l_text.buf;\n    cop_last = static_cast<uint8_t>(l_error);\n  }\n}\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "CANOPEN_SLAVE_STATUS.cpp",
      "source": "(* Gives the state of this runtime's CANopen slave, in the same call while ENABLE is TRUE: STATE (PRE_OPERATIONAL, OPERATIONAL, STOPPED, or NOT_AVAIL while its interface is not open), OPERATIONAL, the node ID in use in NODEID, whether the master's heartbeat is watched (MASTERWATCHED) and received (MASTERSEEN), the link in BUSSTATE (BUS_ERROR_ACTIVE, BUS_ERROR_PASSIVE, BUS_OFF or BUS_UNKNOWN), the error register 0x1001 in ERRORREGISTER and the number of active emergencies in EMCYACTIVE. The values are at most 100 ms old. SLAVE is the slave's name or its place in the project's slaves, from 1.\nExample: slave(SLAVE := Line_IO, ENABLE := TRUE); IF NOT slave.MASTERSEEN THEN ... END_IF; *)\nFUNCTION_BLOCK CANOPEN_SLAVE_STATUS\nVAR_INPUT\n  SLAVE : USINT := 1;\n  ENABLE : BOOL;\nEND_VAR\nVAR_OUTPUT\n  CONFIRM : BOOL;\n  ERROR : USINT;\n  ERRORTEXT : STRING;\n  STATE : USINT;\n  OPERATIONAL : BOOL;\n  NODEID : USINT;\n  MASTERWATCHED : BOOL;\n  MASTERSEEN : BOOL;\n  BUSSTATE : USINT;\n  ERRORREGISTER : BYTE;\n  EMCYACTIVE : USINT;\nEND_VAR\nVAR\n  cop_last : USINT;\n  cop_reason : USINT;\nEND_VAR\n// SPDX-License-Identifier: Apache-2.0\n//\n// Shared code of the canopen function blocks. The generator copies it into every block's source,\n// because the editor grafts each library C++ block into one c_blocks_code.cpp and has no other\n// place for shared code; the include guard keeps one copy per program.\n//\n// The editor binds every pin and local of a block to a #define of its name, so nothing here uses\n// a pin or local name (those are upper case or start with cop_; this code is lower case), nor the\n// keyword that closes a variable section, and no system header is included after those defines:\n// dlopen, dlsym and dlclose are declared here as glibc declares them.\n//\n// Derived from canworks ec7fd59, library/src/common.inc (Apache-2.0), adapted to the plugin's\n// interface version 3 (core/src/drivers/plugins/native/canopen/plc_api.h in the runtime fork).\n#ifndef CANOPEN_FB_SHARED_INCLUDED\n#define CANOPEN_FB_SHARED_INCLUDED\n#if defined(__linux__)\nextern \"C\" void *dlopen(const char *file, int mode) noexcept(true);\nextern \"C\" void *dlsym(void *handle, const char *name) noexcept(true);\nextern \"C\" int dlclose(void *handle) noexcept(true);\n#else\n// A board's firmware: the slave module's table, when the project has a slave on the board.\nextern \"C\" const void *canopen_plc_api(uint32_t version) __attribute__((weak));\n#endif\n\nnamespace canopen_fb {\n\n// A copy of the plugin's C interface, version 3; keep in step with plc_api.h. Version 1 is asked\n// for, since a newer plugin answers it with its newest table; `size` tells which it is.\nconst uint32_t api_version = 1;\nconst uint32_t max_data = 256;\nenum {\n  e_no_error = 0, e_other_error = 1, e_timeout = 2, e_bus_off = 3, e_error_passive = 4,\n  e_internal = 5, e_wrong_parameter = 6, e_node_id_unknown = 7, e_net_id_unknown = 8,\n  e_request_error = 9, e_no_driver = 10\n};\nenum {\n  r_none = 0, r_booting = 1, r_full = 2, r_not_run = 3, r_restart = 4, r_link = 5,\n  r_too_large = 6, r_length = 7, r_command = 8, r_version = 9,\n  r_not_in_eds = 100,  // the blocks' own: DATALENGTH 0 for an object the EDS does not list\n  r_needs_v2 = 101,    // the blocks' own: the plugin's table lacks the functions the block needs\n  r_reset = 102,       // the blocks' own: a slave NMT block asked for a reset\n  r_own_code = 103,    // the blocks' own: an emergency code the slave sends itself\n  r_slots = 104,       // the blocks' own: all program emergency slots are taken\n  r_object = 105       // the blocks' own: the slave has no such object from the master\n};\nenum { k_read = 0, k_write = 1, k_nmt = 2 };\nstruct request {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint8_t command;\n  uint16_t index;\n  uint8_t subindex;\n  uint8_t reserved;\n  uint32_t timeout_ms;\n  uint32_t length;\n  const uint8_t *data;\n};\nstruct result {\n  uint8_t error;\n  uint8_t reason;\n  uint16_t reserved;\n  uint32_t abort_code;\n  uint32_t length;\n};\nstruct emcy {\n  uint8_t node;\n  uint8_t error_register;\n  uint16_t error_code;\n  uint8_t data[5];\n  uint8_t reserved[3];\n  uint32_t lost;\n};\nstruct api_v1 {\n  uint32_t size;\n  uint32_t version;\n  uint64_t (*start)(const request *req, result *res);\n  int (*poll)(uint64_t handle, result *res, uint8_t *data, uint32_t cap);\n  void (*cancel)(uint64_t handle);\n  int (*node_state)(uint8_t network, uint8_t node, uint8_t *state);\n  int (*kernel_state)(uint8_t network, uint8_t *state);\n  int (*local_node_id)(uint8_t network, uint8_t *node_id);\n  int (*emcy_cursor)(uint8_t network, uint64_t *cursor);\n  int (*emcy_next)(uint8_t network, uint8_t node, uint64_t *cursor, emcy *out);\n  uint32_t flags;  // present when size covers it\n};\n// flags: the plugin is never unmapped, so its table stays valid for the life of the process.\nconst uint32_t flag_permanent = 0x1;\n// node_info::flags\nconst uint8_t node_enabled = 0x01;\nconst uint8_t node_optional = 0x02;\nconst uint8_t node_program_start = 0x04;\nconst uint32_t status_text = 80;\nstruct node_info {\n  uint8_t run_state;\n  uint8_t flags;\n  uint8_t reserved[2];\n  char problem[status_text];\n};\nstruct network_info {\n  uint8_t mandatory_up;\n  uint8_t optional_up;\n  uint8_t configured;\n  uint8_t operational;\n  uint8_t waiting;\n  uint8_t disabled;\n  uint8_t faulty;\n  uint8_t nodes;\n};\nstruct api_v2 {\n  api_v1 v1;\n  int (*node_status)(uint8_t network, uint8_t node, node_info *out);\n  int (*network_status)(uint8_t network, network_info *out);\n  int (*node_enable)(uint8_t network, uint8_t node, uint8_t on);\n};\n// slave_info::flags\nconst uint8_t slave_on_bus = 0x01;\nconst uint8_t slave_master_watched = 0x02;\nconst uint8_t slave_master_seen = 0x04;\nconst uint32_t slave_emcy_slots = 31;\nstruct slave_info {\n  uint8_t state;\n  uint8_t node_id;\n  uint8_t flags;\n  uint8_t bus_state;\n  uint8_t error_register;\n  uint8_t emcy_active;\n  uint8_t reserved[2];\n};\nstruct api_v3 {\n  api_v2 v2;\n  int (*slave_status)(uint8_t slave, slave_info *out);\n  int (*slave_nmt)(uint8_t slave, uint8_t command);\n  int (*slave_nmt_done)(uint8_t slave, uint8_t command, uint8_t *done);\n  int (*slave_emcy_claim)(uint8_t slave, uint32_t *handle);\n  int (*slave_emcy)(uint8_t slave, uint32_t handle, uint8_t active, uint16_t code, uint32_t info);\n  int (*slave_written)(uint8_t slave, uint16_t index, uint8_t subindex, uint32_t *count);\n};\n// After a lookup that found no plugin, this many lookups are skipped before the next one.\nconst uint32_t miss_skip = 1024;\n\n// The loaded plugin's table, or null with `why` set (r_not_run or r_version). The runtime loads\n// the plugin again at each PLC start while this program stays loaded, so a table is kept only\n// when its flags say it stays valid; otherwise it is looked up on each call. While no plugin is\n// found, only one lookup in miss_skip runs; the others answer r_not_run at once.\ninline const api_v1 *lookup_api(uint8_t &why) {\n  const void *table = nullptr;\n  why = r_not_run;\n#if defined(__linux__)\n  void *lib = dlopen(\"libcanopen_plugin.so\", 0x2 | 0x4);  // RTLD_NOW | RTLD_NOLOAD\n  if (!lib) return nullptr;\n  typedef const void *(*entry_t)(uint32_t);\n  entry_t entry = reinterpret_cast<entry_t>(dlsym(lib, \"canopen_plc_api\"));\n  if (entry) {\n    table = entry(api_version);\n    if (!table) why = r_version;\n  }\n  dlclose(lib);\n#else\n  if (canopen_plc_api) {\n    table = canopen_plc_api(api_version);\n    if (!table) why = r_version;\n  }\n#endif\n  const api_v1 *t = static_cast<const api_v1 *>(table);\n  if (t && t->size < __builtin_offsetof(api_v1, flags)) {\n    why = r_version;\n    return nullptr;\n  }\n  return t;\n}\n\ninline bool api_is_permanent(const api_v1 *t) {\n  return t->size >= sizeof(api_v1) && (t->flags & flag_permanent) != 0;\n}\n\ninline const api_v1 *api(uint8_t &why) {\n  static const api_v1 *kept = nullptr;\n  static uint32_t skip = 0;\n  const api_v1 *t = __atomic_load_n(&kept, __ATOMIC_ACQUIRE);\n  if (t) {\n    why = r_not_run;\n    return t;\n  }\n  uint32_t left = __atomic_load_n(&skip, __ATOMIC_RELAXED);\n  if (left > 0) {\n    __atomic_store_n(&skip, left - 1, __ATOMIC_RELAXED);\n    why = r_not_run;\n    return nullptr;\n  }\n  t = lookup_api(why);\n  if (!t) {\n    if (why == r_not_run) __atomic_store_n(&skip, miss_skip, __ATOMIC_RELAXED);\n    return nullptr;\n  }\n  if (api_is_permanent(t)) __atomic_store_n(&kept, t, __ATOMIC_RELEASE);\n  return t;\n}\n\n// The table with the version 2 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v2 *api2(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 2 || t->size < sizeof(api_v2)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v2 *>(static_cast<const void *>(t));\n}\n\n// The table with the version 3 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v3 *api3(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 3 || t->size < sizeof(api_v3)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v3 *>(static_cast<const void *>(t));\n}\n\n// ---- Error text, written into a fixed buffer (no allocation, no libc). ----\nstruct text {\n  char buf[200];\n  unsigned len;\n};\ninline void clear(text &t) {\n  t.len = 0;\n  t.buf[0] = 0;\n}\ninline void put(text &t, const char *s) {\n  while (*s && t.len + 1 < sizeof t.buf) t.buf[t.len++] = *s++;\n  t.buf[t.len] = 0;\n}\ninline void put_dec(text &t, uint32_t v) {\n  char d[12];\n  int n = 0;\n  do {\n    d[n++] = static_cast<char>('0' + v % 10);\n    v /= 10;\n  } while (v && n < 12);\n  while (n > 0 && t.len + 1 < sizeof t.buf) t.buf[t.len++] = d[--n];\n  t.buf[t.len] = 0;\n}\ninline void put_hex(text &t, uint32_t v, int digits) {\n  put(t, \"16#\");\n  for (int i = digits - 1; i >= 0 && t.len + 1 < sizeof t.buf; --i)\n    t.buf[t.len++] = \"0123456789ABCDEF\"[(v >> (4 * i)) & 0xF];\n  t.buf[t.len] = 0;\n}\n\n// CiA 301 SDO abort codes.\ninline const char *abort_text(uint32_t code) {\n  switch (code) {\n    case 0x05030000u: return \"toggle bit not alternated\";\n    case 0x05040000u: return \"SDO protocol timed out\";\n    case 0x05040001u: return \"command specifier not valid or unknown\";\n    case 0x05040002u: return \"invalid block size\";\n    case 0x05040003u: return \"invalid sequence number\";\n    case 0x05040004u: return \"CRC error\";\n    case 0x05040005u: return \"out of memory\";\n    case 0x06010000u: return \"unsupported access to an object\";\n    case 0x06010001u: return \"attempt to read a write only object\";\n    case 0x06010002u: return \"attempt to write a read only object\";\n    case 0x06020000u: return \"object does not exist\";\n    case 0x06040041u: return \"object cannot be mapped to the PDO\";\n    case 0x06040042u: return \"the mapped objects would exceed the PDO length\";\n    case 0x06040043u: return \"general parameter incompatibility\";\n    case 0x06040047u: return \"general internal incompatibility in the device\";\n    case 0x06060000u: return \"access failed due to a hardware error\";\n    case 0x06070010u: return \"data type or length does not match\";\n    case 0x06070012u: return \"data type does not match, length too high\";\n    case 0x06070013u: return \"data type does not match, length too low\";\n    case 0x06090011u: return \"sub-index does not exist\";\n    case 0x06090030u: return \"invalid value for parameter\";\n    case 0x06090031u: return \"value of parameter written too high\";\n    case 0x06090032u: return \"value of parameter written too low\";\n    case 0x06090036u: return \"maximum value is less than minimum value\";\n    case 0x060A0023u: return \"resource not available: SDO connection\";\n    case 0x08000000u: return \"general error\";\n    case 0x08000020u: return \"data cannot be transferred or stored to the application\";\n    case 0x08000021u: return \"data cannot be transferred or stored because of local control\";\n    case 0x08000022u: return \"data cannot be transferred or stored in the present device state\";\n    case 0x08000023u: return \"no object dictionary is present\";\n    case 0x08000024u: return \"no data available\";\n    default: return \"unknown abort code\";\n  }\n}\n\n// What a request was about, for its error text.\nstruct what {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint16_t index;\n  uint8_t subindex;\n  uint32_t timeout_ms;\n  uint32_t capacity;  // bytes the block holds\n};\n\ninline what what_of(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex,\n                    uint32_t timeout_ms, uint32_t capacity) {\n  what w{};\n  w.network = network;\n  w.node = node;\n  w.index = index;\n  w.subindex = subindex;\n  w.timeout_ms = timeout_ms;\n  w.capacity = capacity;\n  return w;\n}\n\ninline void put_node(text &t, const what &w) {\n  if (w.node == 0) {\n    put(t, \"the nodes of network \");\n    put_dec(t, w.network);\n  } else {\n    put(t, \"node \");\n    put_dec(t, w.node);\n  }\n}\n\ninline void put_object(text &t, const what &w) {\n  put_hex(t, w.index, 4);\n  put(t, \" sub \");\n  put_dec(t, w.subindex);\n}\n\n// The error text of a failed request, and its ERRORINFO.\ninline uint32_t describe(text &t, const what &w, const result &r) {\n  clear(t);\n  switch (r.error) {\n    case e_other_error:\n      put_node(t, w);\n      put(t, \" aborted \");\n      put_object(t, w);\n      put(t, \": \");\n      put(t, abort_text(r.abort_code));\n      put(t, \" (\");\n      put_hex(t, r.abort_code, 8);\n      put(t, \")\");\n      return r.abort_code;\n    case e_timeout:\n      put_node(t, w);\n      put(t, \" did not answer\");\n      if (w.timeout_ms) {\n        put(t, \" within \");\n        put_dec(t, w.timeout_ms);\n        put(t, \" ms\");\n      }\n      return r.abort_code ? r.abort_code : 0x05040000u;\n    case e_bus_off:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, r.reason == r_link ? \" link is down\" : \" bus is off\");\n      return 0;\n    case e_error_passive:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" is error passive\");\n      return 0;\n    case e_wrong_parameter:\n      if (r.reason == r_too_large) {\n        put(t, \"object has \");\n        put_dec(t, r.length);\n        put(t, \" bytes, the block holds \");\n        put_dec(t, w.capacity);\n        return r.length;\n      }\n      if (r.reason == r_length) {\n        put(t, \"DATALENGTH \");\n        put_dec(t, r.length);\n        put(t, \" is not 1 to \");\n        put_dec(t, w.capacity);\n        return 0;\n      }\n      if (r.reason == r_not_in_eds) {\n        put_node(t, w);\n        put(t, \" has no object \");\n        put_object(t, w);\n        put(t, \" of 1 to 4 bytes in its EDS; set DATALENGTH\");\n        return 0;\n      }\n      if (r.reason == r_command) {\n        put(t, \"STATE \");\n        put_dec(t, r.length);\n        put(t, \" is not an NMT state change\");\n        return 0;\n      }\n      put(t, \"wrong parameter\");\n      return 0;\n    case e_node_id_unknown:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" has no node \");\n      put_dec(t, w.node);\n      return 0;\n    case e_net_id_unknown:\n      put(t, \"no CANopen network \");\n      put_dec(t, w.network);\n      return 0;\n    case e_request_error:\n      if (r.reason == r_booting) {\n        put_node(t, w);\n        put(t, \" is booting\");\n      } else if (r.reason == r_full) {\n        put(t, \"network \");\n        put_dec(t, w.network);\n        put(t, \" has 16 block requests waiting\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return 0;\n    case e_no_driver:\n      if (r.reason == r_restart)\n        put(t, \"request cancelled by the PLC stop\");\n      else if (r.reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else if (r.reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else\n        put(t, \"no CANopen network runs\");\n      return 0;\n    default:\n      put(t, \"internal error in the CANopen master\");\n      return 0;\n  }\n}\n\n// The error text of a slave block, for `slave` and the object (index, subindex) or ERRORCODE.\ninline void describe_slave(text &t, uint8_t slave, uint8_t error, uint8_t reason, uint16_t index,\n                           uint8_t subindex) {\n  clear(t);\n  switch (error) {\n    case e_no_error:\n      return;\n    case e_net_id_unknown:\n      put(t, \"no CANopen slave \");\n      put_dec(t, slave);\n      return;\n    case e_no_driver:\n      if (reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else if (reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else\n        put(t, \"no CANopen slave runs\");\n      return;\n    case e_wrong_parameter:\n      if (reason == r_reset) {\n        put(t, \"the program cannot reset the slave; STATE must be START_REMOTE_NODE, \");\n        put(t, \"STOP_REMOTE_NODE or ENTER_PRE_OPERATIONAL\");\n      } else if (reason == r_own_code) {\n        put(t, \"ERRORCODE \");\n        put_hex(t, index, 4);\n        put(t, \" is sent by the slave itself; use another code\");\n      } else if (reason == r_object) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" has no object \");\n        put_hex(t, index, 4);\n        put(t, \" sub \");\n        put_dec(t, subindex);\n        put(t, \" written by the master\");\n      } else {\n        put(t, \"wrong parameter\");\n      }\n      return;\n    case e_request_error:\n      if (reason == r_slots) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" already holds 31 program emergencies\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return;\n    default:\n      put(t, \"internal error in the CANopen slave\");\n      return;\n  }\n}\n\n// Shows a failed request on the block's ERROR, ERRORINFO and ERRORTEXT pins.\ntemplate <class error_pin, class info_pin, class text_pin>\ninline void show(error_pin &error, info_pin &info, text_pin &errortext, const what &w,\n                 const result &r) {\n  text t;\n  uint32_t i = describe(t, w, r);\n  error = r.error ? r.error : static_cast<uint8_t>(e_internal);\n  info = i;\n  errortext = t.buf;\n}\n\n// The size of an object of 1 to 4 bytes in the node's EDS, from the table the editor's build\n// generates (sorted network, node, index, sub-index, size); 0 when it is not listed.\ninline uint32_t eds_size(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex) {\n  const uint64_t key = (static_cast<uint64_t>(network) << 32) | (static_cast<uint64_t>(node) << 24) |\n                       (static_cast<uint64_t>(index) << 8) | subindex;\n  long lo = 0;\n  long hi = static_cast<long>(static_cast<uint32_t>(strucpp::CANOPEN_OBJECT_SIZE_COUNT)) - 1;\n  while (lo <= hi) {\n    long mid = (lo + hi) / 2;\n    uint64_t entry = static_cast<uint64_t>(strucpp::CANOPEN_OBJECT_SIZES[mid]);\n    uint64_t k = entry >> 8;\n    if (k == key) return static_cast<uint32_t>(entry & 0xFF);\n    if (k < key)\n      lo = mid + 1;\n    else\n      hi = mid - 1;\n  }\n  return 0;\n}\n\n// TIME (nanoseconds) to milliseconds; 0 or less: the network's SDO timeout.\ninline uint32_t timeout_ms(long long ns) {\n  if (ns <= 0) return 0;\n  long long ms = (ns + 999999) / 1000000;\n  return ms > 3600000 ? 3600000u : static_cast<uint32_t>(ms);\n}\n\n// One instance's handshake (CiA 405): the block keeps `prev`, `phase` and `handle` in its locals.\nenum { phase_idle = 0, phase_busy = 1, phase_ended = 2 };\nstruct step {\n  bool start;   // rising edge of ENABLE: clear the outputs and start a request\n  bool cancel;  // falling edge while busy: drop the request and clear the outputs\n  bool clear;   // the result was shown and ENABLE is FALSE: clear the outputs\n};\ninline step begin(bool enable, bool &prev, uint8_t &phase) {\n  step s{false, false, false};\n  bool rising = enable && !prev;\n  prev = enable;\n  if (!enable && phase == phase_busy) {\n    s.cancel = true;\n    phase = phase_idle;\n  } else if (!enable && phase == phase_ended) {\n    s.clear = true;\n    phase = phase_idle;\n  }\n  if (rising && phase != phase_busy) s.start = true;\n  return s;\n}\n\n// Starts `req`. Returns the handle, or 0 with `res` saying why it cannot run.\ninline uint64_t start(const request &req, result &res) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why;\n    return 0;\n  }\n  uint64_t handle = t->start(&req, &res);\n  if (!handle && res.error == e_no_error) res.error = e_internal;\n  return handle;\n}\n\n// 0 while the request runs; 1 done, 2 failed (`res` set).\ninline int poll(uint64_t handle, result &res, uint8_t *data, uint32_t cap) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why == r_version ? r_version : r_restart;\n    return 2;\n  }\n  return t->poll(handle, &res, data, cap);\n}\n\ninline void cancel(uint64_t handle) {\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (t) t->cancel(handle);\n}\n\ninline void put_le(uint8_t *out, uint32_t v, unsigned n) {\n  for (unsigned b = 0; b < n; ++b) out[b] = static_cast<uint8_t>(v >> (8 * b));\n}\n\ninline uint32_t get_le(const uint8_t *in, unsigned n) {\n  uint32_t v = 0;\n  for (unsigned b = 0; b < n && b < 4; ++b) v |= static_cast<uint32_t>(in[b]) << (8 * b);\n  return v;\n}\n\n// A failure before any request ran (bad input): `res` for describe().\ninline result fail(uint8_t error, uint8_t reason, uint32_t length) {\n  result r{};\n  r.error = error;\n  r.reason = reason;\n  r.length = length;\n  return r;\n}\n\n}  // namespace canopen_fb\n#endif\nvoid setup() {\n}\n\nvoid loop() {\n  if (!ENABLE) {\n    CONFIRM = false;\n    ERROR = 0;\n    if (cop_last != 0) ERRORTEXT = \"\";\n    cop_last = 0;\n    cop_reason = 0;\n    return;\n  }\n  uint8_t l_why = 0;\n  const canopen_fb::api_v3 *l_api = canopen_fb::api3(l_why);\n  int l_error = canopen_fb::e_no_driver;\n  uint8_t l_reason = l_api ? 0 : l_why;\n  uint16_t l_index = 0;\n  uint8_t l_sub = 0;\n  if (l_api) {\n    canopen_fb::slave_info l_info;\n    l_error = l_api->slave_status(SLAVE, &l_info);\n    if (l_error == canopen_fb::e_no_error) {\n      STATE = l_info.state;\n      OPERATIONAL = l_info.state == 5;\n      NODEID = l_info.node_id;\n      MASTERWATCHED = (l_info.flags & canopen_fb::slave_master_watched) != 0;\n      MASTERSEEN = (l_info.flags & canopen_fb::slave_master_seen) != 0;\n      BUSSTATE = l_info.bus_state;\n      ERRORREGISTER = l_info.error_register;\n      EMCYACTIVE = l_info.emcy_active;\n    }\n  }\n  CONFIRM = l_error == canopen_fb::e_no_error;\n  ERROR = static_cast<uint8_t>(l_error);\n  if (l_error != cop_last || l_reason != cop_reason) {\n    canopen_fb::text l_text;\n    canopen_fb::describe_slave(l_text, SLAVE, static_cast<uint8_t>(l_error), l_reason, l_index, l_sub);\n    ERRORTEXT = l_text.buf;\n    cop_last = static_cast<uint8_t>(l_error);\n    cop_reason = l_reason;\n  }\n}\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "CANOPEN_SLAVE_NMT.cpp",
      "source": "(* Puts this runtime's CANopen slave into an NMT state by itself (CiA 301 local control): STATE is START_REMOTE_NODE, STOP_REMOTE_NODE or ENTER_PRE_OPERATIONAL; a reset is refused. A rising edge of ENABLE sends it; BUSY until the slave is in that state, then CONFIRM. The master sees a slave that leaves operational this way as left operational and acts on its own settings; raise an emergency first so it knows why. SLAVE is the slave's name or its place in the project's slaves, from 1.\nExample: nmt(SLAVE := Line_IO, ENABLE := fault, STATE := ENTER_PRE_OPERATIONAL); *)\nFUNCTION_BLOCK CANOPEN_SLAVE_NMT\nVAR_INPUT\n  SLAVE : USINT := 1;\n  ENABLE : BOOL;\n  STATE : USINT;\nEND_VAR\nVAR_OUTPUT\n  CONFIRM : BOOL;\n  BUSY : BOOL;\n  ERROR : USINT;\n  ERRORTEXT : STRING;\nEND_VAR\nVAR\n  cop_prev : BOOL;\n  cop_busy : BOOL;\n  cop_command : USINT;\n  cop_last : USINT;\n  cop_reason : USINT;\nEND_VAR\n// SPDX-License-Identifier: Apache-2.0\n//\n// Shared code of the canopen function blocks. The generator copies it into every block's source,\n// because the editor grafts each library C++ block into one c_blocks_code.cpp and has no other\n// place for shared code; the include guard keeps one copy per program.\n//\n// The editor binds every pin and local of a block to a #define of its name, so nothing here uses\n// a pin or local name (those are upper case or start with cop_; this code is lower case), nor the\n// keyword that closes a variable section, and no system header is included after those defines:\n// dlopen, dlsym and dlclose are declared here as glibc declares them.\n//\n// Derived from canworks ec7fd59, library/src/common.inc (Apache-2.0), adapted to the plugin's\n// interface version 3 (core/src/drivers/plugins/native/canopen/plc_api.h in the runtime fork).\n#ifndef CANOPEN_FB_SHARED_INCLUDED\n#define CANOPEN_FB_SHARED_INCLUDED\n#if defined(__linux__)\nextern \"C\" void *dlopen(const char *file, int mode) noexcept(true);\nextern \"C\" void *dlsym(void *handle, const char *name) noexcept(true);\nextern \"C\" int dlclose(void *handle) noexcept(true);\n#else\n// A board's firmware: the slave module's table, when the project has a slave on the board.\nextern \"C\" const void *canopen_plc_api(uint32_t version) __attribute__((weak));\n#endif\n\nnamespace canopen_fb {\n\n// A copy of the plugin's C interface, version 3; keep in step with plc_api.h. Version 1 is asked\n// for, since a newer plugin answers it with its newest table; `size` tells which it is.\nconst uint32_t api_version = 1;\nconst uint32_t max_data = 256;\nenum {\n  e_no_error = 0, e_other_error = 1, e_timeout = 2, e_bus_off = 3, e_error_passive = 4,\n  e_internal = 5, e_wrong_parameter = 6, e_node_id_unknown = 7, e_net_id_unknown = 8,\n  e_request_error = 9, e_no_driver = 10\n};\nenum {\n  r_none = 0, r_booting = 1, r_full = 2, r_not_run = 3, r_restart = 4, r_link = 5,\n  r_too_large = 6, r_length = 7, r_command = 8, r_version = 9,\n  r_not_in_eds = 100,  // the blocks' own: DATALENGTH 0 for an object the EDS does not list\n  r_needs_v2 = 101,    // the blocks' own: the plugin's table lacks the functions the block needs\n  r_reset = 102,       // the blocks' own: a slave NMT block asked for a reset\n  r_own_code = 103,    // the blocks' own: an emergency code the slave sends itself\n  r_slots = 104,       // the blocks' own: all program emergency slots are taken\n  r_object = 105       // the blocks' own: the slave has no such object from the master\n};\nenum { k_read = 0, k_write = 1, k_nmt = 2 };\nstruct request {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint8_t command;\n  uint16_t index;\n  uint8_t subindex;\n  uint8_t reserved;\n  uint32_t timeout_ms;\n  uint32_t length;\n  const uint8_t *data;\n};\nstruct result {\n  uint8_t error;\n  uint8_t reason;\n  uint16_t reserved;\n  uint32_t abort_code;\n  uint32_t length;\n};\nstruct emcy {\n  uint8_t node;\n  uint8_t error_register;\n  uint16_t error_code;\n  uint8_t data[5];\n  uint8_t reserved[3];\n  uint32_t lost;\n};\nstruct api_v1 {\n  uint32_t size;\n  uint32_t version;\n  uint64_t (*start)(const request *req, result *res);\n  int (*poll)(uint64_t handle, result *res, uint8_t *data, uint32_t cap);\n  void (*cancel)(uint64_t handle);\n  int (*node_state)(uint8_t network, uint8_t node, uint8_t *state);\n  int (*kernel_state)(uint8_t network, uint8_t *state);\n  int (*local_node_id)(uint8_t network, uint8_t *node_id);\n  int (*emcy_cursor)(uint8_t network, uint64_t *cursor);\n  int (*emcy_next)(uint8_t network, uint8_t node, uint64_t *cursor, emcy *out);\n  uint32_t flags;  // present when size covers it\n};\n// flags: the plugin is never unmapped, so its table stays valid for the life of the process.\nconst uint32_t flag_permanent = 0x1;\n// node_info::flags\nconst uint8_t node_enabled = 0x01;\nconst uint8_t node_optional = 0x02;\nconst uint8_t node_program_start = 0x04;\nconst uint32_t status_text = 80;\nstruct node_info {\n  uint8_t run_state;\n  uint8_t flags;\n  uint8_t reserved[2];\n  char problem[status_text];\n};\nstruct network_info {\n  uint8_t mandatory_up;\n  uint8_t optional_up;\n  uint8_t configured;\n  uint8_t operational;\n  uint8_t waiting;\n  uint8_t disabled;\n  uint8_t faulty;\n  uint8_t nodes;\n};\nstruct api_v2 {\n  api_v1 v1;\n  int (*node_status)(uint8_t network, uint8_t node, node_info *out);\n  int (*network_status)(uint8_t network, network_info *out);\n  int (*node_enable)(uint8_t network, uint8_t node, uint8_t on);\n};\n// slave_info::flags\nconst uint8_t slave_on_bus = 0x01;\nconst uint8_t slave_master_watched = 0x02;\nconst uint8_t slave_master_seen = 0x04;\nconst uint32_t slave_emcy_slots = 31;\nstruct slave_info {\n  uint8_t state;\n  uint8_t node_id;\n  uint8_t flags;\n  uint8_t bus_state;\n  uint8_t error_register;\n  uint8_t emcy_active;\n  uint8_t reserved[2];\n};\nstruct api_v3 {\n  api_v2 v2;\n  int (*slave_status)(uint8_t slave, slave_info *out);\n  int (*slave_nmt)(uint8_t slave, uint8_t command);\n  int (*slave_nmt_done)(uint8_t slave, uint8_t command, uint8_t *done);\n  int (*slave_emcy_claim)(uint8_t slave, uint32_t *handle);\n  int (*slave_emcy)(uint8_t slave, uint32_t handle, uint8_t active, uint16_t code, uint32_t info);\n  int (*slave_written)(uint8_t slave, uint16_t index, uint8_t subindex, uint32_t *count);\n};\n// After a lookup that found no plugin, this many lookups are skipped before the next one.\nconst uint32_t miss_skip = 1024;\n\n// The loaded plugin's table, or null with `why` set (r_not_run or r_version). The runtime loads\n// the plugin again at each PLC start while this program stays loaded, so a table is kept only\n// when its flags say it stays valid; otherwise it is looked up on each call. While no plugin is\n// found, only one lookup in miss_skip runs; the others answer r_not_run at once.\ninline const api_v1 *lookup_api(uint8_t &why) {\n  const void *table = nullptr;\n  why = r_not_run;\n#if defined(__linux__)\n  void *lib = dlopen(\"libcanopen_plugin.so\", 0x2 | 0x4);  // RTLD_NOW | RTLD_NOLOAD\n  if (!lib) return nullptr;\n  typedef const void *(*entry_t)(uint32_t);\n  entry_t entry = reinterpret_cast<entry_t>(dlsym(lib, \"canopen_plc_api\"));\n  if (entry) {\n    table = entry(api_version);\n    if (!table) why = r_version;\n  }\n  dlclose(lib);\n#else\n  if (canopen_plc_api) {\n    table = canopen_plc_api(api_version);\n    if (!table) why = r_version;\n  }\n#endif\n  const api_v1 *t = static_cast<const api_v1 *>(table);\n  if (t && t->size < __builtin_offsetof(api_v1, flags)) {\n    why = r_version;\n    return nullptr;\n  }\n  return t;\n}\n\ninline bool api_is_permanent(const api_v1 *t) {\n  return t->size >= sizeof(api_v1) && (t->flags & flag_permanent) != 0;\n}\n\ninline const api_v1 *api(uint8_t &why) {\n  static const api_v1 *kept = nullptr;\n  static uint32_t skip = 0;\n  const api_v1 *t = __atomic_load_n(&kept, __ATOMIC_ACQUIRE);\n  if (t) {\n    why = r_not_run;\n    return t;\n  }\n  uint32_t left = __atomic_load_n(&skip, __ATOMIC_RELAXED);\n  if (left > 0) {\n    __atomic_store_n(&skip, left - 1, __ATOMIC_RELAXED);\n    why = r_not_run;\n    return nullptr;\n  }\n  t = lookup_api(why);\n  if (!t) {\n    if (why == r_not_run) __atomic_store_n(&skip, miss_skip, __ATOMIC_RELAXED);\n    return nullptr;\n  }\n  if (api_is_permanent(t)) __atomic_store_n(&kept, t, __ATOMIC_RELEASE);\n  return t;\n}\n\n// The table with the version 2 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v2 *api2(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 2 || t->size < sizeof(api_v2)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v2 *>(static_cast<const void *>(t));\n}\n\n// The table with the version 3 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v3 *api3(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 3 || t->size < sizeof(api_v3)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v3 *>(static_cast<const void *>(t));\n}\n\n// ---- Error text, written into a fixed buffer (no allocation, no libc). ----\nstruct text {\n  char buf[200];\n  unsigned len;\n};\ninline void clear(text &t) {\n  t.len = 0;\n  t.buf[0] = 0;\n}\ninline void put(text &t, const char *s) {\n  while (*s && t.len + 1 < sizeof t.buf) t.buf[t.len++] = *s++;\n  t.buf[t.len] = 0;\n}\ninline void put_dec(text &t, uint32_t v) {\n  char d[12];\n  int n = 0;\n  do {\n    d[n++] = static_cast<char>('0' + v % 10);\n    v /= 10;\n  } while (v && n < 12);\n  while (n > 0 && t.len + 1 < sizeof t.buf) t.buf[t.len++] = d[--n];\n  t.buf[t.len] = 0;\n}\ninline void put_hex(text &t, uint32_t v, int digits) {\n  put(t, \"16#\");\n  for (int i = digits - 1; i >= 0 && t.len + 1 < sizeof t.buf; --i)\n    t.buf[t.len++] = \"0123456789ABCDEF\"[(v >> (4 * i)) & 0xF];\n  t.buf[t.len] = 0;\n}\n\n// CiA 301 SDO abort codes.\ninline const char *abort_text(uint32_t code) {\n  switch (code) {\n    case 0x05030000u: return \"toggle bit not alternated\";\n    case 0x05040000u: return \"SDO protocol timed out\";\n    case 0x05040001u: return \"command specifier not valid or unknown\";\n    case 0x05040002u: return \"invalid block size\";\n    case 0x05040003u: return \"invalid sequence number\";\n    case 0x05040004u: return \"CRC error\";\n    case 0x05040005u: return \"out of memory\";\n    case 0x06010000u: return \"unsupported access to an object\";\n    case 0x06010001u: return \"attempt to read a write only object\";\n    case 0x06010002u: return \"attempt to write a read only object\";\n    case 0x06020000u: return \"object does not exist\";\n    case 0x06040041u: return \"object cannot be mapped to the PDO\";\n    case 0x06040042u: return \"the mapped objects would exceed the PDO length\";\n    case 0x06040043u: return \"general parameter incompatibility\";\n    case 0x06040047u: return \"general internal incompatibility in the device\";\n    case 0x06060000u: return \"access failed due to a hardware error\";\n    case 0x06070010u: return \"data type or length does not match\";\n    case 0x06070012u: return \"data type does not match, length too high\";\n    case 0x06070013u: return \"data type does not match, length too low\";\n    case 0x06090011u: return \"sub-index does not exist\";\n    case 0x06090030u: return \"invalid value for parameter\";\n    case 0x06090031u: return \"value of parameter written too high\";\n    case 0x06090032u: return \"value of parameter written too low\";\n    case 0x06090036u: return \"maximum value is less than minimum value\";\n    case 0x060A0023u: return \"resource not available: SDO connection\";\n    case 0x08000000u: return \"general error\";\n    case 0x08000020u: return \"data cannot be transferred or stored to the application\";\n    case 0x08000021u: return \"data cannot be transferred or stored because of local control\";\n    case 0x08000022u: return \"data cannot be transferred or stored in the present device state\";\n    case 0x08000023u: return \"no object dictionary is present\";\n    case 0x08000024u: return \"no data available\";\n    default: return \"unknown abort code\";\n  }\n}\n\n// What a request was about, for its error text.\nstruct what {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint16_t index;\n  uint8_t subindex;\n  uint32_t timeout_ms;\n  uint32_t capacity;  // bytes the block holds\n};\n\ninline what what_of(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex,\n                    uint32_t timeout_ms, uint32_t capacity) {\n  what w{};\n  w.network = network;\n  w.node = node;\n  w.index = index;\n  w.subindex = subindex;\n  w.timeout_ms = timeout_ms;\n  w.capacity = capacity;\n  return w;\n}\n\ninline void put_node(text &t, const what &w) {\n  if (w.node == 0) {\n    put(t, \"the nodes of network \");\n    put_dec(t, w.network);\n  } else {\n    put(t, \"node \");\n    put_dec(t, w.node);\n  }\n}\n\ninline void put_object(text &t, const what &w) {\n  put_hex(t, w.index, 4);\n  put(t, \" sub \");\n  put_dec(t, w.subindex);\n}\n\n// The error text of a failed request, and its ERRORINFO.\ninline uint32_t describe(text &t, const what &w, const result &r) {\n  clear(t);\n  switch (r.error) {\n    case e_other_error:\n      put_node(t, w);\n      put(t, \" aborted \");\n      put_object(t, w);\n      put(t, \": \");\n      put(t, abort_text(r.abort_code));\n      put(t, \" (\");\n      put_hex(t, r.abort_code, 8);\n      put(t, \")\");\n      return r.abort_code;\n    case e_timeout:\n      put_node(t, w);\n      put(t, \" did not answer\");\n      if (w.timeout_ms) {\n        put(t, \" within \");\n        put_dec(t, w.timeout_ms);\n        put(t, \" ms\");\n      }\n      return r.abort_code ? r.abort_code : 0x05040000u;\n    case e_bus_off:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, r.reason == r_link ? \" link is down\" : \" bus is off\");\n      return 0;\n    case e_error_passive:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" is error passive\");\n      return 0;\n    case e_wrong_parameter:\n      if (r.reason == r_too_large) {\n        put(t, \"object has \");\n        put_dec(t, r.length);\n        put(t, \" bytes, the block holds \");\n        put_dec(t, w.capacity);\n        return r.length;\n      }\n      if (r.reason == r_length) {\n        put(t, \"DATALENGTH \");\n        put_dec(t, r.length);\n        put(t, \" is not 1 to \");\n        put_dec(t, w.capacity);\n        return 0;\n      }\n      if (r.reason == r_not_in_eds) {\n        put_node(t, w);\n        put(t, \" has no object \");\n        put_object(t, w);\n        put(t, \" of 1 to 4 bytes in its EDS; set DATALENGTH\");\n        return 0;\n      }\n      if (r.reason == r_command) {\n        put(t, \"STATE \");\n        put_dec(t, r.length);\n        put(t, \" is not an NMT state change\");\n        return 0;\n      }\n      put(t, \"wrong parameter\");\n      return 0;\n    case e_node_id_unknown:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" has no node \");\n      put_dec(t, w.node);\n      return 0;\n    case e_net_id_unknown:\n      put(t, \"no CANopen network \");\n      put_dec(t, w.network);\n      return 0;\n    case e_request_error:\n      if (r.reason == r_booting) {\n        put_node(t, w);\n        put(t, \" is booting\");\n      } else if (r.reason == r_full) {\n        put(t, \"network \");\n        put_dec(t, w.network);\n        put(t, \" has 16 block requests waiting\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return 0;\n    case e_no_driver:\n      if (r.reason == r_restart)\n        put(t, \"request cancelled by the PLC stop\");\n      else if (r.reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else if (r.reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else\n        put(t, \"no CANopen network runs\");\n      return 0;\n    default:\n      put(t, \"internal error in the CANopen master\");\n      return 0;\n  }\n}\n\n// The error text of a slave block, for `slave` and the object (index, subindex) or ERRORCODE.\ninline void describe_slave(text &t, uint8_t slave, uint8_t error, uint8_t reason, uint16_t index,\n                           uint8_t subindex) {\n  clear(t);\n  switch (error) {\n    case e_no_error:\n      return;\n    case e_net_id_unknown:\n      put(t, \"no CANopen slave \");\n      put_dec(t, slave);\n      return;\n    case e_no_driver:\n      if (reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else if (reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else\n        put(t, \"no CANopen slave runs\");\n      return;\n    case e_wrong_parameter:\n      if (reason == r_reset) {\n        put(t, \"the program cannot reset the slave; STATE must be START_REMOTE_NODE, \");\n        put(t, \"STOP_REMOTE_NODE or ENTER_PRE_OPERATIONAL\");\n      } else if (reason == r_own_code) {\n        put(t, \"ERRORCODE \");\n        put_hex(t, index, 4);\n        put(t, \" is sent by the slave itself; use another code\");\n      } else if (reason == r_object) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" has no object \");\n        put_hex(t, index, 4);\n        put(t, \" sub \");\n        put_dec(t, subindex);\n        put(t, \" written by the master\");\n      } else {\n        put(t, \"wrong parameter\");\n      }\n      return;\n    case e_request_error:\n      if (reason == r_slots) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" already holds 31 program emergencies\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return;\n    default:\n      put(t, \"internal error in the CANopen slave\");\n      return;\n  }\n}\n\n// Shows a failed request on the block's ERROR, ERRORINFO and ERRORTEXT pins.\ntemplate <class error_pin, class info_pin, class text_pin>\ninline void show(error_pin &error, info_pin &info, text_pin &errortext, const what &w,\n                 const result &r) {\n  text t;\n  uint32_t i = describe(t, w, r);\n  error = r.error ? r.error : static_cast<uint8_t>(e_internal);\n  info = i;\n  errortext = t.buf;\n}\n\n// The size of an object of 1 to 4 bytes in the node's EDS, from the table the editor's build\n// generates (sorted network, node, index, sub-index, size); 0 when it is not listed.\ninline uint32_t eds_size(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex) {\n  const uint64_t key = (static_cast<uint64_t>(network) << 32) | (static_cast<uint64_t>(node) << 24) |\n                       (static_cast<uint64_t>(index) << 8) | subindex;\n  long lo = 0;\n  long hi = static_cast<long>(static_cast<uint32_t>(strucpp::CANOPEN_OBJECT_SIZE_COUNT)) - 1;\n  while (lo <= hi) {\n    long mid = (lo + hi) / 2;\n    uint64_t entry = static_cast<uint64_t>(strucpp::CANOPEN_OBJECT_SIZES[mid]);\n    uint64_t k = entry >> 8;\n    if (k == key) return static_cast<uint32_t>(entry & 0xFF);\n    if (k < key)\n      lo = mid + 1;\n    else\n      hi = mid - 1;\n  }\n  return 0;\n}\n\n// TIME (nanoseconds) to milliseconds; 0 or less: the network's SDO timeout.\ninline uint32_t timeout_ms(long long ns) {\n  if (ns <= 0) return 0;\n  long long ms = (ns + 999999) / 1000000;\n  return ms > 3600000 ? 3600000u : static_cast<uint32_t>(ms);\n}\n\n// One instance's handshake (CiA 405): the block keeps `prev`, `phase` and `handle` in its locals.\nenum { phase_idle = 0, phase_busy = 1, phase_ended = 2 };\nstruct step {\n  bool start;   // rising edge of ENABLE: clear the outputs and start a request\n  bool cancel;  // falling edge while busy: drop the request and clear the outputs\n  bool clear;   // the result was shown and ENABLE is FALSE: clear the outputs\n};\ninline step begin(bool enable, bool &prev, uint8_t &phase) {\n  step s{false, false, false};\n  bool rising = enable && !prev;\n  prev = enable;\n  if (!enable && phase == phase_busy) {\n    s.cancel = true;\n    phase = phase_idle;\n  } else if (!enable && phase == phase_ended) {\n    s.clear = true;\n    phase = phase_idle;\n  }\n  if (rising && phase != phase_busy) s.start = true;\n  return s;\n}\n\n// Starts `req`. Returns the handle, or 0 with `res` saying why it cannot run.\ninline uint64_t start(const request &req, result &res) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why;\n    return 0;\n  }\n  uint64_t handle = t->start(&req, &res);\n  if (!handle && res.error == e_no_error) res.error = e_internal;\n  return handle;\n}\n\n// 0 while the request runs; 1 done, 2 failed (`res` set).\ninline int poll(uint64_t handle, result &res, uint8_t *data, uint32_t cap) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why == r_version ? r_version : r_restart;\n    return 2;\n  }\n  return t->poll(handle, &res, data, cap);\n}\n\ninline void cancel(uint64_t handle) {\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (t) t->cancel(handle);\n}\n\ninline void put_le(uint8_t *out, uint32_t v, unsigned n) {\n  for (unsigned b = 0; b < n; ++b) out[b] = static_cast<uint8_t>(v >> (8 * b));\n}\n\ninline uint32_t get_le(const uint8_t *in, unsigned n) {\n  uint32_t v = 0;\n  for (unsigned b = 0; b < n && b < 4; ++b) v |= static_cast<uint32_t>(in[b]) << (8 * b);\n  return v;\n}\n\n// A failure before any request ran (bad input): `res` for describe().\ninline result fail(uint8_t error, uint8_t reason, uint32_t length) {\n  result r{};\n  r.error = error;\n  r.reason = reason;\n  r.length = length;\n  return r;\n}\n\n}  // namespace canopen_fb\n#endif\nvoid setup() {\n}\n\nvoid loop() {\n  bool l_rising = ENABLE && !cop_prev;\n  cop_prev = ENABLE;\n  if (!ENABLE) {\n    CONFIRM = false;\n    BUSY = false;\n    ERROR = 0;\n    if (cop_last != 0) ERRORTEXT = \"\";\n    cop_last = 0;\n    cop_reason = 0;\n    cop_busy = false;\n    return;\n  }\n  uint8_t l_why = 0;\n  const canopen_fb::api_v3 *l_api = canopen_fb::api3(l_why);\n  int l_error = canopen_fb::e_no_error;\n  uint8_t l_reason = 0;\n  uint16_t l_index = 0;\n  uint8_t l_sub = 0;\n  if (l_rising) {\n    CONFIRM = false;\n    cop_busy = false;\n    switch (static_cast<uint8_t>(STATE)) {\n      case 0: cop_command = 1; break;\n      case 1: cop_command = 2; break;\n      case 2: cop_command = 0x80; break;\n      default: cop_command = 0; break;\n    }\n    if (!cop_command) {\n      l_error = canopen_fb::e_wrong_parameter;\n      l_reason = canopen_fb::r_reset;\n    } else if (!l_api) {\n      l_error = canopen_fb::e_no_driver;\n      l_reason = l_why;\n    } else {\n      l_error = l_api->slave_nmt(SLAVE, cop_command);\n      cop_busy = l_error == canopen_fb::e_no_error;\n    }\n  } else if (cop_busy) {\n    uint8_t l_done = 0;\n    if (!l_api) {\n      l_error = canopen_fb::e_no_driver;\n      l_reason = l_why;\n      cop_busy = false;\n    } else {\n      l_error = l_api->slave_nmt_done(SLAVE, cop_command, &l_done);\n      if (l_error != canopen_fb::e_no_error || l_done) cop_busy = false;\n      if (l_error == canopen_fb::e_no_error && l_done) CONFIRM = true;\n    }\n  } else {\n    l_error = cop_last;\n    l_reason = cop_reason;\n  }\n  BUSY = cop_busy;\n  ERROR = static_cast<uint8_t>(l_error);\n  if (l_error != cop_last || l_reason != cop_reason) {\n    canopen_fb::text l_text;\n    canopen_fb::describe_slave(l_text, SLAVE, static_cast<uint8_t>(l_error), l_reason, l_index, l_sub);\n    ERRORTEXT = l_text.buf;\n    cop_last = static_cast<uint8_t>(l_error);\n    cop_reason = l_reason;\n  }\n}\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "CANOPEN_SLAVE_EMCY.cpp",
      "source": "(* Holds one emergency of the program on this runtime's CANopen slave: while ENABLE is TRUE it is active with ERRORCODE and INFO (sent in bytes 4 to 7 of the EMCY); ENABLE FALSE clears it, and the slave sends EMCY 0000h once no emergency is left. A change of ERRORCODE or INFO while active sends one more EMCY, so do not change them every scan. The error register gets the generic bit and the bit of the code's class (2xxx current, 3xxx voltage, 4xxx temperature, 8xxx communication, FFxx manufacturer). Each instance holds one emergency, up to 31 per slave; 0000h, 6200h and 8130h are the slave's own and refused. A PLC stop clears them; after the start the block raises its emergency again. SLAVE is the slave's name or its place in the project's slaves, from 1.\nExample: overheat(SLAVE := Line_IO, ENABLE := temp > 80.0, ERRORCODE := 16#4210, INFO := REAL_TO_UDINT(temp * 10.0)); *)\nFUNCTION_BLOCK CANOPEN_SLAVE_EMCY\nVAR_INPUT\n  SLAVE : USINT := 1;\n  ENABLE : BOOL;\n  ERRORCODE : WORD;\n  INFO : UDINT;\nEND_VAR\nVAR_OUTPUT\n  CONFIRM : BOOL;\n  ERROR : USINT;\n  ERRORTEXT : STRING;\n  ACTIVE : BOOL;\nEND_VAR\nVAR\n  cop_handle : UDINT;\n  cop_slave : USINT;\n  cop_last : USINT;\n  cop_reason : USINT;\nEND_VAR\n// SPDX-License-Identifier: Apache-2.0\n//\n// Shared code of the canopen function blocks. The generator copies it into every block's source,\n// because the editor grafts each library C++ block into one c_blocks_code.cpp and has no other\n// place for shared code; the include guard keeps one copy per program.\n//\n// The editor binds every pin and local of a block to a #define of its name, so nothing here uses\n// a pin or local name (those are upper case or start with cop_; this code is lower case), nor the\n// keyword that closes a variable section, and no system header is included after those defines:\n// dlopen, dlsym and dlclose are declared here as glibc declares them.\n//\n// Derived from canworks ec7fd59, library/src/common.inc (Apache-2.0), adapted to the plugin's\n// interface version 3 (core/src/drivers/plugins/native/canopen/plc_api.h in the runtime fork).\n#ifndef CANOPEN_FB_SHARED_INCLUDED\n#define CANOPEN_FB_SHARED_INCLUDED\n#if defined(__linux__)\nextern \"C\" void *dlopen(const char *file, int mode) noexcept(true);\nextern \"C\" void *dlsym(void *handle, const char *name) noexcept(true);\nextern \"C\" int dlclose(void *handle) noexcept(true);\n#else\n// A board's firmware: the slave module's table, when the project has a slave on the board.\nextern \"C\" const void *canopen_plc_api(uint32_t version) __attribute__((weak));\n#endif\n\nnamespace canopen_fb {\n\n// A copy of the plugin's C interface, version 3; keep in step with plc_api.h. Version 1 is asked\n// for, since a newer plugin answers it with its newest table; `size` tells which it is.\nconst uint32_t api_version = 1;\nconst uint32_t max_data = 256;\nenum {\n  e_no_error = 0, e_other_error = 1, e_timeout = 2, e_bus_off = 3, e_error_passive = 4,\n  e_internal = 5, e_wrong_parameter = 6, e_node_id_unknown = 7, e_net_id_unknown = 8,\n  e_request_error = 9, e_no_driver = 10\n};\nenum {\n  r_none = 0, r_booting = 1, r_full = 2, r_not_run = 3, r_restart = 4, r_link = 5,\n  r_too_large = 6, r_length = 7, r_command = 8, r_version = 9,\n  r_not_in_eds = 100,  // the blocks' own: DATALENGTH 0 for an object the EDS does not list\n  r_needs_v2 = 101,    // the blocks' own: the plugin's table lacks the functions the block needs\n  r_reset = 102,       // the blocks' own: a slave NMT block asked for a reset\n  r_own_code = 103,    // the blocks' own: an emergency code the slave sends itself\n  r_slots = 104,       // the blocks' own: all program emergency slots are taken\n  r_object = 105       // the blocks' own: the slave has no such object from the master\n};\nenum { k_read = 0, k_write = 1, k_nmt = 2 };\nstruct request {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint8_t command;\n  uint16_t index;\n  uint8_t subindex;\n  uint8_t reserved;\n  uint32_t timeout_ms;\n  uint32_t length;\n  const uint8_t *data;\n};\nstruct result {\n  uint8_t error;\n  uint8_t reason;\n  uint16_t reserved;\n  uint32_t abort_code;\n  uint32_t length;\n};\nstruct emcy {\n  uint8_t node;\n  uint8_t error_register;\n  uint16_t error_code;\n  uint8_t data[5];\n  uint8_t reserved[3];\n  uint32_t lost;\n};\nstruct api_v1 {\n  uint32_t size;\n  uint32_t version;\n  uint64_t (*start)(const request *req, result *res);\n  int (*poll)(uint64_t handle, result *res, uint8_t *data, uint32_t cap);\n  void (*cancel)(uint64_t handle);\n  int (*node_state)(uint8_t network, uint8_t node, uint8_t *state);\n  int (*kernel_state)(uint8_t network, uint8_t *state);\n  int (*local_node_id)(uint8_t network, uint8_t *node_id);\n  int (*emcy_cursor)(uint8_t network, uint64_t *cursor);\n  int (*emcy_next)(uint8_t network, uint8_t node, uint64_t *cursor, emcy *out);\n  uint32_t flags;  // present when size covers it\n};\n// flags: the plugin is never unmapped, so its table stays valid for the life of the process.\nconst uint32_t flag_permanent = 0x1;\n// node_info::flags\nconst uint8_t node_enabled = 0x01;\nconst uint8_t node_optional = 0x02;\nconst uint8_t node_program_start = 0x04;\nconst uint32_t status_text = 80;\nstruct node_info {\n  uint8_t run_state;\n  uint8_t flags;\n  uint8_t reserved[2];\n  char problem[status_text];\n};\nstruct network_info {\n  uint8_t mandatory_up;\n  uint8_t optional_up;\n  uint8_t configured;\n  uint8_t operational;\n  uint8_t waiting;\n  uint8_t disabled;\n  uint8_t faulty;\n  uint8_t nodes;\n};\nstruct api_v2 {\n  api_v1 v1;\n  int (*node_status)(uint8_t network, uint8_t node, node_info *out);\n  int (*network_status)(uint8_t network, network_info *out);\n  int (*node_enable)(uint8_t network, uint8_t node, uint8_t on);\n};\n// slave_info::flags\nconst uint8_t slave_on_bus = 0x01;\nconst uint8_t slave_master_watched = 0x02;\nconst uint8_t slave_master_seen = 0x04;\nconst uint32_t slave_emcy_slots = 31;\nstruct slave_info {\n  uint8_t state;\n  uint8_t node_id;\n  uint8_t flags;\n  uint8_t bus_state;\n  uint8_t error_register;\n  uint8_t emcy_active;\n  uint8_t reserved[2];\n};\nstruct api_v3 {\n  api_v2 v2;\n  int (*slave_status)(uint8_t slave, slave_info *out);\n  int (*slave_nmt)(uint8_t slave, uint8_t command);\n  int (*slave_nmt_done)(uint8_t slave, uint8_t command, uint8_t *done);\n  int (*slave_emcy_claim)(uint8_t slave, uint32_t *handle);\n  int (*slave_emcy)(uint8_t slave, uint32_t handle, uint8_t active, uint16_t code, uint32_t info);\n  int (*slave_written)(uint8_t slave, uint16_t index, uint8_t subindex, uint32_t *count);\n};\n// After a lookup that found no plugin, this many lookups are skipped before the next one.\nconst uint32_t miss_skip = 1024;\n\n// The loaded plugin's table, or null with `why` set (r_not_run or r_version). The runtime loads\n// the plugin again at each PLC start while this program stays loaded, so a table is kept only\n// when its flags say it stays valid; otherwise it is looked up on each call. While no plugin is\n// found, only one lookup in miss_skip runs; the others answer r_not_run at once.\ninline const api_v1 *lookup_api(uint8_t &why) {\n  const void *table = nullptr;\n  why = r_not_run;\n#if defined(__linux__)\n  void *lib = dlopen(\"libcanopen_plugin.so\", 0x2 | 0x4);  // RTLD_NOW | RTLD_NOLOAD\n  if (!lib) return nullptr;\n  typedef const void *(*entry_t)(uint32_t);\n  entry_t entry = reinterpret_cast<entry_t>(dlsym(lib, \"canopen_plc_api\"));\n  if (entry) {\n    table = entry(api_version);\n    if (!table) why = r_version;\n  }\n  dlclose(lib);\n#else\n  if (canopen_plc_api) {\n    table = canopen_plc_api(api_version);\n    if (!table) why = r_version;\n  }\n#endif\n  const api_v1 *t = static_cast<const api_v1 *>(table);\n  if (t && t->size < __builtin_offsetof(api_v1, flags)) {\n    why = r_version;\n    return nullptr;\n  }\n  return t;\n}\n\ninline bool api_is_permanent(const api_v1 *t) {\n  return t->size >= sizeof(api_v1) && (t->flags & flag_permanent) != 0;\n}\n\ninline const api_v1 *api(uint8_t &why) {\n  static const api_v1 *kept = nullptr;\n  static uint32_t skip = 0;\n  const api_v1 *t = __atomic_load_n(&kept, __ATOMIC_ACQUIRE);\n  if (t) {\n    why = r_not_run;\n    return t;\n  }\n  uint32_t left = __atomic_load_n(&skip, __ATOMIC_RELAXED);\n  if (left > 0) {\n    __atomic_store_n(&skip, left - 1, __ATOMIC_RELAXED);\n    why = r_not_run;\n    return nullptr;\n  }\n  t = lookup_api(why);\n  if (!t) {\n    if (why == r_not_run) __atomic_store_n(&skip, miss_skip, __ATOMIC_RELAXED);\n    return nullptr;\n  }\n  if (api_is_permanent(t)) __atomic_store_n(&kept, t, __ATOMIC_RELEASE);\n  return t;\n}\n\n// The table with the version 2 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v2 *api2(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 2 || t->size < sizeof(api_v2)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v2 *>(static_cast<const void *>(t));\n}\n\n// The table with the version 3 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v3 *api3(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 3 || t->size < sizeof(api_v3)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v3 *>(static_cast<const void *>(t));\n}\n\n// ---- Error text, written into a fixed buffer (no allocation, no libc). ----\nstruct text {\n  char buf[200];\n  unsigned len;\n};\ninline void clear(text &t) {\n  t.len = 0;\n  t.buf[0] = 0;\n}\ninline void put(text &t, const char *s) {\n  while (*s && t.len + 1 < sizeof t.buf) t.buf[t.len++] = *s++;\n  t.buf[t.len] = 0;\n}\ninline void put_dec(text &t, uint32_t v) {\n  char d[12];\n  int n = 0;\n  do {\n    d[n++] = static_cast<char>('0' + v % 10);\n    v /= 10;\n  } while (v && n < 12);\n  while (n > 0 && t.len + 1 < sizeof t.buf) t.buf[t.len++] = d[--n];\n  t.buf[t.len] = 0;\n}\ninline void put_hex(text &t, uint32_t v, int digits) {\n  put(t, \"16#\");\n  for (int i = digits - 1; i >= 0 && t.len + 1 < sizeof t.buf; --i)\n    t.buf[t.len++] = \"0123456789ABCDEF\"[(v >> (4 * i)) & 0xF];\n  t.buf[t.len] = 0;\n}\n\n// CiA 301 SDO abort codes.\ninline const char *abort_text(uint32_t code) {\n  switch (code) {\n    case 0x05030000u: return \"toggle bit not alternated\";\n    case 0x05040000u: return \"SDO protocol timed out\";\n    case 0x05040001u: return \"command specifier not valid or unknown\";\n    case 0x05040002u: return \"invalid block size\";\n    case 0x05040003u: return \"invalid sequence number\";\n    case 0x05040004u: return \"CRC error\";\n    case 0x05040005u: return \"out of memory\";\n    case 0x06010000u: return \"unsupported access to an object\";\n    case 0x06010001u: return \"attempt to read a write only object\";\n    case 0x06010002u: return \"attempt to write a read only object\";\n    case 0x06020000u: return \"object does not exist\";\n    case 0x06040041u: return \"object cannot be mapped to the PDO\";\n    case 0x06040042u: return \"the mapped objects would exceed the PDO length\";\n    case 0x06040043u: return \"general parameter incompatibility\";\n    case 0x06040047u: return \"general internal incompatibility in the device\";\n    case 0x06060000u: return \"access failed due to a hardware error\";\n    case 0x06070010u: return \"data type or length does not match\";\n    case 0x06070012u: return \"data type does not match, length too high\";\n    case 0x06070013u: return \"data type does not match, length too low\";\n    case 0x06090011u: return \"sub-index does not exist\";\n    case 0x06090030u: return \"invalid value for parameter\";\n    case 0x06090031u: return \"value of parameter written too high\";\n    case 0x06090032u: return \"value of parameter written too low\";\n    case 0x06090036u: return \"maximum value is less than minimum value\";\n    case 0x060A0023u: return \"resource not available: SDO connection\";\n    case 0x08000000u: return \"general error\";\n    case 0x08000020u: return \"data cannot be transferred or stored to the application\";\n    case 0x08000021u: return \"data cannot be transferred or stored because of local control\";\n    case 0x08000022u: return \"data cannot be transferred or stored in the present device state\";\n    case 0x08000023u: return \"no object dictionary is present\";\n    case 0x08000024u: return \"no data available\";\n    default: return \"unknown abort code\";\n  }\n}\n\n// What a request was about, for its error text.\nstruct what {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint16_t index;\n  uint8_t subindex;\n  uint32_t timeout_ms;\n  uint32_t capacity;  // bytes the block holds\n};\n\ninline what what_of(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex,\n                    uint32_t timeout_ms, uint32_t capacity) {\n  what w{};\n  w.network = network;\n  w.node = node;\n  w.index = index;\n  w.subindex = subindex;\n  w.timeout_ms = timeout_ms;\n  w.capacity = capacity;\n  return w;\n}\n\ninline void put_node(text &t, const what &w) {\n  if (w.node == 0) {\n    put(t, \"the nodes of network \");\n    put_dec(t, w.network);\n  } else {\n    put(t, \"node \");\n    put_dec(t, w.node);\n  }\n}\n\ninline void put_object(text &t, const what &w) {\n  put_hex(t, w.index, 4);\n  put(t, \" sub \");\n  put_dec(t, w.subindex);\n}\n\n// The error text of a failed request, and its ERRORINFO.\ninline uint32_t describe(text &t, const what &w, const result &r) {\n  clear(t);\n  switch (r.error) {\n    case e_other_error:\n      put_node(t, w);\n      put(t, \" aborted \");\n      put_object(t, w);\n      put(t, \": \");\n      put(t, abort_text(r.abort_code));\n      put(t, \" (\");\n      put_hex(t, r.abort_code, 8);\n      put(t, \")\");\n      return r.abort_code;\n    case e_timeout:\n      put_node(t, w);\n      put(t, \" did not answer\");\n      if (w.timeout_ms) {\n        put(t, \" within \");\n        put_dec(t, w.timeout_ms);\n        put(t, \" ms\");\n      }\n      return r.abort_code ? r.abort_code : 0x05040000u;\n    case e_bus_off:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, r.reason == r_link ? \" link is down\" : \" bus is off\");\n      return 0;\n    case e_error_passive:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" is error passive\");\n      return 0;\n    case e_wrong_parameter:\n      if (r.reason == r_too_large) {\n        put(t, \"object has \");\n        put_dec(t, r.length);\n        put(t, \" bytes, the block holds \");\n        put_dec(t, w.capacity);\n        return r.length;\n      }\n      if (r.reason == r_length) {\n        put(t, \"DATALENGTH \");\n        put_dec(t, r.length);\n        put(t, \" is not 1 to \");\n        put_dec(t, w.capacity);\n        return 0;\n      }\n      if (r.reason == r_not_in_eds) {\n        put_node(t, w);\n        put(t, \" has no object \");\n        put_object(t, w);\n        put(t, \" of 1 to 4 bytes in its EDS; set DATALENGTH\");\n        return 0;\n      }\n      if (r.reason == r_command) {\n        put(t, \"STATE \");\n        put_dec(t, r.length);\n        put(t, \" is not an NMT state change\");\n        return 0;\n      }\n      put(t, \"wrong parameter\");\n      return 0;\n    case e_node_id_unknown:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" has no node \");\n      put_dec(t, w.node);\n      return 0;\n    case e_net_id_unknown:\n      put(t, \"no CANopen network \");\n      put_dec(t, w.network);\n      return 0;\n    case e_request_error:\n      if (r.reason == r_booting) {\n        put_node(t, w);\n        put(t, \" is booting\");\n      } else if (r.reason == r_full) {\n        put(t, \"network \");\n        put_dec(t, w.network);\n        put(t, \" has 16 block requests waiting\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return 0;\n    case e_no_driver:\n      if (r.reason == r_restart)\n        put(t, \"request cancelled by the PLC stop\");\n      else if (r.reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else if (r.reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else\n        put(t, \"no CANopen network runs\");\n      return 0;\n    default:\n      put(t, \"internal error in the CANopen master\");\n      return 0;\n  }\n}\n\n// The error text of a slave block, for `slave` and the object (index, subindex) or ERRORCODE.\ninline void describe_slave(text &t, uint8_t slave, uint8_t error, uint8_t reason, uint16_t index,\n                           uint8_t subindex) {\n  clear(t);\n  switch (error) {\n    case e_no_error:\n      return;\n    case e_net_id_unknown:\n      put(t, \"no CANopen slave \");\n      put_dec(t, slave);\n      return;\n    case e_no_driver:\n      if (reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else if (reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else\n        put(t, \"no CANopen slave runs\");\n      return;\n    case e_wrong_parameter:\n      if (reason == r_reset) {\n        put(t, \"the program cannot reset the slave; STATE must be START_REMOTE_NODE, \");\n        put(t, \"STOP_REMOTE_NODE or ENTER_PRE_OPERATIONAL\");\n      } else if (reason == r_own_code) {\n        put(t, \"ERRORCODE \");\n        put_hex(t, index, 4);\n        put(t, \" is sent by the slave itself; use another code\");\n      } else if (reason == r_object) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" has no object \");\n        put_hex(t, index, 4);\n        put(t, \" sub \");\n        put_dec(t, subindex);\n        put(t, \" written by the master\");\n      } else {\n        put(t, \"wrong parameter\");\n      }\n      return;\n    case e_request_error:\n      if (reason == r_slots) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" already holds 31 program emergencies\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return;\n    default:\n      put(t, \"internal error in the CANopen slave\");\n      return;\n  }\n}\n\n// Shows a failed request on the block's ERROR, ERRORINFO and ERRORTEXT pins.\ntemplate <class error_pin, class info_pin, class text_pin>\ninline void show(error_pin &error, info_pin &info, text_pin &errortext, const what &w,\n                 const result &r) {\n  text t;\n  uint32_t i = describe(t, w, r);\n  error = r.error ? r.error : static_cast<uint8_t>(e_internal);\n  info = i;\n  errortext = t.buf;\n}\n\n// The size of an object of 1 to 4 bytes in the node's EDS, from the table the editor's build\n// generates (sorted network, node, index, sub-index, size); 0 when it is not listed.\ninline uint32_t eds_size(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex) {\n  const uint64_t key = (static_cast<uint64_t>(network) << 32) | (static_cast<uint64_t>(node) << 24) |\n                       (static_cast<uint64_t>(index) << 8) | subindex;\n  long lo = 0;\n  long hi = static_cast<long>(static_cast<uint32_t>(strucpp::CANOPEN_OBJECT_SIZE_COUNT)) - 1;\n  while (lo <= hi) {\n    long mid = (lo + hi) / 2;\n    uint64_t entry = static_cast<uint64_t>(strucpp::CANOPEN_OBJECT_SIZES[mid]);\n    uint64_t k = entry >> 8;\n    if (k == key) return static_cast<uint32_t>(entry & 0xFF);\n    if (k < key)\n      lo = mid + 1;\n    else\n      hi = mid - 1;\n  }\n  return 0;\n}\n\n// TIME (nanoseconds) to milliseconds; 0 or less: the network's SDO timeout.\ninline uint32_t timeout_ms(long long ns) {\n  if (ns <= 0) return 0;\n  long long ms = (ns + 999999) / 1000000;\n  return ms > 3600000 ? 3600000u : static_cast<uint32_t>(ms);\n}\n\n// One instance's handshake (CiA 405): the block keeps `prev`, `phase` and `handle` in its locals.\nenum { phase_idle = 0, phase_busy = 1, phase_ended = 2 };\nstruct step {\n  bool start;   // rising edge of ENABLE: clear the outputs and start a request\n  bool cancel;  // falling edge while busy: drop the request and clear the outputs\n  bool clear;   // the result was shown and ENABLE is FALSE: clear the outputs\n};\ninline step begin(bool enable, bool &prev, uint8_t &phase) {\n  step s{false, false, false};\n  bool rising = enable && !prev;\n  prev = enable;\n  if (!enable && phase == phase_busy) {\n    s.cancel = true;\n    phase = phase_idle;\n  } else if (!enable && phase == phase_ended) {\n    s.clear = true;\n    phase = phase_idle;\n  }\n  if (rising && phase != phase_busy) s.start = true;\n  return s;\n}\n\n// Starts `req`. Returns the handle, or 0 with `res` saying why it cannot run.\ninline uint64_t start(const request &req, result &res) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why;\n    return 0;\n  }\n  uint64_t handle = t->start(&req, &res);\n  if (!handle && res.error == e_no_error) res.error = e_internal;\n  return handle;\n}\n\n// 0 while the request runs; 1 done, 2 failed (`res` set).\ninline int poll(uint64_t handle, result &res, uint8_t *data, uint32_t cap) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why == r_version ? r_version : r_restart;\n    return 2;\n  }\n  return t->poll(handle, &res, data, cap);\n}\n\ninline void cancel(uint64_t handle) {\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (t) t->cancel(handle);\n}\n\ninline void put_le(uint8_t *out, uint32_t v, unsigned n) {\n  for (unsigned b = 0; b < n; ++b) out[b] = static_cast<uint8_t>(v >> (8 * b));\n}\n\ninline uint32_t get_le(const uint8_t *in, unsigned n) {\n  uint32_t v = 0;\n  for (unsigned b = 0; b < n && b < 4; ++b) v |= static_cast<uint32_t>(in[b]) << (8 * b);\n  return v;\n}\n\n// A failure before any request ran (bad input): `res` for describe().\ninline result fail(uint8_t error, uint8_t reason, uint32_t length) {\n  result r{};\n  r.error = error;\n  r.reason = reason;\n  r.length = length;\n  return r;\n}\n\n}  // namespace canopen_fb\n#endif\nvoid setup() {\n}\n\nvoid loop() {\n  uint8_t l_why = 0;\n  const canopen_fb::api_v3 *l_api = canopen_fb::api3(l_why);\n  int l_error = canopen_fb::e_no_error;\n  uint8_t l_reason = 0;\n  uint16_t l_index = ERRORCODE;\n  uint8_t l_sub = 0;\n  bool l_active = false;\n  if (!l_api) {\n    if (ENABLE) {\n      l_error = canopen_fb::e_no_driver;\n      l_reason = l_why;\n    }\n  } else if (cop_handle && cop_slave != SLAVE) {\n    // Moved to another slave: clear it on the old one and claim again.\n    l_api->slave_emcy(cop_slave, cop_handle, 0, 0, 0);\n    cop_handle = 0;\n  }\n  if (l_api && (ENABLE || cop_handle)) {\n    uint16_t l_code = ERRORCODE;\n    if (ENABLE && (l_code == 0 || l_code == 0x6200 || l_code == 0x8130)) {\n      l_error = canopen_fb::e_wrong_parameter;\n      l_reason = canopen_fb::r_own_code;\n      if (cop_handle) l_api->slave_emcy(SLAVE, cop_handle, 0, 0, 0);\n    } else {\n      for (int l_try = 0; l_try < 2; ++l_try) {\n        if (!cop_handle) {\n          if (!ENABLE) break;\n          uint32_t l_handle = 0;\n          l_error = l_api->slave_emcy_claim(SLAVE, &l_handle);\n          if (l_error != canopen_fb::e_no_error) {\n            if (l_error == canopen_fb::e_request_error) l_reason = canopen_fb::r_slots;\n            break;\n          }\n          cop_handle = l_handle;\n          cop_slave = SLAVE;\n        }\n        l_error = l_api->slave_emcy(SLAVE, cop_handle, ENABLE ? 1 : 0, l_code, INFO);\n        // A handle from before the last PLC stop is no longer valid: claim again.\n        if (l_error != canopen_fb::e_request_error) break;\n        cop_handle = 0;\n        l_error = canopen_fb::e_no_error;\n      }\n      if (!ENABLE) l_error = canopen_fb::e_no_error;\n      l_active = ENABLE && l_error == canopen_fb::e_no_error;\n    }\n  }\n  ACTIVE = l_active;\n  CONFIRM = ENABLE && l_error == canopen_fb::e_no_error;\n  ERROR = static_cast<uint8_t>(l_error);\n  if (l_error != cop_last || l_reason != cop_reason) {\n    canopen_fb::text l_text;\n    canopen_fb::describe_slave(l_text, SLAVE, static_cast<uint8_t>(l_error), l_reason, l_index, l_sub);\n    ERRORTEXT = l_text.buf;\n    cop_last = static_cast<uint8_t>(l_error);\n    cop_reason = l_reason;\n  }\n}\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "CANOPEN_SLAVE_WRITTEN.cpp",
      "source": "(* Tells how often the master has written an object of this runtime's CANopen slave, by SDO or RPDO, also with the same value: COUNT since the slave started, and NEW TRUE in the call after COUNT changed (in the first call when it was written before). An object mapped to an RPDO counts every frame. INDEX and SUBINDEX name an object from the master. SLAVE is the slave's name or its place in the project's slaves, from 1.\nExample: cmd(SLAVE := Line_IO, ENABLE := TRUE, INDEX := 16#2000, SUBINDEX := 1); IF cmd.NEW THEN ... END_IF; *)\nFUNCTION_BLOCK CANOPEN_SLAVE_WRITTEN\nVAR_INPUT\n  SLAVE : USINT := 1;\n  ENABLE : BOOL;\n  INDEX : WORD;\n  SUBINDEX : BYTE;\nEND_VAR\nVAR_OUTPUT\n  CONFIRM : BOOL;\n  ERROR : USINT;\n  ERRORTEXT : STRING;\n  COUNT : UDINT;\n  NEW : BOOL;\nEND_VAR\nVAR\n  cop_seen : UDINT;\n  cop_last : USINT;\n  cop_reason : USINT;\nEND_VAR\n// SPDX-License-Identifier: Apache-2.0\n//\n// Shared code of the canopen function blocks. The generator copies it into every block's source,\n// because the editor grafts each library C++ block into one c_blocks_code.cpp and has no other\n// place for shared code; the include guard keeps one copy per program.\n//\n// The editor binds every pin and local of a block to a #define of its name, so nothing here uses\n// a pin or local name (those are upper case or start with cop_; this code is lower case), nor the\n// keyword that closes a variable section, and no system header is included after those defines:\n// dlopen, dlsym and dlclose are declared here as glibc declares them.\n//\n// Derived from canworks ec7fd59, library/src/common.inc (Apache-2.0), adapted to the plugin's\n// interface version 3 (core/src/drivers/plugins/native/canopen/plc_api.h in the runtime fork).\n#ifndef CANOPEN_FB_SHARED_INCLUDED\n#define CANOPEN_FB_SHARED_INCLUDED\n#if defined(__linux__)\nextern \"C\" void *dlopen(const char *file, int mode) noexcept(true);\nextern \"C\" void *dlsym(void *handle, const char *name) noexcept(true);\nextern \"C\" int dlclose(void *handle) noexcept(true);\n#else\n// A board's firmware: the slave module's table, when the project has a slave on the board.\nextern \"C\" const void *canopen_plc_api(uint32_t version) __attribute__((weak));\n#endif\n\nnamespace canopen_fb {\n\n// A copy of the plugin's C interface, version 3; keep in step with plc_api.h. Version 1 is asked\n// for, since a newer plugin answers it with its newest table; `size` tells which it is.\nconst uint32_t api_version = 1;\nconst uint32_t max_data = 256;\nenum {\n  e_no_error = 0, e_other_error = 1, e_timeout = 2, e_bus_off = 3, e_error_passive = 4,\n  e_internal = 5, e_wrong_parameter = 6, e_node_id_unknown = 7, e_net_id_unknown = 8,\n  e_request_error = 9, e_no_driver = 10\n};\nenum {\n  r_none = 0, r_booting = 1, r_full = 2, r_not_run = 3, r_restart = 4, r_link = 5,\n  r_too_large = 6, r_length = 7, r_command = 8, r_version = 9,\n  r_not_in_eds = 100,  // the blocks' own: DATALENGTH 0 for an object the EDS does not list\n  r_needs_v2 = 101,    // the blocks' own: the plugin's table lacks the functions the block needs\n  r_reset = 102,       // the blocks' own: a slave NMT block asked for a reset\n  r_own_code = 103,    // the blocks' own: an emergency code the slave sends itself\n  r_slots = 104,       // the blocks' own: all program emergency slots are taken\n  r_object = 105       // the blocks' own: the slave has no such object from the master\n};\nenum { k_read = 0, k_write = 1, k_nmt = 2 };\nstruct request {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint8_t command;\n  uint16_t index;\n  uint8_t subindex;\n  uint8_t reserved;\n  uint32_t timeout_ms;\n  uint32_t length;\n  const uint8_t *data;\n};\nstruct result {\n  uint8_t error;\n  uint8_t reason;\n  uint16_t reserved;\n  uint32_t abort_code;\n  uint32_t length;\n};\nstruct emcy {\n  uint8_t node;\n  uint8_t error_register;\n  uint16_t error_code;\n  uint8_t data[5];\n  uint8_t reserved[3];\n  uint32_t lost;\n};\nstruct api_v1 {\n  uint32_t size;\n  uint32_t version;\n  uint64_t (*start)(const request *req, result *res);\n  int (*poll)(uint64_t handle, result *res, uint8_t *data, uint32_t cap);\n  void (*cancel)(uint64_t handle);\n  int (*node_state)(uint8_t network, uint8_t node, uint8_t *state);\n  int (*kernel_state)(uint8_t network, uint8_t *state);\n  int (*local_node_id)(uint8_t network, uint8_t *node_id);\n  int (*emcy_cursor)(uint8_t network, uint64_t *cursor);\n  int (*emcy_next)(uint8_t network, uint8_t node, uint64_t *cursor, emcy *out);\n  uint32_t flags;  // present when size covers it\n};\n// flags: the plugin is never unmapped, so its table stays valid for the life of the process.\nconst uint32_t flag_permanent = 0x1;\n// node_info::flags\nconst uint8_t node_enabled = 0x01;\nconst uint8_t node_optional = 0x02;\nconst uint8_t node_program_start = 0x04;\nconst uint32_t status_text = 80;\nstruct node_info {\n  uint8_t run_state;\n  uint8_t flags;\n  uint8_t reserved[2];\n  char problem[status_text];\n};\nstruct network_info {\n  uint8_t mandatory_up;\n  uint8_t optional_up;\n  uint8_t configured;\n  uint8_t operational;\n  uint8_t waiting;\n  uint8_t disabled;\n  uint8_t faulty;\n  uint8_t nodes;\n};\nstruct api_v2 {\n  api_v1 v1;\n  int (*node_status)(uint8_t network, uint8_t node, node_info *out);\n  int (*network_status)(uint8_t network, network_info *out);\n  int (*node_enable)(uint8_t network, uint8_t node, uint8_t on);\n};\n// slave_info::flags\nconst uint8_t slave_on_bus = 0x01;\nconst uint8_t slave_master_watched = 0x02;\nconst uint8_t slave_master_seen = 0x04;\nconst uint32_t slave_emcy_slots = 31;\nstruct slave_info {\n  uint8_t state;\n  uint8_t node_id;\n  uint8_t flags;\n  uint8_t bus_state;\n  uint8_t error_register;\n  uint8_t emcy_active;\n  uint8_t reserved[2];\n};\nstruct api_v3 {\n  api_v2 v2;\n  int (*slave_status)(uint8_t slave, slave_info *out);\n  int (*slave_nmt)(uint8_t slave, uint8_t command);\n  int (*slave_nmt_done)(uint8_t slave, uint8_t command, uint8_t *done);\n  int (*slave_emcy_claim)(uint8_t slave, uint32_t *handle);\n  int (*slave_emcy)(uint8_t slave, uint32_t handle, uint8_t active, uint16_t code, uint32_t info);\n  int (*slave_written)(uint8_t slave, uint16_t index, uint8_t subindex, uint32_t *count);\n};\n// After a lookup that found no plugin, this many lookups are skipped before the next one.\nconst uint32_t miss_skip = 1024;\n\n// The loaded plugin's table, or null with `why` set (r_not_run or r_version). The runtime loads\n// the plugin again at each PLC start while this program stays loaded, so a table is kept only\n// when its flags say it stays valid; otherwise it is looked up on each call. While no plugin is\n// found, only one lookup in miss_skip runs; the others answer r_not_run at once.\ninline const api_v1 *lookup_api(uint8_t &why) {\n  const void *table = nullptr;\n  why = r_not_run;\n#if defined(__linux__)\n  void *lib = dlopen(\"libcanopen_plugin.so\", 0x2 | 0x4);  // RTLD_NOW | RTLD_NOLOAD\n  if (!lib) return nullptr;\n  typedef const void *(*entry_t)(uint32_t);\n  entry_t entry = reinterpret_cast<entry_t>(dlsym(lib, \"canopen_plc_api\"));\n  if (entry) {\n    table = entry(api_version);\n    if (!table) why = r_version;\n  }\n  dlclose(lib);\n#else\n  if (canopen_plc_api) {\n    table = canopen_plc_api(api_version);\n    if (!table) why = r_version;\n  }\n#endif\n  const api_v1 *t = static_cast<const api_v1 *>(table);\n  if (t && t->size < __builtin_offsetof(api_v1, flags)) {\n    why = r_version;\n    return nullptr;\n  }\n  return t;\n}\n\ninline bool api_is_permanent(const api_v1 *t) {\n  return t->size >= sizeof(api_v1) && (t->flags & flag_permanent) != 0;\n}\n\ninline const api_v1 *api(uint8_t &why) {\n  static const api_v1 *kept = nullptr;\n  static uint32_t skip = 0;\n  const api_v1 *t = __atomic_load_n(&kept, __ATOMIC_ACQUIRE);\n  if (t) {\n    why = r_not_run;\n    return t;\n  }\n  uint32_t left = __atomic_load_n(&skip, __ATOMIC_RELAXED);\n  if (left > 0) {\n    __atomic_store_n(&skip, left - 1, __ATOMIC_RELAXED);\n    why = r_not_run;\n    return nullptr;\n  }\n  t = lookup_api(why);\n  if (!t) {\n    if (why == r_not_run) __atomic_store_n(&skip, miss_skip, __ATOMIC_RELAXED);\n    return nullptr;\n  }\n  if (api_is_permanent(t)) __atomic_store_n(&kept, t, __ATOMIC_RELEASE);\n  return t;\n}\n\n// The table with the version 2 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v2 *api2(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 2 || t->size < sizeof(api_v2)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v2 *>(static_cast<const void *>(t));\n}\n\n// The table with the version 3 functions, or null with `why` set (r_needs_v2 for an older plugin).\ninline const api_v3 *api3(uint8_t &why) {\n  const api_v1 *t = api(why);\n  if (!t) return nullptr;\n  if (t->version < 3 || t->size < sizeof(api_v3)) {\n    why = r_needs_v2;\n    return nullptr;\n  }\n  return static_cast<const api_v3 *>(static_cast<const void *>(t));\n}\n\n// ---- Error text, written into a fixed buffer (no allocation, no libc). ----\nstruct text {\n  char buf[200];\n  unsigned len;\n};\ninline void clear(text &t) {\n  t.len = 0;\n  t.buf[0] = 0;\n}\ninline void put(text &t, const char *s) {\n  while (*s && t.len + 1 < sizeof t.buf) t.buf[t.len++] = *s++;\n  t.buf[t.len] = 0;\n}\ninline void put_dec(text &t, uint32_t v) {\n  char d[12];\n  int n = 0;\n  do {\n    d[n++] = static_cast<char>('0' + v % 10);\n    v /= 10;\n  } while (v && n < 12);\n  while (n > 0 && t.len + 1 < sizeof t.buf) t.buf[t.len++] = d[--n];\n  t.buf[t.len] = 0;\n}\ninline void put_hex(text &t, uint32_t v, int digits) {\n  put(t, \"16#\");\n  for (int i = digits - 1; i >= 0 && t.len + 1 < sizeof t.buf; --i)\n    t.buf[t.len++] = \"0123456789ABCDEF\"[(v >> (4 * i)) & 0xF];\n  t.buf[t.len] = 0;\n}\n\n// CiA 301 SDO abort codes.\ninline const char *abort_text(uint32_t code) {\n  switch (code) {\n    case 0x05030000u: return \"toggle bit not alternated\";\n    case 0x05040000u: return \"SDO protocol timed out\";\n    case 0x05040001u: return \"command specifier not valid or unknown\";\n    case 0x05040002u: return \"invalid block size\";\n    case 0x05040003u: return \"invalid sequence number\";\n    case 0x05040004u: return \"CRC error\";\n    case 0x05040005u: return \"out of memory\";\n    case 0x06010000u: return \"unsupported access to an object\";\n    case 0x06010001u: return \"attempt to read a write only object\";\n    case 0x06010002u: return \"attempt to write a read only object\";\n    case 0x06020000u: return \"object does not exist\";\n    case 0x06040041u: return \"object cannot be mapped to the PDO\";\n    case 0x06040042u: return \"the mapped objects would exceed the PDO length\";\n    case 0x06040043u: return \"general parameter incompatibility\";\n    case 0x06040047u: return \"general internal incompatibility in the device\";\n    case 0x06060000u: return \"access failed due to a hardware error\";\n    case 0x06070010u: return \"data type or length does not match\";\n    case 0x06070012u: return \"data type does not match, length too high\";\n    case 0x06070013u: return \"data type does not match, length too low\";\n    case 0x06090011u: return \"sub-index does not exist\";\n    case 0x06090030u: return \"invalid value for parameter\";\n    case 0x06090031u: return \"value of parameter written too high\";\n    case 0x06090032u: return \"value of parameter written too low\";\n    case 0x06090036u: return \"maximum value is less than minimum value\";\n    case 0x060A0023u: return \"resource not available: SDO connection\";\n    case 0x08000000u: return \"general error\";\n    case 0x08000020u: return \"data cannot be transferred or stored to the application\";\n    case 0x08000021u: return \"data cannot be transferred or stored because of local control\";\n    case 0x08000022u: return \"data cannot be transferred or stored in the present device state\";\n    case 0x08000023u: return \"no object dictionary is present\";\n    case 0x08000024u: return \"no data available\";\n    default: return \"unknown abort code\";\n  }\n}\n\n// What a request was about, for its error text.\nstruct what {\n  uint8_t network;\n  uint8_t node;\n  uint8_t kind;\n  uint16_t index;\n  uint8_t subindex;\n  uint32_t timeout_ms;\n  uint32_t capacity;  // bytes the block holds\n};\n\ninline what what_of(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex,\n                    uint32_t timeout_ms, uint32_t capacity) {\n  what w{};\n  w.network = network;\n  w.node = node;\n  w.index = index;\n  w.subindex = subindex;\n  w.timeout_ms = timeout_ms;\n  w.capacity = capacity;\n  return w;\n}\n\ninline void put_node(text &t, const what &w) {\n  if (w.node == 0) {\n    put(t, \"the nodes of network \");\n    put_dec(t, w.network);\n  } else {\n    put(t, \"node \");\n    put_dec(t, w.node);\n  }\n}\n\ninline void put_object(text &t, const what &w) {\n  put_hex(t, w.index, 4);\n  put(t, \" sub \");\n  put_dec(t, w.subindex);\n}\n\n// The error text of a failed request, and its ERRORINFO.\ninline uint32_t describe(text &t, const what &w, const result &r) {\n  clear(t);\n  switch (r.error) {\n    case e_other_error:\n      put_node(t, w);\n      put(t, \" aborted \");\n      put_object(t, w);\n      put(t, \": \");\n      put(t, abort_text(r.abort_code));\n      put(t, \" (\");\n      put_hex(t, r.abort_code, 8);\n      put(t, \")\");\n      return r.abort_code;\n    case e_timeout:\n      put_node(t, w);\n      put(t, \" did not answer\");\n      if (w.timeout_ms) {\n        put(t, \" within \");\n        put_dec(t, w.timeout_ms);\n        put(t, \" ms\");\n      }\n      return r.abort_code ? r.abort_code : 0x05040000u;\n    case e_bus_off:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, r.reason == r_link ? \" link is down\" : \" bus is off\");\n      return 0;\n    case e_error_passive:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" is error passive\");\n      return 0;\n    case e_wrong_parameter:\n      if (r.reason == r_too_large) {\n        put(t, \"object has \");\n        put_dec(t, r.length);\n        put(t, \" bytes, the block holds \");\n        put_dec(t, w.capacity);\n        return r.length;\n      }\n      if (r.reason == r_length) {\n        put(t, \"DATALENGTH \");\n        put_dec(t, r.length);\n        put(t, \" is not 1 to \");\n        put_dec(t, w.capacity);\n        return 0;\n      }\n      if (r.reason == r_not_in_eds) {\n        put_node(t, w);\n        put(t, \" has no object \");\n        put_object(t, w);\n        put(t, \" of 1 to 4 bytes in its EDS; set DATALENGTH\");\n        return 0;\n      }\n      if (r.reason == r_command) {\n        put(t, \"STATE \");\n        put_dec(t, r.length);\n        put(t, \" is not an NMT state change\");\n        return 0;\n      }\n      put(t, \"wrong parameter\");\n      return 0;\n    case e_node_id_unknown:\n      put(t, \"network \");\n      put_dec(t, w.network);\n      put(t, \" has no node \");\n      put_dec(t, w.node);\n      return 0;\n    case e_net_id_unknown:\n      put(t, \"no CANopen network \");\n      put_dec(t, w.network);\n      return 0;\n    case e_request_error:\n      if (r.reason == r_booting) {\n        put_node(t, w);\n        put(t, \" is booting\");\n      } else if (r.reason == r_full) {\n        put(t, \"network \");\n        put_dec(t, w.network);\n        put(t, \" has 16 block requests waiting\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return 0;\n    case e_no_driver:\n      if (r.reason == r_restart)\n        put(t, \"request cancelled by the PLC stop\");\n      else if (r.reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else if (r.reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else\n        put(t, \"no CANopen network runs\");\n      return 0;\n    default:\n      put(t, \"internal error in the CANopen master\");\n      return 0;\n  }\n}\n\n// The error text of a slave block, for `slave` and the object (index, subindex) or ERRORCODE.\ninline void describe_slave(text &t, uint8_t slave, uint8_t error, uint8_t reason, uint16_t index,\n                           uint8_t subindex) {\n  clear(t);\n  switch (error) {\n    case e_no_error:\n      return;\n    case e_net_id_unknown:\n      put(t, \"no CANopen slave \");\n      put_dec(t, slave);\n      return;\n    case e_no_driver:\n      if (reason == r_needs_v2)\n        put(t, \"the runtime's CANopen plugin is too old for this block; update the runtime\");\n      else if (reason == r_version)\n        put(t, \"the CANopen plugin does not offer the blocks' interface version 1\");\n      else\n        put(t, \"no CANopen slave runs\");\n      return;\n    case e_wrong_parameter:\n      if (reason == r_reset) {\n        put(t, \"the program cannot reset the slave; STATE must be START_REMOTE_NODE, \");\n        put(t, \"STOP_REMOTE_NODE or ENTER_PRE_OPERATIONAL\");\n      } else if (reason == r_own_code) {\n        put(t, \"ERRORCODE \");\n        put_hex(t, index, 4);\n        put(t, \" is sent by the slave itself; use another code\");\n      } else if (reason == r_object) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" has no object \");\n        put_hex(t, index, 4);\n        put(t, \" sub \");\n        put_dec(t, subindex);\n        put(t, \" written by the master\");\n      } else {\n        put(t, \"wrong parameter\");\n      }\n      return;\n    case e_request_error:\n      if (reason == r_slots) {\n        put(t, \"slave \");\n        put_dec(t, slave);\n        put(t, \" already holds 31 program emergencies\");\n      } else {\n        put(t, \"the request cannot run now\");\n      }\n      return;\n    default:\n      put(t, \"internal error in the CANopen slave\");\n      return;\n  }\n}\n\n// Shows a failed request on the block's ERROR, ERRORINFO and ERRORTEXT pins.\ntemplate <class error_pin, class info_pin, class text_pin>\ninline void show(error_pin &error, info_pin &info, text_pin &errortext, const what &w,\n                 const result &r) {\n  text t;\n  uint32_t i = describe(t, w, r);\n  error = r.error ? r.error : static_cast<uint8_t>(e_internal);\n  info = i;\n  errortext = t.buf;\n}\n\n// The size of an object of 1 to 4 bytes in the node's EDS, from the table the editor's build\n// generates (sorted network, node, index, sub-index, size); 0 when it is not listed.\ninline uint32_t eds_size(uint8_t network, uint8_t node, uint16_t index, uint8_t subindex) {\n  const uint64_t key = (static_cast<uint64_t>(network) << 32) | (static_cast<uint64_t>(node) << 24) |\n                       (static_cast<uint64_t>(index) << 8) | subindex;\n  long lo = 0;\n  long hi = static_cast<long>(static_cast<uint32_t>(strucpp::CANOPEN_OBJECT_SIZE_COUNT)) - 1;\n  while (lo <= hi) {\n    long mid = (lo + hi) / 2;\n    uint64_t entry = static_cast<uint64_t>(strucpp::CANOPEN_OBJECT_SIZES[mid]);\n    uint64_t k = entry >> 8;\n    if (k == key) return static_cast<uint32_t>(entry & 0xFF);\n    if (k < key)\n      lo = mid + 1;\n    else\n      hi = mid - 1;\n  }\n  return 0;\n}\n\n// TIME (nanoseconds) to milliseconds; 0 or less: the network's SDO timeout.\ninline uint32_t timeout_ms(long long ns) {\n  if (ns <= 0) return 0;\n  long long ms = (ns + 999999) / 1000000;\n  return ms > 3600000 ? 3600000u : static_cast<uint32_t>(ms);\n}\n\n// One instance's handshake (CiA 405): the block keeps `prev`, `phase` and `handle` in its locals.\nenum { phase_idle = 0, phase_busy = 1, phase_ended = 2 };\nstruct step {\n  bool start;   // rising edge of ENABLE: clear the outputs and start a request\n  bool cancel;  // falling edge while busy: drop the request and clear the outputs\n  bool clear;   // the result was shown and ENABLE is FALSE: clear the outputs\n};\ninline step begin(bool enable, bool &prev, uint8_t &phase) {\n  step s{false, false, false};\n  bool rising = enable && !prev;\n  prev = enable;\n  if (!enable && phase == phase_busy) {\n    s.cancel = true;\n    phase = phase_idle;\n  } else if (!enable && phase == phase_ended) {\n    s.clear = true;\n    phase = phase_idle;\n  }\n  if (rising && phase != phase_busy) s.start = true;\n  return s;\n}\n\n// Starts `req`. Returns the handle, or 0 with `res` saying why it cannot run.\ninline uint64_t start(const request &req, result &res) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why;\n    return 0;\n  }\n  uint64_t handle = t->start(&req, &res);\n  if (!handle && res.error == e_no_error) res.error = e_internal;\n  return handle;\n}\n\n// 0 while the request runs; 1 done, 2 failed (`res` set).\ninline int poll(uint64_t handle, result &res, uint8_t *data, uint32_t cap) {\n  res = result{};\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (!t) {\n    res.error = e_no_driver;\n    res.reason = why == r_version ? r_version : r_restart;\n    return 2;\n  }\n  return t->poll(handle, &res, data, cap);\n}\n\ninline void cancel(uint64_t handle) {\n  uint8_t why = 0;\n  const api_v1 *t = api(why);\n  if (t) t->cancel(handle);\n}\n\ninline void put_le(uint8_t *out, uint32_t v, unsigned n) {\n  for (unsigned b = 0; b < n; ++b) out[b] = static_cast<uint8_t>(v >> (8 * b));\n}\n\ninline uint32_t get_le(const uint8_t *in, unsigned n) {\n  uint32_t v = 0;\n  for (unsigned b = 0; b < n && b < 4; ++b) v |= static_cast<uint32_t>(in[b]) << (8 * b);\n  return v;\n}\n\n// A failure before any request ran (bad input): `res` for describe().\ninline result fail(uint8_t error, uint8_t reason, uint32_t length) {\n  result r{};\n  r.error = error;\n  r.reason = reason;\n  r.length = length;\n  return r;\n}\n\n}  // namespace canopen_fb\n#endif\nvoid setup() {\n}\n\nvoid loop() {\n  NEW = false;\n  if (!ENABLE) {\n    CONFIRM = false;\n    ERROR = 0;\n    if (cop_last != 0) ERRORTEXT = \"\";\n    cop_last = 0;\n    cop_reason = 0;\n    return;\n  }\n  uint8_t l_why = 0;\n  const canopen_fb::api_v3 *l_api = canopen_fb::api3(l_why);\n  int l_error = canopen_fb::e_no_driver;\n  uint8_t l_reason = l_api ? 0 : l_why;\n  uint16_t l_index = INDEX;\n  uint8_t l_sub = SUBINDEX;\n  if (l_api) {\n    uint32_t l_count = 0;\n    l_error = l_api->slave_written(SLAVE, l_index, l_sub, &l_count);\n    if (l_error == canopen_fb::e_wrong_parameter) l_reason = canopen_fb::r_object;\n    if (l_error == canopen_fb::e_no_error) {\n      COUNT = l_count;\n      NEW = l_count != cop_seen;\n      cop_seen = l_count;\n    }\n  }\n  CONFIRM = l_error == canopen_fb::e_no_error;\n  ERROR = static_cast<uint8_t>(l_error);\n  if (l_error != cop_last || l_reason != cop_reason) {\n    canopen_fb::text l_text;\n    canopen_fb::describe_slave(l_text, SLAVE, static_cast<uint8_t>(l_error), l_reason, l_index, l_sub);\n    ERRORTEXT = l_text.buf;\n    cop_last = static_cast<uint8_t>(l_error);\n    cop_reason = l_reason;\n  }\n}\nEND_FUNCTION_BLOCK\n"
    }
  ]
}
