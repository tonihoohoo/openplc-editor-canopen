            "name": "ERROR",
            "type": "USINT"
          },
          {
            "name": "ERRORTEXT",
            "type": "STRING"
          },
          {
            "name": "RUNSTATE",
            "type": "USINT"
          },
          {
            "name": "ENABLED",
            "type": "BOOL"
          },
          {
            "name": "OPTIONAL",
            "type": "BOOL"
          },
          {
            "name": "PROGRAMSTART",
            "type": "BOOL"
          }
        ],
        "inouts": [],
        "implementation": "cpp",
        "sourceFile": "CANOPEN_NODE_STATUS.cpp",
        "documentation": "Gives how the master runs a node, in the same call while ENABLE is TRUE: RUNSTATE is RUN_NOT_FOUND, RUN_BOOTING, RUN_FAILED, RUN_WAITING_START, RUN_OPERATIONAL, RUN_MANUAL, RUN_LOST, RUN_HELD, RUN_DISABLED or RUN_STOPPED; ENABLED, OPTIONAL and PROGRAMSTART give its settings as they are now. While the node is failed, lost or held, ERRORTEXT says why. NETWORK counts from 1; DEVICE is the node ID or its name.\nExample: status(ENABLE := TRUE, DEVICE := IO_Module); IF status.RUNSTATE = RUN_WAITING_START THEN ... END_IF;"
      },
      {
        "name": "CANOPEN_NETWORK_STATE",
        "inputs": [
          {
            "name": "NETWORK",
            "type": "USINT"
          },
          {
