{
  "formatVersion": 1,
  "manifest": {
    "name": "canopen",
    "version": "1.0.0",
    "namespace": "strucpp",
    "functions": [
      {
        "name": "CANOPEN_DWORD_TO_REAL",
        "returnType": "REAL",
        "parameters": [
          {
            "name": "IN",
            "type": "DWORD",
            "direction": "input"
          }
        ],
        "documentation": "The REAL whose IEEE 754 bits are IN, every bit kept, for a REAL32 object read with SDO_READ4. Example: speed := CANOPEN_DWORD_TO_REAL(read.DATA);"
      },
      {
        "name": "CANOPEN_REAL_TO_DWORD",
        "returnType": "DWORD",
        "parameters": [
          {
            "name": "IN",
            "type": "REAL",
            "direction": "input"
          }
        ],
        "documentation": "The IEEE 754 bits of IN as a DWORD, every bit kept, for a REAL32 object written with SDO_WRITE4. Example: write(DATA := CANOPEN_REAL_TO_DWORD(1.5), DATALENGTH := 4, ...);"
      }
    ],
    "functionBlocks": [
      {
