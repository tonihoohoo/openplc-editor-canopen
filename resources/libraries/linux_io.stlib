  "dependencies": [],
  "sources": [
    {
      "fileName": "types.st",
      "source": "(* Constants of the linux_io function block library.\n\n   STruC++ does not carry the values of a library's enumerations into a program, so each setting\n   is a USINT with one constant per value: GPIO_IN(BIAS := LIO_BIAS_PULL_UP, ...) and\n   IF gpio.ERROR = LIO_BUSY THEN ... *)\nTYPE\n  LIO_ERROR : USINT;\n  LIO_BIAS : USINT;\n  LIO_DRIVE : USINT;\n  LIO_STOP : USINT;\nEND_TYPE\n\nVAR_GLOBAL CONSTANT\n  LIO_NO_ERROR : USINT := 0;\n  LIO_NOT_SUPPORTED : USINT := 1;\n  LIO_WRONG_INPUT : USINT := 2;\n  LIO_NOT_FOUND : USINT := 3;\n  LIO_BUSY : USINT := 4;\n  LIO_REFUSED : USINT := 5;\n  LIO_IO_ERROR : USINT := 6;\n  LIO_NO_SLOT : USINT := 7;\n\n  LIO_BIAS_NONE : USINT := 0;\n  LIO_BIAS_PULL_UP : USINT := 1;\n  LIO_BIAS_PULL_DOWN : USINT := 2;\n\n  LIO_DRIVE_PUSH_PULL : USINT := 0;\n  LIO_DRIVE_OPEN_DRAIN : USINT := 1;\n  LIO_DRIVE_OPEN_SOURCE : USINT := 2;\n\n  LIO_STOP_OFF : USINT := 0;\n  LIO_STOP_ON : USINT := 1;\n  LIO_STOP_HOLD : USINT := 2;\nEND_VAR\n"
    },
    {
      "fileName": "GPIO_IN.cpp",
      "source": "(* Reads a GPIO input line of the Linux device. PIN is the kernel's line name (such as 'GPIO17') or '<chip>:<offset>' (such as 'gpiochip0:17'). BIAS is LIO_BIAS_NONE, LIO_BIAS_PULL_UP or LIO_BIAS_PULL_DOWN; ACTIVE_LOW inverts the level; DEBOUNCE filters bounces shorter than its time (T#0s: off). Q is the level on every call while ENABLE is TRUE and VALID is TRUE. A pin that is missing or in use gives ERROR and ERRORTEXT, and the block tries again every 0.5 s.\nExample: button(ENABLE := TRUE, PIN := 'GPIO17', BIAS := LIO_BIAS_PULL_UP, ACTIVE_LOW := TRUE, DEBOUNCE := T#10ms); pressed := button.Q; *)\nFUNCTION_BLOCK GPIO_IN\nVAR_INPUT\n  ENABLE : BOOL;\n  PIN : STRING;\n  BIAS : USINT;\n  ACTIVE_LOW : BOOL;\n  DEBOUNCE : TIME;\nEND_VAR\nVAR_OUTPUT\n  VALID : BOOL;\n  ERROR : USINT;\n  ERRORTEXT : STRING;\n  Q : BOOL;\nEND_VAR\nVAR\n  lio_slot : UINT;\n  lio_gen : UDINT;\n  lio_last : USINT;\nEND_VAR\n// SPDX-License-Identifier: Apache-2.0\n//\n// Shared code of the linux_io function blocks. The generator copies it into every block's source,\n// because the editor grafts each library C++ block into one c_blocks_code.cpp and has no other\n// place for shared code; the include guard keeps one copy per program.\n//\n// The editor binds every pin and local of a block to a #define of its name before this code, so\n// the system headers are included with those names pushed and undefined, and this code names\n// nothing in upper case.\n//\n// Linux only: GPIO through the character device (uAPI v2), PWM and values through sysfs. A helper\n// thread (normal scheduling) does the slow reads and the PWM writes, puts outputs in their stop\n// state when their block is no longer called, and releases what a block has not used for 2 s.\n#ifndef LINUX_IO_SHARED_INCLUDED\n#define LINUX_IO_SHARED_INCLUDED\n\n#pragma push_macro(\"ENABLE\")\n#pragma push_macro(\"PIN\")\n#pragma push_macro(\"BIAS\")\n#pragma push_macro(\"ACTIVE_LOW\")\n#pragma push_macro(\"DEBOUNCE\")\n#pragma push_macro(\"Q\")\n#pragma push_macro(\"VALUE\")\n#pragma push_macro(\"DRIVE\")\n#pragma push_macro(\"ON_STOP\")\n#pragma push_macro(\"CHIP\")\n#pragma push_macro(\"CHANNEL\")\n#pragma push_macro(\"FREQUENCY\")\n#pragma push_macro(\"DUTY\")\n#pragma push_macro(\"PATH\")\n#pragma push_macro(\"SCALE\")\n#pragma push_macro(\"OFFSET\")\n#pragma push_macro(\"PERIOD\")\n#pragma push_macro(\"RAW\")\n#pragma push_macro(\"DEVICE\")\n#pragma push_macro(\"VALID\")\n#pragma push_macro(\"ERROR\")\n#pragma push_macro(\"ERRORTEXT\")\n#pragma push_macro(\"lio_slot\")\n#pragma push_macro(\"lio_gen\")\n#undef ENABLE\n#undef PIN\n#undef BIAS\n#undef ACTIVE_LOW\n#undef DEBOUNCE\n#undef Q\n#undef VALUE\n#undef DRIVE\n#undef ON_STOP\n#undef CHIP\n#undef CHANNEL\n#undef FREQUENCY\n#undef DUTY\n#undef PATH\n#undef SCALE\n#undef OFFSET\n#undef PERIOD\n#undef RAW\n#undef DEVICE\n#undef VALID\n#undef ERROR\n#undef ERRORTEXT\n#undef lio_slot\n#undef lio_gen\n\n#if defined(__linux__)\n#include <dirent.h>\n#include <errno.h>\n#include <fcntl.h>\n#include <limits.h>\n#include <linux/gpio.h>\n#include <pthread.h>\n#include <sched.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <sys/ioctl.h>\n#include <time.h>\n#include <unistd.h>\n#endif\n\n#ifndef LIO_SYS_ROOT\n#define LIO_SYS_ROOT \"/sys\"\n#endif\n#ifndef LIO_DEV_ROOT\n#define LIO_DEV_ROOT \"/dev\"\n#endif\n\nnamespace lio {\n\nenum {\n  e_no_error = 0, e_not_supported = 1, e_input = 2, e_not_found = 3, e_busy = 4, e_refused = 5,\n  e_io = 6, e_no_slot = 7\n};\nenum { k_none = 0, k_in = 1, k_out = 2, k_pwm = 3, k_value = 4, k_iio = 5 };\nenum { stop_off = 0, stop_on = 1, stop_hold = 2 };\nenum { bias_none = 0, bias_pull_up = 1, bias_pull_down = 2 };\nenum { drive_push_pull = 0, drive_open_drain = 1, drive_open_source = 2 };\n\nconst int max_slots = 64;\nconst int key_size = 520;\nconst int text_size = 128;\nconst long long ms = 1000000LL;\nconst long long release_after = 2000 * ms;\nconst long long retry_after = 500 * ms;\nconst long long min_stop_after = 100 * ms;\n\n// Text for ERRORTEXT, bounded.\nstruct text {\n  char buf[text_size];\n};\ninline void clear(text &t) { t.buf[0] = '\\0'; }\ninline void put(text &t, const char *s) {\n  size_t n = 0;\n  while (t.buf[n] != '\\0' && n + 1 < sizeof(t.buf)) ++n;\n  while (*s != '\\0' && n + 1 < sizeof(t.buf)) t.buf[n++] = *s++;\n  t.buf[n] = '\\0';\n}\ninline void put_num(text &t, long long v) {\n  char tmp[24];\n  int n = 0;\n  bool neg = v < 0;\n  unsigned long long u = neg ? 0ULL - static_cast<unsigned long long>(v) : static_cast<unsigned long long>(v);\n  do {\n    tmp[n++] = static_cast<char>('0' + u % 10);\n    u /= 10;\n  } while (u != 0 && n < 22);\n  char out[24];\n  int k = 0;\n  if (neg) out[k++] = '-';\n  while (n > 0) out[k++] = tmp[--n];\n  out[k] = '\\0';\n  put(t, out);\n}\ninline void copy_cstr(char *dst, size_t size, const char *src) {\n  size_t n = 0;\n  for (; src[n] != '\\0' && n + 1 < size; ++n) dst[n] = src[n];\n  dst[n] = '\\0';\n}\ninline bool same(const char *a, const char *b) {\n  for (; *a != '\\0' && *a == *b; ++a, ++b) {\n  }\n  return *a == *b;\n}\ninline bool starts_with(const char *s, const char *prefix) {\n  for (; *prefix != '\\0'; ++s, ++prefix)\n    if (*s != *prefix) return false;\n  return true;\n}\n\n// The first number in a text: optional sign, digits, optional fraction. False if there is none.\ninline bool first_number(const char *s, double &value) {\n  for (; *s != '\\0'; ++s) {\n    bool sign = (*s == '-' || *s == '+') && s[1] >= '0' && s[1] <= '9';\n    if (!sign && !(*s >= '0' && *s <= '9')) continue;\n    bool neg = *s == '-';\n    if (sign) ++s;\n    double v = 0;\n    for (; *s >= '0' && *s <= '9'; ++s) v = v * 10 + (*s - '0');\n    if (*s == '.' && s[1] >= '0' && s[1] <= '9') {\n      double f = 0.1;\n      for (++s; *s >= '0' && *s <= '9'; ++s, f /= 10) v += (*s - '0') * f;\n    }\n    value = neg ? -v : v;\n    return true;\n  }\n  return false;\n}\n\n// value = (raw + offset) x scale, the IIO rule.\ninline double iio_value(double raw, double offset, double scale) { return (raw + offset) * scale; }\n\n// An output is put in its stop state after max(100 ms, 5 x its call interval) without a call.\ninline long long stop_after(long long interval_ns) {\n  long long five = interval_ns * 5;\n  return five > min_stop_after ? five : min_stop_after;\n}\n\n// \"in_voltage0\" -> \"in_voltage\": the prefix of the device-wide scale and offset files.\ninline void channel_type(const char *channel, char *out, size_t size) {\n  copy_cstr(out, size, channel);\n  size_t n = 0;\n  while (out[n] != '\\0') ++n;\n  while (n > 0 && out[n - 1] >= '0' && out[n - 1] <= '9') out[--n] = '\\0';\n}\n\n#if defined(__linux__)\n\nstruct slot {\n  bool used;\n  int kind;\n  unsigned gen;  // matches the owning block's lio_gen\n  char key[key_size];   // pin, path, or IIO device and channel\n  unsigned long long cfg;  // packed settings; a change makes the block claim again\n  long long last_call;\n  long long interval;\n  bool stopped;\n  int stop;\n  // GPIO\n  int fd;\n  long long next_try;\n  int applied;  // last value set on an output, -1 unknown\n  // PWM\n  double freq;\n  double duty;\n  double applied_freq;\n  double applied_duty;\n  bool applied_on;\n  bool exported;\n  bool force_off;  // write the off state even if this slot never ran the channel\n  char pwm_dir[256];\n  // reads\n  long long period;\n  double scale;\n  double offset;\n  long long next_read;\n  double value;\n  long long raw;\n  bool valid;\n  // result for the block\n  int error;\n  char message[text_size];\n};\n\nstruct state {\n  slot slots[max_slots];\n  pthread_mutex_t lock;\n  pthread_t thread;\n  bool thread_started;\n  bool running;\n  volatile bool quit;\n  unsigned next_gen;\n};\n\ninline state &shared() {\n  static state s = [] {\n    state init{};\n    pthread_mutex_init(&init.lock, nullptr);\n    for (int i = 0; i < max_slots; ++i) init.slots[i].fd = -1;\n    return init;\n  }();\n  return s;\n}\n\ninline long long now_ns() {\n  timespec ts{};\n  clock_gettime(CLOCK_MONOTONIC, &ts);\n  return static_cast<long long>(ts.tv_sec) * 1000000000LL + ts.tv_nsec;\n}\n\ninline void set_error(slot &s, int error, const text &t) {\n  s.error = error;\n  copy_cstr(s.message, sizeof(s.message), error == e_no_error ? \"\" : t.buf);\n}\ninline void set_error(slot &s, int error, const char *subject, const char *what) {\n  text t;\n  clear(t);\n  put(t, subject);\n  put(t, \": \");\n  put(t, what);\n  set_error(s, error, t);\n}\ninline void set_errno(slot &s, int error, const char *subject, const char *what, int err) {\n  text t;\n  clear(t);\n  put(t, subject);\n  put(t, \": \");\n  put(t, what);\n  put(t, \" (\");\n  put(t, strerror(err));\n  put(t, \")\");\n  set_error(s, error, t);\n}\n\n// ---- files ----\n\ninline bool read_file(const char *path, char *buf, size_t size, int &err) {\n  int fd = open(path, O_RDONLY | O_CLOEXEC);\n  if (fd < 0) {\n    err = errno;\n    return false;\n  }\n  ssize_t n = read(fd, buf, size - 1);\n  err = errno;\n  close(fd);\n  if (n < 0) return false;\n  buf[n] = '\\0';\n  return true;\n}\ninline bool write_file(const char *path, const char *value, int &err) {\n  int fd = open(path, O_WRONLY | O_TRUNC | O_CLOEXEC);\n  if (fd < 0) {\n    err = errno;\n    return false;\n  }\n  size_t len = 0;\n  while (value[len] != '\\0') ++len;\n  ssize_t n = write(fd, value, len);\n  err = errno;\n  close(fd);\n  return n == static_cast<ssize_t>(len);\n}\ninline void trim(char *s) {\n  size_t n = 0;\n  while (s[n] != '\\0') ++n;\n  while (n > 0 && (s[n - 1] == '\\n' || s[n - 1] == ' ' || s[n - 1] == '\\r' || s[n - 1] == '\\t')) s[--n] = '\\0';\n}\ninline bool join(char *out, size_t size, const char *a, const char *b, const char *c = \"\") {\n  int n = snprintf(out, size, \"%s%s%s\", a, b, c);\n  return n > 0 && static_cast<size_t>(n) < size;\n}\n\n// ---- GPIO ----\n\ninline bool all_digits(const char *s) {\n  if (*s == '\\0') return false;\n  for (; *s != '\\0'; ++s)\n    if (*s < '0' || *s > '9') return false;\n  return true;\n}\n\n// Opens the chip named `chip` (device name such as gpiochip0, or its label); -1 if none.\ninline int open_chip(const char *chip) {\n  char path[PATH_MAX];\n  if (starts_with(chip, \"gpiochip\") && join(path, sizeof(path), LIO_DEV_ROOT \"/\", chip)) {\n    int fd = open(path, O_RDWR | O_CLOEXEC);\n    if (fd >= 0) return fd;\n  }\n  DIR *dir = opendir(LIO_DEV_ROOT);\n  if (!dir) return -1;\n  int found = -1;\n  while (dirent *e = readdir(dir)) {\n    if (!starts_with(e->d_name, \"gpiochip\") || !join(path, sizeof(path), LIO_DEV_ROOT \"/\", e->d_name)) continue;\n    int fd = open(path, O_RDWR | O_CLOEXEC);\n    if (fd < 0) continue;\n    gpiochip_info info{};\n    if (ioctl(fd, GPIO_GET_CHIPINFO_IOCTL, &info) == 0 && same(info.label, chip)) {\n      found = fd;\n      break;\n    }\n    close(fd);\n  }\n  closedir(dir);\n  return found;\n}\n\n// Finds a line by name on any chip; returns the open chip and sets `offset`, or -1.\ninline int find_line(const char *name, unsigned &offset, char *consumer, size_t consumer_size) {\n  DIR *dir = opendir(LIO_DEV_ROOT);\n  if (!dir) return -1;\n  int found = -1;\n  char path[PATH_MAX];\n  while (found < 0) {\n    dirent *e = readdir(dir);\n    if (!e) break;\n    if (!starts_with(e->d_name, \"gpiochip\") || !join(path, sizeof(path), LIO_DEV_ROOT \"/\", e->d_name)) continue;\n    int fd = open(path, O_RDWR | O_CLOEXEC);\n    if (fd < 0) continue;\n    gpiochip_info info{};\n    if (ioctl(fd, GPIO_GET_CHIPINFO_IOCTL, &info) == 0) {\n      for (unsigned i = 0; i < info.lines; ++i) {\n        gpio_v2_line_info li{};\n        li.offset = i;\n        if (ioctl(fd, GPIO_V2_GET_LINEINFO_IOCTL, &li) == 0 && same(li.name, name)) {\n          offset = i;\n          copy_cstr(consumer, consumer_size, li.consumer);\n          found = fd;\n          break;\n        }\n      }\n    }\n    if (found < 0) close(fd);\n  }\n  closedir(dir);\n  return found;\n}\n\n// Claims the line of slot `s` (pin in key) as input or output with the settings in cfg.\n// cfg: bits 0-1 bias, 2 active low, 3-4 drive, 5 output, 32-63 debounce in microseconds.\ninline void claim_line(slot &s, bool first_value) {\n  const char *pin = s.key;\n  unsigned offset = 0;\n  char consumer[32] = \"\";\n  int chip = -1;\n  const char *colon = nullptr;\n  for (const char *p = pin; *p != '\\0'; ++p)\n    if (*p == ':') colon = p;\n  if (colon) {\n    char name[key_size];\n    size_t n = static_cast<size_t>(colon - pin);\n    if (n >= sizeof(name) || !all_digits(colon + 1)) {\n      set_error(s, e_input, pin, \"PIN is a line name or <chip>:<offset>\");\n      return;\n    }\n    for (size_t i = 0; i < n; ++i) name[i] = pin[i];\n    name[n] = '\\0';\n    offset = static_cast<unsigned>(strtoul(colon + 1, nullptr, 10));\n    chip = open_chip(name);\n    if (chip >= 0) {\n      gpio_v2_line_info li{};\n      li.offset = offset;\n      if (ioctl(chip, GPIO_V2_GET_LINEINFO_IOCTL, &li) != 0) {\n        close(chip);\n        set_error(s, e_not_found, pin, \"the chip has no such line\");\n        return;\n      }\n      copy_cstr(consumer, sizeof(consumer), li.consumer);\n    }\n  } else if (*pin != '\\0') {\n    chip = find_line(pin, offset, consumer, sizeof(consumer));\n  }\n  if (chip < 0) {\n    set_error(s, e_not_found, *pin != '\\0' ? pin : \"PIN\", \"no such GPIO line\");\n    return;\n  }\n  gpio_v2_line_request req{};\n  req.offsets[0] = offset;\n  req.num_lines = 1;\n  copy_cstr(req.consumer, sizeof(req.consumer), \"openplc\");\n  unsigned long long cfg = s.cfg;\n  unsigned long long flags = (cfg & 0x20u) ? GPIO_V2_LINE_FLAG_OUTPUT : GPIO_V2_LINE_FLAG_INPUT;\n  if (cfg & 0x4u) flags |= GPIO_V2_LINE_FLAG_ACTIVE_LOW;\n  if (cfg & 0x20u) {\n    unsigned drive = static_cast<unsigned>((cfg >> 3) & 0x3u);\n    if (drive == drive_open_drain) flags |= GPIO_V2_LINE_FLAG_OPEN_DRAIN;\n    if (drive == drive_open_source) flags |= GPIO_V2_LINE_FLAG_OPEN_SOURCE;\n    req.config.attrs[0].attr.id = GPIO_V2_LINE_ATTR_ID_OUTPUT_VALUES;\n    req.config.attrs[0].attr.values = first_value ? 1u : 0u;\n    req.config.attrs[0].mask = 1u;\n    req.config.num_attrs = 1;\n  } else {\n    unsigned bias = static_cast<unsigned>(cfg & 0x3u);\n    if (bias == bias_pull_up) flags |= GPIO_V2_LINE_FLAG_BIAS_PULL_UP;\n    else if (bias == bias_pull_down) flags |= GPIO_V2_LINE_FLAG_BIAS_PULL_DOWN;\n    else flags |= GPIO_V2_LINE_FLAG_BIAS_DISABLED;\n    unsigned debounce_us = static_cast<unsigned>(cfg >> 32);\n    if (debounce_us != 0) {\n      req.config.attrs[0].attr.id = GPIO_V2_LINE_ATTR_ID_DEBOUNCE;\n      req.config.attrs[0].attr.debounce_period_us = debounce_us;\n      req.config.attrs[0].mask = 1u;\n      req.config.num_attrs = 1;\n    }\n  }\n  req.config.flags = flags;\n  int rc = ioctl(chip, GPIO_V2_GET_LINE_IOCTL, &req);\n  int err = errno;\n  close(chip);\n  if (rc != 0) {\n    if (err == EBUSY) {\n      text t;\n      clear(t);\n      put(t, pin);\n      put(t, \": in use\");\n      if (consumer[0] != '\\0') {\n        put(t, \" by \");\n        put(t, consumer);\n      }\n      set_error(s, e_busy, t);\n    } else {\n      set_errno(s, e_refused, pin, \"the chip refused the line settings\", err);\n    }\n    return;\n  }\n  s.fd = req.fd;\n  s.applied = (cfg & 0x20u) ? (first_value ? 1 : 0) : -1;\n  set_error(s, e_no_error, \"\", \"\");\n}\n\ninline bool line_get(int fd, bool &value) {\n  gpio_v2_line_values v{};\n  v.mask = 1u;\n  if (ioctl(fd, GPIO_V2_LINE_GET_VALUES_IOCTL, &v) != 0) return false;\n  value = (v.bits & 1u) != 0;\n  return true;\n}\ninline bool line_set(int fd, bool value) {\n  gpio_v2_line_values v{};\n  v.mask = 1u;\n  v.bits = value ? 1u : 0u;\n  return ioctl(fd, GPIO_V2_LINE_SET_VALUES_IOCTL, &v) == 0;\n}\n\n// ---- PWM (helper thread) ----\n\n// The sysfs directory of pwmchip `chip`: a number, pwmchipN, or the chip's device name.\ninline bool pwm_chip_dir(const char *chip, char *out, size_t size) {\n  const char *base = LIO_SYS_ROOT \"/class/pwm/\";\n  if (all_digits(chip)) return join(out, size, base, \"pwmchip\", chip) && access(out, F_OK) == 0;\n  if (starts_with(chip, \"pwmchip\")) return join(out, size, base, chip) && access(out, F_OK) == 0;\n  DIR *dir = opendir(LIO_SYS_ROOT \"/class/pwm\");\n  if (!dir) return false;\n  bool found = false;\n  char link[PATH_MAX];\n  char target[PATH_MAX];\n  while (!found) {\n    dirent *e = readdir(dir);\n    if (!e) break;\n    if (!starts_with(e->d_name, \"pwmchip\") || !join(link, sizeof(link), base, e->d_name, \"/device\")) continue;\n    ssize_t n = readlink(link, target, sizeof(target) - 1);\n    if (n <= 0) continue;\n    target[n] = '\\0';\n    const char *name = target;\n    for (const char *p = target; *p != '\\0'; ++p)\n      if (*p == '/') name = p + 1;\n    if (same(name, chip)) found = join(out, size, base, e->d_name);\n  }\n  closedir(dir);\n  return found;\n}\n\ninline bool pwm_write(slot &s, const char *file, long long v, const char *subject) {\n  char path[PATH_MAX];\n  char num[24];\n  snprintf(num, sizeof(num), \"%lld\", v);\n  int err = 0;\n  if (!join(path, sizeof(path), s.pwm_dir, \"/\", file) || !write_file(path, num, err)) {\n    text t;\n    clear(t);\n    put(t, \"cannot write \");\n    put(t, file);\n    set_errno(s, e_io, subject, t.buf, err);\n    return false;\n  }\n  return true;\n}\n\n// Applies duty/frequency, or turns the channel off (on = false). Called without the lock held,\n// on a copy of the slot.\ninline void pwm_apply(slot &s, bool on) {\n  const char *subject = \"PWM\";\n  if (!s.exported) {\n    char chip_dir[PATH_MAX];\n    const char *colon = nullptr;\n    for (const char *p = s.key; *p != '\\0'; ++p)\n      if (*p == ':') colon = p;\n    char chip[key_size];\n    size_t n = colon ? static_cast<size_t>(colon - s.key) : 0;\n    for (size_t i = 0; i < n && i + 1 < sizeof(chip); ++i) chip[i] = s.key[i];\n    chip[n < sizeof(chip) ? n : sizeof(chip) - 1] = '\\0';\n    const char *channel = colon ? colon + 1 : \"0\";\n    if (!pwm_chip_dir(chip, chip_dir, sizeof(chip_dir))) {\n      set_error(s, e_not_found, chip[0] != '\\0' ? chip : \"CHIP\", \"no such PWM chip\");\n      return;\n    }\n    if (!join(s.pwm_dir, sizeof(s.pwm_dir), chip_dir, \"/pwm\", channel)) return;\n    if (access(s.pwm_dir, F_OK) != 0) {\n      char path[PATH_MAX];\n      int err = 0;\n      if (!join(path, sizeof(path), chip_dir, \"/export\") || (!write_file(path, channel, err) && err != EBUSY)) {\n        set_errno(s, err == EINVAL || err == ENODEV ? e_not_found : e_io, chip, \"cannot export the channel\", err);\n        return;\n      }\n    }\n    s.exported = true;\n    s.applied_on = false;\n    s.applied_freq = -1;\n    s.applied_duty = -1;\n  }\n  if (!on) {\n    if (s.applied_on || s.force_off) {\n      pwm_write(s, \"duty_cycle\", 0, subject);\n      pwm_write(s, \"enable\", 0, subject);\n    }\n    s.applied_on = false;\n    return;\n  }\n  if (s.applied_on && s.applied_freq == s.freq && s.applied_duty == s.duty) return;\n  long long period = static_cast<long long>(1e9 / s.freq + 0.5);\n  long long duty = static_cast<long long>(static_cast<double>(period) * s.duty / 100.0 + 0.5);\n  if (period <= 0) {\n    set_error(s, e_input, subject, \"FREQUENCY is too high\");\n    return;\n  }\n  // duty_cycle must stay at or below period while both change.\n  if (!pwm_write(s, \"duty_cycle\", 0, subject) || !pwm_write(s, \"period\", period, subject) ||\n      !pwm_write(s, \"duty_cycle\", duty, subject) || (!s.applied_on && !pwm_write(s, \"enable\", 1, subject)))\n    return;\n  s.applied_on = true;\n  s.applied_freq = s.freq;\n  s.applied_duty = s.duty;\n  set_error(s, e_no_error, \"\", \"\");\n}\n\ninline void pwm_unexport(slot &s) {\n  if (!s.exported) return;\n  char chip_dir[PATH_MAX];\n  copy_cstr(chip_dir, sizeof(chip_dir), s.pwm_dir);\n  size_t n = 0;\n  while (chip_dir[n] != '\\0') ++n;\n  while (n > 0 && chip_dir[n - 1] != '/') --n;\n  const char *channel = s.pwm_dir + n + 3;  // after \"pwm\"\n  if (n > 0) chip_dir[n - 1] = '\\0';\n  char path[PATH_MAX];\n  int err = 0;\n  if (join(path, sizeof(path), chip_dir, \"/unexport\")) write_file(path, channel, err);\n  s.exported = false;\n}\n\n// ---- reads (helper thread) ----\n\ninline void read_value(slot &s, double scale, double offset) {\n  char real[PATH_MAX];\n  const char *root = LIO_SYS_ROOT \"/\";\n  if (!starts_with(s.key, root) || !realpath(s.key, real) || !starts_with(real, root)) {\n    bool outside = !starts_with(s.key, root);\n    if (outside) set_error(s, e_input, s.key[0] != '\\0' ? s.key : \"PATH\", \"PATH must be a file under \" LIO_SYS_ROOT \"/\");\n    else set_errno(s, e_not_found, s.key, \"cannot open\", errno);\n    s.valid = false;\n    return;\n  }\n  char buf[256];\n  int err = 0;\n  double v = 0;\n  if (!read_file(real, buf, sizeof(buf), err)) {\n    set_errno(s, e_io, s.key, \"cannot read\", err);\n    s.valid = false;\n    return;\n  }\n  if (!first_number(buf, v)) {\n    set_error(s, e_io, s.key, \"the file holds no number\");\n    s.valid = false;\n    return;\n  }\n  s.raw = static_cast<long long>(v);\n  s.value = v * scale + offset;\n  s.valid = true;\n  set_error(s, e_no_error, \"\", \"\");\n}\n\ninline bool read_number(const char *dir, const char *file, double &v) {\n  char path[PATH_MAX];\n  char buf[128];\n  int err = 0;\n  return join(path, sizeof(path), dir, \"/\", file) && read_file(path, buf, sizeof(buf), err) && first_number(buf, v);\n}\n\n// key = \"<device>\\n<channel>\"\ninline void read_iio(slot &s) {\n  char device[key_size];\n  copy_cstr(device, sizeof(device), s.key);\n  char *channel = device;\n  while (*channel != '\\0' && *channel != '\\n') ++channel;\n  if (*channel == '\\n') *channel++ = '\\0';\n  s.valid = false;\n  if (device[0] == '\\0' || channel[0] == '\\0') {\n    set_error(s, e_input, \"IIO\", \"DEVICE and CHANNEL are required\");\n    return;\n  }\n  const char *base = LIO_SYS_ROOT \"/bus/iio/devices\";\n  DIR *dir = opendir(base);\n  char found[PATH_MAX] = \"\";\n  if (dir) {\n    char path[PATH_MAX];\n    char name[128];\n    int err = 0;\n    while (dirent *e = readdir(dir)) {\n      if (e->d_name[0] == '.' || !join(path, sizeof(path), base, \"/\", e->d_name)) continue;\n      char name_path[PATH_MAX];\n      if (!join(name_path, sizeof(name_path), path, \"/name\") || !read_file(name_path, name, sizeof(name), err)) continue;\n      trim(name);\n      if (same(name, device)) {\n        copy_cstr(found, sizeof(found), path);\n        break;\n      }\n    }\n    closedir(dir);\n  }\n  if (found[0] == '\\0') {\n    set_error(s, e_not_found, device, \"no such IIO device\");\n    return;\n  }\n  char file[key_size + 16];\n  double raw = 0;\n  snprintf(file, sizeof(file), \"%s_raw\", channel);\n  if (!read_number(found, file, raw)) {\n    set_error(s, e_not_found, device, \"the channel has no readable _raw file\");\n    return;\n  }\n  char type[key_size];\n  channel_type(channel, type, sizeof(type));\n  double scale = 1;\n  double offset = 0;\n  snprintf(file, sizeof(file), \"%s_scale\", channel);\n  if (!read_number(found, file, scale)) {\n    snprintf(file, sizeof(file), \"%s_scale\", type);\n    if (!read_number(found, file, scale)) scale = 1;\n  }\n  snprintf(file, sizeof(file), \"%s_offset\", channel);\n  if (!read_number(found, file, offset)) {\n    snprintf(file, sizeof(file), \"%s_offset\", type);\n    if (!read_number(found, file, offset)) offset = 0;\n  }\n  s.raw = static_cast<long long>(raw);\n  s.value = iio_value(raw, offset, scale);\n  s.valid = true;\n  set_error(s, e_no_error, \"\", \"\");\n}\n\n// ---- helper thread ----\n\n// Puts an output in its stop state. Lock held; GPIO writes are a single ioctl.\ninline void stop_gpio(slot &s) {\n  if (s.fd >= 0 && s.stop != stop_hold) {\n    bool v = s.stop == stop_on;\n    if (line_set(s.fd, v)) s.applied = v ? 1 : 0;\n  }\n}\n\n// Frees a slot; for PWM the caller has already turned it off or kept it (hold).\ninline void free_slot(slot &s) {\n  if (s.fd >= 0) close(s.fd);\n  slot fresh{};\n  fresh.fd = -1;\n  s = fresh;\n}\n\n// True if another used PWM slot drives the same channel (a block enabled again meanwhile).\ninline bool pwm_shared(state &st, int self, const char *key) {\n  pthread_mutex_lock(&st.lock);\n  bool found = false;\n  for (int i = 0; i < max_slots && !found; ++i)\n    found = i != self && st.slots[i].used && st.slots[i].kind == k_pwm && same(st.slots[i].key, key);\n  pthread_mutex_unlock(&st.lock);\n  return found;\n}\n\ninline void *helper(void *) {\n  state &st = shared();\n  for (;;) {\n    timespec tick = {0, 10 * ms};\n    nanosleep(&tick, nullptr);\n    if (st.quit) break;\n    long long now = now_ns();\n    bool any = false;\n    for (int i = 0; i < max_slots; ++i) {\n      pthread_mutex_lock(&st.lock);\n      slot &live = st.slots[i];\n      if (!live.used) {\n        pthread_mutex_unlock(&st.lock);\n        continue;\n      }\n      any = true;\n      long long idle = now - live.last_call;\n      bool timed_out = idle > stop_after(live.interval);\n      int kind = live.kind;\n      if (kind == k_out) {\n        if (timed_out && !live.stopped) {\n          stop_gpio(live);\n          live.stopped = true;\n        }\n        if (idle > release_after) free_slot(live);\n        pthread_mutex_unlock(&st.lock);\n        continue;\n      }\n      if (kind == k_in) {\n        if (idle > release_after) free_slot(live);\n        pthread_mutex_unlock(&st.lock);\n        continue;\n      }\n      if (timed_out && !live.stopped) live.stopped = true;\n      slot work = live;  // slow work on a copy, outside the lock\n      pthread_mutex_unlock(&st.lock);\n\n      bool release = idle > release_after;\n      bool changed = false;\n      if (kind == k_pwm) {\n        bool on = !work.stopped && !release;\n        if (on || work.stop != stop_hold) {\n          pwm_apply(work, on);\n          changed = true;\n        }\n        if (release && work.stop != stop_hold && !pwm_shared(st, i, work.key)) pwm_unexport(work);\n      } else if ((kind == k_value || kind == k_iio) && !work.stopped && now >= work.next_read) {\n        if (kind == k_value) read_value(work, work.scale, work.offset);\n        else read_iio(work);\n        work.next_read = now + work.period;\n        changed = true;\n      }\n\n      pthread_mutex_lock(&st.lock);\n      slot &back = st.slots[i];\n      if (back.used && back.kind == kind && same(back.key, work.key)) {\n        if (release) {\n          free_slot(back);\n        } else if (changed) {\n          back.exported = work.exported;\n          copy_cstr(back.pwm_dir, sizeof(back.pwm_dir), work.pwm_dir);\n          back.applied_on = work.applied_on;\n          back.applied_freq = work.applied_freq;\n          back.applied_duty = work.applied_duty;\n          back.value = work.value;\n          back.raw = work.raw;\n          back.valid = work.valid;\n          back.next_read = work.next_read;\n          back.error = work.error;\n          copy_cstr(back.message, sizeof(back.message), work.message);\n        }\n      }\n      pthread_mutex_unlock(&st.lock);\n    }\n    if (!any) {\n      pthread_mutex_lock(&st.lock);\n      bool still_none = true;\n      for (int i = 0; i < max_slots; ++i) still_none = still_none && !st.slots[i].used;\n      if (still_none) st.running = false;\n      pthread_mutex_unlock(&st.lock);\n      if (still_none) break;\n    }\n  }\n  return nullptr;\n}\n\n// Lock held. Starts the helper thread with normal scheduling, not the scan thread's.\ninline void ensure_helper(state &st) {\n  if (st.running) return;\n  if (st.thread_started) pthread_join(st.thread, nullptr);\n  st.thread_started = false;\n  pthread_attr_t attr;\n  if (pthread_attr_init(&attr) != 0) return;\n  sched_param param{};\n  param.sched_priority = 0;\n  pthread_attr_setinheritsched(&attr, PTHREAD_EXPLICIT_SCHED);\n  pthread_attr_setschedpolicy(&attr, SCHED_OTHER);\n  pthread_attr_setschedparam(&attr, &param);\n  st.quit = false;\n  if (pthread_create(&st.thread, &attr, helper, nullptr) == 0) {\n    st.thread_started = true;\n    st.running = true;\n  }\n  pthread_attr_destroy(&attr);\n}\n\n// Stops the helper and frees every slot when the program library is unloaded.\nstruct unload_guard {\n  ~unload_guard() {\n    state &st = shared();\n    st.quit = true;\n    if (st.thread_started) pthread_join(st.thread, nullptr);\n    st.thread_started = false;\n    st.running = false;\n    for (int i = 0; i < max_slots; ++i) {\n      slot &s = st.slots[i];\n      if (!s.used) continue;\n      if (s.kind == k_out && !s.stopped) stop_gpio(s);\n      if (s.kind == k_pwm && s.stop != stop_hold) {\n        pwm_apply(s, false);\n        pwm_unexport(s);\n      }\n      free_slot(s);\n    }\n  }\n};\ninline unload_guard &guard() {\n  static unload_guard g;\n  return g;\n}\n\n// One call of a block: finds or makes its slot (index + 1 in `id`), records the call and returns\n// the slot with the lock held, or nullptr (no slot free; the lock is not held then).\ninline slot *enter(unsigned short &id, unsigned &gen, int kind, const char *key, unsigned long long cfg) {\n  state &st = shared();\n  (void)guard();\n  long long now = now_ns();\n  pthread_mutex_lock(&st.lock);\n  slot *s = nullptr;\n  if (id >= 1 && id <= max_slots && st.slots[id - 1].used && st.slots[id - 1].kind == kind &&\n      st.slots[id - 1].gen == gen)\n    s = &st.slots[id - 1];\n  if (!s) {\n    for (int i = 0; i < max_slots && !s; ++i) {\n      if (!st.slots[i].used) {\n        s = &st.slots[i];\n        slot fresh{};\n        fresh.fd = -1;\n        fresh.used = true;\n        fresh.kind = kind;\n        fresh.applied = -1;\n        fresh.last_call = now;\n        fresh.gen = ++st.next_gen == 0 ? ++st.next_gen : st.next_gen;\n        *s = fresh;\n        id = static_cast<unsigned short>(i + 1);\n        gen = fresh.gen;\n      }\n    }\n  }\n  if (!s) {\n    pthread_mutex_unlock(&st.lock);\n    id = 0;\n    gen = 0;\n    return nullptr;\n  }\n  if (!same(s->key, key) || s->cfg != cfg) {\n    // A new pin or new settings: claim again.\n    if (s->fd >= 0) close(s->fd);\n    s->fd = -1;\n    s->next_try = 0;\n    s->applied = -1;\n    s->exported = false;\n    s->valid = false;\n    s->next_read = 0;\n    s->error = e_no_error;\n    s->message[0] = '\\0';\n    copy_cstr(s->key, sizeof(s->key), key);\n    s->cfg = cfg;\n  }\n  long long d = now - s->last_call;\n  if (d > 0 && d < 10000 * ms) s->interval = s->interval > 0 ? (s->interval * 7 + d) / 8 : d;\n  s->last_call = now;\n  s->stopped = false;\n  ensure_helper(st);\n  return s;\n}\ninline void leave() { pthread_mutex_unlock(&shared().lock); }\n\n// ENABLE went FALSE: outputs to their stop state, then the slot is freed (PWM by the helper).\ninline void disable(unsigned short &id, unsigned &gen, int kind) {\n  if (id == 0) return;\n  state &st = shared();\n  pthread_mutex_lock(&st.lock);\n  if (id <= max_slots && st.slots[id - 1].used && st.slots[id - 1].kind == kind && st.slots[id - 1].gen == gen) {\n    slot &s = st.slots[id - 1];\n    if (kind == k_pwm) {\n      s.last_call = 0;  // the helper turns it off (or keeps it, hold) and frees it\n      s.stopped = true;\n      s.interval = 0;\n      s.gen = 0;  // no block owns it any more\n    } else {\n      if (kind == k_out) stop_gpio(s);\n      free_slot(s);\n    }\n  }\n  pthread_mutex_unlock(&st.lock);\n  id = 0;\n  gen = 0;\n}\n\n// PWM with ENABLE FALSE: turns the channel off whatever ON_STOP says, also one a block left running\n// (LIO_STOP_HOLD) before. Runs once per disable; id = pwm_done marks it done until the block runs again.\nconst unsigned short pwm_done = 0xFFFF;\ninline void pwm_off(unsigned short &id, unsigned &gen, const char *key) {\n  if (id == pwm_done) return;\n  state &st = shared();\n  (void)guard();\n  pthread_mutex_lock(&st.lock);\n  slot *s = nullptr;\n  if (id >= 1 && id <= max_slots && st.slots[id - 1].used && st.slots[id - 1].kind == k_pwm &&\n      st.slots[id - 1].gen == gen)\n    s = &st.slots[id - 1];\n  for (int i = 0; i < max_slots && !s; ++i)\n    if (st.slots[i].used && st.slots[i].kind == k_pwm && st.slots[i].gen == 0 && same(st.slots[i].key, key))\n      s = &st.slots[i];\n  bool other = false;\n  for (int i = 0; i < max_slots && !s && !other; ++i)\n    other = st.slots[i].used && st.slots[i].kind == k_pwm && same(st.slots[i].key, key);\n  for (int i = 0; i < max_slots && !s && !other; ++i) {\n    if (!st.slots[i].used) {\n      s = &st.slots[i];\n      slot fresh{};\n      fresh.fd = -1;\n      fresh.used = true;\n      fresh.kind = k_pwm;\n      fresh.applied = -1;\n      copy_cstr(fresh.key, sizeof(fresh.key), key);\n      *s = fresh;\n    }\n  }\n  if (s) {\n    s->stop = stop_off;\n    s->force_off = true;\n    s->last_call = 0;  // the helper turns it off, unexports it and frees the slot\n    s->stopped = true;\n    s->interval = 0;\n    s->gen = 0;\n    ensure_helper(st);\n  }\n  pthread_mutex_unlock(&st.lock);\n  id = pwm_done;\n  gen = 0;\n}\n\n#endif  // __linux__\n\n}  // namespace lio\n\n#pragma pop_macro(\"ENABLE\")\n#pragma pop_macro(\"PIN\")\n#pragma pop_macro(\"BIAS\")\n#pragma pop_macro(\"ACTIVE_LOW\")\n#pragma pop_macro(\"DEBOUNCE\")\n#pragma pop_macro(\"Q\")\n#pragma pop_macro(\"VALUE\")\n#pragma pop_macro(\"DRIVE\")\n#pragma pop_macro(\"ON_STOP\")\n#pragma pop_macro(\"CHIP\")\n#pragma pop_macro(\"CHANNEL\")\n#pragma pop_macro(\"FREQUENCY\")\n#pragma pop_macro(\"DUTY\")\n#pragma pop_macro(\"PATH\")\n#pragma pop_macro(\"SCALE\")\n#pragma pop_macro(\"OFFSET\")\n#pragma pop_macro(\"PERIOD\")\n#pragma pop_macro(\"RAW\")\n#pragma pop_macro(\"DEVICE\")\n#pragma pop_macro(\"VALID\")\n#pragma pop_macro(\"ERROR\")\n#pragma pop_macro(\"ERRORTEXT\")\n#pragma pop_macro(\"lio_slot\")\n#pragma pop_macro(\"lio_gen\")\n#endif  // LINUX_IO_SHARED_INCLUDED\nvoid setup() {\n}\n\nvoid loop() {\n#if defined(__linux__)\n  if (!ENABLE) {\n    unsigned short l_id = lio_slot;\n    unsigned l_gen = lio_gen;\n    lio::disable(l_id, l_gen, lio::k_in);\n    lio_slot = 0;\n    lio_gen = 0;\n    Q = false;\n    VALID = false;\n    ERROR = 0;\n    if (lio_last != 0) ERRORTEXT = \"\";\n    lio_last = 0;\n    return;\n  }\n  if (BIAS > 2) {\n    unsigned short l_id = lio_slot;\n    unsigned l_gen = lio_gen;\n    lio::disable(l_id, l_gen, lio::k_in);\n    lio_slot = 0;\n    lio_gen = 0;\n    Q = false;\n    VALID = false;\n    int l_err = lio::e_input;\n    lio::text l_msg;\n    lio::clear(l_msg);\n    lio::put(l_msg, \"BIAS is LIO_BIAS_NONE, LIO_BIAS_PULL_UP or LIO_BIAS_PULL_DOWN\");\n  ERROR = static_cast<uint8_t>(l_err);\n  if (l_err != 0 || lio_last != 0) ERRORTEXT = l_msg.buf;\n  lio_last = static_cast<uint8_t>(l_err);\n    return;\n  }\n  long long l_debounce_ns = DEBOUNCE;\n  unsigned long long l_debounce_us = l_debounce_ns <= 0 ? 0ULL : static_cast<unsigned long long>((l_debounce_ns + 999) / 1000);\n  if (l_debounce_us > 0xFFFFFFFFULL) l_debounce_us = 0xFFFFFFFFULL;\n  uint8_t l_bias = BIAS;\n  unsigned long long l_cfg = (static_cast<unsigned long long>(l_bias) & 0x3u) | (ACTIVE_LOW ? 0x4u : 0u) | (l_debounce_us << 32);\n  unsigned short l_id = lio_slot;\n  unsigned l_gen = lio_gen;\n  lio::slot *l_s = lio::enter(l_id, l_gen, lio::k_in, PIN.c_str(), l_cfg);\n  lio_slot = l_id;\n  lio_gen = l_gen;\n  bool l_valid = false;\n  bool l_q = false;\n  int l_err = lio::e_no_slot;\n  lio::text l_msg;\n  lio::clear(l_msg);\n  lio::put(l_msg, \"more than 64 linux_io blocks\");\n  if (l_s) {\n    long long l_now = lio::now_ns();\n    if (l_s->fd < 0 && l_now >= l_s->next_try) {\n      lio::claim_line(*l_s, false);\n      if (l_s->fd < 0) l_s->next_try = l_now + lio::retry_after;\n    }\n    if (l_s->fd >= 0) {\n      if (lio::line_get(l_s->fd, l_q)) {\n        l_valid = true;\n        if (l_s->error != lio::e_no_error) lio::set_error(*l_s, lio::e_no_error, \"\", \"\");\n      } else {\n        lio::set_errno(*l_s, lio::e_io, l_s->key, \"cannot read the line\", errno);\n      }\n    }\n    l_err = l_s->error;\n    lio::clear(l_msg);\n    lio::put(l_msg, l_s->message);\n    lio::leave();\n  }\n  Q = l_q;\n  VALID = l_valid;\n  ERROR = static_cast<uint8_t>(l_err);\n  if (l_err != 0 || lio_last != 0) ERRORTEXT = l_msg.buf;\n  lio_last = static_cast<uint8_t>(l_err);\n#else\n  Q = false;\n  VALID = false;\n  ERROR = 1;\n  ERRORTEXT = \"not supported on this target\";\n#endif\n}\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "GPIO_OUT.cpp",
      "source": "(* Drives a GPIO output line of the Linux device to VALUE. PIN as for GPIO_IN. DRIVE is LIO_DRIVE_PUSH_PULL, LIO_DRIVE_OPEN_DRAIN or LIO_DRIVE_OPEN_SOURCE; ACTIVE_LOW inverts the level. When the block is no longer called (PLC stop, PLC error, new upload) the line goes to ON_STOP within 100 ms or five call intervals: LIO_STOP_OFF (default), LIO_STOP_ON or LIO_STOP_HOLD. ENABLE FALSE puts it in that state too and frees the line.\nExample: lamp(ENABLE := TRUE, PIN := 'GPIO27', VALUE := alarm, ON_STOP := LIO_STOP_OFF); *)\nFUNCTION_BLOCK GPIO_OUT\nVAR_INPUT\n  ENABLE : BOOL;\n  PIN : STRING;\n  VALUE : BOOL;\n  DRIVE : USINT;\n  ACTIVE_LOW : BOOL;\n  ON_STOP : USINT;\nEND_VAR\nVAR_OUTPUT\n  VALID : BOOL;\n  ERROR : USINT;\n  ERRORTEXT : STRING;\nEND_VAR\nVAR\n  lio_slot : UINT;\n  lio_gen : UDINT;\n  lio_last : USINT;\nEND_VAR\n// SPDX-License-Identifier: Apache-2.0\n//\n// Shared code of the linux_io function blocks. The generator copies it into every block's source,\n// because the editor grafts each library C++ block into one c_blocks_code.cpp and has no other\n// place for shared code; the include guard keeps one copy per program.\n//\n// The editor binds every pin and local of a block to a #define of its name before this code, so\n// the system headers are included with those names pushed and undefined, and this code names\n// nothing in upper case.\n//\n// Linux only: GPIO through the character device (uAPI v2), PWM and values through sysfs. A helper\n// thread (normal scheduling) does the slow reads and the PWM writes, puts outputs in their stop\n// state when their block is no longer called, and releases what a block has not used for 2 s.\n#ifndef LINUX_IO_SHARED_INCLUDED\n#define LINUX_IO_SHARED_INCLUDED\n\n#pragma push_macro(\"ENABLE\")\n#pragma push_macro(\"PIN\")\n#pragma push_macro(\"BIAS\")\n#pragma push_macro(\"ACTIVE_LOW\")\n#pragma push_macro(\"DEBOUNCE\")\n#pragma push_macro(\"Q\")\n#pragma push_macro(\"VALUE\")\n#pragma push_macro(\"DRIVE\")\n#pragma push_macro(\"ON_STOP\")\n#pragma push_macro(\"CHIP\")\n#pragma push_macro(\"CHANNEL\")\n#pragma push_macro(\"FREQUENCY\")\n#pragma push_macro(\"DUTY\")\n#pragma push_macro(\"PATH\")\n#pragma push_macro(\"SCALE\")\n#pragma push_macro(\"OFFSET\")\n#pragma push_macro(\"PERIOD\")\n#pragma push_macro(\"RAW\")\n#pragma push_macro(\"DEVICE\")\n#pragma push_macro(\"VALID\")\n#pragma push_macro(\"ERROR\")\n#pragma push_macro(\"ERRORTEXT\")\n#pragma push_macro(\"lio_slot\")\n#pragma push_macro(\"lio_gen\")\n#undef ENABLE\n#undef PIN\n#undef BIAS\n#undef ACTIVE_LOW\n#undef DEBOUNCE\n#undef Q\n#undef VALUE\n#undef DRIVE\n#undef ON_STOP\n#undef CHIP\n#undef CHANNEL\n#undef FREQUENCY\n#undef DUTY\n#undef PATH\n#undef SCALE\n#undef OFFSET\n#undef PERIOD\n#undef RAW\n#undef DEVICE\n#undef VALID\n#undef ERROR\n#undef ERRORTEXT\n#undef lio_slot\n#undef lio_gen\n\n#if defined(__linux__)\n#include <dirent.h>\n#include <errno.h>\n#include <fcntl.h>\n#include <limits.h>\n#include <linux/gpio.h>\n#include <pthread.h>\n#include <sched.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <sys/ioctl.h>\n#include <time.h>\n#include <unistd.h>\n#endif\n\n#ifndef LIO_SYS_ROOT\n#define LIO_SYS_ROOT \"/sys\"\n#endif\n#ifndef LIO_DEV_ROOT\n#define LIO_DEV_ROOT \"/dev\"\n#endif\n\nnamespace lio {\n\nenum {\n  e_no_error = 0, e_not_supported = 1, e_input = 2, e_not_found = 3, e_busy = 4, e_refused = 5,\n  e_io = 6, e_no_slot = 7\n};\nenum { k_none = 0, k_in = 1, k_out = 2, k_pwm = 3, k_value = 4, k_iio = 5 };\nenum { stop_off = 0, stop_on = 1, stop_hold = 2 };\nenum { bias_none = 0, bias_pull_up = 1, bias_pull_down = 2 };\nenum { drive_push_pull = 0, drive_open_drain = 1, drive_open_source = 2 };\n\nconst int max_slots = 64;\nconst int key_size = 520;\nconst int text_size = 128;\nconst long long ms = 1000000LL;\nconst long long release_after = 2000 * ms;\nconst long long retry_after = 500 * ms;\nconst long long min_stop_after = 100 * ms;\n\n// Text for ERRORTEXT, bounded.\nstruct text {\n  char buf[text_size];\n};\ninline void clear(text &t) { t.buf[0] = '\\0'; }\ninline void put(text &t, const char *s) {\n  size_t n = 0;\n  while (t.buf[n] != '\\0' && n + 1 < sizeof(t.buf)) ++n;\n  while (*s != '\\0' && n + 1 < sizeof(t.buf)) t.buf[n++] = *s++;\n  t.buf[n] = '\\0';\n}\ninline void put_num(text &t, long long v) {\n  char tmp[24];\n  int n = 0;\n  bool neg = v < 0;\n  unsigned long long u = neg ? 0ULL - static_cast<unsigned long long>(v) : static_cast<unsigned long long>(v);\n  do {\n    tmp[n++] = static_cast<char>('0' + u % 10);\n    u /= 10;\n  } while (u != 0 && n < 22);\n  char out[24];\n  int k = 0;\n  if (neg) out[k++] = '-';\n  while (n > 0) out[k++] = tmp[--n];\n  out[k] = '\\0';\n  put(t, out);\n}\ninline void copy_cstr(char *dst, size_t size, const char *src) {\n  size_t n = 0;\n  for (; src[n] != '\\0' && n + 1 < size; ++n) dst[n] = src[n];\n  dst[n] = '\\0';\n}\ninline bool same(const char *a, const char *b) {\n  for (; *a != '\\0' && *a == *b; ++a, ++b) {\n  }\n  return *a == *b;\n}\ninline bool starts_with(const char *s, const char *prefix) {\n  for (; *prefix != '\\0'; ++s, ++prefix)\n    if (*s != *prefix) return false;\n  return true;\n}\n\n// The first number in a text: optional sign, digits, optional fraction. False if there is none.\ninline bool first_number(const char *s, double &value) {\n  for (; *s != '\\0'; ++s) {\n    bool sign = (*s == '-' || *s == '+') && s[1] >= '0' && s[1] <= '9';\n    if (!sign && !(*s >= '0' && *s <= '9')) continue;\n    bool neg = *s == '-';\n    if (sign) ++s;\n    double v = 0;\n    for (; *s >= '0' && *s <= '9'; ++s) v = v * 10 + (*s - '0');\n    if (*s == '.' && s[1] >= '0' && s[1] <= '9') {\n      double f = 0.1;\n      for (++s; *s >= '0' && *s <= '9'; ++s, f /= 10) v += (*s - '0') * f;\n    }\n    value = neg ? -v : v;\n    return true;\n  }\n  return false;\n}\n\n// value = (raw + offset) x scale, the IIO rule.\ninline double iio_value(double raw, double offset, double scale) { return (raw + offset) * scale; }\n\n// An output is put in its stop state after max(100 ms, 5 x its call interval) without a call.\ninline long long stop_after(long long interval_ns) {\n  long long five = interval_ns * 5;\n  return five > min_stop_after ? five : min_stop_after;\n}\n\n// \"in_voltage0\" -> \"in_voltage\": the prefix of the device-wide scale and offset files.\ninline void channel_type(const char *channel, char *out, size_t size) {\n  copy_cstr(out, size, channel);\n  size_t n = 0;\n  while (out[n] != '\\0') ++n;\n  while (n > 0 && out[n - 1] >= '0' && out[n - 1] <= '9') out[--n] = '\\0';\n}\n\n#if defined(__linux__)\n\nstruct slot {\n  bool used;\n  int kind;\n  unsigned gen;  // matches the owning block's lio_gen\n  char key[key_size];   // pin, path, or IIO device and channel\n  unsigned long long cfg;  // packed settings; a change makes the block claim again\n  long long last_call;\n  long long interval;\n  bool stopped;\n  int stop;\n  // GPIO\n  int fd;\n  long long next_try;\n  int applied;  // last value set on an output, -1 unknown\n  // PWM\n  double freq;\n  double duty;\n  double applied_freq;\n  double applied_duty;\n  bool applied_on;\n  bool exported;\n  bool force_off;  // write the off state even if this slot never ran the channel\n  char pwm_dir[256];\n  // reads\n  long long period;\n  double scale;\n  double offset;\n  long long next_read;\n  double value;\n  long long raw;\n  bool valid;\n  // result for the block\n  int error;\n  char message[text_size];\n};\n\nstruct state {\n  slot slots[max_slots];\n  pthread_mutex_t lock;\n  pthread_t thread;\n  bool thread_started;\n  bool running;\n  volatile bool quit;\n  unsigned next_gen;\n};\n\ninline state &shared() {\n  static state s = [] {\n    state init{};\n    pthread_mutex_init(&init.lock, nullptr);\n    for (int i = 0; i < max_slots; ++i) init.slots[i].fd = -1;\n    return init;\n  }();\n  return s;\n}\n\ninline long long now_ns() {\n  timespec ts{};\n  clock_gettime(CLOCK_MONOTONIC, &ts);\n  return static_cast<long long>(ts.tv_sec) * 1000000000LL + ts.tv_nsec;\n}\n\ninline void set_error(slot &s, int error, const text &t) {\n  s.error = error;\n  copy_cstr(s.message, sizeof(s.message), error == e_no_error ? \"\" : t.buf);\n}\ninline void set_error(slot &s, int error, const char *subject, const char *what) {\n  text t;\n  clear(t);\n  put(t, subject);\n  put(t, \": \");\n  put(t, what);\n  set_error(s, error, t);\n}\ninline void set_errno(slot &s, int error, const char *subject, const char *what, int err) {\n  text t;\n  clear(t);\n  put(t, subject);\n  put(t, \": \");\n  put(t, what);\n  put(t, \" (\");\n  put(t, strerror(err));\n  put(t, \")\");\n  set_error(s, error, t);\n}\n\n// ---- files ----\n\ninline bool read_file(const char *path, char *buf, size_t size, int &err) {\n  int fd = open(path, O_RDONLY | O_CLOEXEC);\n  if (fd < 0) {\n    err = errno;\n    return false;\n  }\n  ssize_t n = read(fd, buf, size - 1);\n  err = errno;\n  close(fd);\n  if (n < 0) return false;\n  buf[n] = '\\0';\n  return true;\n}\ninline bool write_file(const char *path, const char *value, int &err) {\n  int fd = open(path, O_WRONLY | O_TRUNC | O_CLOEXEC);\n  if (fd < 0) {\n    err = errno;\n    return false;\n  }\n  size_t len = 0;\n  while (value[len] != '\\0') ++len;\n  ssize_t n = write(fd, value, len);\n  err = errno;\n  close(fd);\n  return n == static_cast<ssize_t>(len);\n}\ninline void trim(char *s) {\n  size_t n = 0;\n  while (s[n] != '\\0') ++n;\n  while (n > 0 && (s[n - 1] == '\\n' || s[n - 1] == ' ' || s[n - 1] == '\\r' || s[n - 1] == '\\t')) s[--n] = '\\0';\n}\ninline bool join(char *out, size_t size, const char *a, const char *b, const char *c = \"\") {\n  int n = snprintf(out, size, \"%s%s%s\", a, b, c);\n  return n > 0 && static_cast<size_t>(n) < size;\n}\n\n// ---- GPIO ----\n\ninline bool all_digits(const char *s) {\n  if (*s == '\\0') return false;\n  for (; *s != '\\0'; ++s)\n    if (*s < '0' || *s > '9') return false;\n  return true;\n}\n\n// Opens the chip named `chip` (device name such as gpiochip0, or its label); -1 if none.\ninline int open_chip(const char *chip) {\n  char path[PATH_MAX];\n  if (starts_with(chip, \"gpiochip\") && join(path, sizeof(path), LIO_DEV_ROOT \"/\", chip)) {\n    int fd = open(path, O_RDWR | O_CLOEXEC);\n    if (fd >= 0) return fd;\n  }\n  DIR *dir = opendir(LIO_DEV_ROOT);\n  if (!dir) return -1;\n  int found = -1;\n  while (dirent *e = readdir(dir)) {\n    if (!starts_with(e->d_name, \"gpiochip\") || !join(path, sizeof(path), LIO_DEV_ROOT \"/\", e->d_name)) continue;\n    int fd = open(path, O_RDWR | O_CLOEXEC);\n    if (fd < 0) continue;\n    gpiochip_info info{};\n    if (ioctl(fd, GPIO_GET_CHIPINFO_IOCTL, &info) == 0 && same(info.label, chip)) {\n      found = fd;\n      break;\n    }\n    close(fd);\n  }\n  closedir(dir);\n  return found;\n}\n\n// Finds a line by name on any chip; returns the open chip and sets `offset`, or -1.\ninline int find_line(const char *name, unsigned &offset, char *consumer, size_t consumer_size) {\n  DIR *dir = opendir(LIO_DEV_ROOT);\n  if (!dir) return -1;\n  int found = -1;\n  char path[PATH_MAX];\n  while (found < 0) {\n    dirent *e = readdir(dir);\n    if (!e) break;\n    if (!starts_with(e->d_name, \"gpiochip\") || !join(path, sizeof(path), LIO_DEV_ROOT \"/\", e->d_name)) continue;\n    int fd = open(path, O_RDWR | O_CLOEXEC);\n    if (fd < 0) continue;\n    gpiochip_info info{};\n    if (ioctl(fd, GPIO_GET_CHIPINFO_IOCTL, &info) == 0) {\n      for (unsigned i = 0; i < info.lines; ++i) {\n        gpio_v2_line_info li{};\n        li.offset = i;\n        if (ioctl(fd, GPIO_V2_GET_LINEINFO_IOCTL, &li) == 0 && same(li.name, name)) {\n          offset = i;\n          copy_cstr(consumer, consumer_size, li.consumer);\n          found = fd;\n          break;\n        }\n      }\n    }\n    if (found < 0) close(fd);\n  }\n  closedir(dir);\n  return found;\n}\n\n// Claims the line of slot `s` (pin in key) as input or output with the settings in cfg.\n// cfg: bits 0-1 bias, 2 active low, 3-4 drive, 5 output, 32-63 debounce in microseconds.\ninline void claim_line(slot &s, bool first_value) {\n  const char *pin = s.key;\n  unsigned offset = 0;\n  char consumer[32] = \"\";\n  int chip = -1;\n  const char *colon = nullptr;\n  for (const char *p = pin; *p != '\\0'; ++p)\n    if (*p == ':') colon = p;\n  if (colon) {\n    char name[key_size];\n    size_t n = static_cast<size_t>(colon - pin);\n    if (n >= sizeof(name) || !all_digits(colon + 1)) {\n      set_error(s, e_input, pin, \"PIN is a line name or <chip>:<offset>\");\n      return;\n    }\n    for (size_t i = 0; i < n; ++i) name[i] = pin[i];\n    name[n] = '\\0';\n    offset = static_cast<unsigned>(strtoul(colon + 1, nullptr, 10));\n    chip = open_chip(name);\n    if (chip >= 0) {\n      gpio_v2_line_info li{};\n      li.offset = offset;\n      if (ioctl(chip, GPIO_V2_GET_LINEINFO_IOCTL, &li) != 0) {\n        close(chip);\n        set_error(s, e_not_found, pin, \"the chip has no such line\");\n        return;\n      }\n      copy_cstr(consumer, sizeof(consumer), li.consumer);\n    }\n  } else if (*pin != '\\0') {\n    chip = find_line(pin, offset, consumer, sizeof(consumer));\n  }\n  if (chip < 0) {\n    set_error(s, e_not_found, *pin != '\\0' ? pin : \"PIN\", \"no such GPIO line\");\n    return;\n  }\n  gpio_v2_line_request req{};\n  req.offsets[0] = offset;\n  req.num_lines = 1;\n  copy_cstr(req.consumer, sizeof(req.consumer), \"openplc\");\n  unsigned long long cfg = s.cfg;\n  unsigned long long flags = (cfg & 0x20u) ? GPIO_V2_LINE_FLAG_OUTPUT : GPIO_V2_LINE_FLAG_INPUT;\n  if (cfg & 0x4u) flags |= GPIO_V2_LINE_FLAG_ACTIVE_LOW;\n  if (cfg & 0x20u) {\n    unsigned drive = static_cast<unsigned>((cfg >> 3) & 0x3u);\n    if (drive == drive_open_drain) flags |= GPIO_V2_LINE_FLAG_OPEN_DRAIN;\n    if (drive == drive_open_source) flags |= GPIO_V2_LINE_FLAG_OPEN_SOURCE;\n    req.config.attrs[0].attr.id = GPIO_V2_LINE_ATTR_ID_OUTPUT_VALUES;\n    req.config.attrs[0].attr.values = first_value ? 1u : 0u;\n    req.config.attrs[0].mask = 1u;\n    req.config.num_attrs = 1;\n  } else {\n    unsigned bias = static_cast<unsigned>(cfg & 0x3u);\n    if (bias == bias_pull_up) flags |= GPIO_V2_LINE_FLAG_BIAS_PULL_UP;\n    else if (bias == bias_pull_down) flags |= GPIO_V2_LINE_FLAG_BIAS_PULL_DOWN;\n    else flags |= GPIO_V2_LINE_FLAG_BIAS_DISABLED;\n    unsigned debounce_us = static_cast<unsigned>(cfg >> 32);\n    if (debounce_us != 0) {\n      req.config.attrs[0].attr.id = GPIO_V2_LINE_ATTR_ID_DEBOUNCE;\n      req.config.attrs[0].attr.debounce_period_us = debounce_us;\n      req.config.attrs[0].mask = 1u;\n      req.config.num_attrs = 1;\n    }\n  }\n  req.config.flags = flags;\n  int rc = ioctl(chip, GPIO_V2_GET_LINE_IOCTL, &req);\n  int err = errno;\n  close(chip);\n  if (rc != 0) {\n    if (err == EBUSY) {\n      text t;\n      clear(t);\n      put(t, pin);\n      put(t, \": in use\");\n      if (consumer[0] != '\\0') {\n        put(t, \" by \");\n        put(t, consumer);\n      }\n      set_error(s, e_busy, t);\n    } else {\n      set_errno(s, e_refused, pin, \"the chip refused the line settings\", err);\n    }\n    return;\n  }\n  s.fd = req.fd;\n  s.applied = (cfg & 0x20u) ? (first_value ? 1 : 0) : -1;\n  set_error(s, e_no_error, \"\", \"\");\n}\n\ninline bool line_get(int fd, bool &value) {\n  gpio_v2_line_values v{};\n  v.mask = 1u;\n  if (ioctl(fd, GPIO_V2_LINE_GET_VALUES_IOCTL, &v) != 0) return false;\n  value = (v.bits & 1u) != 0;\n  return true;\n}\ninline bool line_set(int fd, bool value) {\n  gpio_v2_line_values v{};\n  v.mask = 1u;\n  v.bits = value ? 1u : 0u;\n  return ioctl(fd, GPIO_V2_LINE_SET_VALUES_IOCTL, &v) == 0;\n}\n\n// ---- PWM (helper thread) ----\n\n// The sysfs directory of pwmchip `chip`: a number, pwmchipN, or the chip's device name.\ninline bool pwm_chip_dir(const char *chip, char *out, size_t size) {\n  const char *base = LIO_SYS_ROOT \"/class/pwm/\";\n  if (all_digits(chip)) return join(out, size, base, \"pwmchip\", chip) && access(out, F_OK) == 0;\n  if (starts_with(chip, \"pwmchip\")) return join(out, size, base, chip) && access(out, F_OK) == 0;\n  DIR *dir = opendir(LIO_SYS_ROOT \"/class/pwm\");\n  if (!dir) return false;\n  bool found = false;\n  char link[PATH_MAX];\n  char target[PATH_MAX];\n  while (!found) {\n    dirent *e = readdir(dir);\n    if (!e) break;\n    if (!starts_with(e->d_name, \"pwmchip\") || !join(link, sizeof(link), base, e->d_name, \"/device\")) continue;\n    ssize_t n = readlink(link, target, sizeof(target) - 1);\n    if (n <= 0) continue;\n    target[n] = '\\0';\n    const char *name = target;\n    for (const char *p = target; *p != '\\0'; ++p)\n      if (*p == '/') name = p + 1;\n    if (same(name, chip)) found = join(out, size, base, e->d_name);\n  }\n  closedir(dir);\n  return found;\n}\n\ninline bool pwm_write(slot &s, const char *file, long long v, const char *subject) {\n  char path[PATH_MAX];\n  char num[24];\n  snprintf(num, sizeof(num), \"%lld\", v);\n  int err = 0;\n  if (!join(path, sizeof(path), s.pwm_dir, \"/\", file) || !write_file(path, num, err)) {\n    text t;\n    clear(t);\n    put(t, \"cannot write \");\n    put(t, file);\n    set_errno(s, e_io, subject, t.buf, err);\n    return false;\n  }\n  return true;\n}\n\n// Applies duty/frequency, or turns the channel off (on = false). Called without the lock held,\n// on a copy of the slot.\ninline void pwm_apply(slot &s, bool on) {\n  const char *subject = \"PWM\";\n  if (!s.exported) {\n    char chip_dir[PATH_MAX];\n    const char *colon = nullptr;\n    for (const char *p = s.key; *p != '\\0'; ++p)\n      if (*p == ':') colon = p;\n    char chip[key_size];\n    size_t n = colon ? static_cast<size_t>(colon - s.key) : 0;\n    for (size_t i = 0; i < n && i + 1 < sizeof(chip); ++i) chip[i] = s.key[i];\n    chip[n < sizeof(chip) ? n : sizeof(chip) - 1] = '\\0';\n    const char *channel = colon ? colon + 1 : \"0\";\n    if (!pwm_chip_dir(chip, chip_dir, sizeof(chip_dir))) {\n      set_error(s, e_not_found, chip[0] != '\\0' ? chip : \"CHIP\", \"no such PWM chip\");\n      return;\n    }\n    if (!join(s.pwm_dir, sizeof(s.pwm_dir), chip_dir, \"/pwm\", channel)) return;\n    if (access(s.pwm_dir, F_OK) != 0) {\n      char path[PATH_MAX];\n      int err = 0;\n      if (!join(path, sizeof(path), chip_dir, \"/export\") || (!write_file(path, channel, err) && err != EBUSY)) {\n        set_errno(s, err == EINVAL || err == ENODEV ? e_not_found : e_io, chip, \"cannot export the channel\", err);\n        return;\n      }\n    }\n    s.exported = true;\n    s.applied_on = false;\n    s.applied_freq = -1;\n    s.applied_duty = -1;\n  }\n  if (!on) {\n    if (s.applied_on || s.force_off) {\n      pwm_write(s, \"duty_cycle\", 0, subject);\n      pwm_write(s, \"enable\", 0, subject);\n    }\n    s.applied_on = false;\n    return;\n  }\n  if (s.applied_on && s.applied_freq == s.freq && s.applied_duty == s.duty) return;\n  long long period = static_cast<long long>(1e9 / s.freq + 0.5);\n  long long duty = static_cast<long long>(static_cast<double>(period) * s.duty / 100.0 + 0.5);\n  if (period <= 0) {\n    set_error(s, e_input, subject, \"FREQUENCY is too high\");\n    return;\n  }\n  // duty_cycle must stay at or below period while both change.\n  if (!pwm_write(s, \"duty_cycle\", 0, subject) || !pwm_write(s, \"period\", period, subject) ||\n      !pwm_write(s, \"duty_cycle\", duty, subject) || (!s.applied_on && !pwm_write(s, \"enable\", 1, subject)))\n    return;\n  s.applied_on = true;\n  s.applied_freq = s.freq;\n  s.applied_duty = s.duty;\n  set_error(s, e_no_error, \"\", \"\");\n}\n\ninline void pwm_unexport(slot &s) {\n  if (!s.exported) return;\n  char chip_dir[PATH_MAX];\n  copy_cstr(chip_dir, sizeof(chip_dir), s.pwm_dir);\n  size_t n = 0;\n  while (chip_dir[n] != '\\0') ++n;\n  while (n > 0 && chip_dir[n - 1] != '/') --n;\n  const char *channel = s.pwm_dir + n + 3;  // after \"pwm\"\n  if (n > 0) chip_dir[n - 1] = '\\0';\n  char path[PATH_MAX];\n  int err = 0;\n  if (join(path, sizeof(path), chip_dir, \"/unexport\")) write_file(path, channel, err);\n  s.exported = false;\n}\n\n// ---- reads (helper thread) ----\n\ninline void read_value(slot &s, double scale, double offset) {\n  char real[PATH_MAX];\n  const char *root = LIO_SYS_ROOT \"/\";\n  if (!starts_with(s.key, root) || !realpath(s.key, real) || !starts_with(real, root)) {\n    bool outside = !starts_with(s.key, root);\n    if (outside) set_error(s, e_input, s.key[0] != '\\0' ? s.key : \"PATH\", \"PATH must be a file under \" LIO_SYS_ROOT \"/\");\n    else set_errno(s, e_not_found, s.key, \"cannot open\", errno);\n    s.valid = false;\n    return;\n  }\n  char buf[256];\n  int err = 0;\n  double v = 0;\n  if (!read_file(real, buf, sizeof(buf), err)) {\n    set_errno(s, e_io, s.key, \"cannot read\", err);\n    s.valid = false;\n    return;\n  }\n  if (!first_number(buf, v)) {\n    set_error(s, e_io, s.key, \"the file holds no number\");\n    s.valid = false;\n    return;\n  }\n  s.raw = static_cast<long long>(v);\n  s.value = v * scale + offset;\n  s.valid = true;\n  set_error(s, e_no_error, \"\", \"\");\n}\n\ninline bool read_number(const char *dir, const char *file, double &v) {\n  char path[PATH_MAX];\n  char buf[128];\n  int err = 0;\n  return join(path, sizeof(path), dir, \"/\", file) && read_file(path, buf, sizeof(buf), err) && first_number(buf, v);\n}\n\n// key = \"<device>\\n<channel>\"\ninline void read_iio(slot &s) {\n  char device[key_size];\n  copy_cstr(device, sizeof(device), s.key);\n  char *channel = device;\n  while (*channel != '\\0' && *channel != '\\n') ++channel;\n  if (*channel == '\\n') *channel++ = '\\0';\n  s.valid = false;\n  if (device[0] == '\\0' || channel[0] == '\\0') {\n    set_error(s, e_input, \"IIO\", \"DEVICE and CHANNEL are required\");\n    return;\n  }\n  const char *base = LIO_SYS_ROOT \"/bus/iio/devices\";\n  DIR *dir = opendir(base);\n  char found[PATH_MAX] = \"\";\n  if (dir) {\n    char path[PATH_MAX];\n    char name[128];\n    int err = 0;\n    while (dirent *e = readdir(dir)) {\n      if (e->d_name[0] == '.' || !join(path, sizeof(path), base, \"/\", e->d_name)) continue;\n      char name_path[PATH_MAX];\n      if (!join(name_path, sizeof(name_path), path, \"/name\") || !read_file(name_path, name, sizeof(name), err)) continue;\n      trim(name);\n      if (same(name, device)) {\n        copy_cstr(found, sizeof(found), path);\n        break;\n      }\n    }\n    closedir(dir);\n  }\n  if (found[0] == '\\0') {\n    set_error(s, e_not_found, device, \"no such IIO device\");\n    return;\n  }\n  char file[key_size + 16];\n  double raw = 0;\n  snprintf(file, sizeof(file), \"%s_raw\", channel);\n  if (!read_number(found, file, raw)) {\n    set_error(s, e_not_found, device, \"the channel has no readable _raw file\");\n    return;\n  }\n  char type[key_size];\n  channel_type(channel, type, sizeof(type));\n  double scale = 1;\n  double offset = 0;\n  snprintf(file, sizeof(file), \"%s_scale\", channel);\n  if (!read_number(found, file, scale)) {\n    snprintf(file, sizeof(file), \"%s_scale\", type);\n    if (!read_number(found, file, scale)) scale = 1;\n  }\n  snprintf(file, sizeof(file), \"%s_offset\", channel);\n  if (!read_number(found, file, offset)) {\n    snprintf(file, sizeof(file), \"%s_offset\", type);\n    if (!read_number(found, file, offset)) offset = 0;\n  }\n  s.raw = static_cast<long long>(raw);\n  s.value = iio_value(raw, offset, scale);\n  s.valid = true;\n  set_error(s, e_no_error, \"\", \"\");\n}\n\n// ---- helper thread ----\n\n// Puts an output in its stop state. Lock held; GPIO writes are a single ioctl.\ninline void stop_gpio(slot &s) {\n  if (s.fd >= 0 && s.stop != stop_hold) {\n    bool v = s.stop == stop_on;\n    if (line_set(s.fd, v)) s.applied = v ? 1 : 0;\n  }\n}\n\n// Frees a slot; for PWM the caller has already turned it off or kept it (hold).\ninline void free_slot(slot &s) {\n  if (s.fd >= 0) close(s.fd);\n  slot fresh{};\n  fresh.fd = -1;\n  s = fresh;\n}\n\n// True if another used PWM slot drives the same channel (a block enabled again meanwhile).\ninline bool pwm_shared(state &st, int self, const char *key) {\n  pthread_mutex_lock(&st.lock);\n  bool found = false;\n  for (int i = 0; i < max_slots && !found; ++i)\n    found = i != self && st.slots[i].used && st.slots[i].kind == k_pwm && same(st.slots[i].key, key);\n  pthread_mutex_unlock(&st.lock);\n  return found;\n}\n\ninline void *helper(void *) {\n  state &st = shared();\n  for (;;) {\n    timespec tick = {0, 10 * ms};\n    nanosleep(&tick, nullptr);\n    if (st.quit) break;\n    long long now = now_ns();\n    bool any = false;\n    for (int i = 0; i < max_slots; ++i) {\n      pthread_mutex_lock(&st.lock);\n      slot &live = st.slots[i];\n      if (!live.used) {\n        pthread_mutex_unlock(&st.lock);\n        continue;\n      }\n      any = true;\n      long long idle = now - live.last_call;\n      bool timed_out = idle > stop_after(live.interval);\n      int kind = live.kind;\n      if (kind == k_out) {\n        if (timed_out && !live.stopped) {\n          stop_gpio(live);\n          live.stopped = true;\n        }\n        if (idle > release_after) free_slot(live);\n        pthread_mutex_unlock(&st.lock);\n        continue;\n      }\n      if (kind == k_in) {\n        if (idle > release_after) free_slot(live);\n        pthread_mutex_unlock(&st.lock);\n        continue;\n      }\n      if (timed_out && !live.stopped) live.stopped = true;\n      slot work = live;  // slow work on a copy, outside the lock\n      pthread_mutex_unlock(&st.lock);\n\n      bool release = idle > release_after;\n      bool changed = false;\n      if (kind == k_pwm) {\n        bool on = !work.stopped && !release;\n        if (on || work.stop != stop_hold) {\n          pwm_apply(work, on);\n          changed = true;\n        }\n        if (release && work.stop != stop_hold && !pwm_shared(st, i, work.key)) pwm_unexport(work);\n      } else if ((kind == k_value || kind == k_iio) && !work.stopped && now >= work.next_read) {\n        if (kind == k_value) read_value(work, work.scale, work.offset);\n        else read_iio(work);\n        work.next_read = now + work.period;\n        changed = true;\n      }\n\n      pthread_mutex_lock(&st.lock);\n      slot &back = st.slots[i];\n      if (back.used && back.kind == kind && same(back.key, work.key)) {\n        if (release) {\n          free_slot(back);\n        } else if (changed) {\n          back.exported = work.exported;\n          copy_cstr(back.pwm_dir, sizeof(back.pwm_dir), work.pwm_dir);\n          back.applied_on = work.applied_on;\n          back.applied_freq = work.applied_freq;\n          back.applied_duty = work.applied_duty;\n          back.value = work.value;\n          back.raw = work.raw;\n          back.valid = work.valid;\n          back.next_read = work.next_read;\n          back.error = work.error;\n          copy_cstr(back.message, sizeof(back.message), work.message);\n        }\n      }\n      pthread_mutex_unlock(&st.lock);\n    }\n    if (!any) {\n      pthread_mutex_lock(&st.lock);\n      bool still_none = true;\n      for (int i = 0; i < max_slots; ++i) still_none = still_none && !st.slots[i].used;\n      if (still_none) st.running = false;\n      pthread_mutex_unlock(&st.lock);\n      if (still_none) break;\n    }\n  }\n  return nullptr;\n}\n\n// Lock held. Starts the helper thread with normal scheduling, not the scan thread's.\ninline void ensure_helper(state &st) {\n  if (st.running) return;\n  if (st.thread_started) pthread_join(st.thread, nullptr);\n  st.thread_started = false;\n  pthread_attr_t attr;\n  if (pthread_attr_init(&attr) != 0) return;\n  sched_param param{};\n  param.sched_priority = 0;\n  pthread_attr_setinheritsched(&attr, PTHREAD_EXPLICIT_SCHED);\n  pthread_attr_setschedpolicy(&attr, SCHED_OTHER);\n  pthread_attr_setschedparam(&attr, &param);\n  st.quit = false;\n  if (pthread_create(&st.thread, &attr, helper, nullptr) == 0) {\n    st.thread_started = true;\n    st.running = true;\n  }\n  pthread_attr_destroy(&attr);\n}\n\n// Stops the helper and frees every slot when the program library is unloaded.\nstruct unload_guard {\n  ~unload_guard() {\n    state &st = shared();\n    st.quit = true;\n    if (st.thread_started) pthread_join(st.thread, nullptr);\n    st.thread_started = false;\n    st.running = false;\n    for (int i = 0; i < max_slots; ++i) {\n      slot &s = st.slots[i];\n      if (!s.used) continue;\n      if (s.kind == k_out && !s.stopped) stop_gpio(s);\n      if (s.kind == k_pwm && s.stop != stop_hold) {\n        pwm_apply(s, false);\n        pwm_unexport(s);\n      }\n      free_slot(s);\n    }\n  }\n};\ninline unload_guard &guard() {\n  static unload_guard g;\n  return g;\n}\n\n// One call of a block: finds or makes its slot (index + 1 in `id`), records the call and returns\n// the slot with the lock held, or nullptr (no slot free; the lock is not held then).\ninline slot *enter(unsigned short &id, unsigned &gen, int kind, const char *key, unsigned long long cfg) {\n  state &st = shared();\n  (void)guard();\n  long long now = now_ns();\n  pthread_mutex_lock(&st.lock);\n  slot *s = nullptr;\n  if (id >= 1 && id <= max_slots && st.slots[id - 1].used && st.slots[id - 1].kind == kind &&\n      st.slots[id - 1].gen == gen)\n    s = &st.slots[id - 1];\n  if (!s) {\n    for (int i = 0; i < max_slots && !s; ++i) {\n      if (!st.slots[i].used) {\n        s = &st.slots[i];\n        slot fresh{};\n        fresh.fd = -1;\n        fresh.used = true;\n        fresh.kind = kind;\n        fresh.applied = -1;\n        fresh.last_call = now;\n        fresh.gen = ++st.next_gen == 0 ? ++st.next_gen : st.next_gen;\n        *s = fresh;\n        id = static_cast<unsigned short>(i + 1);\n        gen = fresh.gen;\n      }\n    }\n  }\n  if (!s) {\n    pthread_mutex_unlock(&st.lock);\n    id = 0;\n    gen = 0;\n    return nullptr;\n  }\n  if (!same(s->key, key) || s->cfg != cfg) {\n    // A new pin or new settings: claim again.\n    if (s->fd >= 0) close(s->fd);\n    s->fd = -1;\n    s->next_try = 0;\n    s->applied = -1;\n    s->exported = false;\n    s->valid = false;\n    s->next_read = 0;\n    s->error = e_no_error;\n    s->message[0] = '\\0';\n    copy_cstr(s->key, sizeof(s->key), key);\n    s->cfg = cfg;\n  }\n  long long d = now - s->last_call;\n  if (d > 0 && d < 10000 * ms) s->interval = s->interval > 0 ? (s->interval * 7 + d) / 8 : d;\n  s->last_call = now;\n  s->stopped = false;\n  ensure_helper(st);\n  return s;\n}\ninline void leave() { pthread_mutex_unlock(&shared().lock); }\n\n// ENABLE went FALSE: outputs to their stop state, then the slot is freed (PWM by the helper).\ninline void disable(unsigned short &id, unsigned &gen, int kind) {\n  if (id == 0) return;\n  state &st = shared();\n  pthread_mutex_lock(&st.lock);\n  if (id <= max_slots && st.slots[id - 1].used && st.slots[id - 1].kind == kind && st.slots[id - 1].gen == gen) {\n    slot &s = st.slots[id - 1];\n    if (kind == k_pwm) {\n      s.last_call = 0;  // the helper turns it off (or keeps it, hold) and frees it\n      s.stopped = true;\n      s.interval = 0;\n      s.gen = 0;  // no block owns it any more\n    } else {\n      if (kind == k_out) stop_gpio(s);\n      free_slot(s);\n    }\n  }\n  pthread_mutex_unlock(&st.lock);\n  id = 0;\n  gen = 0;\n}\n\n// PWM with ENABLE FALSE: turns the channel off whatever ON_STOP says, also one a block left running\n// (LIO_STOP_HOLD) before. Runs once per disable; id = pwm_done marks it done until the block runs again.\nconst unsigned short pwm_done = 0xFFFF;\ninline void pwm_off(unsigned short &id, unsigned &gen, const char *key) {\n  if (id == pwm_done) return;\n  state &st = shared();\n  (void)guard();\n  pthread_mutex_lock(&st.lock);\n  slot *s = nullptr;\n  if (id >= 1 && id <= max_slots && st.slots[id - 1].used && st.slots[id - 1].kind == k_pwm &&\n      st.slots[id - 1].gen == gen)\n    s = &st.slots[id - 1];\n  for (int i = 0; i < max_slots && !s; ++i)\n    if (st.slots[i].used && st.slots[i].kind == k_pwm && st.slots[i].gen == 0 && same(st.slots[i].key, key))\n      s = &st.slots[i];\n  bool other = false;\n  for (int i = 0; i < max_slots && !s && !other; ++i)\n    other = st.slots[i].used && st.slots[i].kind == k_pwm && same(st.slots[i].key, key);\n  for (int i = 0; i < max_slots && !s && !other; ++i) {\n    if (!st.slots[i].used) {\n      s = &st.slots[i];\n      slot fresh{};\n      fresh.fd = -1;\n      fresh.used = true;\n      fresh.kind = k_pwm;\n      fresh.applied = -1;\n      copy_cstr(fresh.key, sizeof(fresh.key), key);\n      *s = fresh;\n    }\n  }\n  if (s) {\n    s->stop = stop_off;\n    s->force_off = true;\n    s->last_call = 0;  // the helper turns it off, unexports it and frees the slot\n    s->stopped = true;\n    s->interval = 0;\n    s->gen = 0;\n    ensure_helper(st);\n  }\n  pthread_mutex_unlock(&st.lock);\n  id = pwm_done;\n  gen = 0;\n}\n\n#endif  // __linux__\n\n}  // namespace lio\n\n#pragma pop_macro(\"ENABLE\")\n#pragma pop_macro(\"PIN\")\n#pragma pop_macro(\"BIAS\")\n#pragma pop_macro(\"ACTIVE_LOW\")\n#pragma pop_macro(\"DEBOUNCE\")\n#pragma pop_macro(\"Q\")\n#pragma pop_macro(\"VALUE\")\n#pragma pop_macro(\"DRIVE\")\n#pragma pop_macro(\"ON_STOP\")\n#pragma pop_macro(\"CHIP\")\n#pragma pop_macro(\"CHANNEL\")\n#pragma pop_macro(\"FREQUENCY\")\n#pragma pop_macro(\"DUTY\")\n#pragma pop_macro(\"PATH\")\n#pragma pop_macro(\"SCALE\")\n#pragma pop_macro(\"OFFSET\")\n#pragma pop_macro(\"PERIOD\")\n#pragma pop_macro(\"RAW\")\n#pragma pop_macro(\"DEVICE\")\n#pragma pop_macro(\"VALID\")\n#pragma pop_macro(\"ERROR\")\n#pragma pop_macro(\"ERRORTEXT\")\n#pragma pop_macro(\"lio_slot\")\n#pragma pop_macro(\"lio_gen\")\n#endif  // LINUX_IO_SHARED_INCLUDED\nvoid setup() {\n}\n\nvoid loop() {\n#if defined(__linux__)\n  if (!ENABLE) {\n    unsigned short l_id = lio_slot;\n    unsigned l_gen = lio_gen;\n    lio::disable(l_id, l_gen, lio::k_out);\n    lio_slot = 0;\n    lio_gen = 0;\n    VALID = false;\n    ERROR = 0;\n    if (lio_last != 0) ERRORTEXT = \"\";\n    lio_last = 0;\n    return;\n  }\n  if (DRIVE > 2 || ON_STOP > 2) {\n    unsigned short l_id = lio_slot;\n    unsigned l_gen = lio_gen;\n    lio::disable(l_id, l_gen, lio::k_out);\n    lio_slot = 0;\n    lio_gen = 0;\n    VALID = false;\n    int l_err = lio::e_input;\n    lio::text l_msg;\n    lio::clear(l_msg);\n    lio::put(l_msg, \"DRIVE or ON_STOP is out of range\");\n  ERROR = static_cast<uint8_t>(l_err);\n  if (l_err != 0 || lio_last != 0) ERRORTEXT = l_msg.buf;\n  lio_last = static_cast<uint8_t>(l_err);\n    return;\n  }\n  uint8_t l_drive = DRIVE;\n  unsigned long long l_cfg = 0x20u | (ACTIVE_LOW ? 0x4u : 0u) | ((static_cast<unsigned long long>(l_drive) & 0x3u) << 3);\n  bool l_value = VALUE;\n  unsigned short l_id = lio_slot;\n  unsigned l_gen = lio_gen;\n  lio::slot *l_s = lio::enter(l_id, l_gen, lio::k_out, PIN.c_str(), l_cfg);\n  lio_slot = l_id;\n  lio_gen = l_gen;\n  bool l_valid = false;\n  int l_err = lio::e_no_slot;\n  lio::text l_msg;\n  lio::clear(l_msg);\n  lio::put(l_msg, \"more than 64 linux_io blocks\");\n  if (l_s) {\n    l_s->stop = ON_STOP;\n    long long l_now = lio::now_ns();\n    if (l_s->fd < 0 && l_now >= l_s->next_try) {\n      lio::claim_line(*l_s, l_value);\n      if (l_s->fd < 0) l_s->next_try = l_now + lio::retry_after;\n    }\n    if (l_s->fd >= 0) {\n      int l_want = l_value ? 1 : 0;\n      if (l_s->applied != l_want) {\n        if (lio::line_set(l_s->fd, l_value)) {\n          l_s->applied = l_want;\n          if (l_s->error != lio::e_no_error) lio::set_error(*l_s, lio::e_no_error, \"\", \"\");\n        } else {\n          lio::set_errno(*l_s, lio::e_io, l_s->key, \"cannot set the line\", errno);\n        }\n      }\n      l_valid = l_s->applied == l_want;\n    }\n    l_err = l_s->error;\n    lio::clear(l_msg);\n    lio::put(l_msg, l_s->message);\n    lio::leave();\n  }\n  VALID = l_valid;\n  ERROR = static_cast<uint8_t>(l_err);\n  if (l_err != 0 || lio_last != 0) ERRORTEXT = l_msg.buf;\n  lio_last = static_cast<uint8_t>(l_err);\n#else\n\n  VALID = false;\n  ERROR = 1;\n  ERRORTEXT = \"not supported on this target\";\n#endif\n}\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "PWM_OUT.cpp",
      "source": "(* Drives a hardware PWM channel of the Linux device (sysfs) at FREQUENCY (Hz) with DUTY (0 to 100 %). CHIP is the pwmchip number ('0'), its name ('pwmchip0') or its device name; CHANNEL counts from 0. The channel is set up outside the PLC scan and written only when a value changes; VALID is TRUE once it runs with the values asked for. When the block is no longer called (PLC stop, PLC error, new upload) the channel goes to ON_STOP: LIO_STOP_OFF (default, duty 0 and disabled) or LIO_STOP_HOLD. ENABLE FALSE turns the channel off, also one left running by LIO_STOP_HOLD before. A board may need its PWM driver switched on in its boot settings first.\nExample: fan(ENABLE := TRUE, CHIP := '0', CHANNEL := 0, FREQUENCY := 1000.0, DUTY := speed); *)\nFUNCTION_BLOCK PWM_OUT\nVAR_INPUT\n  ENABLE : BOOL;\n  CHIP : STRING;\n  CHANNEL : USINT;\n  FREQUENCY : REAL;\n  DUTY : REAL;\n  ON_STOP : USINT;\nEND_VAR\nVAR_OUTPUT\n  VALID : BOOL;\n  ERROR : USINT;\n  ERRORTEXT : STRING;\nEND_VAR\nVAR\n  lio_slot : UINT;\n  lio_gen : UDINT;\n  lio_last : USINT;\nEND_VAR\n// SPDX-License-Identifier: Apache-2.0\n//\n// Shared code of the linux_io function blocks. The generator copies it into every block's source,\n// because the editor grafts each library C++ block into one c_blocks_code.cpp and has no other\n// place for shared code; the include guard keeps one copy per program.\n//\n// The editor binds every pin and local of a block to a #define of its name before this code, so\n// the system headers are included with those names pushed and undefined, and this code names\n// nothing in upper case.\n//\n// Linux only: GPIO through the character device (uAPI v2), PWM and values through sysfs. A helper\n// thread (normal scheduling) does the slow reads and the PWM writes, puts outputs in their stop\n// state when their block is no longer called, and releases what a block has not used for 2 s.\n#ifndef LINUX_IO_SHARED_INCLUDED\n#define LINUX_IO_SHARED_INCLUDED\n\n#pragma push_macro(\"ENABLE\")\n#pragma push_macro(\"PIN\")\n#pragma push_macro(\"BIAS\")\n#pragma push_macro(\"ACTIVE_LOW\")\n#pragma push_macro(\"DEBOUNCE\")\n#pragma push_macro(\"Q\")\n#pragma push_macro(\"VALUE\")\n#pragma push_macro(\"DRIVE\")\n#pragma push_macro(\"ON_STOP\")\n#pragma push_macro(\"CHIP\")\n#pragma push_macro(\"CHANNEL\")\n#pragma push_macro(\"FREQUENCY\")\n#pragma push_macro(\"DUTY\")\n#pragma push_macro(\"PATH\")\n#pragma push_macro(\"SCALE\")\n#pragma push_macro(\"OFFSET\")\n#pragma push_macro(\"PERIOD\")\n#pragma push_macro(\"RAW\")\n#pragma push_macro(\"DEVICE\")\n#pragma push_macro(\"VALID\")\n#pragma push_macro(\"ERROR\")\n#pragma push_macro(\"ERRORTEXT\")\n#pragma push_macro(\"lio_slot\")\n#pragma push_macro(\"lio_gen\")\n#undef ENABLE\n#undef PIN\n#undef BIAS\n#undef ACTIVE_LOW\n#undef DEBOUNCE\n#undef Q\n#undef VALUE\n#undef DRIVE\n#undef ON_STOP\n#undef CHIP\n#undef CHANNEL\n#undef FREQUENCY\n#undef DUTY\n#undef PATH\n#undef SCALE\n#undef OFFSET\n#undef PERIOD\n#undef RAW\n#undef DEVICE\n#undef VALID\n#undef ERROR\n#undef ERRORTEXT\n#undef lio_slot\n#undef lio_gen\n\n#if defined(__linux__)\n#include <dirent.h>\n#include <errno.h>\n#include <fcntl.h>\n#include <limits.h>\n#include <linux/gpio.h>\n#include <pthread.h>\n#include <sched.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <sys/ioctl.h>\n#include <time.h>\n#include <unistd.h>\n#endif\n\n#ifndef LIO_SYS_ROOT\n#define LIO_SYS_ROOT \"/sys\"\n#endif\n#ifndef LIO_DEV_ROOT\n#define LIO_DEV_ROOT \"/dev\"\n#endif\n\nnamespace lio {\n\nenum {\n  e_no_error = 0, e_not_supported = 1, e_input = 2, e_not_found = 3, e_busy = 4, e_refused = 5,\n  e_io = 6, e_no_slot = 7\n};\nenum { k_none = 0, k_in = 1, k_out = 2, k_pwm = 3, k_value = 4, k_iio = 5 };\nenum { stop_off = 0, stop_on = 1, stop_hold = 2 };\nenum { bias_none = 0, bias_pull_up = 1, bias_pull_down = 2 };\nenum { drive_push_pull = 0, drive_open_drain = 1, drive_open_source = 2 };\n\nconst int max_slots = 64;\nconst int key_size = 520;\nconst int text_size = 128;\nconst long long ms = 1000000LL;\nconst long long release_after = 2000 * ms;\nconst long long retry_after = 500 * ms;\nconst long long min_stop_after = 100 * ms;\n\n// Text for ERRORTEXT, bounded.\nstruct text {\n  char buf[text_size];\n};\ninline void clear(text &t) { t.buf[0] = '\\0'; }\ninline void put(text &t, const char *s) {\n  size_t n = 0;\n  while (t.buf[n] != '\\0' && n + 1 < sizeof(t.buf)) ++n;\n  while (*s != '\\0' && n + 1 < sizeof(t.buf)) t.buf[n++] = *s++;\n  t.buf[n] = '\\0';\n}\ninline void put_num(text &t, long long v) {\n  char tmp[24];\n  int n = 0;\n  bool neg = v < 0;\n  unsigned long long u = neg ? 0ULL - static_cast<unsigned long long>(v) : static_cast<unsigned long long>(v);\n  do {\n    tmp[n++] = static_cast<char>('0' + u % 10);\n    u /= 10;\n  } while (u != 0 && n < 22);\n  char out[24];\n  int k = 0;\n  if (neg) out[k++] = '-';\n  while (n > 0) out[k++] = tmp[--n];\n  out[k] = '\\0';\n  put(t, out);\n}\ninline void copy_cstr(char *dst, size_t size, const char *src) {\n  size_t n = 0;\n  for (; src[n] != '\\0' && n + 1 < size; ++n) dst[n] = src[n];\n  dst[n] = '\\0';\n}\ninline bool same(const char *a, const char *b) {\n  for (; *a != '\\0' && *a == *b; ++a, ++b) {\n  }\n  return *a == *b;\n}\ninline bool starts_with(const char *s, const char *prefix) {\n  for (; *prefix != '\\0'; ++s, ++prefix)\n    if (*s != *prefix) return false;\n  return true;\n}\n\n// The first number in a text: optional sign, digits, optional fraction. False if there is none.\ninline bool first_number(const char *s, double &value) {\n  for (; *s != '\\0'; ++s) {\n    bool sign = (*s == '-' || *s == '+') && s[1] >= '0' && s[1] <= '9';\n    if (!sign && !(*s >= '0' && *s <= '9')) continue;\n    bool neg = *s == '-';\n    if (sign) ++s;\n    double v = 0;\n    for (; *s >= '0' && *s <= '9'; ++s) v = v * 10 + (*s - '0');\n    if (*s == '.' && s[1] >= '0' && s[1] <= '9') {\n      double f = 0.1;\n      for (++s; *s >= '0' && *s <= '9'; ++s, f /= 10) v += (*s - '0') * f;\n    }\n    value = neg ? -v : v;\n    return true;\n  }\n  return false;\n}\n\n// value = (raw + offset) x scale, the IIO rule.\ninline double iio_value(double raw, double offset, double scale) { return (raw + offset) * scale; }\n\n// An output is put in its stop state after max(100 ms, 5 x its call interval) without a call.\ninline long long stop_after(long long interval_ns) {\n  long long five = interval_ns * 5;\n  return five > min_stop_after ? five : min_stop_after;\n}\n\n// \"in_voltage0\" -> \"in_voltage\": the prefix of the device-wide scale and offset files.\ninline void channel_type(const char *channel, char *out, size_t size) {\n  copy_cstr(out, size, channel);\n  size_t n = 0;\n  while (out[n] != '\\0') ++n;\n  while (n > 0 && out[n - 1] >= '0' && out[n - 1] <= '9') out[--n] = '\\0';\n}\n\n#if defined(__linux__)\n\nstruct slot {\n  bool used;\n  int kind;\n  unsigned gen;  // matches the owning block's lio_gen\n  char key[key_size];   // pin, path, or IIO device and channel\n  unsigned long long cfg;  // packed settings; a change makes the block claim again\n  long long last_call;\n  long long interval;\n  bool stopped;\n  int stop;\n  // GPIO\n  int fd;\n  long long next_try;\n  int applied;  // last value set on an output, -1 unknown\n  // PWM\n  double freq;\n  double duty;\n  double applied_freq;\n  double applied_duty;\n  bool applied_on;\n  bool exported;\n  bool force_off;  // write the off state even if this slot never ran the channel\n  char pwm_dir[256];\n  // reads\n  long long period;\n  double scale;\n  double offset;\n  long long next_read;\n  double value;\n  long long raw;\n  bool valid;\n  // result for the block\n  int error;\n  char message[text_size];\n};\n\nstruct state {\n  slot slots[max_slots];\n  pthread_mutex_t lock;\n  pthread_t thread;\n  bool thread_started;\n  bool running;\n  volatile bool quit;\n  unsigned next_gen;\n};\n\ninline state &shared() {\n  static state s = [] {\n    state init{};\n    pthread_mutex_init(&init.lock, nullptr);\n    for (int i = 0; i < max_slots; ++i) init.slots[i].fd = -1;\n    return init;\n  }();\n  return s;\n}\n\ninline long long now_ns() {\n  timespec ts{};\n  clock_gettime(CLOCK_MONOTONIC, &ts);\n  return static_cast<long long>(ts.tv_sec) * 1000000000LL + ts.tv_nsec;\n}\n\ninline void set_error(slot &s, int error, const text &t) {\n  s.error = error;\n  copy_cstr(s.message, sizeof(s.message), error == e_no_error ? \"\" : t.buf);\n}\ninline void set_error(slot &s, int error, const char *subject, const char *what) {\n  text t;\n  clear(t);\n  put(t, subject);\n  put(t, \": \");\n  put(t, what);\n  set_error(s, error, t);\n}\ninline void set_errno(slot &s, int error, const char *subject, const char *what, int err) {\n  text t;\n  clear(t);\n  put(t, subject);\n  put(t, \": \");\n  put(t, what);\n  put(t, \" (\");\n  put(t, strerror(err));\n  put(t, \")\");\n  set_error(s, error, t);\n}\n\n// ---- files ----\n\ninline bool read_file(const char *path, char *buf, size_t size, int &err) {\n  int fd = open(path, O_RDONLY | O_CLOEXEC);\n  if (fd < 0) {\n    err = errno;\n    return false;\n  }\n  ssize_t n = read(fd, buf, size - 1);\n  err = errno;\n  close(fd);\n  if (n < 0) return false;\n  buf[n] = '\\0';\n  return true;\n}\ninline bool write_file(const char *path, const char *value, int &err) {\n  int fd = open(path, O_WRONLY | O_TRUNC | O_CLOEXEC);\n  if (fd < 0) {\n    err = errno;\n    return false;\n  }\n  size_t len = 0;\n  while (value[len] != '\\0') ++len;\n  ssize_t n = write(fd, value, len);\n  err = errno;\n  close(fd);\n  return n == static_cast<ssize_t>(len);\n}\ninline void trim(char *s) {\n  size_t n = 0;\n  while (s[n] != '\\0') ++n;\n  while (n > 0 && (s[n - 1] == '\\n' || s[n - 1] == ' ' || s[n - 1] == '\\r' || s[n - 1] == '\\t')) s[--n] = '\\0';\n}\ninline bool join(char *out, size_t size, const char *a, const char *b, const char *c = \"\") {\n  int n = snprintf(out, size, \"%s%s%s\", a, b, c);\n  return n > 0 && static_cast<size_t>(n) < size;\n}\n\n// ---- GPIO ----\n\ninline bool all_digits(const char *s) {\n  if (*s == '\\0') return false;\n  for (; *s != '\\0'; ++s)\n    if (*s < '0' || *s > '9') return false;\n  return true;\n}\n\n// Opens the chip named `chip` (device name such as gpiochip0, or its label); -1 if none.\ninline int open_chip(const char *chip) {\n  char path[PATH_MAX];\n  if (starts_with(chip, \"gpiochip\") && join(path, sizeof(path), LIO_DEV_ROOT \"/\", chip)) {\n    int fd = open(path, O_RDWR | O_CLOEXEC);\n    if (fd >= 0) return fd;\n  }\n  DIR *dir = opendir(LIO_DEV_ROOT);\n  if (!dir) return -1;\n  int found = -1;\n  while (dirent *e = readdir(dir)) {\n    if (!starts_with(e->d_name, \"gpiochip\") || !join(path, sizeof(path), LIO_DEV_ROOT \"/\", e->d_name)) continue;\n    int fd = open(path, O_RDWR | O_CLOEXEC);\n    if (fd < 0) continue;\n    gpiochip_info info{};\n    if (ioctl(fd, GPIO_GET_CHIPINFO_IOCTL, &info) == 0 && same(info.label, chip)) {\n      found = fd;\n      break;\n    }\n    close(fd);\n  }\n  closedir(dir);\n  return found;\n}\n\n// Finds a line by name on any chip; returns the open chip and sets `offset`, or -1.\ninline int find_line(const char *name, unsigned &offset, char *consumer, size_t consumer_size) {\n  DIR *dir = opendir(LIO_DEV_ROOT);\n  if (!dir) return -1;\n  int found = -1;\n  char path[PATH_MAX];\n  while (found < 0) {\n    dirent *e = readdir(dir);\n    if (!e) break;\n    if (!starts_with(e->d_name, \"gpiochip\") || !join(path, sizeof(path), LIO_DEV_ROOT \"/\", e->d_name)) continue;\n    int fd = open(path, O_RDWR | O_CLOEXEC);\n    if (fd < 0) continue;\n    gpiochip_info info{};\n    if (ioctl(fd, GPIO_GET_CHIPINFO_IOCTL, &info) == 0) {\n      for (unsigned i = 0; i < info.lines; ++i) {\n        gpio_v2_line_info li{};\n        li.offset = i;\n        if (ioctl(fd, GPIO_V2_GET_LINEINFO_IOCTL, &li) == 0 && same(li.name, name)) {\n          offset = i;\n          copy_cstr(consumer, consumer_size, li.consumer);\n          found = fd;\n          break;\n        }\n      }\n    }\n    if (found < 0) close(fd);\n  }\n  closedir(dir);\n  return found;\n}\n\n// Claims the line of slot `s` (pin in key) as input or output with the settings in cfg.\n// cfg: bits 0-1 bias, 2 active low, 3-4 drive, 5 output, 32-63 debounce in microseconds.\ninline void claim_line(slot &s, bool first_value) {\n  const char *pin = s.key;\n  unsigned offset = 0;\n  char consumer[32] = \"\";\n  int chip = -1;\n  const char *colon = nullptr;\n  for (const char *p = pin; *p != '\\0'; ++p)\n    if (*p == ':') colon = p;\n  if (colon) {\n    char name[key_size];\n    size_t n = static_cast<size_t>(colon - pin);\n    if (n >= sizeof(name) || !all_digits(colon + 1)) {\n      set_error(s, e_input, pin, \"PIN is a line name or <chip>:<offset>\");\n      return;\n    }\n    for (size_t i = 0; i < n; ++i) name[i] = pin[i];\n    name[n] = '\\0';\n    offset = static_cast<unsigned>(strtoul(colon + 1, nullptr, 10));\n    chip = open_chip(name);\n    if (chip >= 0) {\n      gpio_v2_line_info li{};\n      li.offset = offset;\n      if (ioctl(chip, GPIO_V2_GET_LINEINFO_IOCTL, &li) != 0) {\n        close(chip);\n        set_error(s, e_not_found, pin, \"the chip has no such line\");\n        return;\n      }\n      copy_cstr(consumer, sizeof(consumer), li.consumer);\n    }\n  } else if (*pin != '\\0') {\n    chip = find_line(pin, offset, consumer, sizeof(consumer));\n  }\n  if (chip < 0) {\n    set_error(s, e_not_found, *pin != '\\0' ? pin : \"PIN\", \"no such GPIO line\");\n    return;\n  }\n  gpio_v2_line_request req{};\n  req.offsets[0] = offset;\n  req.num_lines = 1;\n  copy_cstr(req.consumer, sizeof(req.consumer), \"openplc\");\n  unsigned long long cfg = s.cfg;\n  unsigned long long flags = (cfg & 0x20u) ? GPIO_V2_LINE_FLAG_OUTPUT : GPIO_V2_LINE_FLAG_INPUT;\n  if (cfg & 0x4u) flags |= GPIO_V2_LINE_FLAG_ACTIVE_LOW;\n  if (cfg & 0x20u) {\n    unsigned drive = static_cast<unsigned>((cfg >> 3) & 0x3u);\n    if (drive == drive_open_drain) flags |= GPIO_V2_LINE_FLAG_OPEN_DRAIN;\n    if (drive == drive_open_source) flags |= GPIO_V2_LINE_FLAG_OPEN_SOURCE;\n    req.config.attrs[0].attr.id = GPIO_V2_LINE_ATTR_ID_OUTPUT_VALUES;\n    req.config.attrs[0].attr.values = first_value ? 1u : 0u;\n    req.config.attrs[0].mask = 1u;\n    req.config.num_attrs = 1;\n  } else {\n    unsigned bias = static_cast<unsigned>(cfg & 0x3u);\n    if (bias == bias_pull_up) flags |= GPIO_V2_LINE_FLAG_BIAS_PULL_UP;\n    else if (bias == bias_pull_down) flags |= GPIO_V2_LINE_FLAG_BIAS_PULL_DOWN;\n    else flags |= GPIO_V2_LINE_FLAG_BIAS_DISABLED;\n    unsigned debounce_us = static_cast<unsigned>(cfg >> 32);\n    if (debounce_us != 0) {\n      req.config.attrs[0].attr.id = GPIO_V2_LINE_ATTR_ID_DEBOUNCE;\n      req.config.attrs[0].attr.debounce_period_us = debounce_us;\n      req.config.attrs[0].mask = 1u;\n      req.config.num_attrs = 1;\n    }\n  }\n  req.config.flags = flags;\n  int rc = ioctl(chip, GPIO_V2_GET_LINE_IOCTL, &req);\n  int err = errno;\n  close(chip);\n  if (rc != 0) {\n    if (err == EBUSY) {\n      text t;\n      clear(t);\n      put(t, pin);\n      put(t, \": in use\");\n      if (consumer[0] != '\\0') {\n        put(t, \" by \");\n        put(t, consumer);\n      }\n      set_error(s, e_busy, t);\n    } else {\n      set_errno(s, e_refused, pin, \"the chip refused the line settings\", err);\n    }\n    return;\n  }\n  s.fd = req.fd;\n  s.applied = (cfg & 0x20u) ? (first_value ? 1 : 0) : -1;\n  set_error(s, e_no_error, \"\", \"\");\n}\n\ninline bool line_get(int fd, bool &value) {\n  gpio_v2_line_values v{};\n  v.mask = 1u;\n  if (ioctl(fd, GPIO_V2_LINE_GET_VALUES_IOCTL, &v) != 0) return false;\n  value = (v.bits & 1u) != 0;\n  return true;\n}\ninline bool line_set(int fd, bool value) {\n  gpio_v2_line_values v{};\n  v.mask = 1u;\n  v.bits = value ? 1u : 0u;\n  return ioctl(fd, GPIO_V2_LINE_SET_VALUES_IOCTL, &v) == 0;\n}\n\n// ---- PWM (helper thread) ----\n\n// The sysfs directory of pwmchip `chip`: a number, pwmchipN, or the chip's device name.\ninline bool pwm_chip_dir(const char *chip, char *out, size_t size) {\n  const char *base = LIO_SYS_ROOT \"/class/pwm/\";\n  if (all_digits(chip)) return join(out, size, base, \"pwmchip\", chip) && access(out, F_OK) == 0;\n  if (starts_with(chip, \"pwmchip\")) return join(out, size, base, chip) && access(out, F_OK) == 0;\n  DIR *dir = opendir(LIO_SYS_ROOT \"/class/pwm\");\n  if (!dir) return false;\n  bool found = false;\n  char link[PATH_MAX];\n  char target[PATH_MAX];\n  while (!found) {\n    dirent *e = readdir(dir);\n    if (!e) break;\n    if (!starts_with(e->d_name, \"pwmchip\") || !join(link, sizeof(link), base, e->d_name, \"/device\")) continue;\n    ssize_t n = readlink(link, target, sizeof(target) - 1);\n    if (n <= 0) continue;\n    target[n] = '\\0';\n    const char *name = target;\n    for (const char *p = target; *p != '\\0'; ++p)\n      if (*p == '/') name = p + 1;\n    if (same(name, chip)) found = join(out, size, base, e->d_name);\n  }\n  closedir(dir);\n  return found;\n}\n\ninline bool pwm_write(slot &s, const char *file, long long v, const char *subject) {\n  char path[PATH_MAX];\n  char num[24];\n  snprintf(num, sizeof(num), \"%lld\", v);\n  int err = 0;\n  if (!join(path, sizeof(path), s.pwm_dir, \"/\", file) || !write_file(path, num, err)) {\n    text t;\n    clear(t);\n    put(t, \"cannot write \");\n    put(t, file);\n    set_errno(s, e_io, subject, t.buf, err);\n    return false;\n  }\n  return true;\n}\n\n// Applies duty/frequency, or turns the channel off (on = false). Called without the lock held,\n// on a copy of the slot.\ninline void pwm_apply(slot &s, bool on) {\n  const char *subject = \"PWM\";\n  if (!s.exported) {\n    char chip_dir[PATH_MAX];\n    const char *colon = nullptr;\n    for (const char *p = s.key; *p != '\\0'; ++p)\n      if (*p == ':') colon = p;\n    char chip[key_size];\n    size_t n = colon ? static_cast<size_t>(colon - s.key) : 0;\n    for (size_t i = 0; i < n && i + 1 < sizeof(chip); ++i) chip[i] = s.key[i];\n    chip[n < sizeof(chip) ? n : sizeof(chip) - 1] = '\\0';\n    const char *channel = colon ? colon + 1 : \"0\";\n    if (!pwm_chip_dir(chip, chip_dir, sizeof(chip_dir))) {\n      set_error(s, e_not_found, chip[0] != '\\0' ? chip : \"CHIP\", \"no such PWM chip\");\n      return;\n    }\n    if (!join(s.pwm_dir, sizeof(s.pwm_dir), chip_dir, \"/pwm\", channel)) return;\n    if (access(s.pwm_dir, F_OK) != 0) {\n      char path[PATH_MAX];\n      int err = 0;\n      if (!join(path, sizeof(path), chip_dir, \"/export\") || (!write_file(path, channel, err) && err != EBUSY)) {\n        set_errno(s, err == EINVAL || err == ENODEV ? e_not_found : e_io, chip, \"cannot export the channel\", err);\n        return;\n      }\n    }\n    s.exported = true;\n    s.applied_on = false;\n    s.applied_freq = -1;\n    s.applied_duty = -1;\n  }\n  if (!on) {\n    if (s.applied_on || s.force_off) {\n      pwm_write(s, \"duty_cycle\", 0, subject);\n      pwm_write(s, \"enable\", 0, subject);\n    }\n    s.applied_on = false;\n    return;\n  }\n  if (s.applied_on && s.applied_freq == s.freq && s.applied_duty == s.duty) return;\n  long long period = static_cast<long long>(1e9 / s.freq + 0.5);\n  long long duty = static_cast<long long>(static_cast<double>(period) * s.duty / 100.0 + 0.5);\n  if (period <= 0) {\n    set_error(s, e_input, subject, \"FREQUENCY is too high\");\n    return;\n  }\n  // duty_cycle must stay at or below period while both change.\n  if (!pwm_write(s, \"duty_cycle\", 0, subject) || !pwm_write(s, \"period\", period, subject) ||\n      !pwm_write(s, \"duty_cycle\", duty, subject) || (!s.applied_on && !pwm_write(s, \"enable\", 1, subject)))\n    return;\n  s.applied_on = true;\n  s.applied_freq = s.freq;\n  s.applied_duty = s.duty;\n  set_error(s, e_no_error, \"\", \"\");\n}\n\ninline void pwm_unexport(slot &s) {\n  if (!s.exported) return;\n  char chip_dir[PATH_MAX];\n  copy_cstr(chip_dir, sizeof(chip_dir), s.pwm_dir);\n  size_t n = 0;\n  while (chip_dir[n] != '\\0') ++n;\n  while (n > 0 && chip_dir[n - 1] != '/') --n;\n  const char *channel = s.pwm_dir + n + 3;  // after \"pwm\"\n  if (n > 0) chip_dir[n - 1] = '\\0';\n  char path[PATH_MAX];\n  int err = 0;\n  if (join(path, sizeof(path), chip_dir, \"/unexport\")) write_file(path, channel, err);\n  s.exported = false;\n}\n\n// ---- reads (helper thread) ----\n\ninline void read_value(slot &s, double scale, double offset) {\n  char real[PATH_MAX];\n  const char *root = LIO_SYS_ROOT \"/\";\n  if (!starts_with(s.key, root) || !realpath(s.key, real) || !starts_with(real, root)) {\n    bool outside = !starts_with(s.key, root);\n    if (outside) set_error(s, e_input, s.key[0] != '\\0' ? s.key : \"PATH\", \"PATH must be a file under \" LIO_SYS_ROOT \"/\");\n    else set_errno(s, e_not_found, s.key, \"cannot open\", errno);\n    s.valid = false;\n    return;\n  }\n  char buf[256];\n  int err = 0;\n  double v = 0;\n  if (!read_file(real, buf, sizeof(buf), err)) {\n    set_errno(s, e_io, s.key, \"cannot read\", err);\n    s.valid = false;\n    return;\n  }\n  if (!first_number(buf, v)) {\n    set_error(s, e_io, s.key, \"the file holds no number\");\n    s.valid = false;\n    return;\n  }\n  s.raw = static_cast<long long>(v);\n  s.value = v * scale + offset;\n  s.valid = true;\n  set_error(s, e_no_error, \"\", \"\");\n}\n\ninline bool read_number(const char *dir, const char *file, double &v) {\n  char path[PATH_MAX];\n  char buf[128];\n  int err = 0;\n  return join(path, sizeof(path), dir, \"/\", file) && read_file(path, buf, sizeof(buf), err) && first_number(buf, v);\n}\n\n// key = \"<device>\\n<channel>\"\ninline void read_iio(slot &s) {\n  char device[key_size];\n  copy_cstr(device, sizeof(device), s.key);\n  char *channel = device;\n  while (*channel != '\\0' && *channel != '\\n') ++channel;\n  if (*channel == '\\n') *channel++ = '\\0';\n  s.valid = false;\n  if (device[0] == '\\0' || channel[0] == '\\0') {\n    set_error(s, e_input, \"IIO\", \"DEVICE and CHANNEL are required\");\n    return;\n  }\n  const char *base = LIO_SYS_ROOT \"/bus/iio/devices\";\n  DIR *dir = opendir(base);\n  char found[PATH_MAX] = \"\";\n  if (dir) {\n    char path[PATH_MAX];\n    char name[128];\n    int err = 0;\n    while (dirent *e = readdir(dir)) {\n      if (e->d_name[0] == '.' || !join(path, sizeof(path), base, \"/\", e->d_name)) continue;\n      char name_path[PATH_MAX];\n      if (!join(name_path, sizeof(name_path), path, \"/name\") || !read_file(name_path, name, sizeof(name), err)) continue;\n      trim(name);\n      if (same(name, device)) {\n        copy_cstr(found, sizeof(found), path);\n        break;\n      }\n    }\n    closedir(dir);\n  }\n  if (found[0] == '\\0') {\n    set_error(s, e_not_found, device, \"no such IIO device\");\n    return;\n  }\n  char file[key_size + 16];\n  double raw = 0;\n  snprintf(file, sizeof(file), \"%s_raw\", channel);\n  if (!read_number(found, file, raw)) {\n    set_error(s, e_not_found, device, \"the channel has no readable _raw file\");\n    return;\n  }\n  char type[key_size];\n  channel_type(channel, type, sizeof(type));\n  double scale = 1;\n  double offset = 0;\n  snprintf(file, sizeof(file), \"%s_scale\", channel);\n  if (!read_number(found, file, scale)) {\n    snprintf(file, sizeof(file), \"%s_scale\", type);\n    if (!read_number(found, file, scale)) scale = 1;\n  }\n  snprintf(file, sizeof(file), \"%s_offset\", channel);\n  if (!read_number(found, file, offset)) {\n    snprintf(file, sizeof(file), \"%s_offset\", type);\n    if (!read_number(found, file, offset)) offset = 0;\n  }\n  s.raw = static_cast<long long>(raw);\n  s.value = iio_value(raw, offset, scale);\n  s.valid = true;\n  set_error(s, e_no_error, \"\", \"\");\n}\n\n// ---- helper thread ----\n\n// Puts an output in its stop state. Lock held; GPIO writes are a single ioctl.\ninline void stop_gpio(slot &s) {\n  if (s.fd >= 0 && s.stop != stop_hold) {\n    bool v = s.stop == stop_on;\n    if (line_set(s.fd, v)) s.applied = v ? 1 : 0;\n  }\n}\n\n// Frees a slot; for PWM the caller has already turned it off or kept it (hold).\ninline void free_slot(slot &s) {\n  if (s.fd >= 0) close(s.fd);\n  slot fresh{};\n  fresh.fd = -1;\n  s = fresh;\n}\n\n// True if another used PWM slot drives the same channel (a block enabled again meanwhile).\ninline bool pwm_shared(state &st, int self, const char *key) {\n  pthread_mutex_lock(&st.lock);\n  bool found = false;\n  for (int i = 0; i < max_slots && !found; ++i)\n    found = i != self && st.slots[i].used && st.slots[i].kind == k_pwm && same(st.slots[i].key, key);\n  pthread_mutex_unlock(&st.lock);\n  return found;\n}\n\ninline void *helper(void *) {\n  state &st = shared();\n  for (;;) {\n    timespec tick = {0, 10 * ms};\n    nanosleep(&tick, nullptr);\n    if (st.quit) break;\n    long long now = now_ns();\n    bool any = false;\n    for (int i = 0; i < max_slots; ++i) {\n      pthread_mutex_lock(&st.lock);\n      slot &live = st.slots[i];\n      if (!live.used) {\n        pthread_mutex_unlock(&st.lock);\n        continue;\n      }\n      any = true;\n      long long idle = now - live.last_call;\n      bool timed_out = idle > stop_after(live.interval);\n      int kind = live.kind;\n      if (kind == k_out) {\n        if (timed_out && !live.stopped) {\n          stop_gpio(live);\n          live.stopped = true;\n        }\n        if (idle > release_after) free_slot(live);\n        pthread_mutex_unlock(&st.lock);\n        continue;\n      }\n      if (kind == k_in) {\n        if (idle > release_after) free_slot(live);\n        pthread_mutex_unlock(&st.lock);\n        continue;\n      }\n      if (timed_out && !live.stopped) live.stopped = true;\n      slot work = live;  // slow work on a copy, outside the lock\n      pthread_mutex_unlock(&st.lock);\n\n      bool release = idle > release_after;\n      bool changed = false;\n      if (kind == k_pwm) {\n        bool on = !work.stopped && !release;\n        if (on || work.stop != stop_hold) {\n          pwm_apply(work, on);\n          changed = true;\n        }\n        if (release && work.stop != stop_hold && !pwm_shared(st, i, work.key)) pwm_unexport(work);\n      } else if ((kind == k_value || kind == k_iio) && !work.stopped && now >= work.next_read) {\n        if (kind == k_value) read_value(work, work.scale, work.offset);\n        else read_iio(work);\n        work.next_read = now + work.period;\n        changed = true;\n      }\n\n      pthread_mutex_lock(&st.lock);\n      slot &back = st.slots[i];\n      if (back.used && back.kind == kind && same(back.key, work.key)) {\n        if (release) {\n          free_slot(back);\n        } else if (changed) {\n          back.exported = work.exported;\n          copy_cstr(back.pwm_dir, sizeof(back.pwm_dir), work.pwm_dir);\n          back.applied_on = work.applied_on;\n          back.applied_freq = work.applied_freq;\n          back.applied_duty = work.applied_duty;\n          back.value = work.value;\n          back.raw = work.raw;\n          back.valid = work.valid;\n          back.next_read = work.next_read;\n          back.error = work.error;\n          copy_cstr(back.message, sizeof(back.message), work.message);\n        }\n      }\n      pthread_mutex_unlock(&st.lock);\n    }\n    if (!any) {\n      pthread_mutex_lock(&st.lock);\n      bool still_none = true;\n      for (int i = 0; i < max_slots; ++i) still_none = still_none && !st.slots[i].used;\n      if (still_none) st.running = false;\n      pthread_mutex_unlock(&st.lock);\n      if (still_none) break;\n    }\n  }\n  return nullptr;\n}\n\n// Lock held. Starts the helper thread with normal scheduling, not the scan thread's.\ninline void ensure_helper(state &st) {\n  if (st.running) return;\n  if (st.thread_started) pthread_join(st.thread, nullptr);\n  st.thread_started = false;\n  pthread_attr_t attr;\n  if (pthread_attr_init(&attr) != 0) return;\n  sched_param param{};\n  param.sched_priority = 0;\n  pthread_attr_setinheritsched(&attr, PTHREAD_EXPLICIT_SCHED);\n  pthread_attr_setschedpolicy(&attr, SCHED_OTHER);\n  pthread_attr_setschedparam(&attr, &param);\n  st.quit = false;\n  if (pthread_create(&st.thread, &attr, helper, nullptr) == 0) {\n    st.thread_started = true;\n    st.running = true;\n  }\n  pthread_attr_destroy(&attr);\n}\n\n// Stops the helper and frees every slot when the program library is unloaded.\nstruct unload_guard {\n  ~unload_guard() {\n    state &st = shared();\n    st.quit = true;\n    if (st.thread_started) pthread_join(st.thread, nullptr);\n    st.thread_started = false;\n    st.running = false;\n    for (int i = 0; i < max_slots; ++i) {\n      slot &s = st.slots[i];\n      if (!s.used) continue;\n      if (s.kind == k_out && !s.stopped) stop_gpio(s);\n      if (s.kind == k_pwm && s.stop != stop_hold) {\n        pwm_apply(s, false);\n        pwm_unexport(s);\n      }\n      free_slot(s);\n    }\n  }\n};\ninline unload_guard &guard() {\n  static unload_guard g;\n  return g;\n}\n\n// One call of a block: finds or makes its slot (index + 1 in `id`), records the call and returns\n// the slot with the lock held, or nullptr (no slot free; the lock is not held then).\ninline slot *enter(unsigned short &id, unsigned &gen, int kind, const char *key, unsigned long long cfg) {\n  state &st = shared();\n  (void)guard();\n  long long now = now_ns();\n  pthread_mutex_lock(&st.lock);\n  slot *s = nullptr;\n  if (id >= 1 && id <= max_slots && st.slots[id - 1].used && st.slots[id - 1].kind == kind &&\n      st.slots[id - 1].gen == gen)\n    s = &st.slots[id - 1];\n  if (!s) {\n    for (int i = 0; i < max_slots && !s; ++i) {\n      if (!st.slots[i].used) {\n        s = &st.slots[i];\n        slot fresh{};\n        fresh.fd = -1;\n        fresh.used = true;\n        fresh.kind = kind;\n        fresh.applied = -1;\n        fresh.last_call = now;\n        fresh.gen = ++st.next_gen == 0 ? ++st.next_gen : st.next_gen;\n        *s = fresh;\n        id = static_cast<unsigned short>(i + 1);\n        gen = fresh.gen;\n      }\n    }\n  }\n  if (!s) {\n    pthread_mutex_unlock(&st.lock);\n    id = 0;\n    gen = 0;\n    return nullptr;\n  }\n  if (!same(s->key, key) || s->cfg != cfg) {\n    // A new pin or new settings: claim again.\n    if (s->fd >= 0) close(s->fd);\n    s->fd = -1;\n    s->next_try = 0;\n    s->applied = -1;\n    s->exported = false;\n    s->valid = false;\n    s->next_read = 0;\n    s->error = e_no_error;\n    s->message[0] = '\\0';\n    copy_cstr(s->key, sizeof(s->key), key);\n    s->cfg = cfg;\n  }\n  long long d = now - s->last_call;\n  if (d > 0 && d < 10000 * ms) s->interval = s->interval > 0 ? (s->interval * 7 + d) / 8 : d;\n  s->last_call = now;\n  s->stopped = false;\n  ensure_helper(st);\n  return s;\n}\ninline void leave() { pthread_mutex_unlock(&shared().lock); }\n\n// ENABLE went FALSE: outputs to their stop state, then the slot is freed (PWM by the helper).\ninline void disable(unsigned short &id, unsigned &gen, int kind) {\n  if (id == 0) return;\n  state &st = shared();\n  pthread_mutex_lock(&st.lock);\n  if (id <= max_slots && st.slots[id - 1].used && st.slots[id - 1].kind == kind && st.slots[id - 1].gen == gen) {\n    slot &s = st.slots[id - 1];\n    if (kind == k_pwm) {\n      s.last_call = 0;  // the helper turns it off (or keeps it, hold) and frees it\n      s.stopped = true;\n      s.interval = 0;\n      s.gen = 0;  // no block owns it any more\n    } else {\n      if (kind == k_out) stop_gpio(s);\n      free_slot(s);\n    }\n  }\n  pthread_mutex_unlock(&st.lock);\n  id = 0;\n  gen = 0;\n}\n\n// PWM with ENABLE FALSE: turns the channel off whatever ON_STOP says, also one a block left running\n// (LIO_STOP_HOLD) before. Runs once per disable; id = pwm_done marks it done until the block runs again.\nconst unsigned short pwm_done = 0xFFFF;\ninline void pwm_off(unsigned short &id, unsigned &gen, const char *key) {\n  if (id == pwm_done) return;\n  state &st = shared();\n  (void)guard();\n  pthread_mutex_lock(&st.lock);\n  slot *s = nullptr;\n  if (id >= 1 && id <= max_slots && st.slots[id - 1].used && st.slots[id - 1].kind == k_pwm &&\n      st.slots[id - 1].gen == gen)\n    s = &st.slots[id - 1];\n  for (int i = 0; i < max_slots && !s; ++i)\n    if (st.slots[i].used && st.slots[i].kind == k_pwm && st.slots[i].gen == 0 && same(st.slots[i].key, key))\n      s = &st.slots[i];\n  bool other = false;\n  for (int i = 0; i < max_slots && !s && !other; ++i)\n    other = st.slots[i].used && st.slots[i].kind == k_pwm && same(st.slots[i].key, key);\n  for (int i = 0; i < max_slots && !s && !other; ++i) {\n    if (!st.slots[i].used) {\n      s = &st.slots[i];\n      slot fresh{};\n      fresh.fd = -1;\n      fresh.used = true;\n      fresh.kind = k_pwm;\n      fresh.applied = -1;\n      copy_cstr(fresh.key, sizeof(fresh.key), key);\n      *s = fresh;\n    }\n  }\n  if (s) {\n    s->stop = stop_off;\n    s->force_off = true;\n    s->last_call = 0;  // the helper turns it off, unexports it and frees the slot\n    s->stopped = true;\n    s->interval = 0;\n    s->gen = 0;\n    ensure_helper(st);\n  }\n  pthread_mutex_unlock(&st.lock);\n  id = pwm_done;\n  gen = 0;\n}\n\n#endif  // __linux__\n\n}  // namespace lio\n\n#pragma pop_macro(\"ENABLE\")\n#pragma pop_macro(\"PIN\")\n#pragma pop_macro(\"BIAS\")\n#pragma pop_macro(\"ACTIVE_LOW\")\n#pragma pop_macro(\"DEBOUNCE\")\n#pragma pop_macro(\"Q\")\n#pragma pop_macro(\"VALUE\")\n#pragma pop_macro(\"DRIVE\")\n#pragma pop_macro(\"ON_STOP\")\n#pragma pop_macro(\"CHIP\")\n#pragma pop_macro(\"CHANNEL\")\n#pragma pop_macro(\"FREQUENCY\")\n#pragma pop_macro(\"DUTY\")\n#pragma pop_macro(\"PATH\")\n#pragma pop_macro(\"SCALE\")\n#pragma pop_macro(\"OFFSET\")\n#pragma pop_macro(\"PERIOD\")\n#pragma pop_macro(\"RAW\")\n#pragma pop_macro(\"DEVICE\")\n#pragma pop_macro(\"VALID\")\n#pragma pop_macro(\"ERROR\")\n#pragma pop_macro(\"ERRORTEXT\")\n#pragma pop_macro(\"lio_slot\")\n#pragma pop_macro(\"lio_gen\")\n#endif  // LINUX_IO_SHARED_INCLUDED\nvoid setup() {\n}\n\nvoid loop() {\n#if defined(__linux__)\n  if (!ENABLE) {\n    char l_key[lio::key_size];\n    snprintf(l_key, sizeof(l_key), \"%s:%u\", CHIP.c_str(), static_cast<unsigned>(CHANNEL));\n    unsigned short l_id = lio_slot;\n    unsigned l_gen = lio_gen;\n    lio::pwm_off(l_id, l_gen, l_key);\n    lio_slot = l_id;\n    lio_gen = l_gen;\n    VALID = false;\n    ERROR = 0;\n    if (lio_last != 0) ERRORTEXT = \"\";\n    lio_last = 0;\n    return;\n  }\n  if (ON_STOP != 0 && ON_STOP != 2) {\n    unsigned short l_id = lio_slot;\n    unsigned l_gen = lio_gen;\n    lio::disable(l_id, l_gen, lio::k_pwm);\n    lio_slot = 0;\n    lio_gen = 0;\n    VALID = false;\n    int l_err = lio::e_input;\n    lio::text l_msg;\n    lio::clear(l_msg);\n    lio::put(l_msg, \"ON_STOP is LIO_STOP_OFF or LIO_STOP_HOLD\");\n  ERROR = static_cast<uint8_t>(l_err);\n  if (l_err != 0 || lio_last != 0) ERRORTEXT = l_msg.buf;\n  lio_last = static_cast<uint8_t>(l_err);\n    return;\n  }\n  double l_freq = FREQUENCY;\n  double l_duty = DUTY;\n  char l_key[lio::key_size];\n  uint8_t l_channel = CHANNEL;\n  snprintf(l_key, sizeof(l_key), \"%s:%u\", CHIP.c_str(), static_cast<unsigned>(l_channel));\n  unsigned short l_id = lio_slot;\n  unsigned l_gen = lio_gen;\n  lio::slot *l_s = lio::enter(l_id, l_gen, lio::k_pwm, l_key, 0);\n  lio_slot = l_id;\n  lio_gen = l_gen;\n  bool l_valid = false;\n  int l_err = lio::e_no_slot;\n  lio::text l_msg;\n  lio::clear(l_msg);\n  lio::put(l_msg, \"more than 64 linux_io blocks\");\n  if (l_s) {\n    l_s->stop = ON_STOP;\n    bool l_ok = l_freq > 0 && l_duty >= 0 && l_duty <= 100;\n    if (l_ok) {\n      l_s->freq = l_freq;\n      l_s->duty = l_duty;\n    }\n    l_err = l_s->error;\n    lio::clear(l_msg);\n    lio::put(l_msg, l_s->message);\n    if (!l_ok && l_err == lio::e_no_error) {\n      l_err = lio::e_input;\n      lio::clear(l_msg);\n      lio::put(l_msg, \"FREQUENCY must be above 0 and DUTY from 0 to 100; the output is unchanged\");\n    }\n    l_valid = l_ok && l_err == lio::e_no_error && l_s->applied_on && l_s->applied_freq == l_freq &&\n              l_s->applied_duty == l_duty;\n    lio::leave();\n  }\n  VALID = l_valid;\n  ERROR = static_cast<uint8_t>(l_err);\n  if (l_err != 0 || lio_last != 0) ERRORTEXT = l_msg.buf;\n  lio_last = static_cast<uint8_t>(l_err);\n#else\n\n  VALID = false;\n  ERROR = 1;\n  ERRORTEXT = \"not supported on this target\";\n#endif\n}\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "READ_VALUE.cpp",
      "source": "(* Reads the first number in a file under /sys/ of the Linux device every PERIOD, outside the PLC scan: a temperature from a thermal zone or hwmon, a 1-wire sensor's temperature file, any value a kernel driver shows as a file. RAW is the number, VALUE is RAW x SCALE + OFFSET. VALID is FALSE until the first reading after a start, and on an error, when VALUE and RAW keep the last good reading.\nExample: cpu(ENABLE := TRUE, PATH := '/sys/class/thermal/thermal_zone0/temp', SCALE := 0.001); temperature := cpu.VALUE; *)\nFUNCTION_BLOCK READ_VALUE\nVAR_INPUT\n  ENABLE : BOOL;\n  PATH : STRING;\n  SCALE : REAL := 1.0;\n  OFFSET : REAL;\n  PERIOD : TIME := T#1s;\nEND_VAR\nVAR_OUTPUT\n  VALID : BOOL;\n  ERROR : USINT;\n  ERRORTEXT : STRING;\n  VALUE : REAL;\n  RAW : LINT;\nEND_VAR\nVAR\n  lio_slot : UINT;\n  lio_gen : UDINT;\n  lio_last : USINT;\nEND_VAR\n// SPDX-License-Identifier: Apache-2.0\n//\n// Shared code of the linux_io function blocks. The generator copies it into every block's source,\n// because the editor grafts each library C++ block into one c_blocks_code.cpp and has no other\n// place for shared code; the include guard keeps one copy per program.\n//\n// The editor binds every pin and local of a block to a #define of its name before this code, so\n// the system headers are included with those names pushed and undefined, and this code names\n// nothing in upper case.\n//\n// Linux only: GPIO through the character device (uAPI v2), PWM and values through sysfs. A helper\n// thread (normal scheduling) does the slow reads and the PWM writes, puts outputs in their stop\n// state when their block is no longer called, and releases what a block has not used for 2 s.\n#ifndef LINUX_IO_SHARED_INCLUDED\n#define LINUX_IO_SHARED_INCLUDED\n\n#pragma push_macro(\"ENABLE\")\n#pragma push_macro(\"PIN\")\n#pragma push_macro(\"BIAS\")\n#pragma push_macro(\"ACTIVE_LOW\")\n#pragma push_macro(\"DEBOUNCE\")\n#pragma push_macro(\"Q\")\n#pragma push_macro(\"VALUE\")\n#pragma push_macro(\"DRIVE\")\n#pragma push_macro(\"ON_STOP\")\n#pragma push_macro(\"CHIP\")\n#pragma push_macro(\"CHANNEL\")\n#pragma push_macro(\"FREQUENCY\")\n#pragma push_macro(\"DUTY\")\n#pragma push_macro(\"PATH\")\n#pragma push_macro(\"SCALE\")\n#pragma push_macro(\"OFFSET\")\n#pragma push_macro(\"PERIOD\")\n#pragma push_macro(\"RAW\")\n#pragma push_macro(\"DEVICE\")\n#pragma push_macro(\"VALID\")\n#pragma push_macro(\"ERROR\")\n#pragma push_macro(\"ERRORTEXT\")\n#pragma push_macro(\"lio_slot\")\n#pragma push_macro(\"lio_gen\")\n#undef ENABLE\n#undef PIN\n#undef BIAS\n#undef ACTIVE_LOW\n#undef DEBOUNCE\n#undef Q\n#undef VALUE\n#undef DRIVE\n#undef ON_STOP\n#undef CHIP\n#undef CHANNEL\n#undef FREQUENCY\n#undef DUTY\n#undef PATH\n#undef SCALE\n#undef OFFSET\n#undef PERIOD\n#undef RAW\n#undef DEVICE\n#undef VALID\n#undef ERROR\n#undef ERRORTEXT\n#undef lio_slot\n#undef lio_gen\n\n#if defined(__linux__)\n#include <dirent.h>\n#include <errno.h>\n#include <fcntl.h>\n#include <limits.h>\n#include <linux/gpio.h>\n#include <pthread.h>\n#include <sched.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <sys/ioctl.h>\n#include <time.h>\n#include <unistd.h>\n#endif\n\n#ifndef LIO_SYS_ROOT\n#define LIO_SYS_ROOT \"/sys\"\n#endif\n#ifndef LIO_DEV_ROOT\n#define LIO_DEV_ROOT \"/dev\"\n#endif\n\nnamespace lio {\n\nenum {\n  e_no_error = 0, e_not_supported = 1, e_input = 2, e_not_found = 3, e_busy = 4, e_refused = 5,\n  e_io = 6, e_no_slot = 7\n};\nenum { k_none = 0, k_in = 1, k_out = 2, k_pwm = 3, k_value = 4, k_iio = 5 };\nenum { stop_off = 0, stop_on = 1, stop_hold = 2 };\nenum { bias_none = 0, bias_pull_up = 1, bias_pull_down = 2 };\nenum { drive_push_pull = 0, drive_open_drain = 1, drive_open_source = 2 };\n\nconst int max_slots = 64;\nconst int key_size = 520;\nconst int text_size = 128;\nconst long long ms = 1000000LL;\nconst long long release_after = 2000 * ms;\nconst long long retry_after = 500 * ms;\nconst long long min_stop_after = 100 * ms;\n\n// Text for ERRORTEXT, bounded.\nstruct text {\n  char buf[text_size];\n};\ninline void clear(text &t) { t.buf[0] = '\\0'; }\ninline void put(text &t, const char *s) {\n  size_t n = 0;\n  while (t.buf[n] != '\\0' && n + 1 < sizeof(t.buf)) ++n;\n  while (*s != '\\0' && n + 1 < sizeof(t.buf)) t.buf[n++] = *s++;\n  t.buf[n] = '\\0';\n}\ninline void put_num(text &t, long long v) {\n  char tmp[24];\n  int n = 0;\n  bool neg = v < 0;\n  unsigned long long u = neg ? 0ULL - static_cast<unsigned long long>(v) : static_cast<unsigned long long>(v);\n  do {\n    tmp[n++] = static_cast<char>('0' + u % 10);\n    u /= 10;\n  } while (u != 0 && n < 22);\n  char out[24];\n  int k = 0;\n  if (neg) out[k++] = '-';\n  while (n > 0) out[k++] = tmp[--n];\n  out[k] = '\\0';\n  put(t, out);\n}\ninline void copy_cstr(char *dst, size_t size, const char *src) {\n  size_t n = 0;\n  for (; src[n] != '\\0' && n + 1 < size; ++n) dst[n] = src[n];\n  dst[n] = '\\0';\n}\ninline bool same(const char *a, const char *b) {\n  for (; *a != '\\0' && *a == *b; ++a, ++b) {\n  }\n  return *a == *b;\n}\ninline bool starts_with(const char *s, const char *prefix) {\n  for (; *prefix != '\\0'; ++s, ++prefix)\n    if (*s != *prefix) return false;\n  return true;\n}\n\n// The first number in a text: optional sign, digits, optional fraction. False if there is none.\ninline bool first_number(const char *s, double &value) {\n  for (; *s != '\\0'; ++s) {\n    bool sign = (*s == '-' || *s == '+') && s[1] >= '0' && s[1] <= '9';\n    if (!sign && !(*s >= '0' && *s <= '9')) continue;\n    bool neg = *s == '-';\n    if (sign) ++s;\n    double v = 0;\n    for (; *s >= '0' && *s <= '9'; ++s) v = v * 10 + (*s - '0');\n    if (*s == '.' && s[1] >= '0' && s[1] <= '9') {\n      double f = 0.1;\n      for (++s; *s >= '0' && *s <= '9'; ++s, f /= 10) v += (*s - '0') * f;\n    }\n    value = neg ? -v : v;\n    return true;\n  }\n  return false;\n}\n\n// value = (raw + offset) x scale, the IIO rule.\ninline double iio_value(double raw, double offset, double scale) { return (raw + offset) * scale; }\n\n// An output is put in its stop state after max(100 ms, 5 x its call interval) without a call.\ninline long long stop_after(long long interval_ns) {\n  long long five = interval_ns * 5;\n  return five > min_stop_after ? five : min_stop_after;\n}\n\n// \"in_voltage0\" -> \"in_voltage\": the prefix of the device-wide scale and offset files.\ninline void channel_type(const char *channel, char *out, size_t size) {\n  copy_cstr(out, size, channel);\n  size_t n = 0;\n  while (out[n] != '\\0') ++n;\n  while (n > 0 && out[n - 1] >= '0' && out[n - 1] <= '9') out[--n] = '\\0';\n}\n\n#if defined(__linux__)\n\nstruct slot {\n  bool used;\n  int kind;\n  unsigned gen;  // matches the owning block's lio_gen\n  char key[key_size];   // pin, path, or IIO device and channel\n  unsigned long long cfg;  // packed settings; a change makes the block claim again\n  long long last_call;\n  long long interval;\n  bool stopped;\n  int stop;\n  // GPIO\n  int fd;\n  long long next_try;\n  int applied;  // last value set on an output, -1 unknown\n  // PWM\n  double freq;\n  double duty;\n  double applied_freq;\n  double applied_duty;\n  bool applied_on;\n  bool exported;\n  bool force_off;  // write the off state even if this slot never ran the channel\n  char pwm_dir[256];\n  // reads\n  long long period;\n  double scale;\n  double offset;\n  long long next_read;\n  double value;\n  long long raw;\n  bool valid;\n  // result for the block\n  int error;\n  char message[text_size];\n};\n\nstruct state {\n  slot slots[max_slots];\n  pthread_mutex_t lock;\n  pthread_t thread;\n  bool thread_started;\n  bool running;\n  volatile bool quit;\n  unsigned next_gen;\n};\n\ninline state &shared() {\n  static state s = [] {\n    state init{};\n    pthread_mutex_init(&init.lock, nullptr);\n    for (int i = 0; i < max_slots; ++i) init.slots[i].fd = -1;\n    return init;\n  }();\n  return s;\n}\n\ninline long long now_ns() {\n  timespec ts{};\n  clock_gettime(CLOCK_MONOTONIC, &ts);\n  return static_cast<long long>(ts.tv_sec) * 1000000000LL + ts.tv_nsec;\n}\n\ninline void set_error(slot &s, int error, const text &t) {\n  s.error = error;\n  copy_cstr(s.message, sizeof(s.message), error == e_no_error ? \"\" : t.buf);\n}\ninline void set_error(slot &s, int error, const char *subject, const char *what) {\n  text t;\n  clear(t);\n  put(t, subject);\n  put(t, \": \");\n  put(t, what);\n  set_error(s, error, t);\n}\ninline void set_errno(slot &s, int error, const char *subject, const char *what, int err) {\n  text t;\n  clear(t);\n  put(t, subject);\n  put(t, \": \");\n  put(t, what);\n  put(t, \" (\");\n  put(t, strerror(err));\n  put(t, \")\");\n  set_error(s, error, t);\n}\n\n// ---- files ----\n\ninline bool read_file(const char *path, char *buf, size_t size, int &err) {\n  int fd = open(path, O_RDONLY | O_CLOEXEC);\n  if (fd < 0) {\n    err = errno;\n    return false;\n  }\n  ssize_t n = read(fd, buf, size - 1);\n  err = errno;\n  close(fd);\n  if (n < 0) return false;\n  buf[n] = '\\0';\n  return true;\n}\ninline bool write_file(const char *path, const char *value, int &err) {\n  int fd = open(path, O_WRONLY | O_TRUNC | O_CLOEXEC);\n  if (fd < 0) {\n    err = errno;\n    return false;\n  }\n  size_t len = 0;\n  while (value[len] != '\\0') ++len;\n  ssize_t n = write(fd, value, len);\n  err = errno;\n  close(fd);\n  return n == static_cast<ssize_t>(len);\n}\ninline void trim(char *s) {\n  size_t n = 0;\n  while (s[n] != '\\0') ++n;\n  while (n > 0 && (s[n - 1] == '\\n' || s[n - 1] == ' ' || s[n - 1] == '\\r' || s[n - 1] == '\\t')) s[--n] = '\\0';\n}\ninline bool join(char *out, size_t size, const char *a, const char *b, const char *c = \"\") {\n  int n = snprintf(out, size, \"%s%s%s\", a, b, c);\n  return n > 0 && static_cast<size_t>(n) < size;\n}\n\n// ---- GPIO ----\n\ninline bool all_digits(const char *s) {\n  if (*s == '\\0') return false;\n  for (; *s != '\\0'; ++s)\n    if (*s < '0' || *s > '9') return false;\n  return true;\n}\n\n// Opens the chip named `chip` (device name such as gpiochip0, or its label); -1 if none.\ninline int open_chip(const char *chip) {\n  char path[PATH_MAX];\n  if (starts_with(chip, \"gpiochip\") && join(path, sizeof(path), LIO_DEV_ROOT \"/\", chip)) {\n    int fd = open(path, O_RDWR | O_CLOEXEC);\n    if (fd >= 0) return fd;\n  }\n  DIR *dir = opendir(LIO_DEV_ROOT);\n  if (!dir) return -1;\n  int found = -1;\n  while (dirent *e = readdir(dir)) {\n    if (!starts_with(e->d_name, \"gpiochip\") || !join(path, sizeof(path), LIO_DEV_ROOT \"/\", e->d_name)) continue;\n    int fd = open(path, O_RDWR | O_CLOEXEC);\n    if (fd < 0) continue;\n    gpiochip_info info{};\n    if (ioctl(fd, GPIO_GET_CHIPINFO_IOCTL, &info) == 0 && same(info.label, chip)) {\n      found = fd;\n      break;\n    }\n    close(fd);\n  }\n  closedir(dir);\n  return found;\n}\n\n// Finds a line by name on any chip; returns the open chip and sets `offset`, or -1.\ninline int find_line(const char *name, unsigned &offset, char *consumer, size_t consumer_size) {\n  DIR *dir = opendir(LIO_DEV_ROOT);\n  if (!dir) return -1;\n  int found = -1;\n  char path[PATH_MAX];\n  while (found < 0) {\n    dirent *e = readdir(dir);\n    if (!e) break;\n    if (!starts_with(e->d_name, \"gpiochip\") || !join(path, sizeof(path), LIO_DEV_ROOT \"/\", e->d_name)) continue;\n    int fd = open(path, O_RDWR | O_CLOEXEC);\n    if (fd < 0) continue;\n    gpiochip_info info{};\n    if (ioctl(fd, GPIO_GET_CHIPINFO_IOCTL, &info) == 0) {\n      for (unsigned i = 0; i < info.lines; ++i) {\n        gpio_v2_line_info li{};\n        li.offset = i;\n        if (ioctl(fd, GPIO_V2_GET_LINEINFO_IOCTL, &li) == 0 && same(li.name, name)) {\n          offset = i;\n          copy_cstr(consumer, consumer_size, li.consumer);\n          found = fd;\n          break;\n        }\n      }\n    }\n    if (found < 0) close(fd);\n  }\n  closedir(dir);\n  return found;\n}\n\n// Claims the line of slot `s` (pin in key) as input or output with the settings in cfg.\n// cfg: bits 0-1 bias, 2 active low, 3-4 drive, 5 output, 32-63 debounce in microseconds.\ninline void claim_line(slot &s, bool first_value) {\n  const char *pin = s.key;\n  unsigned offset = 0;\n  char consumer[32] = \"\";\n  int chip = -1;\n  const char *colon = nullptr;\n  for (const char *p = pin; *p != '\\0'; ++p)\n    if (*p == ':') colon = p;\n  if (colon) {\n    char name[key_size];\n    size_t n = static_cast<size_t>(colon - pin);\n    if (n >= sizeof(name) || !all_digits(colon + 1)) {\n      set_error(s, e_input, pin, \"PIN is a line name or <chip>:<offset>\");\n      return;\n    }\n    for (size_t i = 0; i < n; ++i) name[i] = pin[i];\n    name[n] = '\\0';\n    offset = static_cast<unsigned>(strtoul(colon + 1, nullptr, 10));\n    chip = open_chip(name);\n    if (chip >= 0) {\n      gpio_v2_line_info li{};\n      li.offset = offset;\n      if (ioctl(chip, GPIO_V2_GET_LINEINFO_IOCTL, &li) != 0) {\n        close(chip);\n        set_error(s, e_not_found, pin, \"the chip has no such line\");\n        return;\n      }\n      copy_cstr(consumer, sizeof(consumer), li.consumer);\n    }\n  } else if (*pin != '\\0') {\n    chip = find_line(pin, offset, consumer, sizeof(consumer));\n  }\n  if (chip < 0) {\n    set_error(s, e_not_found, *pin != '\\0' ? pin : \"PIN\", \"no such GPIO line\");\n    return;\n  }\n  gpio_v2_line_request req{};\n  req.offsets[0] = offset;\n  req.num_lines = 1;\n  copy_cstr(req.consumer, sizeof(req.consumer), \"openplc\");\n  unsigned long long cfg = s.cfg;\n  unsigned long long flags = (cfg & 0x20u) ? GPIO_V2_LINE_FLAG_OUTPUT : GPIO_V2_LINE_FLAG_INPUT;\n  if (cfg & 0x4u) flags |= GPIO_V2_LINE_FLAG_ACTIVE_LOW;\n  if (cfg & 0x20u) {\n    unsigned drive = static_cast<unsigned>((cfg >> 3) & 0x3u);\n    if (drive == drive_open_drain) flags |= GPIO_V2_LINE_FLAG_OPEN_DRAIN;\n    if (drive == drive_open_source) flags |= GPIO_V2_LINE_FLAG_OPEN_SOURCE;\n    req.config.attrs[0].attr.id = GPIO_V2_LINE_ATTR_ID_OUTPUT_VALUES;\n    req.config.attrs[0].attr.values = first_value ? 1u : 0u;\n    req.config.attrs[0].mask = 1u;\n    req.config.num_attrs = 1;\n  } else {\n    unsigned bias = static_cast<unsigned>(cfg & 0x3u);\n    if (bias == bias_pull_up) flags |= GPIO_V2_LINE_FLAG_BIAS_PULL_UP;\n    else if (bias == bias_pull_down) flags |= GPIO_V2_LINE_FLAG_BIAS_PULL_DOWN;\n    else flags |= GPIO_V2_LINE_FLAG_BIAS_DISABLED;\n    unsigned debounce_us = static_cast<unsigned>(cfg >> 32);\n    if (debounce_us != 0) {\n      req.config.attrs[0].attr.id = GPIO_V2_LINE_ATTR_ID_DEBOUNCE;\n      req.config.attrs[0].attr.debounce_period_us = debounce_us;\n      req.config.attrs[0].mask = 1u;\n      req.config.num_attrs = 1;\n    }\n  }\n  req.config.flags = flags;\n  int rc = ioctl(chip, GPIO_V2_GET_LINE_IOCTL, &req);\n  int err = errno;\n  close(chip);\n  if (rc != 0) {\n    if (err == EBUSY) {\n      text t;\n      clear(t);\n      put(t, pin);\n      put(t, \": in use\");\n      if (consumer[0] != '\\0') {\n        put(t, \" by \");\n        put(t, consumer);\n      }\n      set_error(s, e_busy, t);\n    } else {\n      set_errno(s, e_refused, pin, \"the chip refused the line settings\", err);\n    }\n    return;\n  }\n  s.fd = req.fd;\n  s.applied = (cfg & 0x20u) ? (first_value ? 1 : 0) : -1;\n  set_error(s, e_no_error, \"\", \"\");\n}\n\ninline bool line_get(int fd, bool &value) {\n  gpio_v2_line_values v{};\n  v.mask = 1u;\n  if (ioctl(fd, GPIO_V2_LINE_GET_VALUES_IOCTL, &v) != 0) return false;\n  value = (v.bits & 1u) != 0;\n  return true;\n}\ninline bool line_set(int fd, bool value) {\n  gpio_v2_line_values v{};\n  v.mask = 1u;\n  v.bits = value ? 1u : 0u;\n  return ioctl(fd, GPIO_V2_LINE_SET_VALUES_IOCTL, &v) == 0;\n}\n\n// ---- PWM (helper thread) ----\n\n// The sysfs directory of pwmchip `chip`: a number, pwmchipN, or the chip's device name.\ninline bool pwm_chip_dir(const char *chip, char *out, size_t size) {\n  const char *base = LIO_SYS_ROOT \"/class/pwm/\";\n  if (all_digits(chip)) return join(out, size, base, \"pwmchip\", chip) && access(out, F_OK) == 0;\n  if (starts_with(chip, \"pwmchip\")) return join(out, size, base, chip) && access(out, F_OK) == 0;\n  DIR *dir = opendir(LIO_SYS_ROOT \"/class/pwm\");\n  if (!dir) return false;\n  bool found = false;\n  char link[PATH_MAX];\n  char target[PATH_MAX];\n  while (!found) {\n    dirent *e = readdir(dir);\n    if (!e) break;\n    if (!starts_with(e->d_name, \"pwmchip\") || !join(link, sizeof(link), base, e->d_name, \"/device\")) continue;\n    ssize_t n = readlink(link, target, sizeof(target) - 1);\n    if (n <= 0) continue;\n    target[n] = '\\0';\n    const char *name = target;\n    for (const char *p = target; *p != '\\0'; ++p)\n      if (*p == '/') name = p + 1;\n    if (same(name, chip)) found = join(out, size, base, e->d_name);\n  }\n  closedir(dir);\n  return found;\n}\n\ninline bool pwm_write(slot &s, const char *file, long long v, const char *subject) {\n  char path[PATH_MAX];\n  char num[24];\n  snprintf(num, sizeof(num), \"%lld\", v);\n  int err = 0;\n  if (!join(path, sizeof(path), s.pwm_dir, \"/\", file) || !write_file(path, num, err)) {\n    text t;\n    clear(t);\n    put(t, \"cannot write \");\n    put(t, file);\n    set_errno(s, e_io, subject, t.buf, err);\n    return false;\n  }\n  return true;\n}\n\n// Applies duty/frequency, or turns the channel off (on = false). Called without the lock held,\n// on a copy of the slot.\ninline void pwm_apply(slot &s, bool on) {\n  const char *subject = \"PWM\";\n  if (!s.exported) {\n    char chip_dir[PATH_MAX];\n    const char *colon = nullptr;\n    for (const char *p = s.key; *p != '\\0'; ++p)\n      if (*p == ':') colon = p;\n    char chip[key_size];\n    size_t n = colon ? static_cast<size_t>(colon - s.key) : 0;\n    for (size_t i = 0; i < n && i + 1 < sizeof(chip); ++i) chip[i] = s.key[i];\n    chip[n < sizeof(chip) ? n : sizeof(chip) - 1] = '\\0';\n    const char *channel = colon ? colon + 1 : \"0\";\n    if (!pwm_chip_dir(chip, chip_dir, sizeof(chip_dir))) {\n      set_error(s, e_not_found, chip[0] != '\\0' ? chip : \"CHIP\", \"no such PWM chip\");\n      return;\n    }\n    if (!join(s.pwm_dir, sizeof(s.pwm_dir), chip_dir, \"/pwm\", channel)) return;\n    if (access(s.pwm_dir, F_OK) != 0) {\n      char path[PATH_MAX];\n      int err = 0;\n      if (!join(path, sizeof(path), chip_dir, \"/export\") || (!write_file(path, channel, err) && err != EBUSY)) {\n        set_errno(s, err == EINVAL || err == ENODEV ? e_not_found : e_io, chip, \"cannot export the channel\", err);\n        return;\n      }\n    }\n    s.exported = true;\n    s.applied_on = false;\n    s.applied_freq = -1;\n    s.applied_duty = -1;\n  }\n  if (!on) {\n    if (s.applied_on || s.force_off) {\n      pwm_write(s, \"duty_cycle\", 0, subject);\n      pwm_write(s, \"enable\", 0, subject);\n    }\n    s.applied_on = false;\n    return;\n  }\n  if (s.applied_on && s.applied_freq == s.freq && s.applied_duty == s.duty) return;\n  long long period = static_cast<long long>(1e9 / s.freq + 0.5);\n  long long duty = static_cast<long long>(static_cast<double>(period) * s.duty / 100.0 + 0.5);\n  if (period <= 0) {\n    set_error(s, e_input, subject, \"FREQUENCY is too high\");\n    return;\n  }\n  // duty_cycle must stay at or below period while both change.\n  if (!pwm_write(s, \"duty_cycle\", 0, subject) || !pwm_write(s, \"period\", period, subject) ||\n      !pwm_write(s, \"duty_cycle\", duty, subject) || (!s.applied_on && !pwm_write(s, \"enable\", 1, subject)))\n    return;\n  s.applied_on = true;\n  s.applied_freq = s.freq;\n  s.applied_duty = s.duty;\n  set_error(s, e_no_error, \"\", \"\");\n}\n\ninline void pwm_unexport(slot &s) {\n  if (!s.exported) return;\n  char chip_dir[PATH_MAX];\n  copy_cstr(chip_dir, sizeof(chip_dir), s.pwm_dir);\n  size_t n = 0;\n  while (chip_dir[n] != '\\0') ++n;\n  while (n > 0 && chip_dir[n - 1] != '/') --n;\n  const char *channel = s.pwm_dir + n + 3;  // after \"pwm\"\n  if (n > 0) chip_dir[n - 1] = '\\0';\n  char path[PATH_MAX];\n  int err = 0;\n  if (join(path, sizeof(path), chip_dir, \"/unexport\")) write_file(path, channel, err);\n  s.exported = false;\n}\n\n// ---- reads (helper thread) ----\n\ninline void read_value(slot &s, double scale, double offset) {\n  char real[PATH_MAX];\n  const char *root = LIO_SYS_ROOT \"/\";\n  if (!starts_with(s.key, root) || !realpath(s.key, real) || !starts_with(real, root)) {\n    bool outside = !starts_with(s.key, root);\n    if (outside) set_error(s, e_input, s.key[0] != '\\0' ? s.key : \"PATH\", \"PATH must be a file under \" LIO_SYS_ROOT \"/\");\n    else set_errno(s, e_not_found, s.key, \"cannot open\", errno);\n    s.valid = false;\n    return;\n  }\n  char buf[256];\n  int err = 0;\n  double v = 0;\n  if (!read_file(real, buf, sizeof(buf), err)) {\n    set_errno(s, e_io, s.key, \"cannot read\", err);\n    s.valid = false;\n    return;\n  }\n  if (!first_number(buf, v)) {\n    set_error(s, e_io, s.key, \"the file holds no number\");\n    s.valid = false;\n    return;\n  }\n  s.raw = static_cast<long long>(v);\n  s.value = v * scale + offset;\n  s.valid = true;\n  set_error(s, e_no_error, \"\", \"\");\n}\n\ninline bool read_number(const char *dir, const char *file, double &v) {\n  char path[PATH_MAX];\n  char buf[128];\n  int err = 0;\n  return join(path, sizeof(path), dir, \"/\", file) && read_file(path, buf, sizeof(buf), err) && first_number(buf, v);\n}\n\n// key = \"<device>\\n<channel>\"\ninline void read_iio(slot &s) {\n  char device[key_size];\n  copy_cstr(device, sizeof(device), s.key);\n  char *channel = device;\n  while (*channel != '\\0' && *channel != '\\n') ++channel;\n  if (*channel == '\\n') *channel++ = '\\0';\n  s.valid = false;\n  if (device[0] == '\\0' || channel[0] == '\\0') {\n    set_error(s, e_input, \"IIO\", \"DEVICE and CHANNEL are required\");\n    return;\n  }\n  const char *base = LIO_SYS_ROOT \"/bus/iio/devices\";\n  DIR *dir = opendir(base);\n  char found[PATH_MAX] = \"\";\n  if (dir) {\n    char path[PATH_MAX];\n    char name[128];\n    int err = 0;\n    while (dirent *e = readdir(dir)) {\n      if (e->d_name[0] == '.' || !join(path, sizeof(path), base, \"/\", e->d_name)) continue;\n      char name_path[PATH_MAX];\n      if (!join(name_path, sizeof(name_path), path, \"/name\") || !read_file(name_path, name, sizeof(name), err)) continue;\n      trim(name);\n      if (same(name, device)) {\n        copy_cstr(found, sizeof(found), path);\n        break;\n      }\n    }\n    closedir(dir);\n  }\n  if (found[0] == '\\0') {\n    set_error(s, e_not_found, device, \"no such IIO device\");\n    return;\n  }\n  char file[key_size + 16];\n  double raw = 0;\n  snprintf(file, sizeof(file), \"%s_raw\", channel);\n  if (!read_number(found, file, raw)) {\n    set_error(s, e_not_found, device, \"the channel has no readable _raw file\");\n    return;\n  }\n  char type[key_size];\n  channel_type(channel, type, sizeof(type));\n  double scale = 1;\n  double offset = 0;\n  snprintf(file, sizeof(file), \"%s_scale\", channel);\n  if (!read_number(found, file, scale)) {\n    snprintf(file, sizeof(file), \"%s_scale\", type);\n    if (!read_number(found, file, scale)) scale = 1;\n  }\n  snprintf(file, sizeof(file), \"%s_offset\", channel);\n  if (!read_number(found, file, offset)) {\n    snprintf(file, sizeof(file), \"%s_offset\", type);\n    if (!read_number(found, file, offset)) offset = 0;\n  }\n  s.raw = static_cast<long long>(raw);\n  s.value = iio_value(raw, offset, scale);\n  s.valid = true;\n  set_error(s, e_no_error, \"\", \"\");\n}\n\n// ---- helper thread ----\n\n// Puts an output in its stop state. Lock held; GPIO writes are a single ioctl.\ninline void stop_gpio(slot &s) {\n  if (s.fd >= 0 && s.stop != stop_hold) {\n    bool v = s.stop == stop_on;\n    if (line_set(s.fd, v)) s.applied = v ? 1 : 0;\n  }\n}\n\n// Frees a slot; for PWM the caller has already turned it off or kept it (hold).\ninline void free_slot(slot &s) {\n  if (s.fd >= 0) close(s.fd);\n  slot fresh{};\n  fresh.fd = -1;\n  s = fresh;\n}\n\n// True if another used PWM slot drives the same channel (a block enabled again meanwhile).\ninline bool pwm_shared(state &st, int self, const char *key) {\n  pthread_mutex_lock(&st.lock);\n  bool found = false;\n  for (int i = 0; i < max_slots && !found; ++i)\n    found = i != self && st.slots[i].used && st.slots[i].kind == k_pwm && same(st.slots[i].key, key);\n  pthread_mutex_unlock(&st.lock);\n  return found;\n}\n\ninline void *helper(void *) {\n  state &st = shared();\n  for (;;) {\n    timespec tick = {0, 10 * ms};\n    nanosleep(&tick, nullptr);\n    if (st.quit) break;\n    long long now = now_ns();\n    bool any = false;\n    for (int i = 0; i < max_slots; ++i) {\n      pthread_mutex_lock(&st.lock);\n      slot &live = st.slots[i];\n      if (!live.used) {\n        pthread_mutex_unlock(&st.lock);\n        continue;\n      }\n      any = true;\n      long long idle = now - live.last_call;\n      bool timed_out = idle > stop_after(live.interval);\n      int kind = live.kind;\n      if (kind == k_out) {\n        if (timed_out && !live.stopped) {\n          stop_gpio(live);\n          live.stopped = true;\n        }\n        if (idle > release_after) free_slot(live);\n        pthread_mutex_unlock(&st.lock);\n        continue;\n      }\n      if (kind == k_in) {\n        if (idle > release_after) free_slot(live);\n        pthread_mutex_unlock(&st.lock);\n        continue;\n      }\n      if (timed_out && !live.stopped) live.stopped = true;\n      slot work = live;  // slow work on a copy, outside the lock\n      pthread_mutex_unlock(&st.lock);\n\n      bool release = idle > release_after;\n      bool changed = false;\n      if (kind == k_pwm) {\n        bool on = !work.stopped && !release;\n        if (on || work.stop != stop_hold) {\n          pwm_apply(work, on);\n          changed = true;\n        }\n        if (release && work.stop != stop_hold && !pwm_shared(st, i, work.key)) pwm_unexport(work);\n      } else if ((kind == k_value || kind == k_iio) && !work.stopped && now >= work.next_read) {\n        if (kind == k_value) read_value(work, work.scale, work.offset);\n        else read_iio(work);\n        work.next_read = now + work.period;\n        changed = true;\n      }\n\n      pthread_mutex_lock(&st.lock);\n      slot &back = st.slots[i];\n      if (back.used && back.kind == kind && same(back.key, work.key)) {\n        if (release) {\n          free_slot(back);\n        } else if (changed) {\n          back.exported = work.exported;\n          copy_cstr(back.pwm_dir, sizeof(back.pwm_dir), work.pwm_dir);\n          back.applied_on = work.applied_on;\n          back.applied_freq = work.applied_freq;\n          back.applied_duty = work.applied_duty;\n          back.value = work.value;\n          back.raw = work.raw;\n          back.valid = work.valid;\n          back.next_read = work.next_read;\n          back.error = work.error;\n          copy_cstr(back.message, sizeof(back.message), work.message);\n        }\n      }\n      pthread_mutex_unlock(&st.lock);\n    }\n    if (!any) {\n      pthread_mutex_lock(&st.lock);\n      bool still_none = true;\n      for (int i = 0; i < max_slots; ++i) still_none = still_none && !st.slots[i].used;\n      if (still_none) st.running = false;\n      pthread_mutex_unlock(&st.lock);\n      if (still_none) break;\n    }\n  }\n  return nullptr;\n}\n\n// Lock held. Starts the helper thread with normal scheduling, not the scan thread's.\ninline void ensure_helper(state &st) {\n  if (st.running) return;\n  if (st.thread_started) pthread_join(st.thread, nullptr);\n  st.thread_started = false;\n  pthread_attr_t attr;\n  if (pthread_attr_init(&attr) != 0) return;\n  sched_param param{};\n  param.sched_priority = 0;\n  pthread_attr_setinheritsched(&attr, PTHREAD_EXPLICIT_SCHED);\n  pthread_attr_setschedpolicy(&attr, SCHED_OTHER);\n  pthread_attr_setschedparam(&attr, &param);\n  st.quit = false;\n  if (pthread_create(&st.thread, &attr, helper, nullptr) == 0) {\n    st.thread_started = true;\n    st.running = true;\n  }\n  pthread_attr_destroy(&attr);\n}\n\n// Stops the helper and frees every slot when the program library is unloaded.\nstruct unload_guard {\n  ~unload_guard() {\n    state &st = shared();\n    st.quit = true;\n    if (st.thread_started) pthread_join(st.thread, nullptr);\n    st.thread_started = false;\n    st.running = false;\n    for (int i = 0; i < max_slots; ++i) {\n      slot &s = st.slots[i];\n      if (!s.used) continue;\n      if (s.kind == k_out && !s.stopped) stop_gpio(s);\n      if (s.kind == k_pwm && s.stop != stop_hold) {\n        pwm_apply(s, false);\n        pwm_unexport(s);\n      }\n      free_slot(s);\n    }\n  }\n};\ninline unload_guard &guard() {\n  static unload_guard g;\n  return g;\n}\n\n// One call of a block: finds or makes its slot (index + 1 in `id`), records the call and returns\n// the slot with the lock held, or nullptr (no slot free; the lock is not held then).\ninline slot *enter(unsigned short &id, unsigned &gen, int kind, const char *key, unsigned long long cfg) {\n  state &st = shared();\n  (void)guard();\n  long long now = now_ns();\n  pthread_mutex_lock(&st.lock);\n  slot *s = nullptr;\n  if (id >= 1 && id <= max_slots && st.slots[id - 1].used && st.slots[id - 1].kind == kind &&\n      st.slots[id - 1].gen == gen)\n    s = &st.slots[id - 1];\n  if (!s) {\n    for (int i = 0; i < max_slots && !s; ++i) {\n      if (!st.slots[i].used) {\n        s = &st.slots[i];\n        slot fresh{};\n        fresh.fd = -1;\n        fresh.used = true;\n        fresh.kind = kind;\n        fresh.applied = -1;\n        fresh.last_call = now;\n        fresh.gen = ++st.next_gen == 0 ? ++st.next_gen : st.next_gen;\n        *s = fresh;\n        id = static_cast<unsigned short>(i + 1);\n        gen = fresh.gen;\n      }\n    }\n  }\n  if (!s) {\n    pthread_mutex_unlock(&st.lock);\n    id = 0;\n    gen = 0;\n    return nullptr;\n  }\n  if (!same(s->key, key) || s->cfg != cfg) {\n    // A new pin or new settings: claim again.\n    if (s->fd >= 0) close(s->fd);\n    s->fd = -1;\n    s->next_try = 0;\n    s->applied = -1;\n    s->exported = false;\n    s->valid = false;\n    s->next_read = 0;\n    s->error = e_no_error;\n    s->message[0] = '\\0';\n    copy_cstr(s->key, sizeof(s->key), key);\n    s->cfg = cfg;\n  }\n  long long d = now - s->last_call;\n  if (d > 0 && d < 10000 * ms) s->interval = s->interval > 0 ? (s->interval * 7 + d) / 8 : d;\n  s->last_call = now;\n  s->stopped = false;\n  ensure_helper(st);\n  return s;\n}\ninline void leave() { pthread_mutex_unlock(&shared().lock); }\n\n// ENABLE went FALSE: outputs to their stop state, then the slot is freed (PWM by the helper).\ninline void disable(unsigned short &id, unsigned &gen, int kind) {\n  if (id == 0) return;\n  state &st = shared();\n  pthread_mutex_lock(&st.lock);\n  if (id <= max_slots && st.slots[id - 1].used && st.slots[id - 1].kind == kind && st.slots[id - 1].gen == gen) {\n    slot &s = st.slots[id - 1];\n    if (kind == k_pwm) {\n      s.last_call = 0;  // the helper turns it off (or keeps it, hold) and frees it\n      s.stopped = true;\n      s.interval = 0;\n      s.gen = 0;  // no block owns it any more\n    } else {\n      if (kind == k_out) stop_gpio(s);\n      free_slot(s);\n    }\n  }\n  pthread_mutex_unlock(&st.lock);\n  id = 0;\n  gen = 0;\n}\n\n// PWM with ENABLE FALSE: turns the channel off whatever ON_STOP says, also one a block left running\n// (LIO_STOP_HOLD) before. Runs once per disable; id = pwm_done marks it done until the block runs again.\nconst unsigned short pwm_done = 0xFFFF;\ninline void pwm_off(unsigned short &id, unsigned &gen, const char *key) {\n  if (id == pwm_done) return;\n  state &st = shared();\n  (void)guard();\n  pthread_mutex_lock(&st.lock);\n  slot *s = nullptr;\n  if (id >= 1 && id <= max_slots && st.slots[id - 1].used && st.slots[id - 1].kind == k_pwm &&\n      st.slots[id - 1].gen == gen)\n    s = &st.slots[id - 1];\n  for (int i = 0; i < max_slots && !s; ++i)\n    if (st.slots[i].used && st.slots[i].kind == k_pwm && st.slots[i].gen == 0 && same(st.slots[i].key, key))\n      s = &st.slots[i];\n  bool other = false;\n  for (int i = 0; i < max_slots && !s && !other; ++i)\n    other = st.slots[i].used && st.slots[i].kind == k_pwm && same(st.slots[i].key, key);\n  for (int i = 0; i < max_slots && !s && !other; ++i) {\n    if (!st.slots[i].used) {\n      s = &st.slots[i];\n      slot fresh{};\n      fresh.fd = -1;\n      fresh.used = true;\n      fresh.kind = k_pwm;\n      fresh.applied = -1;\n      copy_cstr(fresh.key, sizeof(fresh.key), key);\n      *s = fresh;\n    }\n  }\n  if (s) {\n    s->stop = stop_off;\n    s->force_off = true;\n    s->last_call = 0;  // the helper turns it off, unexports it and frees the slot\n    s->stopped = true;\n    s->interval = 0;\n    s->gen = 0;\n    ensure_helper(st);\n  }\n  pthread_mutex_unlock(&st.lock);\n  id = pwm_done;\n  gen = 0;\n}\n\n#endif  // __linux__\n\n}  // namespace lio\n\n#pragma pop_macro(\"ENABLE\")\n#pragma pop_macro(\"PIN\")\n#pragma pop_macro(\"BIAS\")\n#pragma pop_macro(\"ACTIVE_LOW\")\n#pragma pop_macro(\"DEBOUNCE\")\n#pragma pop_macro(\"Q\")\n#pragma pop_macro(\"VALUE\")\n#pragma pop_macro(\"DRIVE\")\n#pragma pop_macro(\"ON_STOP\")\n#pragma pop_macro(\"CHIP\")\n#pragma pop_macro(\"CHANNEL\")\n#pragma pop_macro(\"FREQUENCY\")\n#pragma pop_macro(\"DUTY\")\n#pragma pop_macro(\"PATH\")\n#pragma pop_macro(\"SCALE\")\n#pragma pop_macro(\"OFFSET\")\n#pragma pop_macro(\"PERIOD\")\n#pragma pop_macro(\"RAW\")\n#pragma pop_macro(\"DEVICE\")\n#pragma pop_macro(\"VALID\")\n#pragma pop_macro(\"ERROR\")\n#pragma pop_macro(\"ERRORTEXT\")\n#pragma pop_macro(\"lio_slot\")\n#pragma pop_macro(\"lio_gen\")\n#endif  // LINUX_IO_SHARED_INCLUDED\nvoid setup() {\n}\n\nvoid loop() {\n#if defined(__linux__)\n  if (!ENABLE) {\n    unsigned short l_id = lio_slot;\n    unsigned l_gen = lio_gen;\n    lio::disable(l_id, l_gen, lio::k_value);\n    lio_slot = 0;\n    lio_gen = 0;\n    VALID = false;\n    ERROR = 0;\n    if (lio_last != 0) ERRORTEXT = \"\";\n    lio_last = 0;\n    return;\n  }\n  char l_key[lio::key_size];\n  lio::copy_cstr(l_key, sizeof(l_key), PATH.c_str());\n  long long l_period = PERIOD;\n  if (l_period < 10 * lio::ms) l_period = 10 * lio::ms;\n  unsigned short l_id = lio_slot;\n  unsigned l_gen = lio_gen;\n  lio::slot *l_s = lio::enter(l_id, l_gen, lio::k_value, l_key, 0);\n  lio_slot = l_id;\n  lio_gen = l_gen;\n  bool l_valid = false;\n  double l_value = 0;\n  long long l_raw = 0;\n  int l_err = lio::e_no_slot;\n  lio::text l_msg;\n  lio::clear(l_msg);\n  lio::put(l_msg, \"more than 64 linux_io blocks\");\n  if (l_s) {\n    l_s->period = l_period;\n    double l_scale = SCALE;\n    double l_offset = OFFSET;\n    l_s->scale = l_scale;\n    l_s->offset = l_offset;\n    l_valid = l_s->valid;\n    l_value = l_s->value;\n    l_raw = l_s->raw;\n    l_err = l_s->error;\n    lio::clear(l_msg);\n    lio::put(l_msg, l_s->message);\n    lio::leave();\n  }\n  VALID = l_valid;\n  if (l_valid) {\n    VALUE = static_cast<float>(l_value);\n    RAW = l_raw;\n  }\n  ERROR = static_cast<uint8_t>(l_err);\n  if (l_err != 0 || lio_last != 0) ERRORTEXT = l_msg.buf;\n  lio_last = static_cast<uint8_t>(l_err);\n#else\n\n  VALID = false;\n  ERROR = 1;\n  ERRORTEXT = \"not supported on this target\";\n#endif\n}\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "IIO_READ.cpp",
      "source": "(* Reads a channel of a Linux IIO device (ADCs and other sensors with a kernel driver) every PERIOD, outside the PLC scan. DEVICE is the device's name as the driver gives it, CHANNEL the channel's file prefix (such as 'in_voltage0'). RAW is the channel's raw value and VALUE = (RAW + offset) x scale with the driver's offset and scale, in the driver's unit (such as mV). VALID is FALSE until the first reading after a start, and on an error, when VALUE and RAW keep the last good reading.\nExample: adc(ENABLE := TRUE, DEVICE := 'adc_name', CHANNEL := 'in_voltage0'); millivolts := adc.VALUE; *)\nFUNCTION_BLOCK IIO_READ\nVAR_INPUT\n  ENABLE : BOOL;\n  DEVICE : STRING;\n  CHANNEL : STRING;\n  PERIOD : TIME := T#1s;\nEND_VAR\nVAR_OUTPUT\n  VALID : BOOL;\n  ERROR : USINT;\n  ERRORTEXT : STRING;\n  VALUE : REAL;\n  RAW : DINT;\nEND_VAR\nVAR\n  lio_slot : UINT;\n  lio_gen : UDINT;\n  lio_last : USINT;\nEND_VAR\n// SPDX-License-Identifier: Apache-2.0\n//\n// Shared code of the linux_io function blocks. The generator copies it into every block's source,\n// because the editor grafts each library C++ block into one c_blocks_code.cpp and has no other\n// place for shared code; the include guard keeps one copy per program.\n//\n// The editor binds every pin and local of a block to a #define of its name before this code, so\n// the system headers are included with those names pushed and undefined, and this code names\n// nothing in upper case.\n//\n// Linux only: GPIO through the character device (uAPI v2), PWM and values through sysfs. A helper\n// thread (normal scheduling) does the slow reads and the PWM writes, puts outputs in their stop\n// state when their block is no longer called, and releases what a block has not used for 2 s.\n#ifndef LINUX_IO_SHARED_INCLUDED\n#define LINUX_IO_SHARED_INCLUDED\n\n#pragma push_macro(\"ENABLE\")\n#pragma push_macro(\"PIN\")\n#pragma push_macro(\"BIAS\")\n#pragma push_macro(\"ACTIVE_LOW\")\n#pragma push_macro(\"DEBOUNCE\")\n#pragma push_macro(\"Q\")\n#pragma push_macro(\"VALUE\")\n#pragma push_macro(\"DRIVE\")\n#pragma push_macro(\"ON_STOP\")\n#pragma push_macro(\"CHIP\")\n#pragma push_macro(\"CHANNEL\")\n#pragma push_macro(\"FREQUENCY\")\n#pragma push_macro(\"DUTY\")\n#pragma push_macro(\"PATH\")\n#pragma push_macro(\"SCALE\")\n#pragma push_macro(\"OFFSET\")\n#pragma push_macro(\"PERIOD\")\n#pragma push_macro(\"RAW\")\n#pragma push_macro(\"DEVICE\")\n#pragma push_macro(\"VALID\")\n#pragma push_macro(\"ERROR\")\n#pragma push_macro(\"ERRORTEXT\")\n#pragma push_macro(\"lio_slot\")\n#pragma push_macro(\"lio_gen\")\n#undef ENABLE\n#undef PIN\n#undef BIAS\n#undef ACTIVE_LOW\n#undef DEBOUNCE\n#undef Q\n#undef VALUE\n#undef DRIVE\n#undef ON_STOP\n#undef CHIP\n#undef CHANNEL\n#undef FREQUENCY\n#undef DUTY\n#undef PATH\n#undef SCALE\n#undef OFFSET\n#undef PERIOD\n#undef RAW\n#undef DEVICE\n#undef VALID\n#undef ERROR\n#undef ERRORTEXT\n#undef lio_slot\n#undef lio_gen\n\n#if defined(__linux__)\n#include <dirent.h>\n#include <errno.h>\n#include <fcntl.h>\n#include <limits.h>\n#include <linux/gpio.h>\n#include <pthread.h>\n#include <sched.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <sys/ioctl.h>\n#include <time.h>\n#include <unistd.h>\n#endif\n\n#ifndef LIO_SYS_ROOT\n#define LIO_SYS_ROOT \"/sys\"\n#endif\n#ifndef LIO_DEV_ROOT\n#define LIO_DEV_ROOT \"/dev\"\n#endif\n\nnamespace lio {\n\nenum {\n  e_no_error = 0, e_not_supported = 1, e_input = 2, e_not_found = 3, e_busy = 4, e_refused = 5,\n  e_io = 6, e_no_slot = 7\n};\nenum { k_none = 0, k_in = 1, k_out = 2, k_pwm = 3, k_value = 4, k_iio = 5 };\nenum { stop_off = 0, stop_on = 1, stop_hold = 2 };\nenum { bias_none = 0, bias_pull_up = 1, bias_pull_down = 2 };\nenum { drive_push_pull = 0, drive_open_drain = 1, drive_open_source = 2 };\n\nconst int max_slots = 64;\nconst int key_size = 520;\nconst int text_size = 128;\nconst long long ms = 1000000LL;\nconst long long release_after = 2000 * ms;\nconst long long retry_after = 500 * ms;\nconst long long min_stop_after = 100 * ms;\n\n// Text for ERRORTEXT, bounded.\nstruct text {\n  char buf[text_size];\n};\ninline void clear(text &t) { t.buf[0] = '\\0'; }\ninline void put(text &t, const char *s) {\n  size_t n = 0;\n  while (t.buf[n] != '\\0' && n + 1 < sizeof(t.buf)) ++n;\n  while (*s != '\\0' && n + 1 < sizeof(t.buf)) t.buf[n++] = *s++;\n  t.buf[n] = '\\0';\n}\ninline void put_num(text &t, long long v) {\n  char tmp[24];\n  int n = 0;\n  bool neg = v < 0;\n  unsigned long long u = neg ? 0ULL - static_cast<unsigned long long>(v) : static_cast<unsigned long long>(v);\n  do {\n    tmp[n++] = static_cast<char>('0' + u % 10);\n    u /= 10;\n  } while (u != 0 && n < 22);\n  char out[24];\n  int k = 0;\n  if (neg) out[k++] = '-';\n  while (n > 0) out[k++] = tmp[--n];\n  out[k] = '\\0';\n  put(t, out);\n}\ninline void copy_cstr(char *dst, size_t size, const char *src) {\n  size_t n = 0;\n  for (; src[n] != '\\0' && n + 1 < size; ++n) dst[n] = src[n];\n  dst[n] = '\\0';\n}\ninline bool same(const char *a, const char *b) {\n  for (; *a != '\\0' && *a == *b; ++a, ++b) {\n  }\n  return *a == *b;\n}\ninline bool starts_with(const char *s, const char *prefix) {\n  for (; *prefix != '\\0'; ++s, ++prefix)\n    if (*s != *prefix) return false;\n  return true;\n}\n\n// The first number in a text: optional sign, digits, optional fraction. False if there is none.\ninline bool first_number(const char *s, double &value) {\n  for (; *s != '\\0'; ++s) {\n    bool sign = (*s == '-' || *s == '+') && s[1] >= '0' && s[1] <= '9';\n    if (!sign && !(*s >= '0' && *s <= '9')) continue;\n    bool neg = *s == '-';\n    if (sign) ++s;\n    double v = 0;\n    for (; *s >= '0' && *s <= '9'; ++s) v = v * 10 + (*s - '0');\n    if (*s == '.' && s[1] >= '0' && s[1] <= '9') {\n      double f = 0.1;\n      for (++s; *s >= '0' && *s <= '9'; ++s, f /= 10) v += (*s - '0') * f;\n    }\n    value = neg ? -v : v;\n    return true;\n  }\n  return false;\n}\n\n// value = (raw + offset) x scale, the IIO rule.\ninline double iio_value(double raw, double offset, double scale) { return (raw + offset) * scale; }\n\n// An output is put in its stop state after max(100 ms, 5 x its call interval) without a call.\ninline long long stop_after(long long interval_ns) {\n  long long five = interval_ns * 5;\n  return five > min_stop_after ? five : min_stop_after;\n}\n\n// \"in_voltage0\" -> \"in_voltage\": the prefix of the device-wide scale and offset files.\ninline void channel_type(const char *channel, char *out, size_t size) {\n  copy_cstr(out, size, channel);\n  size_t n = 0;\n  while (out[n] != '\\0') ++n;\n  while (n > 0 && out[n - 1] >= '0' && out[n - 1] <= '9') out[--n] = '\\0';\n}\n\n#if defined(__linux__)\n\nstruct slot {\n  bool used;\n  int kind;\n  unsigned gen;  // matches the owning block's lio_gen\n  char key[key_size];   // pin, path, or IIO device and channel\n  unsigned long long cfg;  // packed settings; a change makes the block claim again\n  long long last_call;\n  long long interval;\n  bool stopped;\n  int stop;\n  // GPIO\n  int fd;\n  long long next_try;\n  int applied;  // last value set on an output, -1 unknown\n  // PWM\n  double freq;\n  double duty;\n  double applied_freq;\n  double applied_duty;\n  bool applied_on;\n  bool exported;\n  bool force_off;  // write the off state even if this slot never ran the channel\n  char pwm_dir[256];\n  // reads\n  long long period;\n  double scale;\n  double offset;\n  long long next_read;\n  double value;\n  long long raw;\n  bool valid;\n  // result for the block\n  int error;\n  char message[text_size];\n};\n\nstruct state {\n  slot slots[max_slots];\n  pthread_mutex_t lock;\n  pthread_t thread;\n  bool thread_started;\n  bool running;\n  volatile bool quit;\n  unsigned next_gen;\n};\n\ninline state &shared() {\n  static state s = [] {\n    state init{};\n    pthread_mutex_init(&init.lock, nullptr);\n    for (int i = 0; i < max_slots; ++i) init.slots[i].fd = -1;\n    return init;\n  }();\n  return s;\n}\n\ninline long long now_ns() {\n  timespec ts{};\n  clock_gettime(CLOCK_MONOTONIC, &ts);\n  return static_cast<long long>(ts.tv_sec) * 1000000000LL + ts.tv_nsec;\n}\n\ninline void set_error(slot &s, int error, const text &t) {\n  s.error = error;\n  copy_cstr(s.message, sizeof(s.message), error == e_no_error ? \"\" : t.buf);\n}\ninline void set_error(slot &s, int error, const char *subject, const char *what) {\n  text t;\n  clear(t);\n  put(t, subject);\n  put(t, \": \");\n  put(t, what);\n  set_error(s, error, t);\n}\ninline void set_errno(slot &s, int error, const char *subject, const char *what, int err) {\n  text t;\n  clear(t);\n  put(t, subject);\n  put(t, \": \");\n  put(t, what);\n  put(t, \" (\");\n  put(t, strerror(err));\n  put(t, \")\");\n  set_error(s, error, t);\n}\n\n// ---- files ----\n\ninline bool read_file(const char *path, char *buf, size_t size, int &err) {\n  int fd = open(path, O_RDONLY | O_CLOEXEC);\n  if (fd < 0) {\n    err = errno;\n    return false;\n  }\n  ssize_t n = read(fd, buf, size - 1);\n  err = errno;\n  close(fd);\n  if (n < 0) return false;\n  buf[n] = '\\0';\n  return true;\n}\ninline bool write_file(const char *path, const char *value, int &err) {\n  int fd = open(path, O_WRONLY | O_TRUNC | O_CLOEXEC);\n  if (fd < 0) {\n    err = errno;\n    return false;\n  }\n  size_t len = 0;\n  while (value[len] != '\\0') ++len;\n  ssize_t n = write(fd, value, len);\n  err = errno;\n  close(fd);\n  return n == static_cast<ssize_t>(len);\n}\ninline void trim(char *s) {\n  size_t n = 0;\n  while (s[n] != '\\0') ++n;\n  while (n > 0 && (s[n - 1] == '\\n' || s[n - 1] == ' ' || s[n - 1] == '\\r' || s[n - 1] == '\\t')) s[--n] = '\\0';\n}\ninline bool join(char *out, size_t size, const char *a, const char *b, const char *c = \"\") {\n  int n = snprintf(out, size, \"%s%s%s\", a, b, c);\n  return n > 0 && static_cast<size_t>(n) < size;\n}\n\n// ---- GPIO ----\n\ninline bool all_digits(const char *s) {\n  if (*s == '\\0') return false;\n  for (; *s != '\\0'; ++s)\n    if (*s < '0' || *s > '9') return false;\n  return true;\n}\n\n// Opens the chip named `chip` (device name such as gpiochip0, or its label); -1 if none.\ninline int open_chip(const char *chip) {\n  char path[PATH_MAX];\n  if (starts_with(chip, \"gpiochip\") && join(path, sizeof(path), LIO_DEV_ROOT \"/\", chip)) {\n    int fd = open(path, O_RDWR | O_CLOEXEC);\n    if (fd >= 0) return fd;\n  }\n  DIR *dir = opendir(LIO_DEV_ROOT);\n  if (!dir) return -1;\n  int found = -1;\n  while (dirent *e = readdir(dir)) {\n    if (!starts_with(e->d_name, \"gpiochip\") || !join(path, sizeof(path), LIO_DEV_ROOT \"/\", e->d_name)) continue;\n    int fd = open(path, O_RDWR | O_CLOEXEC);\n    if (fd < 0) continue;\n    gpiochip_info info{};\n    if (ioctl(fd, GPIO_GET_CHIPINFO_IOCTL, &info) == 0 && same(info.label, chip)) {\n      found = fd;\n      break;\n    }\n    close(fd);\n  }\n  closedir(dir);\n  return found;\n}\n\n// Finds a line by name on any chip; returns the open chip and sets `offset`, or -1.\ninline int find_line(const char *name, unsigned &offset, char *consumer, size_t consumer_size) {\n  DIR *dir = opendir(LIO_DEV_ROOT);\n  if (!dir) return -1;\n  int found = -1;\n  char path[PATH_MAX];\n  while (found < 0) {\n    dirent *e = readdir(dir);\n    if (!e) break;\n    if (!starts_with(e->d_name, \"gpiochip\") || !join(path, sizeof(path), LIO_DEV_ROOT \"/\", e->d_name)) continue;\n    int fd = open(path, O_RDWR | O_CLOEXEC);\n    if (fd < 0) continue;\n    gpiochip_info info{};\n    if (ioctl(fd, GPIO_GET_CHIPINFO_IOCTL, &info) == 0) {\n      for (unsigned i = 0; i < info.lines; ++i) {\n        gpio_v2_line_info li{};\n        li.offset = i;\n        if (ioctl(fd, GPIO_V2_GET_LINEINFO_IOCTL, &li) == 0 && same(li.name, name)) {\n          offset = i;\n          copy_cstr(consumer, consumer_size, li.consumer);\n          found = fd;\n          break;\n        }\n      }\n    }\n    if (found < 0) close(fd);\n  }\n  closedir(dir);\n  return found;\n}\n\n// Claims the line of slot `s` (pin in key) as input or output with the settings in cfg.\n// cfg: bits 0-1 bias, 2 active low, 3-4 drive, 5 output, 32-63 debounce in microseconds.\ninline void claim_line(slot &s, bool first_value) {\n  const char *pin = s.key;\n  unsigned offset = 0;\n  char consumer[32] = \"\";\n  int chip = -1;\n  const char *colon = nullptr;\n  for (const char *p = pin; *p != '\\0'; ++p)\n    if (*p == ':') colon = p;\n  if (colon) {\n    char name[key_size];\n    size_t n = static_cast<size_t>(colon - pin);\n    if (n >= sizeof(name) || !all_digits(colon + 1)) {\n      set_error(s, e_input, pin, \"PIN is a line name or <chip>:<offset>\");\n      return;\n    }\n    for (size_t i = 0; i < n; ++i) name[i] = pin[i];\n    name[n] = '\\0';\n    offset = static_cast<unsigned>(strtoul(colon + 1, nullptr, 10));\n    chip = open_chip(name);\n    if (chip >= 0) {\n      gpio_v2_line_info li{};\n      li.offset = offset;\n      if (ioctl(chip, GPIO_V2_GET_LINEINFO_IOCTL, &li) != 0) {\n        close(chip);\n        set_error(s, e_not_found, pin, \"the chip has no such line\");\n        return;\n      }\n      copy_cstr(consumer, sizeof(consumer), li.consumer);\n    }\n  } else if (*pin != '\\0') {\n    chip = find_line(pin, offset, consumer, sizeof(consumer));\n  }\n  if (chip < 0) {\n    set_error(s, e_not_found, *pin != '\\0' ? pin : \"PIN\", \"no such GPIO line\");\n    return;\n  }\n  gpio_v2_line_request req{};\n  req.offsets[0] = offset;\n  req.num_lines = 1;\n  copy_cstr(req.consumer, sizeof(req.consumer), \"openplc\");\n  unsigned long long cfg = s.cfg;\n  unsigned long long flags = (cfg & 0x20u) ? GPIO_V2_LINE_FLAG_OUTPUT : GPIO_V2_LINE_FLAG_INPUT;\n  if (cfg & 0x4u) flags |= GPIO_V2_LINE_FLAG_ACTIVE_LOW;\n  if (cfg & 0x20u) {\n    unsigned drive = static_cast<unsigned>((cfg >> 3) & 0x3u);\n    if (drive == drive_open_drain) flags |= GPIO_V2_LINE_FLAG_OPEN_DRAIN;\n    if (drive == drive_open_source) flags |= GPIO_V2_LINE_FLAG_OPEN_SOURCE;\n    req.config.attrs[0].attr.id = GPIO_V2_LINE_ATTR_ID_OUTPUT_VALUES;\n    req.config.attrs[0].attr.values = first_value ? 1u : 0u;\n    req.config.attrs[0].mask = 1u;\n    req.config.num_attrs = 1;\n  } else {\n    unsigned bias = static_cast<unsigned>(cfg & 0x3u);\n    if (bias == bias_pull_up) flags |= GPIO_V2_LINE_FLAG_BIAS_PULL_UP;\n    else if (bias == bias_pull_down) flags |= GPIO_V2_LINE_FLAG_BIAS_PULL_DOWN;\n    else flags |= GPIO_V2_LINE_FLAG_BIAS_DISABLED;\n    unsigned debounce_us = static_cast<unsigned>(cfg >> 32);\n    if (debounce_us != 0) {\n      req.config.attrs[0].attr.id = GPIO_V2_LINE_ATTR_ID_DEBOUNCE;\n      req.config.attrs[0].attr.debounce_period_us = debounce_us;\n      req.config.attrs[0].mask = 1u;\n      req.config.num_attrs = 1;\n    }\n  }\n  req.config.flags = flags;\n  int rc = ioctl(chip, GPIO_V2_GET_LINE_IOCTL, &req);\n  int err = errno;\n  close(chip);\n  if (rc != 0) {\n    if (err == EBUSY) {\n      text t;\n      clear(t);\n      put(t, pin);\n      put(t, \": in use\");\n      if (consumer[0] != '\\0') {\n        put(t, \" by \");\n        put(t, consumer);\n      }\n      set_error(s, e_busy, t);\n    } else {\n      set_errno(s, e_refused, pin, \"the chip refused the line settings\", err);\n    }\n    return;\n  }\n  s.fd = req.fd;\n  s.applied = (cfg & 0x20u) ? (first_value ? 1 : 0) : -1;\n  set_error(s, e_no_error, \"\", \"\");\n}\n\ninline bool line_get(int fd, bool &value) {\n  gpio_v2_line_values v{};\n  v.mask = 1u;\n  if (ioctl(fd, GPIO_V2_LINE_GET_VALUES_IOCTL, &v) != 0) return false;\n  value = (v.bits & 1u) != 0;\n  return true;\n}\ninline bool line_set(int fd, bool value) {\n  gpio_v2_line_values v{};\n  v.mask = 1u;\n  v.bits = value ? 1u : 0u;\n  return ioctl(fd, GPIO_V2_LINE_SET_VALUES_IOCTL, &v) == 0;\n}\n\n// ---- PWM (helper thread) ----\n\n// The sysfs directory of pwmchip `chip`: a number, pwmchipN, or the chip's device name.\ninline bool pwm_chip_dir(const char *chip, char *out, size_t size) {\n  const char *base = LIO_SYS_ROOT \"/class/pwm/\";\n  if (all_digits(chip)) return join(out, size, base, \"pwmchip\", chip) && access(out, F_OK) == 0;\n  if (starts_with(chip, \"pwmchip\")) return join(out, size, base, chip) && access(out, F_OK) == 0;\n  DIR *dir = opendir(LIO_SYS_ROOT \"/class/pwm\");\n  if (!dir) return false;\n  bool found = false;\n  char link[PATH_MAX];\n  char target[PATH_MAX];\n  while (!found) {\n    dirent *e = readdir(dir);\n    if (!e) break;\n    if (!starts_with(e->d_name, \"pwmchip\") || !join(link, sizeof(link), base, e->d_name, \"/device\")) continue;\n    ssize_t n = readlink(link, target, sizeof(target) - 1);\n    if (n <= 0) continue;\n    target[n] = '\\0';\n    const char *name = target;\n    for (const char *p = target; *p != '\\0'; ++p)\n      if (*p == '/') name = p + 1;\n    if (same(name, chip)) found = join(out, size, base, e->d_name);\n  }\n  closedir(dir);\n  return found;\n}\n\ninline bool pwm_write(slot &s, const char *file, long long v, const char *subject) {\n  char path[PATH_MAX];\n  char num[24];\n  snprintf(num, sizeof(num), \"%lld\", v);\n  int err = 0;\n  if (!join(path, sizeof(path), s.pwm_dir, \"/\", file) || !write_file(path, num, err)) {\n    text t;\n    clear(t);\n    put(t, \"cannot write \");\n    put(t, file);\n    set_errno(s, e_io, subject, t.buf, err);\n    return false;\n  }\n  return true;\n}\n\n// Applies duty/frequency, or turns the channel off (on = false). Called without the lock held,\n// on a copy of the slot.\ninline void pwm_apply(slot &s, bool on) {\n  const char *subject = \"PWM\";\n  if (!s.exported) {\n    char chip_dir[PATH_MAX];\n    const char *colon = nullptr;\n    for (const char *p = s.key; *p != '\\0'; ++p)\n      if (*p == ':') colon = p;\n    char chip[key_size];\n    size_t n = colon ? static_cast<size_t>(colon - s.key) : 0;\n    for (size_t i = 0; i < n && i + 1 < sizeof(chip); ++i) chip[i] = s.key[i];\n    chip[n < sizeof(chip) ? n : sizeof(chip) - 1] = '\\0';\n    const char *channel = colon ? colon + 1 : \"0\";\n    if (!pwm_chip_dir(chip, chip_dir, sizeof(chip_dir))) {\n      set_error(s, e_not_found, chip[0] != '\\0' ? chip : \"CHIP\", \"no such PWM chip\");\n      return;\n    }\n    if (!join(s.pwm_dir, sizeof(s.pwm_dir), chip_dir, \"/pwm\", channel)) return;\n    if (access(s.pwm_dir, F_OK) != 0) {\n      char path[PATH_MAX];\n      int err = 0;\n      if (!join(path, sizeof(path), chip_dir, \"/export\") || (!write_file(path, channel, err) && err != EBUSY)) {\n        set_errno(s, err == EINVAL || err == ENODEV ? e_not_found : e_io, chip, \"cannot export the channel\", err);\n        return;\n      }\n    }\n    s.exported = true;\n    s.applied_on = false;\n    s.applied_freq = -1;\n    s.applied_duty = -1;\n  }\n  if (!on) {\n    if (s.applied_on || s.force_off) {\n      pwm_write(s, \"duty_cycle\", 0, subject);\n      pwm_write(s, \"enable\", 0, subject);\n    }\n    s.applied_on = false;\n    return;\n  }\n  if (s.applied_on && s.applied_freq == s.freq && s.applied_duty == s.duty) return;\n  long long period = static_cast<long long>(1e9 / s.freq + 0.5);\n  long long duty = static_cast<long long>(static_cast<double>(period) * s.duty / 100.0 + 0.5);\n  if (period <= 0) {\n    set_error(s, e_input, subject, \"FREQUENCY is too high\");\n    return;\n  }\n  // duty_cycle must stay at or below period while both change.\n  if (!pwm_write(s, \"duty_cycle\", 0, subject) || !pwm_write(s, \"period\", period, subject) ||\n      !pwm_write(s, \"duty_cycle\", duty, subject) || (!s.applied_on && !pwm_write(s, \"enable\", 1, subject)))\n    return;\n  s.applied_on = true;\n  s.applied_freq = s.freq;\n  s.applied_duty = s.duty;\n  set_error(s, e_no_error, \"\", \"\");\n}\n\ninline void pwm_unexport(slot &s) {\n  if (!s.exported) return;\n  char chip_dir[PATH_MAX];\n  copy_cstr(chip_dir, sizeof(chip_dir), s.pwm_dir);\n  size_t n = 0;\n  while (chip_dir[n] != '\\0') ++n;\n  while (n > 0 && chip_dir[n - 1] != '/') --n;\n  const char *channel = s.pwm_dir + n + 3;  // after \"pwm\"\n  if (n > 0) chip_dir[n - 1] = '\\0';\n  char path[PATH_MAX];\n  int err = 0;\n  if (join(path, sizeof(path), chip_dir, \"/unexport\")) write_file(path, channel, err);\n  s.exported = false;\n}\n\n// ---- reads (helper thread) ----\n\ninline void read_value(slot &s, double scale, double offset) {\n  char real[PATH_MAX];\n  const char *root = LIO_SYS_ROOT \"/\";\n  if (!starts_with(s.key, root) || !realpath(s.key, real) || !starts_with(real, root)) {\n    bool outside = !starts_with(s.key, root);\n    if (outside) set_error(s, e_input, s.key[0] != '\\0' ? s.key : \"PATH\", \"PATH must be a file under \" LIO_SYS_ROOT \"/\");\n    else set_errno(s, e_not_found, s.key, \"cannot open\", errno);\n    s.valid = false;\n    return;\n  }\n  char buf[256];\n  int err = 0;\n  double v = 0;\n  if (!read_file(real, buf, sizeof(buf), err)) {\n    set_errno(s, e_io, s.key, \"cannot read\", err);\n    s.valid = false;\n    return;\n  }\n  if (!first_number(buf, v)) {\n    set_error(s, e_io, s.key, \"the file holds no number\");\n    s.valid = false;\n    return;\n  }\n  s.raw = static_cast<long long>(v);\n  s.value = v * scale + offset;\n  s.valid = true;\n  set_error(s, e_no_error, \"\", \"\");\n}\n\ninline bool read_number(const char *dir, const char *file, double &v) {\n  char path[PATH_MAX];\n  char buf[128];\n  int err = 0;\n  return join(path, sizeof(path), dir, \"/\", file) && read_file(path, buf, sizeof(buf), err) && first_number(buf, v);\n}\n\n// key = \"<device>\\n<channel>\"\ninline void read_iio(slot &s) {\n  char device[key_size];\n  copy_cstr(device, sizeof(device), s.key);\n  char *channel = device;\n  while (*channel != '\\0' && *channel != '\\n') ++channel;\n  if (*channel == '\\n') *channel++ = '\\0';\n  s.valid = false;\n  if (device[0] == '\\0' || channel[0] == '\\0') {\n    set_error(s, e_input, \"IIO\", \"DEVICE and CHANNEL are required\");\n    return;\n  }\n  const char *base = LIO_SYS_ROOT \"/bus/iio/devices\";\n  DIR *dir = opendir(base);\n  char found[PATH_MAX] = \"\";\n  if (dir) {\n    char path[PATH_MAX];\n    char name[128];\n    int err = 0;\n    while (dirent *e = readdir(dir)) {\n      if (e->d_name[0] == '.' || !join(path, sizeof(path), base, \"/\", e->d_name)) continue;\n      char name_path[PATH_MAX];\n      if (!join(name_path, sizeof(name_path), path, \"/name\") || !read_file(name_path, name, sizeof(name), err)) continue;\n      trim(name);\n      if (same(name, device)) {\n        copy_cstr(found, sizeof(found), path);\n        break;\n      }\n    }\n    closedir(dir);\n  }\n  if (found[0] == '\\0') {\n    set_error(s, e_not_found, device, \"no such IIO device\");\n    return;\n  }\n  char file[key_size + 16];\n  double raw = 0;\n  snprintf(file, sizeof(file), \"%s_raw\", channel);\n  if (!read_number(found, file, raw)) {\n    set_error(s, e_not_found, device, \"the channel has no readable _raw file\");\n    return;\n  }\n  char type[key_size];\n  channel_type(channel, type, sizeof(type));\n  double scale = 1;\n  double offset = 0;\n  snprintf(file, sizeof(file), \"%s_scale\", channel);\n  if (!read_number(found, file, scale)) {\n    snprintf(file, sizeof(file), \"%s_scale\", type);\n    if (!read_number(found, file, scale)) scale = 1;\n  }\n  snprintf(file, sizeof(file), \"%s_offset\", channel);\n  if (!read_number(found, file, offset)) {\n    snprintf(file, sizeof(file), \"%s_offset\", type);\n    if (!read_number(found, file, offset)) offset = 0;\n  }\n  s.raw = static_cast<long long>(raw);\n  s.value = iio_value(raw, offset, scale);\n  s.valid = true;\n  set_error(s, e_no_error, \"\", \"\");\n}\n\n// ---- helper thread ----\n\n// Puts an output in its stop state. Lock held; GPIO writes are a single ioctl.\ninline void stop_gpio(slot &s) {\n  if (s.fd >= 0 && s.stop != stop_hold) {\n    bool v = s.stop == stop_on;\n    if (line_set(s.fd, v)) s.applied = v ? 1 : 0;\n  }\n}\n\n// Frees a slot; for PWM the caller has already turned it off or kept it (hold).\ninline void free_slot(slot &s) {\n  if (s.fd >= 0) close(s.fd);\n  slot fresh{};\n  fresh.fd = -1;\n  s = fresh;\n}\n\n// True if another used PWM slot drives the same channel (a block enabled again meanwhile).\ninline bool pwm_shared(state &st, int self, const char *key) {\n  pthread_mutex_lock(&st.lock);\n  bool found = false;\n  for (int i = 0; i < max_slots && !found; ++i)\n    found = i != self && st.slots[i].used && st.slots[i].kind == k_pwm && same(st.slots[i].key, key);\n  pthread_mutex_unlock(&st.lock);\n  return found;\n}\n\ninline void *helper(void *) {\n  state &st = shared();\n  for (;;) {\n    timespec tick = {0, 10 * ms};\n    nanosleep(&tick, nullptr);\n    if (st.quit) break;\n    long long now = now_ns();\n    bool any = false;\n    for (int i = 0; i < max_slots; ++i) {\n      pthread_mutex_lock(&st.lock);\n      slot &live = st.slots[i];\n      if (!live.used) {\n        pthread_mutex_unlock(&st.lock);\n        continue;\n      }\n      any = true;\n      long long idle = now - live.last_call;\n      bool timed_out = idle > stop_after(live.interval);\n      int kind = live.kind;\n      if (kind == k_out) {\n        if (timed_out && !live.stopped) {\n          stop_gpio(live);\n          live.stopped = true;\n        }\n        if (idle > release_after) free_slot(live);\n        pthread_mutex_unlock(&st.lock);\n        continue;\n      }\n      if (kind == k_in) {\n        if (idle > release_after) free_slot(live);\n        pthread_mutex_unlock(&st.lock);\n        continue;\n      }\n      if (timed_out && !live.stopped) live.stopped = true;\n      slot work = live;  // slow work on a copy, outside the lock\n      pthread_mutex_unlock(&st.lock);\n\n      bool release = idle > release_after;\n      bool changed = false;\n      if (kind == k_pwm) {\n        bool on = !work.stopped && !release;\n        if (on || work.stop != stop_hold) {\n          pwm_apply(work, on);\n          changed = true;\n        }\n        if (release && work.stop != stop_hold && !pwm_shared(st, i, work.key)) pwm_unexport(work);\n      } else if ((kind == k_value || kind == k_iio) && !work.stopped && now >= work.next_read) {\n        if (kind == k_value) read_value(work, work.scale, work.offset);\n        else read_iio(work);\n        work.next_read = now + work.period;\n        changed = true;\n      }\n\n      pthread_mutex_lock(&st.lock);\n      slot &back = st.slots[i];\n      if (back.used && back.kind == kind && same(back.key, work.key)) {\n        if (release) {\n          free_slot(back);\n        } else if (changed) {\n          back.exported = work.exported;\n          copy_cstr(back.pwm_dir, sizeof(back.pwm_dir), work.pwm_dir);\n          back.applied_on = work.applied_on;\n          back.applied_freq = work.applied_freq;\n          back.applied_duty = work.applied_duty;\n          back.value = work.value;\n          back.raw = work.raw;\n          back.valid = work.valid;\n          back.next_read = work.next_read;\n          back.error = work.error;\n          copy_cstr(back.message, sizeof(back.message), work.message);\n        }\n      }\n      pthread_mutex_unlock(&st.lock);\n    }\n    if (!any) {\n      pthread_mutex_lock(&st.lock);\n      bool still_none = true;\n      for (int i = 0; i < max_slots; ++i) still_none = still_none && !st.slots[i].used;\n      if (still_none) st.running = false;\n      pthread_mutex_unlock(&st.lock);\n      if (still_none) break;\n    }\n  }\n  return nullptr;\n}\n\n// Lock held. Starts the helper thread with normal scheduling, not the scan thread's.\ninline void ensure_helper(state &st) {\n  if (st.running) return;\n  if (st.thread_started) pthread_join(st.thread, nullptr);\n  st.thread_started = false;\n  pthread_attr_t attr;\n  if (pthread_attr_init(&attr) != 0) return;\n  sched_param param{};\n  param.sched_priority = 0;\n  pthread_attr_setinheritsched(&attr, PTHREAD_EXPLICIT_SCHED);\n  pthread_attr_setschedpolicy(&attr, SCHED_OTHER);\n  pthread_attr_setschedparam(&attr, &param);\n  st.quit = false;\n  if (pthread_create(&st.thread, &attr, helper, nullptr) == 0) {\n    st.thread_started = true;\n    st.running = true;\n  }\n  pthread_attr_destroy(&attr);\n}\n\n// Stops the helper and frees every slot when the program library is unloaded.\nstruct unload_guard {\n  ~unload_guard() {\n    state &st = shared();\n    st.quit = true;\n    if (st.thread_started) pthread_join(st.thread, nullptr);\n    st.thread_started = false;\n    st.running = false;\n    for (int i = 0; i < max_slots; ++i) {\n      slot &s = st.slots[i];\n      if (!s.used) continue;\n      if (s.kind == k_out && !s.stopped) stop_gpio(s);\n      if (s.kind == k_pwm && s.stop != stop_hold) {\n        pwm_apply(s, false);\n        pwm_unexport(s);\n      }\n      free_slot(s);\n    }\n  }\n};\ninline unload_guard &guard() {\n  static unload_guard g;\n  return g;\n}\n\n// One call of a block: finds or makes its slot (index + 1 in `id`), records the call and returns\n// the slot with the lock held, or nullptr (no slot free; the lock is not held then).\ninline slot *enter(unsigned short &id, unsigned &gen, int kind, const char *key, unsigned long long cfg) {\n  state &st = shared();\n  (void)guard();\n  long long now = now_ns();\n  pthread_mutex_lock(&st.lock);\n  slot *s = nullptr;\n  if (id >= 1 && id <= max_slots && st.slots[id - 1].used && st.slots[id - 1].kind == kind &&\n      st.slots[id - 1].gen == gen)\n    s = &st.slots[id - 1];\n  if (!s) {\n    for (int i = 0; i < max_slots && !s; ++i) {\n      if (!st.slots[i].used) {\n        s = &st.slots[i];\n        slot fresh{};\n        fresh.fd = -1;\n        fresh.used = true;\n        fresh.kind = kind;\n        fresh.applied = -1;\n        fresh.last_call = now;\n        fresh.gen = ++st.next_gen == 0 ? ++st.next_gen : st.next_gen;\n        *s = fresh;\n        id = static_cast<unsigned short>(i + 1);\n        gen = fresh.gen;\n      }\n    }\n  }\n  if (!s) {\n    pthread_mutex_unlock(&st.lock);\n    id = 0;\n    gen = 0;\n    return nullptr;\n  }\n  if (!same(s->key, key) || s->cfg != cfg) {\n    // A new pin or new settings: claim again.\n    if (s->fd >= 0) close(s->fd);\n    s->fd = -1;\n    s->next_try = 0;\n    s->applied = -1;\n    s->exported = false;\n    s->valid = false;\n    s->next_read = 0;\n    s->error = e_no_error;\n    s->message[0] = '\\0';\n    copy_cstr(s->key, sizeof(s->key), key);\n    s->cfg = cfg;\n  }\n  long long d = now - s->last_call;\n  if (d > 0 && d < 10000 * ms) s->interval = s->interval > 0 ? (s->interval * 7 + d) / 8 : d;\n  s->last_call = now;\n  s->stopped = false;\n  ensure_helper(st);\n  return s;\n}\ninline void leave() { pthread_mutex_unlock(&shared().lock); }\n\n// ENABLE went FALSE: outputs to their stop state, then the slot is freed (PWM by the helper).\ninline void disable(unsigned short &id, unsigned &gen, int kind) {\n  if (id == 0) return;\n  state &st = shared();\n  pthread_mutex_lock(&st.lock);\n  if (id <= max_slots && st.slots[id - 1].used && st.slots[id - 1].kind == kind && st.slots[id - 1].gen == gen) {\n    slot &s = st.slots[id - 1];\n    if (kind == k_pwm) {\n      s.last_call = 0;  // the helper turns it off (or keeps it, hold) and frees it\n      s.stopped = true;\n      s.interval = 0;\n      s.gen = 0;  // no block owns it any more\n    } else {\n      if (kind == k_out) stop_gpio(s);\n      free_slot(s);\n    }\n  }\n  pthread_mutex_unlock(&st.lock);\n  id = 0;\n  gen = 0;\n}\n\n// PWM with ENABLE FALSE: turns the channel off whatever ON_STOP says, also one a block left running\n// (LIO_STOP_HOLD) before. Runs once per disable; id = pwm_done marks it done until the block runs again.\nconst unsigned short pwm_done = 0xFFFF;\ninline void pwm_off(unsigned short &id, unsigned &gen, const char *key) {\n  if (id == pwm_done) return;\n  state &st = shared();\n  (void)guard();\n  pthread_mutex_lock(&st.lock);\n  slot *s = nullptr;\n  if (id >= 1 && id <= max_slots && st.slots[id - 1].used && st.slots[id - 1].kind == k_pwm &&\n      st.slots[id - 1].gen == gen)\n    s = &st.slots[id - 1];\n  for (int i = 0; i < max_slots && !s; ++i)\n    if (st.slots[i].used && st.slots[i].kind == k_pwm && st.slots[i].gen == 0 && same(st.slots[i].key, key))\n      s = &st.slots[i];\n  bool other = false;\n  for (int i = 0; i < max_slots && !s && !other; ++i)\n    other = st.slots[i].used && st.slots[i].kind == k_pwm && same(st.slots[i].key, key);\n  for (int i = 0; i < max_slots && !s && !other; ++i) {\n    if (!st.slots[i].used) {\n      s = &st.slots[i];\n      slot fresh{};\n      fresh.fd = -1;\n      fresh.used = true;\n      fresh.kind = k_pwm;\n      fresh.applied = -1;\n      copy_cstr(fresh.key, sizeof(fresh.key), key);\n      *s = fresh;\n    }\n  }\n  if (s) {\n    s->stop = stop_off;\n    s->force_off = true;\n    s->last_call = 0;  // the helper turns it off, unexports it and frees the slot\n    s->stopped = true;\n    s->interval = 0;\n    s->gen = 0;\n    ensure_helper(st);\n  }\n  pthread_mutex_unlock(&st.lock);\n  id = pwm_done;\n  gen = 0;\n}\n\n#endif  // __linux__\n\n}  // namespace lio\n\n#pragma pop_macro(\"ENABLE\")\n#pragma pop_macro(\"PIN\")\n#pragma pop_macro(\"BIAS\")\n#pragma pop_macro(\"ACTIVE_LOW\")\n#pragma pop_macro(\"DEBOUNCE\")\n#pragma pop_macro(\"Q\")\n#pragma pop_macro(\"VALUE\")\n#pragma pop_macro(\"DRIVE\")\n#pragma pop_macro(\"ON_STOP\")\n#pragma pop_macro(\"CHIP\")\n#pragma pop_macro(\"CHANNEL\")\n#pragma pop_macro(\"FREQUENCY\")\n#pragma pop_macro(\"DUTY\")\n#pragma pop_macro(\"PATH\")\n#pragma pop_macro(\"SCALE\")\n#pragma pop_macro(\"OFFSET\")\n#pragma pop_macro(\"PERIOD\")\n#pragma pop_macro(\"RAW\")\n#pragma pop_macro(\"DEVICE\")\n#pragma pop_macro(\"VALID\")\n#pragma pop_macro(\"ERROR\")\n#pragma pop_macro(\"ERRORTEXT\")\n#pragma pop_macro(\"lio_slot\")\n#pragma pop_macro(\"lio_gen\")\n#endif  // LINUX_IO_SHARED_INCLUDED\nvoid setup() {\n}\n\nvoid loop() {\n#if defined(__linux__)\n  if (!ENABLE) {\n    unsigned short l_id = lio_slot;\n    unsigned l_gen = lio_gen;\n    lio::disable(l_id, l_gen, lio::k_iio);\n    lio_slot = 0;\n    lio_gen = 0;\n    VALID = false;\n    ERROR = 0;\n    if (lio_last != 0) ERRORTEXT = \"\";\n    lio_last = 0;\n    return;\n  }\n  char l_key[lio::key_size];\n  snprintf(l_key, sizeof(l_key), \"%s\\n%s\", DEVICE.c_str(), CHANNEL.c_str());\n  long long l_period = PERIOD;\n  if (l_period < 10 * lio::ms) l_period = 10 * lio::ms;\n  unsigned short l_id = lio_slot;\n  unsigned l_gen = lio_gen;\n  lio::slot *l_s = lio::enter(l_id, l_gen, lio::k_iio, l_key, 0);\n  lio_slot = l_id;\n  lio_gen = l_gen;\n  bool l_valid = false;\n  double l_value = 0;\n  long long l_raw = 0;\n  int l_err = lio::e_no_slot;\n  lio::text l_msg;\n  lio::clear(l_msg);\n  lio::put(l_msg, \"more than 64 linux_io blocks\");\n  if (l_s) {\n    l_s->period = l_period;\n    l_valid = l_s->valid;\n    l_value = l_s->value;\n    l_raw = l_s->raw;\n    l_err = l_s->error;\n    lio::clear(l_msg);\n    lio::put(l_msg, l_s->message);\n    lio::leave();\n  }\n  VALID = l_valid;\n  if (l_valid) {\n    VALUE = static_cast<float>(l_value);\n    RAW = l_raw;\n  }\n  ERROR = static_cast<uint8_t>(l_err);\n  if (l_err != 0 || lio_last != 0) ERRORTEXT = l_msg.buf;\n  lio_last = static_cast<uint8_t>(l_err);\n#else\n\n  VALID = false;\n  ERROR = 1;\n  ERRORTEXT = \"not supported on this target\";\n#endif\n}\nEND_FUNCTION_BLOCK\n"
    }
  ]
}
